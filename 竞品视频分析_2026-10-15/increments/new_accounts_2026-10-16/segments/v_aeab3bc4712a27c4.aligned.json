{
  "video_id": "v_aeab3bc4712a27c4",
  "duration_s": 411.76,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_aeab3bc4712a27c4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_aeab3bc4712a27c4.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 7290,
      "text": "前两集咱们聊了呃几纳天池、盐湖这些这集直接亮底牌，",
      "token_start": 0,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 7990,
      "end_ms": 10410,
      "text": "尤其是排在榜首的那个地方。",
      "token_start": 23,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 11070,
      "end_ms": 13410,
      "text": "你站在那里的第一反应不是好美，",
      "token_start": 35,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 13770,
      "end_ms": 15810,
      "text": "是这地方不应该存在。",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16750,
      "end_ms": 18810,
      "text": "觉得有意思的朋友可以先收藏，",
      "token_start": 58,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 19390,
      "end_ms": 21150,
      "text": "免得刷着刷着找不到了。",
      "token_start": 71,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 22070,
      "end_ms": 22770,
      "text": "第五名，",
      "token_start": 81,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23550,
      "end_ms": 25310,
      "text": "广西德天瀑布，",
      "token_start": 84,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 25310,
      "end_ms": 28730,
      "text": "你站在中越边境的观景台上，",
      "token_start": 90,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 28730,
      "end_ms": 30580,
      "text": "还没看到到瀑布。",
      "token_start": 102,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 31340,
      "end_ms": 32440,
      "text": "先听到声音，",
      "token_start": 109,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 32460,
      "end_ms": 35440,
      "text": "轰隆隆的向远处在打闷雷，",
      "token_start": 114,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 36580,
      "end_ms": 37760,
      "text": "你往前走几步，",
      "token_start": 125,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 37780,
      "end_ms": 41080,
      "text": "转个弯一整面白色的水幕，",
      "token_start": 131,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 41280,
      "end_ms": 43360,
      "text": "从七十米高的地方砸下来，",
      "token_start": 142,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 43360,
      "end_ms": 45100,
      "text": "砸在下面的水潭里，",
      "token_start": 153,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 45100,
      "end_ms": 51720,
      "text": "集起的水雾飘到你脸上凉丝丝的瀑布，",
      "token_start": 161,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 51740,
      "end_ms": 53280,
      "text": "宽二百零八米，",
      "token_start": 177,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 53280,
      "end_ms": 54960,
      "text": "分三级跌落。",
      "token_start": 183,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 54960,
      "end_ms": 56820,
      "text": "水雾升腾的时候，",
      "token_start": 188,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 56820,
      "end_ms": 61095,
      "text": "整个瀑布会消失在白白茫茫的雾气。",
      "token_start": 195,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 61650,
      "end_ms": 63195,
      "text": "你只听到轰鸣声，",
      "token_start": 210,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 63950,
      "end_ms": 65025,
      "text": "看不见水在哪？",
      "token_start": 217,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 66040,
      "end_ms": 68305,
      "text": "像有人把先进的门帘放下来，",
      "token_start": 223,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 68790,
      "end_ms": 70525,
      "text": "瀑布旁边就是国境县，",
      "token_start": 235,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 71260,
      "end_ms": 72265,
      "text": "你往对面看，",
      "token_start": 244,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 73010,
      "end_ms": 75155,
      "text": "越南的村庄清清楚楚，",
      "token_start": 249,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 75900,
      "end_ms": 78460,
      "text": "炊烟在竹林上面慢慢升起来。",
      "token_start": 258,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 78540,
      "end_ms": 82935,
      "text": "一条瀑布两个国家中间只隔了一条水。",
      "token_start": 270,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 83830,
      "end_ms": 84485,
      "text": "第四名，",
      "token_start": 286,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 85500,
      "end_ms": 87625,
      "text": "贵州荔波小七孔，",
      "token_start": 289,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 88320,
      "end_ms": 89925,
      "text": "你沿着河谷往里走，",
      "token_start": 296,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 90780,
      "end_ms": 93215,
      "text": "脚下的石板路被水汽打湿，",
      "token_start": 304,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 94550,
      "end_ms": 95305,
      "text": "滑滑的，",
      "token_start": 315,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 95690,
      "end_ms": 97165,
      "text": "两边的树越来越密，",
      "token_start": 318,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 97530,
      "end_ms": 98685,
      "text": "光线越来越暗，",
      "token_start": 326,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 99050,
      "end_ms": 100215,
      "text": "水声越来越响。",
      "token_start": 332,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 100900,
      "end_ms": 102085,
      "text": "你转过一个弯儿，",
      "token_start": 338,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 102480,
      "end_ms": 105265,
      "text": "眼前忽然打开一片碧绿的水，",
      "token_start": 345,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 105650,
      "end_ms": 107565,
      "text": "那种绿绿的不真实，",
      "token_start": 357,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 108240,
      "end_ms": 111535,
      "text": "像有人把一整块翡翠融化在了河里。",
      "token_start": 365,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 111950,
      "end_ms": 113530,
      "text": "六十八级跌水瀑布，",
      "token_start": 380,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 113530,
      "end_ms": 116190,
      "text": "沿着一千六百米的河道层层跌落，",
      "token_start": 388,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 116210,
      "end_ms": 118085,
      "text": "每一级的水色都不一样，",
      "token_start": 402,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 118610,
      "end_ms": 119755,
      "text": "深处是墨绿，",
      "token_start": 412,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 120190,
      "end_ms": 124695,
      "text": "浅处是翠绿阳光照透的地方变成荧光绿，",
      "token_start": 417,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 125490,
      "end_ms": 127330,
      "text": "最绝的是水上森林，",
      "token_start": 434,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 127330,
      "end_ms": 129605,
      "text": "一片古树直接长在河床上，",
      "token_start": 442,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 129990,
      "end_ms": 131955,
      "text": "根系扎在水底的石头缝里，",
      "token_start": 453,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 132270,
      "end_ms": 134185,
      "text": "树冠在头顶合拢。",
      "token_start": 464,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 134780,
      "end_ms": 135640,
      "text": "你脱了鞋，",
      "token_start": 471,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 135860,
      "end_ms": 138350,
      "text": "赤脚踩在水里的石头上水，",
      "token_start": 475,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 138410,
      "end_ms": 142125,
      "text": "从脚趾缝里流过去凉的你倒吸一口气。",
      "token_start": 486,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 142540,
      "end_ms": 143695,
      "text": "头顶是树荫，",
      "token_start": 502,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 144210,
      "end_ms": 146085,
      "text": "脚下是清澈的溪水，",
      "token_start": 507,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 146770,
      "end_ms": 149695,
      "text": "阳光从树叶缝隙里洒下来，",
      "token_start": 515,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 150070,
      "end_ms": 152070,
      "text": "一块儿一块的落在水面上，",
      "token_start": 526,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 152110,
      "end_ms": 154155,
      "text": "整片森林像被施了魔法。",
      "token_start": 537,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 155250,
      "end_ms": 156025,
      "text": "第三名，",
      "token_start": 547,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 156920,
      "end_ms": 159235,
      "text": "云南孟姜丙中洛，",
      "token_start": 550,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 160110,
      "end_ms": 162315,
      "text": "你站在丙中洛观景台上，",
      "token_start": 557,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 163080,
      "end_ms": 164865,
      "text": "脚下是怒江大拐弯，",
      "token_start": 567,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 165300,
      "end_ms": 168040,
      "text": "江水在这里拐了一个一百八十度的大弯，",
      "token_start": 575,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 168540,
      "end_ms": 171935,
      "text": "从上游的暴怒变成了拐弯处的平静。",
      "token_start": 592,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 172410,
      "end_ms": 174680,
      "text": "碧绿的水面像一块翡翠，",
      "token_start": 607,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 174900,
      "end_ms": 175895,
      "text": "嵌在峡谷里，",
      "token_start": 617,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 176530,
      "end_ms": 179135,
      "text": "弯道对面是一面垂直的绝壁，",
      "token_start": 622,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 179750,
      "end_ms": 182185,
      "text": "绝壁上挂着一条细长的瀑布，",
      "token_start": 634,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 182640,
      "end_ms": 185225,
      "text": "像一条白线从天上垂下来。",
      "token_start": 646,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 186070,
      "end_ms": 192860,
      "text": "藏族牧足隶肃祖独龙族的村寨散落在台地边缘，",
      "token_start": 657,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 192980,
      "end_ms": 195725,
      "text": "炊烟在雪山和峡谷之间升起来。",
      "token_start": 677,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 196140,
      "end_ms": 198880,
      "text": "你听到赶马的怒族老人哼着调子，",
      "token_start": 690,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 198880,
      "end_ms": 200055,
      "text": "从身边走过，",
      "token_start": 704,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 200560,
      "end_ms": 205385,
      "text": "看到背着竹篓的隶肃族女人从溜索上划过江面。",
      "token_start": 709,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 205840,
      "end_ms": 207820,
      "text": "江边有藏族小孩在洗衣服，",
      "token_start": 729,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 208000,
      "end_ms": 209060,
      "text": "水花溅起来，",
      "token_start": 740,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 209140,
      "end_ms": 210625,
      "text": "在阳光下闪着光。",
      "token_start": 745,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 211330,
      "end_ms": 212265,
      "text": "你站在那里，",
      "token_start": 752,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 212540,
      "end_ms": 214175,
      "text": "风从峡谷里灌过来，",
      "token_start": 757,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 214460,
      "end_ms": 217165,
      "text": "带着江水的气息和炊烟的味道。",
      "token_start": 765,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 217520,
      "end_ms": 218120,
      "text": "那一刻，",
      "token_start": 778,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 218120,
      "end_ms": 219760,
      "text": "你的第一反应真的不是好美，",
      "token_start": 781,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 219840,
      "end_ms": 226600,
      "text": "而是这种地方怎么可能存在第二名四川黄龙盖华彩池群。",
      "token_start": 793,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 226800,
      "end_ms": 228775,
      "text": "你沿着栈道往上走，",
      "token_start": 817,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 229130,
      "end_ms": 231205,
      "text": "海拔三千到三千六百米，",
      "token_start": 825,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 231580,
      "end_ms": 233185,
      "text": "走几步就要喘一口气，",
      "token_start": 835,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 233890,
      "end_ms": 237255,
      "text": "但你一抬头就不想再低头了。",
      "token_start": 844,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 238190,
      "end_ms": 239730,
      "text": "三千四百多个彩翅，",
      "token_start": 856,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 239770,
      "end_ms": 240785,
      "text": "层层叠叠，",
      "token_start": 864,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 241270,
      "end_ms": 242485,
      "text": "从高处往下看，",
      "token_start": 868,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 243080,
      "end_ms": 244580,
      "text": "像一条金色的巨龙，",
      "token_start": 874,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 244820,
      "end_ms": 250505,
      "text": "趴在雪山峡谷里池水的颜色随深度和光线变化，",
      "token_start": 882,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 251170,
      "end_ms": 256795,
      "text": "浅处透明深处碧蓝阳光照透的地方变成翠绿。",
      "token_start": 902,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 257380,
      "end_ms": 259365,
      "text": "你蹲下来看最近的一个池子，",
      "token_start": 921,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 259880,
      "end_ms": 262805,
      "text": "水清的能看见池底的钙化结晶，",
      "token_start": 933,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 263510,
      "end_ms": 268355,
      "text": "白色的黄色的褐色的纹理像一幅画。",
      "token_start": 946,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 268850,
      "end_ms": 272165,
      "text": "你伸手碰了一下水兵的指尖发麻，",
      "token_start": 961,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 272790,
      "end_ms": 273830,
      "text": "钙滑的形成，",
      "token_start": 975,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 273830,
      "end_ms": 275690,
      "text": "需要极其苛刻的条件。",
      "token_start": 980,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 275690,
      "end_ms": 277350,
      "text": "高寒喀斯特地貌，",
      "token_start": 989,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 277590,
      "end_ms": 279395,
      "text": "富含碳酸钙的水源，",
      "token_start": 996,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 279840,
      "end_ms": 281535,
      "text": "合适的温度和压力。",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 282330,
      "end_ms": 286045,
      "text": "黄龙的采池群是亚洲最大的盖华景观，",
      "token_start": 1012,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 286690,
      "end_ms": 289405,
      "text": "世界上能跟他比的只有土耳其的棉花堡，",
      "token_start": 1028,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 290080,
      "end_ms": 291475,
      "text": "但棉花宝是白色的。",
      "token_start": 1045,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 291920,
      "end_ms": 295085,
      "text": "黄龙是五彩的第一名，",
      "token_start": 1053,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 295890,
      "end_ms": 297235,
      "text": "四川九寨沟，",
      "token_start": 1062,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 298060,
      "end_ms": 299655,
      "text": "你站在五花海边。",
      "token_start": 1067,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 300580,
      "end_ms": 301460,
      "text": "低头看水，",
      "token_start": 1074,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 301480,
      "end_ms": 302480,
      "text": "你看到的是一种，",
      "token_start": 1078,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 302480,
      "end_ms": 304100,
      "text": "你从来没见过的蓝，",
      "token_start": 1085,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 304300,
      "end_ms": 305760,
      "text": "不是天空的蓝，",
      "token_start": 1093,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 306140,
      "end_ms": 307440,
      "text": "不是海水的蓝，",
      "token_start": 1099,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 307760,
      "end_ms": 309780,
      "text": "是一种从水底发出来的，",
      "token_start": 1105,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 309780,
      "end_ms": 311580,
      "text": "带着绿调的亮的，",
      "token_start": 1115,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 311580,
      "end_ms": 313100,
      "text": "净乎透明的蓝。",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 314060,
      "end_ms": 319620,
      "text": "五花海的湖水反射红绿蓝光的比例大约是百分之九点二，",
      "token_start": 1128,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 320080,
      "end_ms": 321880,
      "text": "百分之四十九点六，",
      "token_start": 1152,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 322720,
      "end_ms": 324580,
      "text": "百分之四十一点二。",
      "token_start": 1160,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 325480,
      "end_ms": 327680,
      "text": "这种独特的反射光组成，",
      "token_start": 1168,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 327760,
      "end_ms": 333270,
      "text": "让人眼看到的湖泊颜色是明亮的蓝绿色水。",
      "token_start": 1178,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 333290,
      "end_ms": 334130,
      "text": "为什么这么蓝？",
      "token_start": 1196,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 334530,
      "end_ms": 337710,
      "text": "因为九寨沟地处高寒喀斯特地区，",
      "token_start": 1202,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 338030,
      "end_ms": 340570,
      "text": "水中含有大量钙、华颗粒物，",
      "token_start": 1216,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 341230,
      "end_ms": 346970,
      "text": "这些微小颗粒对蓝绿光有强烈的选择性反射和散射作用，",
      "token_start": 1227,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 346970,
      "end_ms": 348890,
      "text": "加上水体洁净度极高，",
      "token_start": 1251,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 349330,
      "end_ms": 350450,
      "text": "含沙量极低，",
      "token_start": 1260,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 351030,
      "end_ms": 351950,
      "text": "湖泊越深，",
      "token_start": 1265,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 352310,
      "end_ms": 353310,
      "text": "颜色就越蓝。",
      "token_start": 1269,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 354110,
      "end_ms": 355110,
      "text": "你站在湖边，",
      "token_start": 1274,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 355430,
      "end_ms": 357210,
      "text": "风从水面上吹过来，",
      "token_start": 1279,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 357650,
      "end_ms": 360700,
      "text": "带着一点湿润的清甜的气息。",
      "token_start": 1287,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 361040,
      "end_ms": 362600,
      "text": "秋天的九寨沟，",
      "token_start": 1299,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 362900,
      "end_ms": 369485,
      "text": "红叶黄叶、绿水和蓝湖四种颜色同时出现在你眼前。",
      "token_start": 1305,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 369850,
      "end_ms": 370845,
      "text": "你看着那种蓝，",
      "token_start": 1326,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 371140,
      "end_ms": 372975,
      "text": "会怀疑自己是不是在做梦，",
      "token_start": 1332,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 374480,
      "end_ms": 375325,
      "text": "这不是水，",
      "token_start": 1343,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 375770,
      "end_ms": 377785,
      "text": "这是大地打翻的调色盘。",
      "token_start": 1347,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 378610,
      "end_ms": 381375,
      "text": "好十五个水做的仙境，",
      "token_start": 1357,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 382180,
      "end_ms": 385590,
      "text": "从西湖的雨到额济纳的金，",
      "token_start": 1366,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 385730,
      "end_ms": 388515,
      "text": "从泸沽湖的花到九寨沟的兰，",
      "token_start": 1377,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 389070,
      "end_ms": 391745,
      "text": "这些地方散落在中国的四面八方，",
      "token_start": 1389,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 392300,
      "end_ms": 393720,
      "text": "有的在沙漠里，",
      "token_start": 1403,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 393780,
      "end_ms": 395205,
      "text": "有的在雪山下，",
      "token_start": 1409,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 395650,
      "end_ms": 397250,
      "text": "有的挂在悬崖边，",
      "token_start": 1415,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 397470,
      "end_ms": 399365,
      "text": "有的藏在峡谷深处。",
      "token_start": 1422,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 399870,
      "end_ms": 402095,
      "text": "如果让你挑一个水井住三天，",
      "token_start": 1430,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 402420,
      "end_ms": 406245,
      "text": "你去哪个是俄济纳的胡杨倒影，",
      "token_start": 1442,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 406510,
      "end_ms": 409795,
      "text": "还是九寨沟的蓝色海子评论区聊聊，",
      "token_start": 1455,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 411250,
      "end_ms": 411675,
      "text": "我等你。",
      "token_start": 1470,
      "token_end_exclusive": 1473
    }
  ],
