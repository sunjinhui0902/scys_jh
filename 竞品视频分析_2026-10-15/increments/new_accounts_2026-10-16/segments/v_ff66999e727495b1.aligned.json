{
  "video_id": "v_ff66999e727495b1",
  "duration_s": 558.300998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_ff66999e727495b1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_ff66999e727495b1.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 770,
      "text": "接着上集，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1150,
      "end_ms": 3550,
      "text": "咱们继续聊故宫里十件皇帝，",
      "token_start": 4,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3550,
      "end_ms": 5490,
      "text": "每天都用的日常器物，",
      "token_start": 16,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5950,
      "end_ms": 8050,
      "text": "上一集讲了第十道第六名，",
      "token_start": 25,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8650,
      "end_ms": 11410,
      "text": "成化鸡纲杯拍出二点八亿。",
      "token_start": 36,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12930,
      "end_ms": 15410,
      "text": "雍正批奏折劈的跟聊天一样，",
      "token_start": 47,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15750,
      "end_ms": 17270,
      "text": "康熙的眼镜丢了，",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 17270,
      "end_ms": 18010,
      "text": "比丢了，",
      "token_start": 66,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 18010,
      "end_ms": 18830,
      "text": "玉玺还急。",
      "token_start": 69,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 19710,
      "end_ms": 23070,
      "text": "乾隆的多宝阁藏了一百零八件小玩意儿。",
      "token_start": 73,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 23830,
      "end_ms": 27090,
      "text": "慈禧的指甲套掉一个赏一百两银子，",
      "token_start": 90,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 27970,
      "end_ms": 30000,
      "text": "可这五件还不是最特别的。",
      "token_start": 105,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 30480,
      "end_ms": 34805,
      "text": "接下来第五道第一名更能看出皇帝的真性情。",
      "token_start": 116,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 36980,
      "end_ms": 38080,
      "text": "有一件东西，",
      "token_start": 135,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 38240,
      "end_ms": 40300,
      "text": "康熙一支笔用了几十年，",
      "token_start": 140,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 40660,
      "end_ms": 42380,
      "text": "笔杆都磨出包浆了，",
      "token_start": 150,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 42660,
      "end_ms": 46700,
      "text": "有一件皇帝每天睡觉前都要闻一闻，",
      "token_start": 158,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 46840,
      "end_ms": 47600,
      "text": "才能入睡。",
      "token_start": 173,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 48000,
      "end_ms": 49800,
      "text": "有一件乾隆，",
      "token_start": 177,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 49900,
      "end_ms": 52900,
      "text": "每天吃饭前都要看一眼才动筷子。",
      "token_start": 182,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 53380,
      "end_ms": 59615,
      "text": "有一件皇帝每天带在身上丢了就睡不着觉。",
      "token_start": 196,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 60280,
      "end_ms": 64085,
      "text": "还有一件皇帝临死前抱着不撒手，",
      "token_start": 214,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 64480,
      "end_ms": 65435,
      "text": "带进了棺材。",
      "token_start": 228,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 66530,
      "end_ms": 67225,
      "text": "第五名，",
      "token_start": 233,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 68260,
      "end_ms": 69335,
      "text": "康熙的御笔，",
      "token_start": 236,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 70540,
      "end_ms": 73965,
      "text": "这是一支毛笔普普通通的狼嚎笔，",
      "token_start": 241,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 74370,
      "end_ms": 75785,
      "text": "笔杆是竹子做的，",
      "token_start": 255,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 76070,
      "end_ms": 77455,
      "text": "没有相金相银，",
      "token_start": 262,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 77780,
      "end_ms": 78700,
      "text": "也没有刻字。",
      "token_start": 268,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 78880,
      "end_ms": 82495,
      "text": "康熙用这支笔批奏折写字，",
      "token_start": 273,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 83360,
      "end_ms": 85405,
      "text": "画画一用就是几十年，",
      "token_start": 284,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 86210,
      "end_ms": 89285,
      "text": "您知道用了几十年的毛笔是什么样吗？",
      "token_start": 293,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 90120,
      "end_ms": 92265,
      "text": "笔杆被守汉浸透了，",
      "token_start": 309,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 92660,
      "end_ms": 94255,
      "text": "颜色变深了，",
      "token_start": 317,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 94660,
      "end_ms": 96585,
      "text": "表面磨的光滑发亮，",
      "token_start": 322,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 97080,
      "end_ms": 98445,
      "text": "像涂了一层油，",
      "token_start": 330,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 98850,
      "end_ms": 99665,
      "text": "这叫褒浆，",
      "token_start": 336,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 100790,
      "end_ms": 102245,
      "text": "比豪模短了，",
      "token_start": 340,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 102810,
      "end_ms": 104345,
      "text": "康熙也舍不得换，",
      "token_start": 345,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 105040,
      "end_ms": 105805,
      "text": "还接着用。",
      "token_start": 352,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 106800,
      "end_ms": 112235,
      "text": "传说康熙晚年有一次比吊地上笔杆裂了一道缝，",
      "token_start": 356,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 112940,
      "end_ms": 114345,
      "text": "康熙心疼的不行，",
      "token_start": 376,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 114910,
      "end_ms": 116635,
      "text": "让人拿金丝缠上，",
      "token_start": 383,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 117320,
      "end_ms": 120075,
      "text": "接着用大臣劝他换支新笔。",
      "token_start": 390,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 121160,
      "end_ms": 121820,
      "text": "康熙说，",
      "token_start": 401,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 121920,
      "end_ms": 123735,
      "text": "这支笔跟了我几十年，",
      "token_start": 404,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 124230,
      "end_ms": 126445,
      "text": "比有些大臣跟我的时间还长，",
      "token_start": 413,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 126990,
      "end_ms": 129700,
      "text": "怎么能说换就换一支毛笔，",
      "token_start": 425,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 130020,
      "end_ms": 132120,
      "text": "用到笔杆裂了还舍不得扔。",
      "token_start": 436,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 132380,
      "end_ms": 134645,
      "text": "您说这是节俭还是念旧？",
      "token_start": 447,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 135050,
      "end_ms": 136975,
      "text": "第四名皇帝的香囊？",
      "token_start": 457,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 137850,
      "end_ms": 138975,
      "text": "这是一个小袋子，",
      "token_start": 465,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 139240,
      "end_ms": 142565,
      "text": "巴掌大丝绸做的里头装着香料，",
      "token_start": 472,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 143160,
      "end_ms": 146105,
      "text": "皇帝每天睡觉前都要闻一闻才能入睡。",
      "token_start": 485,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 146880,
      "end_ms": 149135,
      "text": "您知道皇帝为什么要闻香吗？",
      "token_start": 501,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 149680,
      "end_ms": 150655,
      "text": "不是为了相，",
      "token_start": 513,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 151550,
      "end_ms": 152665,
      "text": "是为了安神。",
      "token_start": 518,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 153820,
      "end_ms": 155095,
      "text": "古代皇帝压力大，",
      "token_start": 523,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 155590,
      "end_ms": 156770,
      "text": "每天处理朝政，",
      "token_start": 530,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 156830,
      "end_ms": 158010,
      "text": "担心有人造反，",
      "token_start": 536,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 158090,
      "end_ms": 159485,
      "text": "担心天灾人祸，",
      "token_start": 542,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 159940,
      "end_ms": 161095,
      "text": "晚上睡不着觉，",
      "token_start": 548,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 161890,
      "end_ms": 163945,
      "text": "太医就配了安神香，",
      "token_start": 554,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 164650,
      "end_ms": 170815,
      "text": "用檀香、沉香、艾草、薰衣草混在一起，",
      "token_start": 562,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 171660,
      "end_ms": 172975,
      "text": "装在香囊里，",
      "token_start": 576,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 174530,
      "end_ms": 175755,
      "text": "睡前闻一闻，",
      "token_start": 581,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 176260,
      "end_ms": 177575,
      "text": "能静下心来。",
      "token_start": 586,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 178000,
      "end_ms": 182990,
      "text": "乾隆有个香囊里头装的是他母亲生前用过的香料。",
      "token_start": 591,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 183770,
      "end_ms": 185730,
      "text": "乾隆每天睡前闻一闻，",
      "token_start": 612,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 186390,
      "end_ms": 186630,
      "text": "说，",
      "token_start": 621,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 186710,
      "end_ms": 187829,
      "text": "闻着这个味儿，",
      "token_start": 622,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 187890,
      "end_ms": 190050,
      "text": "就像母亲还在身边一样。",
      "token_start": 628,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 190410,
      "end_ms": 192150,
      "text": "传说乾隆去世前，",
      "token_start": 638,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 192910,
      "end_ms": 194790,
      "text": "把这个香囊传给了嘉庆，",
      "token_start": 645,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 195650,
      "end_ms": 196950,
      "text": "嘉庆打开一闻，",
      "token_start": 655,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 197370,
      "end_ms": 199390,
      "text": "把这个香味早就散了。",
      "token_start": 661,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 199390,
      "end_ms": 201930,
      "text": "可他还是每天带着一个香囊，",
      "token_start": 670,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 202210,
      "end_ms": 203430,
      "text": "装的不是香料，",
      "token_start": 682,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 203610,
      "end_ms": 204450,
      "text": "是思念。",
      "token_start": 688,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 204830,
      "end_ms": 206630,
      "text": "您说这是器物还是情感？",
      "token_start": 691,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 206630,
      "end_ms": 209005,
      "text": "第三名，",
      "token_start": 701,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 209940,
      "end_ms": 211540,
      "text": "乾隆的三喜堂法帖，",
      "token_start": 704,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 212400,
      "end_ms": 214300,
      "text": "这是三件稀世珍宝。",
      "token_start": 712,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 214660,
      "end_ms": 216520,
      "text": "王羲之的快雪诗请帖，",
      "token_start": 720,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 216660,
      "end_ms": 219560,
      "text": "王献之的中秋帖王孔的博元帖。",
      "token_start": 729,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 220000,
      "end_ms": 223580,
      "text": "乾隆把他们收藏在养心殿的一间小屋里，",
      "token_start": 742,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 224040,
      "end_ms": 225660,
      "text": "起名叫三喜堂。",
      "token_start": 759,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 226600,
      "end_ms": 229800,
      "text": "乾隆每天吃饭前都要去三喜堂看一眼，",
      "token_start": 765,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 229880,
      "end_ms": 232620,
      "text": "这三件法帖看完了才去吃饭。",
      "token_start": 781,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 233420,
      "end_ms": 235420,
      "text": "您知道乾隆为什么这么宝贝？",
      "token_start": 793,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 235420,
      "end_ms": 236620,
      "text": "这三件帖子嘛，",
      "token_start": 805,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 236680,
      "end_ms": 238760,
      "text": "因为这是王羲之家族的真迹，",
      "token_start": 811,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 240020,
      "end_ms": 243120,
      "text": "一千多年前的东西流传到现在，",
      "token_start": 823,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 243360,
      "end_ms": 244620,
      "text": "全国就这三件，",
      "token_start": 836,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 245460,
      "end_ms": 248140,
      "text": "乾隆一辈子收藏了几万件文物，",
      "token_start": 842,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 248720,
      "end_ms": 251140,
      "text": "可他最宝贝的就是这三件，",
      "token_start": 855,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 251520,
      "end_ms": 254060,
      "text": "每一件上面都盖满了他的印章，",
      "token_start": 866,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 254300,
      "end_ms": 255440,
      "text": "还亲笔提拔。",
      "token_start": 879,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 256260,
      "end_ms": 258080,
      "text": "传说乾隆有一次生病，",
      "token_start": 884,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 258280,
      "end_ms": 259520,
      "text": "躺在床上起不来。",
      "token_start": 893,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 259900,
      "end_ms": 263040,
      "text": "传说太监把三七堂的帖子抬到床前，",
      "token_start": 900,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 263560,
      "end_ms": 266540,
      "text": "他看着帖子病就好了，",
      "token_start": 915,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 266540,
      "end_ms": 269245,
      "text": "一半三件法帖。",
      "token_start": 924,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 270060,
      "end_ms": 271240,
      "text": "乾隆看了几十年，",
      "token_start": 930,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 272200,
      "end_ms": 274180,
      "text": "您说这是收藏还是信仰？",
      "token_start": 937,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 274280,
      "end_ms": 274960,
      "text": "聊到这儿，",
      "token_start": 947,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 275060,
      "end_ms": 277400,
      "text": "先在评论区打出四个字，",
      "token_start": 951,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 277799,
      "end_ms": 281460,
      "text": "皇家真情打完我接着往下讲。",
      "token_start": 961,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 282560,
      "end_ms": 286520,
      "text": "接下来这两件一件皇帝天天带，",
      "token_start": 973,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 286520,
      "end_ms": 289300,
      "text": "身上丢了睡不着，",
      "token_start": 986,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 290520,
      "end_ms": 295715,
      "text": "还有一件皇帝临死前抱着不撒手第二名。",
      "token_start": 993,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 296410,
      "end_ms": 298290,
      "text": "皇帝的玉扳指，",
      "token_start": 1010,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 299070,
      "end_ms": 304110,
      "text": "这是一个小玉环套在大拇指上打猎，",
      "token_start": 1016,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 304410,
      "end_ms": 304950,
      "text": "射箭，",
      "token_start": 1031,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 305010,
      "end_ms": 308350,
      "text": "用满清皇帝都是骑马打猎出身，",
      "token_start": 1033,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 308710,
      "end_ms": 310630,
      "text": "扳指是他们的贴身之物。",
      "token_start": 1046,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 311470,
      "end_ms": 313290,
      "text": "康熙有一个白玉扳指，",
      "token_start": 1056,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 313910,
      "end_ms": 316850,
      "text": "温润如指戴了一辈子。",
      "token_start": 1065,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 316910,
      "end_ms": 318590,
      "text": "这个扳指不是最贵的，",
      "token_start": 1074,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 319390,
      "end_ms": 321570,
      "text": "康熙的宝库里有更好的玉，",
      "token_start": 1083,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 322490,
      "end_ms": 323970,
      "text": "可他就喜欢这一个，",
      "token_start": 1094,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 324850,
      "end_ms": 327260,
      "text": "因为这是他父亲顺传给给他。",
      "token_start": 1102,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 328160,
      "end_ms": 329560,
      "text": "康熙八岁登基，",
      "token_start": 1114,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 330360,
      "end_ms": 332860,
      "text": "顺治去世前把扳指摘下来，",
      "token_start": 1120,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 332900,
      "end_ms": 334040,
      "text": "套在康熙手上，",
      "token_start": 1131,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 334440,
      "end_ms": 336920,
      "text": "说以后你就是大清的皇帝了，",
      "token_start": 1137,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 337020,
      "end_ms": 341040,
      "text": "这个扳指你带着就当爹还在你身边。",
      "token_start": 1149,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 341520,
      "end_ms": 344280,
      "text": "康熙每天都带着这个扳指上朝，",
      "token_start": 1164,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 344300,
      "end_ms": 345720,
      "text": "带着披奏折，",
      "token_start": 1177,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 345720,
      "end_ms": 353960,
      "text": "带着睡觉都带着传说康熙有一次去打猎扳指掉在草丛里了。",
      "token_start": 1182,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 353960,
      "end_ms": 355760,
      "text": "康熙急得当场就哭了，",
      "token_start": 1207,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 356550,
      "end_ms": 361045,
      "text": "几百个侍卫找了三天才找到一个玉扳指。",
      "token_start": 1216,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 361330,
      "end_ms": 362905,
      "text": "康熙待了六十多年，",
      "token_start": 1233,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 363520,
      "end_ms": 367805,
      "text": "您说这是班指还是父亲第一名？",
      "token_start": 1241,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 368240,
      "end_ms": 370160,
      "text": "乾隆的田皇三连章，",
      "token_start": 1254,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 370300,
      "end_ms": 371485,
      "text": "这是三枚印章。",
      "token_start": 1262,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 371890,
      "end_ms": 374795,
      "text": "田黄时刻的每一枚都有鸡蛋的大小，",
      "token_start": 1268,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 375100,
      "end_ms": 376735,
      "text": "三枚连在一起，",
      "token_start": 1283,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 377300,
      "end_ms": 378840,
      "text": "刻着乾隆御览之宝。",
      "token_start": 1289,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 378860,
      "end_ms": 380240,
      "text": "乾隆鉴赏三夕堂，",
      "token_start": 1297,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 380300,
      "end_ms": 381015,
      "text": "今见喜。",
      "token_start": 1304,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 381360,
      "end_ms": 383805,
      "text": "田黄石是时钟之王，",
      "token_start": 1307,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 384400,
      "end_ms": 385875,
      "text": "比黄金还贵。",
      "token_start": 1315,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 386840,
      "end_ms": 387500,
      "text": "古人说，",
      "token_start": 1320,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 387740,
      "end_ms": 389655,
      "text": "一两田黄三两金，",
      "token_start": 1323,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 390430,
      "end_ms": 392510,
      "text": "乾隆用着三枚印章，",
      "token_start": 1330,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 392590,
      "end_ms": 395170,
      "text": "在他收藏的每一件文物上盖章，",
      "token_start": 1338,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 395210,
      "end_ms": 396245,
      "text": "盖了几十年，",
      "token_start": 1351,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 396580,
      "end_ms": 397975,
      "text": "盖了几万个章。",
      "token_start": 1356,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 398950,
      "end_ms": 400830,
      "text": "您知道乾隆有多宝贝？",
      "token_start": 1362,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 400830,
      "end_ms": 401915,
      "text": "这三枚章吗？",
      "token_start": 1371,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 402720,
      "end_ms": 403520,
      "text": "他走到哪儿，",
      "token_start": 1376,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 403520,
      "end_ms": 404245,
      "text": "带到哪儿，",
      "token_start": 1381,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 404690,
      "end_ms": 406675,
      "text": "每天都要拿出来摸一摸。",
      "token_start": 1385,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 407910,
      "end_ms": 409525,
      "text": "传说乾隆去世前，",
      "token_start": 1395,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 410090,
      "end_ms": 411210,
      "text": "躺在病床上，",
      "token_start": 1402,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 411330,
      "end_ms": 413085,
      "text": "手里还握着这三枚章，",
      "token_start": 1407,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 413940,
      "end_ms": 414925,
      "text": "太监想拿走。",
      "token_start": 1416,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 415840,
      "end_ms": 416555,
      "text": "乾隆说，",
      "token_start": 1421,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 417420,
      "end_ms": 417905,
      "text": "别动，",
      "token_start": 1424,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 418840,
      "end_ms": 419775,
      "text": "让我再摸摸。",
      "token_start": 1426,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 420650,
      "end_ms": 421935,
      "text": "乾隆死的时候，",
      "token_start": 1431,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 422830,
      "end_ms": 424655,
      "text": "这三枚章就握在手里。",
      "token_start": 1437,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 425710,
      "end_ms": 428245,
      "text": "后来嘉庆从他手里掰出来，",
      "token_start": 1446,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 428810,
      "end_ms": 430985,
      "text": "才放进了库房三枚印章，",
      "token_start": 1457,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 431830,
      "end_ms": 433705,
      "text": "乾隆带进了棺材边缘。",
      "token_start": 1467,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 434500,
      "end_ms": 437300,
      "text": "您说这是印章还是一生的执念？",
      "token_start": 1476,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 437440,
      "end_ms": 438895,
      "text": "从第五到第一名，",
      "token_start": 1489,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 439220,
      "end_ms": 440875,
      "text": "这五件东西更特别。",
      "token_start": 1496,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 441730,
      "end_ms": 444335,
      "text": "康熙的御笔用了几十年，",
      "token_start": 1504,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 445090,
      "end_ms": 446050,
      "text": "笔杆裂了，",
      "token_start": 1514,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 446050,
      "end_ms": 448910,
      "text": "还舍不得扔皇帝的香囊。",
      "token_start": 1518,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 449210,
      "end_ms": 450335,
      "text": "睡前闻一闻，",
      "token_start": 1528,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 450860,
      "end_ms": 451780,
      "text": "闻的不是香，",
      "token_start": 1533,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 451860,
      "end_ms": 454855,
      "text": "是思念乾隆的三七堂法帖，",
      "token_start": 1538,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 455230,
      "end_ms": 457085,
      "text": "每天吃饭前都要看一眼。",
      "token_start": 1549,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 457330,
      "end_ms": 458365,
      "text": "看了几十年，",
      "token_start": 1559,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 458820,
      "end_ms": 461685,
      "text": "康熙的玉扳指是父亲传的，",
      "token_start": 1564,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 461950,
      "end_ms": 462270,
      "text": "丢了，",
      "token_start": 1575,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 462270,
      "end_ms": 463105,
      "text": "当场就哭。",
      "token_start": 1577,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 463590,
      "end_ms": 467905,
      "text": "乾隆的田黄三连章临死前握在手里不撒手，",
      "token_start": 1581,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 468710,
      "end_ms": 470335,
      "text": "十件东西讲完了，",
      "token_start": 1599,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 470900,
      "end_ms": 471885,
      "text": "您发现没有？",
      "token_start": 1606,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 472580,
      "end_ms": 474700,
      "text": "皇帝每天用的不是金碗，",
      "token_start": 1611,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 474720,
      "end_ms": 475460,
      "text": "不是龙椅，",
      "token_start": 1621,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 475520,
      "end_ms": 476635,
      "text": "是这些小物件，",
      "token_start": 1625,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 477760,
      "end_ms": 481985,
      "text": "一只小酒杯、一支毛笔、一个香囊，",
      "token_start": 1631,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 482420,
      "end_ms": 485085,
      "text": "一个扳指、三枚印章。",
      "token_start": 1644,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 485880,
      "end_ms": 487375,
      "text": "这些东西不是最贵的，",
      "token_start": 1652,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 488370,
      "end_ms": 489935,
      "text": "可皇帝最离不开。",
      "token_start": 1661,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 493430,
      "end_ms": 495115,
      "text": "因为这些东西上面有感情。",
      "token_start": 1668,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 495730,
      "end_ms": 497270,
      "text": "成化摔碎纪刚杯，",
      "token_start": 1679,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 497270,
      "end_ms": 498165,
      "text": "心疼的重烧，",
      "token_start": 1686,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 498930,
      "end_ms": 500470,
      "text": "康熙的笔用到裂了，",
      "token_start": 1691,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 500470,
      "end_ms": 501315,
      "text": "还舍不得扔。",
      "token_start": 1699,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 502320,
      "end_ms": 505155,
      "text": "乾隆的香囊装的是母亲的味道，",
      "token_start": 1704,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 505790,
      "end_ms": 508055,
      "text": "康熙的扳指是父亲传的，",
      "token_start": 1717,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 508790,
      "end_ms": 511975,
      "text": "乾隆的印章临死前还握在手里，",
      "token_start": 1727,
      "token_end_exclusive": 1740
    },
    {
      "start_ms": 512810,
      "end_ms": 514005,
      "text": "皇帝也是人，",
      "token_start": 1740,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 514360,
      "end_ms": 515700,
      "text": "也有七情六欲，",
      "token_start": 1745,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 516120,
      "end_ms": 517060,
      "text": "也会念旧，",
      "token_start": 1751,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 517200,
      "end_ms": 518175,
      "text": "也会思念，",
      "token_start": 1755,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 518510,
      "end_ms": 520090,
      "text": "也会心疼一件东西。",
      "token_start": 1759,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 520860,
      "end_ms": 522800,
      "text": "老祖宗留给咱们的，",
      "token_start": 1767,
      "token_end_exclusive": 1775
    },
    {
      "start_ms": 522800,
      "end_ms": 523980,
      "text": "不只是这些器物，",
      "token_start": 1775,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 524260,
      "end_ms": 527470,
      "text": "是告诉咱们真正珍贵的东西，",
      "token_start": 1782,
      "token_end_exclusive": 1794
    },
    {
      "start_ms": 527470,
      "end_ms": 529025,
      "text": "不是用钱能买到，",
      "token_start": 1794,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 529580,
      "end_ms": 531095,
      "text": "是那些承载的感情，",
      "token_start": 1801,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 531570,
      "end_ms": 533170,
      "text": "陪伴了岁月的东西。",
      "token_start": 1809,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 534070,
      "end_ms": 536425,
      "text": "您手里有没有这样一件东西？",
      "token_start": 1817,
      "token_end_exclusive": 1829
    },
    {
      "start_ms": 536770,
