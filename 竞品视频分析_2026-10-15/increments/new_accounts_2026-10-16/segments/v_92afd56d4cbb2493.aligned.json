{
  "video_id": "v_92afd56d4cbb2493",
  "duration_s": 751.862993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_92afd56d4cbb2493.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_92afd56d4cbb2493.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 1710,
      "text": "上一集咱们聊了诛文，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 1750,
      "end_ms": 9190,
      "text": "陶钵玉朱龙跪坐、玉人器型、博画、云纹铜镜从第十数到第六，",
      "token_start": 9,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 9490,
      "end_ms": 11110,
      "text": "每一件都够诡异了，",
      "token_start": 33,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 12190,
      "end_ms": 14470,
      "text": "可跟接下来的前五名笔，",
      "token_start": 41,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 14910,
      "end_ms": 17170,
      "text": "那些真的只是开胃菜。",
      "token_start": 51,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 18030,
      "end_ms": 19550,
      "text": "这集直接解绑，",
      "token_start": 60,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 20030,
      "end_ms": 22070,
      "text": "尤其是排在第一的那件。",
      "token_start": 66,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 22070,
      "end_ms": 22570,
      "text": "看一眼，",
      "token_start": 76,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 22570,
      "end_ms": 23230,
      "text": "您就会说，",
      "token_start": 79,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 23230,
      "end_ms": 24990,
      "text": "这不可能是古代的东西，",
      "token_start": 83,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 25710,
      "end_ms": 28170,
      "text": "他跟你家喝水的玻璃杯一模一样，",
      "token_start": 93,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 28430,
      "end_ms": 30000,
      "text": "可他是排千多年前的，",
      "token_start": 107,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 31660,
      "end_ms": 35560,
      "text": "咱们从第五名开始往上数第五名。",
      "token_start": 116,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 35660,
      "end_ms": 44060,
      "text": "曾侯乙鉴骨底座湖北随州一九七八年曾侯乙墓出土了一万五千多件东西。",
      "token_start": 130,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 44240,
      "end_ms": 45600,
      "text": "编钟最出名，",
      "token_start": 161,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 46100,
      "end_ms": 49080,
      "text": "可有一件东西被编钟的光芒盖住，",
      "token_start": 166,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 49720,
      "end_ms": 55840,
      "text": "很多人不知道剑骨底座用来架骨的底盘，",
      "token_start": 180,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 56780,
      "end_ms": 60010,
      "text": "青铜铸的一百九十二公斤，",
      "token_start": 197,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 60030,
      "end_ms": 62365,
      "text": "亲将近四百斤。",
      "token_start": 208,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 63520,
      "end_ms": 64735,
      "text": "这东西长什么样？",
      "token_start": 214,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 66550,
      "end_ms": 70400,
      "text": "八队大龙十六条龙身体互相缠绕，",
      "token_start": 221,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 70720,
      "end_ms": 72145,
      "text": "穿插盘旋，",
      "token_start": 235,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 72600,
      "end_ms": 73320,
      "text": "你中有我，",
      "token_start": 239,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 73320,
      "end_ms": 74085,
      "text": "我中有你，",
      "token_start": 243,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 74380,
      "end_ms": 75885,
      "text": "密密麻麻纠缠在一起。",
      "token_start": 247,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 76260,
      "end_ms": 78320,
      "text": "每条龙的身体还是镂空的龙，",
      "token_start": 256,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 78320,
      "end_ms": 80745,
      "text": "身上还爬着无数条小蛇，",
      "token_start": 268,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 81650,
      "end_ms": 85354,
      "text": "整件东西就是一团铜铸的龙舌纠缠体。",
      "token_start": 278,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 86170,
      "end_ms": 88805,
      "text": "可每一条龙的走向都清清楚楚，",
      "token_start": 294,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 89280,
      "end_ms": 90455,
      "text": "没有一条断掉，",
      "token_start": 307,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 90870,
      "end_ms": 92165,
      "text": "没有一条并措。",
      "token_start": 313,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 92810,
      "end_ms": 99030,
      "text": "一百九十二公斤十六条龙加上数不清的小蛇缠在一起，",
      "token_start": 319,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 99050,
      "end_ms": 100365,
      "text": "还能条条分明，",
      "token_start": 342,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 101230,
      "end_ms": 104835,
      "text": "这怎么住的吵到现在没有定论。",
      "token_start": 348,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 105700,
      "end_ms": 107235,
      "text": "有人说是施蜡法，",
      "token_start": 361,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 107660,
      "end_ms": 109645,
      "text": "有人说是分住在汉街的，",
      "token_start": 368,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 110160,
      "end_ms": 111760,
      "text": "双方各有证据，",
      "token_start": 378,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 112100,
      "end_ms": 113455,
      "text": "谁也说服不了谁。",
      "token_start": 384,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 114320,
      "end_ms": 116355,
      "text": "两千四百多年前的一个古作，",
      "token_start": 391,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 116880,
      "end_ms": 119920,
      "text": "把当代最顶尖的青铜研究专家难住，",
      "token_start": 403,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 119980,
      "end_ms": 122485,
      "text": "光是他怎么做出来的这一个问题，",
      "token_start": 418,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 122880,
      "end_ms": 124535,
      "text": "就发了上百篇论文，",
      "token_start": 432,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 125500,
      "end_ms": 128105,
      "text": "还没炒完一个架骨的底盘，",
      "token_start": 440,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 128930,
      "end_ms": 132770,
      "text": "一百九十二公斤十六条龙缠在一起，",
      "token_start": 451,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 132770,
      "end_ms": 133745,
      "text": "条条分明，",
      "token_start": 466,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 134280,
      "end_ms": 136105,
      "text": "做法炒了几十年没定论，",
      "token_start": 470,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 136590,
      "end_ms": 137915,
      "text": "您说这诡异不诡异？",
      "token_start": 480,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 138440,
      "end_ms": 149910,
      "text": "第四名秦朝同车马陕西西安、一九八零年秦始皇陵旁边出土了两辆青铜马车编号一号车和二号车。",
      "token_start": 488,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 150250,
      "end_ms": 151715,
      "text": "二号车最震撼。",
      "token_start": 529,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 152200,
      "end_ms": 156110,
      "text": "通常三点一七米是真车的一半大小。",
      "token_start": 535,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 156190,
      "end_ms": 158375,
      "text": "四匹马拉着一辆带棚的车，",
      "token_start": 550,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 159050,
      "end_ms": 160410,
      "text": "车上坐着一个铜人，",
      "token_start": 561,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 160410,
      "end_ms": 163595,
      "text": "御手这辆车一共三千多个零件，",
      "token_start": 569,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 164350,
      "end_ms": 166115,
      "text": "每一个零件都能拆下来。",
      "token_start": 582,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 166420,
      "end_ms": 167860,
      "text": "车轮能转车门，",
      "token_start": 592,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 167860,
      "end_ms": 170235,
      "text": "能开车窗能推嗯，",
      "token_start": 598,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 170570,
      "end_ms": 171190,
      "text": "窗户上，",
      "token_start": 605,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 171190,
      "end_ms": 173170,
      "text": "还有镂空的菱形花纹。",
      "token_start": 608,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 173170,
      "end_ms": 174650,
      "text": "当纱窗透气，",
      "token_start": 617,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 174770,
      "end_ms": 179540,
      "text": "用马身上的配膀是金银铸的缰绳，",
      "token_start": 622,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 179600,
      "end_ms": 182295,
      "text": "是一节一节的铜环串起来的，",
      "token_start": 636,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 182670,
      "end_ms": 184095,
      "text": "每一节都能活动。",
      "token_start": 648,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 184590,
      "end_ms": 187675,
      "text": "车盖是一整块青铜版，",
      "token_start": 655,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 188470,
      "end_ms": 190765,
      "text": "面积二点三平方米，",
      "token_start": 664,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 191620,
      "end_ms": 194035,
      "text": "最薄的地方只有一毫米，",
      "token_start": 672,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 194820,
      "end_ms": 195820,
      "text": "可弧度均匀，",
      "token_start": 682,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 195900,
      "end_ms": 197065,
      "text": "没有一道裂纹。",
      "token_start": 687,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 198110,
      "end_ms": 199570,
      "text": "两千两百多年前，",
      "token_start": 693,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 199570,
      "end_ms": 200635,
      "text": "没有冲压机，",
      "token_start": 700,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 201410,
      "end_ms": 202750,
      "text": "这么大一块铜板，",
      "token_start": 705,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 202830,
      "end_ms": 204655,
      "text": "怎么垂出这个弧度的，",
      "token_start": 712,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 205300,
      "end_ms": 206395,
      "text": "没人说得清。",
      "token_start": 721,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 207320,
      "end_ms": 208540,
      "text": "更诡异的是，",
      "token_start": 726,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 208580,
      "end_ms": 209265,
      "text": "细节，",
      "token_start": 731,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 210150,
      "end_ms": 213505,
      "text": "您看马嘴里的咸口舌头是能动的。",
      "token_start": 733,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 214260,
      "end_ms": 215420,
      "text": "马脖子上的鬃毛，",
      "token_start": 747,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 215460,
      "end_ms": 217315,
      "text": "一根一根排列整齐，",
      "token_start": 754,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 218150,
      "end_ms": 220615,
      "text": "铜人玉手的指甲盖都刻出来，",
      "token_start": 762,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 221420,
      "end_ms": 223905,
      "text": "手指关节的褶皱都能看见。",
      "token_start": 774,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 225000,
      "end_ms": 226485,
      "text": "两千两百多年前，",
      "token_start": 785,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 226920,
      "end_ms": 230585,
      "text": "秦朝工匠造了一辆等比缩小的模型车，",
      "token_start": 792,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 231190,
      "end_ms": 232510,
      "text": "三千多个零件，",
      "token_start": 808,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 232590,
      "end_ms": 235910,
      "text": "能拆能装精细到指甲盖上的纹路，",
      "token_start": 814,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 235930,
      "end_ms": 236965,
      "text": "这不是工艺品。",
      "token_start": 828,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 237600,
      "end_ms": 241315,
      "text": "这是一辆两千两百年前的工业样机，",
      "token_start": 834,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 242160,
      "end_ms": 245495,
      "text": "一辆青铜车三千多个零件，",
      "token_start": 849,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 246240,
      "end_ms": 247480,
      "text": "车窗能推马嘴，",
      "token_start": 860,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 247480,
      "end_ms": 248025,
      "text": "能动，",
      "token_start": 866,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 248850,
      "end_ms": 250055,
      "text": "指甲盖儿都刻出来。",
      "token_start": 868,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 250520,
      "end_ms": 254244,
      "text": "两千两百年前的人到底在认真到什么程度？",
      "token_start": 876,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 255190,
      "end_ms": 255855,
      "text": "第三名，",
      "token_start": 894,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 256860,
      "end_ms": 263735,
      "text": "蛋壳黑桃杯山东日照这件东西的年代比前面所有文物都老，",
      "token_start": 897,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 264840,
      "end_ms": 270475,
      "text": "距今四千多年新石器时代龙山文化一只高脚杯，",
      "token_start": 922,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 271170,
      "end_ms": 272305,
      "text": "通体漆黑，",
      "token_start": 942,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 272990,
      "end_ms": 275410,
      "text": "表面光滑的向上了釉，",
      "token_start": 946,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 276270,
      "end_ms": 277310,
      "text": "可它没有上釉，",
      "token_start": 955,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 277390,
      "end_ms": 279385,
      "text": "那层光泽是烧出来的，",
      "token_start": 961,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 280210,
      "end_ms": 281505,
      "text": "他诡异在哪儿？",
      "token_start": 970,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 282790,
      "end_ms": 286554,
      "text": "薄杯壁最薄的地方只有零点二毫米，",
      "token_start": 976,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 287090,
      "end_ms": 288370,
      "text": "您拿一张a货纸，",
      "token_start": 991,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 288370,
      "end_ms": 292965,
      "text": "比a four纸的厚度大概是零点一毫米。",
      "token_start": 998,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 293420,
      "end_ms": 296255,
      "text": "这只杯子只比两张纸厚一点。",
      "token_start": 1013,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 297110,
      "end_ms": 299210,
      "text": "整只杯子拿在手里，",
      "token_start": 1025,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 299230,
      "end_ms": 300410,
      "text": "几乎没有重量，",
      "token_start": 1033,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 301190,
      "end_ms": 304070,
      "text": "轻轻一弹嗡的一声，",
      "token_start": 1039,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 304790,
      "end_ms": 306390,
      "text": "跟金属似的能响。",
      "token_start": 1047,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 307870,
      "end_ms": 309810,
      "text": "四千多年前没有拉皮机，",
      "token_start": 1054,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 310210,
      "end_ms": 311070,
      "text": "没有电窑，",
      "token_start": 1064,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 311350,
      "end_ms": 313690,
      "text": "陶土是手工一点一点捏的，",
      "token_start": 1068,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 314010,
      "end_ms": 316430,
      "text": "烧窑是柴火烧的温度，",
      "token_start": 1079,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 316430,
      "end_ms": 317890,
      "text": "全凭经验控制。",
      "token_start": 1088,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 317950,
      "end_ms": 319210,
      "text": "在这种条件下，",
      "token_start": 1094,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 319590,
      "end_ms": 323030,
      "text": "把一只杯子的壁做到零点二毫米，",
      "token_start": 1100,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 323790,
      "end_ms": 325310,
      "text": "烧的时候还不能塌，",
      "token_start": 1114,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 326050,
      "end_ms": 326715,
      "text": "不能裂，",
      "token_start": 1122,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 327440,
      "end_ms": 328380,
      "text": "不能变形。",
      "token_start": 1125,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 329380,
      "end_ms": 330880,
      "text": "您想想这有多难。",
      "token_start": 1129,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 331840,
      "end_ms": 340220,
      "text": "后来有人试过用现代设备复制专业的陶艺师用现代拉坯机烧了很多次，",
      "token_start": 1136,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 340860,
      "end_ms": 345440,
      "text": "能做到零点五毫米就已经是极限了零点二毫米，",
      "token_start": 1166,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 345440,
      "end_ms": 348940,
      "text": "做不到四千年前的人用手搓出来的东西，",
      "token_start": 1186,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 349500,
      "end_ms": 351040,
      "text": "现代机器复制不了，",
      "token_start": 1203,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 352000,
      "end_ms": 353260,
      "text": "这句话听着离谱，",
      "token_start": 1211,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 354060,
      "end_ms": 355835,
      "text": "可事实就是这样。",
      "token_start": 1218,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 356540,
      "end_ms": 357600,
      "text": "更诡异的是，",
      "token_start": 1225,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 357720,
      "end_ms": 363845,
      "text": "这种极薄的黑陶杯在龙山文化里不是一件两件好几个遗址都出过，",
      "token_start": 1230,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 364130,
      "end_ms": 367715,
      "text": "说明这不是某一个天才工匠的偶然杰作，",
      "token_start": 1258,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 368150,
      "end_ms": 370375,
      "text": "而是当时的一种成熟工艺。",
      "token_start": 1275,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 370930,
      "end_ms": 372895,
      "text": "后来这种工艺彻底失传了，",
      "token_start": 1286,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 373190,
      "end_ms": 377115,
      "text": "再也没出现过一只四千年前的杯子。",
      "token_start": 1297,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 377550,
      "end_ms": 379635,
      "text": "壁薄零点二毫米，",
      "token_start": 1312,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 380370,
      "end_ms": 384700,
      "text": "现代机器复制不了公艺失传了。",
      "token_start": 1319,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 384700,
      "end_ms": 385325,
      "text": "四千年，",
      "token_start": 1332,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 385760,
      "end_ms": 387180,
      "text": "您说这叫诡异，",
      "token_start": 1335,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 387420,
      "end_ms": 389080,
      "text": "还是叫恐怖？",
      "token_start": 1341,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 390190,
      "end_ms": 390765,
      "text": "第二名，",
      "token_start": 1346,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 392440,
      "end_ms": 393785,
      "text": "青铜卡尺，",
      "token_start": 1349,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 395180,
      "end_ms": 396105,
      "text": "江苏淳江。",
      "token_start": 1353,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 397940,
      "end_ms": 399000,
      "text": "一九九二年，",
      "token_start": 1357,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 399120,
      "end_ms": 402565,
      "text": "江苏沁江一座汉墓出土了一件小铜器，",
      "token_start": 1362,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 403230,
      "end_ms": 405590,
      "text": "考古人员第一眼看见他的时候，",
      "token_start": 1378,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 405590,
      "end_ms": 406545,
      "text": "以为搞错了。",
      "token_start": 1391,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 407420,
      "end_ms": 411125,
      "text": "这东西长十三点三厘米一根固定尺，",
      "token_start": 1396,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 411670,
      "end_ms": 412825,
      "text": "一根活动尺，",
      "token_start": 1411,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 413060,
      "end_ms": 416900,
      "text": "活动尺可以左右滑动尺上有刻度合起来，",
      "token_start": 1416,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 416900,
      "end_ms": 417640,
      "text": "能量外径，",
      "token_start": 1433,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 417800,
      "end_ms": 418580,
      "text": "张开能量，",
      "token_start": 1437,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 418580,
      "end_ms": 420135,
      "text": "内径还能量深度，",
      "token_start": 1441,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 420470,
      "end_ms": 421495,
      "text": "您听着耳熟吧。",
      "token_start": 1448,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 422510,
      "end_ms": 423995,
      "text": "这就是游标卡尺，",
      "token_start": 1454,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 424390,
      "end_ms": 426675,
      "text": "您去五金店花十几块钱买一把，",
      "token_start": 1461,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 427000,
      "end_ms": 429145,
      "text": "跟它的结构几乎一模一样，",
      "token_start": 1474,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 430080,
      "end_ms": 432095,
      "text": "可这件东西是稀罕的。",
      "token_start": 1485,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 433310,
      "end_ms": 436885,
      "text": "距今两千多年同样原理的测量工具，",
      "token_start": 1494,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 437580,
      "end_ms": 440185,
      "text": "欧洲人到了十七世纪才发明出来。",
      "token_start": 1509,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 440890,
      "end_ms": 445500,
      "text": "法国人约尼埃在一千六百三十一年造出了第一把游镖。",
      "token_start": 1523,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 445500,
      "end_ms": 449825,
      "text": "卡尺比这件铜卡尺晚了将近一千八百年，",
      "token_start": 1546,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 450340,
      "end_ms": 453615,
      "text": "两千多年前的汉朝人拿这把尺子量什么，",
      "token_start": 1563,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 454390,
      "end_ms": 454975,
      "text": "不知道，",
      "token_start": 1580,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 456020,
      "end_ms": 457965,
      "text": "墓里没有留下任何说明，",
      "token_start": 1583,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 458850,
      "end_ms": 465695,
      "text": "可光看这把尺子的结构固定尺游标尺、滑动机构刻度线，",
      "token_start": 1593,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 466640,
      "end_ms": 469335,
      "text": "每一个要素跟现代的都能对上。",
      "token_start": 1616,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 470190,
      "end_ms": 474100,
      "text": "这是目前世界上已知最早的卡尺型测量工具，",
      "token_start": 1629,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 474180,
      "end_ms": 476430,
      "text": "没有之一一把。",
      "token_start": 1648,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 476510,
      "end_ms": 483305,
      "text": "二零零零年前的铜尺子跟现代游标卡尺结构一模一样，",
      "token_start": 1654,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 484180,
      "end_ms": 486595,
      "text": "比欧洲早了一千八百年。",
      "token_start": 1677,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 487880,
      "end_ms": 489535,
      "text": "您说这要怎么解释？",
      "token_start": 1687,
      "token_end_exclusive": 1695
    },
    {
      "start_ms": 490470,
      "end_ms": 492230,
      "text": "先在评论区打出四个字，",
      "token_start": 1695,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 492430,
      "end_ms": 493315,
      "text": "细思极恐。",
      "token_start": 1705,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 493780,
      "end_ms": 496055,
      "text": "打完了看看第一名到底是什么？",
      "token_start": 1709,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 496910,
      "end_ms": 497575,
      "text": "第一名，",
      "token_start": 1722,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 498590,
      "end_ms": 499945,
      "text": "战国水晶杯，",
      "token_start": 1725,
      "token_end_exclusive": 1730
    },
    {
      "start_ms": 500930,
      "end_ms": 507730,
      "text": "浙江杭州一九九零年杭州半山镇一座战国墓葬。",
      "token_start": 1730,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 507750,
      "end_ms": 511665,
      "text": "发掘考古人员打开棺椁，",
      "token_start": 1750,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 512090,
      "end_ms": 515145,
      "text": "在一堆随葬品中间看见了一个东西，",
      "token_start": 1760,
      "token_end_exclusive": 1775
    },
    {
      "start_ms": 516020,
      "end_ms": 520950,
      "text": "所有人第一反应都是谁把现代的玻璃杯吊进去。",
      "token_start": 1775,
      "token_end_exclusive": 1795
    },
    {
      "start_ms": 521110,
      "end_ms": 522830,
      "text": "这只杯子通体透明，",
      "token_start": 1795,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 523150,
      "end_ms": 524115,
      "text": "微微发黄，",
      "token_start": 1803,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 524510,
      "end_ms": 528735,
      "text": "敞口直筒圆底高十五点四厘米，",
      "token_start": 1807,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 529160,
      "end_ms": 530585,
      "text": "口径七点八厘。",
      "token_start": 1820,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 531380,
      "end_ms": 532660,
      "text": " B面光滑，",
      "token_start": 1826,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 532860,
      "end_ms": 533580,
      "text": "没有花纹，",
      "token_start": 1830,
      "token_end_exclusive": 1834
    },
    {
      "start_ms": 534010,
      "end_ms": 534710,
      "text": "没有装饰，",
      "token_start": 1834,
      "token_end_exclusive": 1838
    },
    {
      "start_ms": 534890,
      "end_ms": 536835,
      "text": "就是一只干干净净的杯子。",
      "token_start": 1838,
      "token_end_exclusive": 1849
    },
    {
      "start_ms": 537470,
      "end_ms": 539430,
      "text": "您把它放在宜家的货架上，",
      "token_start": 1849,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 539490,
      "end_ms": 541905,
      "text": "没有任何人会看出它有什么特别的，",
      "token_start": 1860,
      "token_end_exclusive": 1875
    },
    {
      "start_ms": 542260,
      "end_ms": 544065,
      "text": "就是一只普通的玻璃杯，",
      "token_start": 1875,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 544720,
      "end_ms": 545820,
      "text": "可它不是玻璃，",
      "token_start": 1885,
      "token_end_exclusive": 1891
    },
    {
      "start_ms": 546020,
      "end_ms": 551795,
      "text": "是水晶的整块天然水晶掏出来不是拼的，",
      "token_start": 1891,
      "token_end_exclusive": 1908
    },
    {
      "start_ms": 552020,
      "end_ms": 554060,
      "text": "不是粘的一整块。",
      "token_start": 1908,
      "token_end_exclusive": 1915
    },
    {
      "start_ms": 554080,
      "end_ms": 557420,
      "text": "水晶从外面一点一点掏空，",
      "token_start": 1915,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 557560,
      "end_ms": 559505,
      "text": "掏成了一只杯子的形状，",
      "token_start": 1926,
      "token_end_exclusive": 1936
    },
    {
      "start_ms": 559970,
      "end_ms": 561755,
      "text": "内壁打磨的光滑透亮，",
      "token_start": 1936,
      "token_end_exclusive": 1945
    },
    {
      "start_ms": 562310,
      "end_ms": 564565,
      "text": "看不见一道工具的划痕。",
      "token_start": 1945,
      "token_end_exclusive": 1955
    },
    {
      "start_ms": 565480,
      "end_ms": 568255,
      "text": "水晶的硬度是漆比钢还硬。",
      "token_start": 1955,
      "token_end_exclusive": 1966
    },
    {
      "start_ms": 569190,
      "end_ms": 571715,
      "text": "两千多年前没有金刚石工具，",
      "token_start": 1966,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 572180,
      "end_ms": 573695,
      "text": "没有电动打磨机。",
      "token_start": 1978,
      "token_end_exclusive": 1985
    },
    {
      "start_ms": 574110,
      "end_ms": 575630,
      "text": "战国时期的工匠，",
      "token_start": 1985,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 575650,
      "end_ms": 580815,
      "text": "是用什么东西把一块比钢还硬的石头掏成了一只薄壁杯子，",
      "token_start": 1992,
      "token_end_exclusive": 2017
    },
    {
      "start_ms": 582050,
      "end_ms": 582725,
      "text": "解释不了。",
      "token_start": 2017,
      "token_end_exclusive": 2021
    },
    {
      "start_ms": 583900,
      "end_ms": 584500,
      "text": "有人猜，",
      "token_start": 2021,
      "token_end_exclusive": 2024
    },
    {
      "start_ms": 584500,
      "end_ms": 586565,
      "text": "是用解玉砂一点一点磨的，",
      "token_start": 2024,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 587010,
      "end_ms": 588210,
      "text": "可磨到内壁，",
      "token_start": 2035,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 588210,
      "end_ms": 592655,
      "text": "这么光滑看不见痕迹需要多长时间？",
      "token_start": 2040,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 593070,
      "end_ms": 594230,
      "text": "没人算得出来。",
      "token_start": 2055,
      "token_end_exclusive": 2061
    },
    {
      "start_ms": 594270,
      "end_ms": 596285,
      "text": "更让人说不清的是他的造型。",
      "token_start": 2061,
      "token_end_exclusive": 2073
    },
    {
      "start_ms": 597050,
      "end_ms": 598970,
      "text": "您见过的所有古代器皿，",
      "token_start": 2073,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 599090,
      "end_ms": 601810,
      "text": "多多少少都有那个年代的风格，",
      "token_start": 2083,
      "token_end_exclusive": 2096
    },
    {
      "start_ms": 601850,
      "end_ms": 604960,
      "text": "花纹兽首铭纹图案。",
      "token_start": 2096,
      "token_end_exclusive": 2104
    },
    {
      "start_ms": 605910,
      "end_ms": 607370,
      "text": "可这只杯子什么都没有，",
      "token_start": 2104,
      "token_end_exclusive": 2114
    },
    {
      "start_ms": 607710,
      "end_ms": 608570,
      "text": "素面朝天，",
      "token_start": 2114,
      "token_end_exclusive": 2118
    },
    {
      "start_ms": 609010,
      "end_ms": 610190,
      "text": "简洁到了极点，",
      "token_start": 2118,
      "token_end_exclusive": 2124
    },
    {
      "start_ms": 610550,
      "end_ms": 614430,
      "text": "简洁到跟两千多年后的现代审美完全一致。",
      "token_start": 2124,
      "token_end_exclusive": 2142
    },
    {
      "start_ms": 615310,
      "end_ms": 618870,
      "text": "两千多年前的一个战国人不知道用什么办法，",
      "token_start": 2142,
      "token_end_exclusive": 2161
    },
    {
      "start_ms": 619590,
      "end_ms": 622630,
      "text": "从一块天然水晶里掏出了一只杯子，",
      "token_start": 2161,
      "token_end_exclusive": 2176
    },
    {
      "start_ms": 623190,
      "end_ms": 627050,
      "text": "这只杯子的造型放在今天的商场里毫无尾痕。",
      "token_start": 2176,
      "token_end_exclusive": 2195
    },
    {
      "start_ms": 627110,
      "end_ms": 631250,
      "text": "他现在在杭州博物馆单独一个展柜，",
      "token_start": 2195,
      "token_end_exclusive": 2210
    },
    {
      "start_ms": 632090,
      "end_ms": 634010,
      "text": "常年有保安站在旁边。",
      "token_start": 2210,
      "token_end_exclusive": 2219
    },
    {
      "start_ms": 634870,
      "end_ms": 636140,
      "text": "从零零二年，",
      "token_start": 2219,
      "token_end_exclusive": 2224
    },
    {
      "start_ms": 636740,
      "end_ms": 641280,
      "text": "他被列入首批禁止出国展览文物名单。",
      "token_start": 2224,
      "token_end_exclusive": 2240
    },
    {
      "start_ms": 642840,
      "end_ms": 646060,
      "text": "全中国只有这一件战国水晶杯，",
      "token_start": 2240,
      "token_end_exclusive": 2253
    },
    {
      "start_ms": 646300,
      "end_ms": 647440,
      "text": "为什么排第一？",
      "token_start": 2253,
      "token_end_exclusive": 2259
    },
    {
      "start_ms": 648000,
      "end_ms": 649480,
      "text": "因为前面九件，",
      "token_start": 2259,
      "token_end_exclusive": 2265
    },
    {
      "start_ms": 650180,
      "end_ms": 651400,
      "text": "不管多诡异，",
      "token_start": 2265,
      "token_end_exclusive": 2270
    },
    {
      "start_ms": 652020,
      "end_ms": 654080,
      "text": "您都能说古人手艺好，",
      "token_start": 2270,
      "token_end_exclusive": 2279
    },
    {
      "start_ms": 654120,
      "end_ms": 655820,
      "text": "四个字糊弄过去，",
      "token_start": 2279,
      "token_end_exclusive": 2286
    },
    {
      "start_ms": 656780,
      "end_ms": 657940,
      "text": "可这只杯子不行，",
      "token_start": 2286,
      "token_end_exclusive": 2293
    },
    {
      "start_ms": 658160,
      "end_ms": 660000,
      "text": "它不是手艺好不好的问题。",
      "token_start": 2293,
      "token_end_exclusive": 2304
    },
    {
      "start_ms": 660360,
      "end_ms": 661200,
      "text": "它的造型，",
      "token_start": 2304,
      "token_end_exclusive": 2308
    },
    {
      "start_ms": 661600,
      "end_ms": 662640,
      "text": "它的光洁度，",
      "token_start": 2308,
      "token_end_exclusive": 2313
    },
    {
      "start_ms": 662960,
      "end_ms": 665460,
      "text": "它的审美全方位的，",
      "token_start": 2313,
      "token_end_exclusive": 2321
    },
    {
      "start_ms": 665460,
      "end_ms": 668670,
      "text": "不像一件两千多年前的东西，",
      "token_start": 2321,
      "token_end_exclusive": 2333
    },
    {
      "start_ms": 668670,
      "end_ms": 670055,
      "text": "他站在那个展柜里，",
      "token_start": 2333,
      "token_end_exclusive": 2341
    },
    {
      "start_ms": 670430,
      "end_ms": 672575,
      "text": "像是从未来掉进了过去。",
      "token_start": 2341,
      "token_end_exclusive": 2351
    },
    {
      "start_ms": 673730,
      "end_ms": 675115,
      "text": "实践文物讲完了，",
      "token_start": 2351,
      "token_end_exclusive": 2358
    },
    {
      "start_ms": 675970,
      "end_ms": 677270,
      "text": "七千年前的猪，",
      "token_start": 2358,
      "token_end_exclusive": 2364
    },
    {
      "start_ms": 677450,
      "end_ms": 678725,
      "text": "长得像表情包，",
      "token_start": 2364,
      "token_end_exclusive": 2370
    },
    {
      "start_ms": 679380,
      "end_ms": 681360,
      "text": "五千年前的龙长得像猪，",
      "token_start": 2370,
      "token_end_exclusive": 2380
    },
    {
      "start_ms": 681740,
      "end_ms": 684675,
      "text": "三千年前的发型跟今天一模一样。",
      "token_start": 2380,
      "token_end_exclusive": 2394
    },
    {
      "start_ms": 685240,
      "end_ms": 686500,
      "text": "两千一百年前，",
      "token_start": 2394,
      "token_end_exclusive": 2400
    },
    {
      "start_ms": 686500,
      "end_ms": 690100,
      "text": "一块博画画了三个世界两千五百年前，",
      "token_start": 2400,
      "token_end_exclusive": 2416
    },
    {
      "start_ms": 690120,
      "end_ms": 693145,
      "text": "一张铜桌子镂空到向三d打印。",
      "token_start": 2416,
      "token_end_exclusive": 2429
    },
    {
      "start_ms": 693770,
      "end_ms": 695210,
      "text": "两千四百年前，",
      "token_start": 2429,
      "token_end_exclusive": 2435
    },
    {
      "start_ms": 695210,
      "end_ms": 697530,
      "text": "一个古座十六条龙缠在一起，",
      "token_start": 2435,
      "token_end_exclusive": 2447
    },
    {
      "start_ms": 697550,
      "end_ms": 700160,
      "text": "做法到现在还在炒两千两。",
      "token_start": 2447,
      "token_end_exclusive": 2458
    },
    {
      "start_ms": 700160,
      "end_ms": 700780,
      "text": "百年前，",
      "token_start": 2458,
      "token_end_exclusive": 2461
    },
    {
      "start_ms": 700780,
      "end_ms": 706980,
      "text": "一辆童车三千多个零件能拆能装四千年前一只杯子薄到零点二毫米。",
      "token_start": 2461,
      "token_end_exclusive": 2490
    },
    {
      "start_ms": 706980,
      "end_ms": 708375,
      "text": "现代机器复制不了，",
      "token_start": 2490,
      "token_end_exclusive": 2498
    },
    {
      "start_ms": 708820,
      "end_ms": 710120,
      "text": "二零零零年前，",
      "token_start": 2498,
      "token_end_exclusive": 2504
    },
    {
      "start_ms": 710140,
      "end_ms": 713135,
      "text": "一把尺子比欧洲早了一千八百年，",
      "token_start": 2504,
      "token_end_exclusive": 2518
    },
    {
      "start_ms": 714110,
      "end_ms": 719615,
      "text": "可压在所有人头顶上的是一只从水晶里掏出来的杯子，",
      "token_start": 2518,
      "token_end_exclusive": 2541
    },
    {
      "start_ms": 720270,
      "end_ms": 721350,
      "text": "放在商场里。",
      "token_start": 2541,
      "token_end_exclusive": 2546
    },
    {
      "start_ms": 721350,
      "end_ms": 724095,
      "text": "你分不出它是古代的还是现代的？",
      "token_start": 2546,
      "token_end_exclusive": 2560
    },
    {
      "start_ms": 725010,
      "end_ms": 726070,
      "text": "评论区告诉我，",
      "token_start": 2560,
      "token_end_exclusive": 2566
    },
    {
      "start_ms": 726710,
      "end_ms": 730450,
      "text": "这十件文物哪一件最让您觉得细思极恐，",
      "token_start": 2566,
      "token_end_exclusive": 2583
    },
    {
      "start_ms": 730970,
      "end_ms": 732170,
      "text": "觉得长知识了，",
      "token_start": 2583,
      "token_end_exclusive": 2589
    },
    {
      "start_ms": 732290,
      "end_ms": 732889,
      "text": "点个赞，",
      "token_start": 2589,
      "token_end_exclusive": 2592
    },
    {
      "start_ms": 733230,
      "end_ms": 734090,
      "text": "点个收藏，",
      "token_start": 2592,
      "token_end_exclusive": 2596
    },
    {
      "start_ms": 734990,
      "end_ms": 738770,
      "text": "转给您身边那位最爱刷手机的老伙计，",
      "token_start": 2596,
      "token_end_exclusive": 2612
    },
    {
      "start_ms": 738830,
      "end_ms": 739770,
      "text": "就跟他说一句，",
      "token_start": 2612,
      "token_end_exclusive": 2618
    },
    {
      "start_ms": 740890,
      "end_ms": 742290,
      "text": "别光刷段子了，",
      "token_start": 2618,
      "token_end_exclusive": 2624
    },
    {
      "start_ms": 743010,
      "end_ms": 744510,
      "text": "看看老祖宗干的活，",
      "token_start": 2624,
      "token_end_exclusive": 2632
    },
    {
      "start_ms": 745170,
      "end_ms": 747790,
      "text": "想看更多让人说不清的老物家，",
      "token_start": 2632,
      "token_end_exclusive": 2645
    },
    {
      "start_ms": 748470,
      "end_ms": 749290,
      "text": "点个关注，",
      "token_start": 2645,
      "token_end_exclusive": 2649
    },
    {
      "start_ms": 750030,
      "end_ms": 751775,
      "text": "咱们下回接着聊。",
      "token_start": 2649,
      "token_end_exclusive": 2656
    }
  ],
