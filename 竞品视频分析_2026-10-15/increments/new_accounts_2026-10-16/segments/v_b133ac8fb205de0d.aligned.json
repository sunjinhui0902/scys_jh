{
  "video_id": "v_b133ac8fb205de0d",
  "duration_s": 767.629977,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_b133ac8fb205de0d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_b133ac8fb205de0d.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 2910,
      "text": "上一集咱们盘了中国十大秋水秘境，",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3690,
      "end_ms": 5430,
      "text": "从第十名如情湖，",
      "token_start": 15,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5470,
      "end_ms": 6870,
      "text": "一路讲到第六名，",
      "token_start": 22,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6990,
      "end_ms": 8050,
      "text": "闻献天池。",
      "token_start": 29,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 9130,
      "end_ms": 10690,
      "text": "有朋友在评论区说，",
      "token_start": 33,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 10970,
      "end_ms": 16309,
      "text": "闻县天池那种陇南深山里一池安静的水已经够让人心动了。",
      "token_start": 41,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 16770,
      "end_ms": 17690,
      "text": "可我跟您说，",
      "token_start": 66,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 18230,
      "end_ms": 21350,
      "text": "闻献天池排第六前五名，",
      "token_start": 71,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21390,
      "end_ms": 22590,
      "text": "随便拿一个出来，",
      "token_start": 81,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 22590,
      "end_ms": 24990,
      "text": "都能把它压住榜首，",
      "token_start": 88,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25050,
      "end_ms": 31600,
      "text": "那个地方一年只有十几天的秋色窗口去早了没变色，",
      "token_start": 96,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 32100,
      "end_ms": 32340,
      "text": "去，",
      "token_start": 118,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 32440,
      "end_ms": 33460,
      "text": "晚了全落光。",
      "token_start": 119,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 34340,
      "end_ms": 35540,
      "text": "那十几天里，",
      "token_start": 124,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 35540,
      "end_ms": 37900,
      "text": "湖水的颜色能从蓝变到绿，",
      "token_start": 129,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 37900,
      "end_ms": 38720,
      "text": "再变回蓝，",
      "token_start": 140,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38860,
      "end_ms": 39920,
      "text": "像活的一样，",
      "token_start": 144,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 40040,
      "end_ms": 40740,
      "text": "还是咱们的。",
      "token_start": 149,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 40740,
      "end_ms": 41300,
      "text": "老规矩。",
      "token_start": 154,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 41620,
      "end_ms": 42300,
      "text": "开讲前，",
      "token_start": 157,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 42300,
      "end_ms": 44580,
      "text": "劳烦各位老友顺手点亮红心。",
      "token_start": 160,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 44820,
      "end_ms": 50160,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场。",
      "token_start": 172,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 50620,
      "end_ms": 51760,
      "text": "从第五名开始，",
      "token_start": 194,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 52980,
      "end_ms": 53680,
      "text": "第五名，",
      "token_start": 200,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 54180,
      "end_ms": 62145,
      "text": "四川李塘错谱湖措谱湖藏在四川甘孜州、巴塘和礼堂之间的大山深处。",
      "token_start": 203,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 62960,
      "end_ms": 64245,
      "text": "海拔四千多米，",
      "token_start": 232,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 65640,
      "end_ms": 66595,
      "text": "这个壶不大，",
      "token_start": 238,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 67010,
      "end_ms": 69650,
      "text": "但四周的环境好到不像真的。",
      "token_start": 243,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 69650,
      "end_ms": 71705,
      "text": "三面是五千多米的雪山，",
      "token_start": 255,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 72460,
      "end_ms": 75000,
      "text": "一面是连绵的高山草甸，",
      "token_start": 265,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 75140,
      "end_ms": 77805,
      "text": "湖边长着一圈密密的云山和冷山。",
      "token_start": 275,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 78570,
      "end_ms": 79495,
      "text": "秋天一到，",
      "token_start": 289,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 80140,
      "end_ms": 80660,
      "text": "草甸，",
      "token_start": 293,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 80740,
      "end_ms": 81305,
      "text": "先皇，",
      "token_start": 295,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 82020,
      "end_ms": 84070,
      "text": "然后是湖边的灌木，",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 84090,
      "end_ms": 85105,
      "text": "从绿变红，",
      "token_start": 305,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 85860,
      "end_ms": 87905,
      "text": "云山保持墨绿不动。",
      "token_start": 309,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 88560,
      "end_ms": 92785,
      "text": "三种颜色裹着一汪蓝绿色的湖水层层分明。",
      "token_start": 317,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 93640,
      "end_ms": 95255,
      "text": "清晨没有风的时候，",
      "token_start": 335,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 95800,
      "end_ms": 99745,
      "text": "湖面把雪山、彩云蓝天全部倒映在水里，",
      "token_start": 343,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 100370,
      "end_ms": 102230,
      "text": "倒影清晰到分不出哪边？",
      "token_start": 359,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 102230,
      "end_ms": 108435,
      "text": "是真的错谱湖最特别的一点是湖里有一种不怕人的高原萝莉，",
      "token_start": 369,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 108890,
      "end_ms": 110275,
      "text": "您往湖边一蹲，",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 110700,
      "end_ms": 112320,
      "text": "鱼群会自己游过来，",
      "token_start": 401,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 112320,
      "end_ms": 113080,
      "text": "围在脚边。",
      "token_start": 409,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 113240,
      "end_ms": 115920,
      "text": "当地藏族人从来不捕这些鱼，",
      "token_start": 413,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 116320,
      "end_ms": 117745,
      "text": "管他们叫神鱼，",
      "token_start": 425,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 118140,
      "end_ms": 119465,
      "text": "说虎有灵气，",
      "token_start": 431,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 119850,
      "end_ms": 120930,
      "text": "鱼也有灵气，",
      "token_start": 436,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 121410,
      "end_ms": 122775,
      "text": "一汪高原湖泊，",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 123100,
      "end_ms": 124265,
      "text": "雪山贴着水面，",
      "token_start": 447,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 124560,
      "end_ms": 125345,
      "text": "鱼不怕人。",
      "token_start": 453,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 125890,
      "end_ms": 129405,
      "text": "秋天的颜色从山顶一直铺到湖底，",
      "token_start": 457,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 129910,
      "end_ms": 132855,
      "text": "这个地方连导航都不太找得准，",
      "token_start": 471,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 133740,
      "end_ms": 135945,
      "text": "去过的人少之又少。",
      "token_start": 484,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 136600,
      "end_ms": 137375,
      "text": "第四名，",
      "token_start": 492,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 138630,
      "end_ms": 146165,
      "text": "西藏然、芜湖然芜湖在西藏昌都八宿县三百十八国道边上。",
      "token_start": 495,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 146570,
      "end_ms": 148775,
      "text": "很多人走川藏线的时候会路过他，",
      "token_start": 519,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 149740,
      "end_ms": 152100,
      "text": "可大部分人只是停下来拍张照就走，",
      "token_start": 533,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 152180,
      "end_ms": 153995,
      "text": "没有在秋天专程去过，",
      "token_start": 548,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 154320,
      "end_ms": 155595,
      "text": "然后是堰塞湖，",
      "token_start": 557,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 156060,
      "end_ms": 158560,
      "text": "湖水的颜色随季节变夏天，",
      "token_start": 563,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 158560,
      "end_ms": 159815,
      "text": "冰川融水量大，",
      "token_start": 574,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 160070,
      "end_ms": 162225,
      "text": "湖水是浑的灰蓝色，",
      "token_start": 580,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 162780,
      "end_ms": 165565,
      "text": "可一到秋天融水变少，",
      "token_start": 588,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 165990,
      "end_ms": 168005,
      "text": "湖水慢慢沉淀下来，",
      "token_start": 597,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 168900,
      "end_ms": 171755,
      "text": "变成一种安安静静的碧绿色。",
      "token_start": 605,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 172850,
      "end_ms": 176015,
      "text": "湖的两岸是秘密的原始森林。",
      "token_start": 617,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 176830,
      "end_ms": 177390,
      "text": "秋天，",
      "token_start": 629,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 177430,
      "end_ms": 181945,
      "text": "树叶变黄变红和碧绿的湖水配在一起，",
      "token_start": 631,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 182540,
      "end_ms": 187845,
      "text": "头顶是雪山燃芜湖最动人的时候是清晨，",
      "token_start": 647,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 188710,
      "end_ms": 190815,
      "text": "太阳还没翻过东边的山，",
      "token_start": 664,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 191520,
      "end_ms": 193680,
      "text": "湖面上浮着一层薄雾，",
      "token_start": 674,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 193740,
      "end_ms": 195675,
      "text": "雾气贴着水面慢慢移动，",
      "token_start": 683,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 196060,
      "end_ms": 199210,
      "text": "远处的雪山只露出山间湖边。",
      "token_start": 693,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 199430,
      "end_ms": 201425,
      "text": "有几户藏族人家的房子，",
      "token_start": 705,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 201850,
      "end_ms": 203375,
      "text": "屋顶上冒着炊烟，",
      "token_start": 715,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 203920,
      "end_ms": 205700,
      "text": "炊烟和晨雾搅在一起，",
      "token_start": 722,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 205700,
      "end_ms": 209645,
      "text": "分不清哪个是哪个那个画面安静到什么程度呢？",
      "token_start": 731,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 210000,
      "end_ms": 211965,
      "text": "连鸟叫都显得多余。",
      "token_start": 751,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 212760,
      "end_ms": 218080,
      "text": "一个堰塞湖夏天浑秋天清清下来之后，",
      "token_start": 759,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 218080,
      "end_ms": 226025,
      "text": "碧绿碧绿的配着雪山和城雾向谁在高原上打翻了一碟子绿墨水。",
      "token_start": 775,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 227170,
      "end_ms": 227775,
      "text": "第三名，",
      "token_start": 802,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 228960,
      "end_ms": 232325,
      "text": "四川松潘黄龙五彩池，",
      "token_start": 805,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 233250,
      "end_ms": 239495,
      "text": "黄龙五彩池在四川阿坝州松潘县海拔三千五百多米。",
      "token_start": 814,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 240460,
      "end_ms": 243300,
      "text": "很多人知道九寨沟的五彩池，",
      "token_start": 836,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 243680,
      "end_ms": 246700,
      "text": "可黄龙的五彩池跟九寨沟不是一回事。",
      "token_start": 848,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 247540,
      "end_ms": 250260,
      "text": "黄龙的五彩池是六百多个钙化，",
      "token_start": 864,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 250260,
      "end_ms": 252040,
      "text": "彩池挤在一片山坡，",
      "token_start": 877,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 252040,
      "end_ms": 253740,
      "text": "上大的像澡盆，",
      "token_start": 885,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 253740,
      "end_ms": 254620,
      "text": "小的像脸盆，",
      "token_start": 891,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 254680,
      "end_ms": 258080,
      "text": "一个挨一个密密麻麻的排着每个池子的水。",
      "token_start": 896,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 258140,
      "end_ms": 259400,
      "text": "因为深浅不同，",
      "token_start": 914,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 259680,
      "end_ms": 260960,
      "text": "钙化程度不同，",
      "token_start": 920,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 261200,
      "end_ms": 262660,
      "text": "呈现出不一样的颜色。",
      "token_start": 926,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 262660,
      "end_ms": 263600,
      "text": "有的是浅蓝，",
      "token_start": 935,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 264180,
      "end_ms": 265260,
      "text": "有的是翠绿，",
      "token_start": 940,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 265660,
      "end_ms": 266580,
      "text": "有的是鹅黄，",
      "token_start": 945,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 266900,
      "end_ms": 267900,
      "text": "有的是乳白，",
      "token_start": 950,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 268320,
      "end_ms": 269100,
      "text": "挨在一起，",
      "token_start": 955,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 269100,
      "end_ms": 271070,
      "text": "像一块被打调色板。",
      "token_start": 959,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 271210,
      "end_ms": 272630,
      "text": "秋天去五彩池，",
      "token_start": 967,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 272630,
      "end_ms": 274190,
      "text": "跟其他季节完全不同，",
      "token_start": 973,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 274730,
      "end_ms": 277530,
      "text": "周围山坡上的彩铃红了黄了，",
      "token_start": 982,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 277930,
      "end_ms": 284950,
      "text": "倒映在那些小池子里面池水本身的蓝绿色和彩铃的红黄色搅在一起，",
      "token_start": 994,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 285390,
      "end_ms": 288590,
      "text": "六百多个池子每一个的颜色都不重样，",
      "token_start": 1023,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 289330,
      "end_ms": 291950,
      "text": "往山坡上面一站俯瞰下去，",
      "token_start": 1039,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 292730,
      "end_ms": 296115,
      "text": "就像有人在山坡上摆了几百叠子颜料。",
      "token_start": 1050,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 296900,
      "end_ms": 298000,
      "text": "叠叠不同色，",
      "token_start": 1066,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 298460,
      "end_ms": 299640,
      "text": "可黄龙有个问题，",
      "token_start": 1071,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 299640,
      "end_ms": 302500,
      "text": "海拔高从停车场走到五彩池，",
      "token_start": 1078,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 302800,
      "end_ms": 304520,
      "text": "要爬三四公里的山路，",
      "token_start": 1090,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 304900,
      "end_ms": 307700,
      "text": "海拔从三千米爬到三千五百米，",
      "token_start": 1099,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 307780,
      "end_ms": 309920,
      "text": "很多人走到半路就喘不上来了，",
      "token_start": 1112,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 309940,
      "end_ms": 312020,
      "text": "到不了顶到了顶的人回来，",
      "token_start": 1125,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 312020,
      "end_ms": 313100,
      "text": "都说同一句话，",
      "token_start": 1136,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 314080,
      "end_ms": 319520,
      "text": "值六百多个池子六百多种颜色铺在三千五百米的山坡上。",
      "token_start": 1142,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 319880,
      "end_ms": 322460,
      "text": "秋天彩铃一映池子，",
      "token_start": 1166,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 322460,
      "end_ms": 324380,
      "text": "里面又多了几百种颜色。",
      "token_start": 1174,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 324740,
      "end_ms": 325400,
      "text": "第二名，",
      "token_start": 1184,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 326300,
      "end_ms": 335530,
      "text": "内蒙蒙古阿尔山天池、阿尔山天池在内蒙古兴安盟阿尔山市藏在大兴安岭的林海深处。",
      "token_start": 1187,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 336010,
      "end_ms": 338890,
      "text": "这个天池是火山口积水形成的，",
      "token_start": 1223,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 339190,
      "end_ms": 340930,
      "text": "海拔一千三百多米，",
      "token_start": 1236,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 340990,
      "end_ms": 341770,
      "text": "面积不大，",
      "token_start": 1244,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 342010,
      "end_ms": 343490,
      "text": "大概也就几个足球场。",
      "token_start": 1248,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 343490,
      "end_ms": 346250,
      "text": "那么大可面积不大不要紧，",
      "token_start": 1257,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 346650,
      "end_ms": 353310,
      "text": "它剩在四周的林子、阿尔山天池的四面全是白桦林和落叶松。",
      "token_start": 1268,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 353870,
      "end_ms": 354750,
      "text": "秋天一到，",
      "token_start": 1293,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 355050,
      "end_ms": 357215,
      "text": "白桦叶子变成金黄色，",
      "token_start": 1297,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 357660,
      "end_ms": 360380,
      "text": "落叶松变成橘黄色两种，",
      "token_start": 1306,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 360400,
      "end_ms": 363495,
      "text": "黄色裹着中间一汪蓝得发深的湖水，",
      "token_start": 1316,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 364370,
      "end_ms": 365805,
      "text": "从高处往下看，",
      "token_start": 1331,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 366180,
      "end_ms": 369485,
      "text": "就像一块蓝宝石镶在一圈金子里面。",
      "token_start": 1337,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 370020,
      "end_ms": 372440,
      "text": "阿尔山天池还有一个说不清的地方。",
      "token_start": 1352,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 372460,
      "end_ms": 373700,
      "text": "这个湖没有入水口，",
      "token_start": 1367,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 373700,
      "end_ms": 374700,
      "text": "也没有出水口，",
      "token_start": 1375,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 374760,
      "end_ms": 376060,
      "text": "不管旱年涝，",
      "token_start": 1381,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 376060,
      "end_ms": 377200,
      "text": "年水位不升，",
      "token_start": 1386,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 377220,
      "end_ms": 379305,
      "text": "不降始终保持那么多。",
      "token_start": 1391,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 380060,
      "end_ms": 382145,
      "text": "有人说底下连着地下暗河，",
      "token_start": 1400,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 382660,
      "end_ms": 385305,
      "text": "有人说是火山口的地质结构特殊，",
      "token_start": 1411,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 385690,
      "end_ms": 388860,
      "text": "到今天也没有一个完全确定的解释，",
      "token_start": 1425,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 389420,
      "end_ms": 390560,
      "text": "一个没有进水，",
      "token_start": 1440,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 390580,
      "end_ms": 392570,
      "text": "没有出水的湖水，",
      "token_start": 1446,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 392590,
      "end_ms": 394595,
      "text": "不多不少呆了不知道多少年。",
      "token_start": 1453,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 395500,
      "end_ms": 397240,
      "text": "秋天去阿尔山天池，",
      "token_start": 1465,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 397260,
      "end_ms": 400525,
      "text": "最好的时间是九月中旬到十月初。",
      "token_start": 1473,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 401460,
      "end_ms": 403725,
      "text": "那个时候林子的颜色最浓，",
      "token_start": 1487,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 404260,
      "end_ms": 406305,
      "text": "早晨湖面会起一层薄雾，",
      "token_start": 1498,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 407110,
      "end_ms": 409770,
      "text": "金色的林子在雾后面若隐若现。",
      "token_start": 1508,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 409810,
      "end_ms": 411825,
      "text": "太阳出来雾一散，",
      "token_start": 1521,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 412240,
      "end_ms": 415865,
      "text": "蓝色的湖水和金色的树林同时亮起来，",
      "token_start": 1528,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 416270,
      "end_ms": 419665,
      "text": "那个瞬间干净的向世界刚被洗过一遍，",
      "token_start": 1544,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 420560,
      "end_ms": 424965,
      "text": "大兴安岭林海深处一汪不升不降的蓝水，",
      "token_start": 1560,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 425470,
      "end_ms": 429165,
      "text": "四面裹着金色的林子安安静静待在那儿，",
      "token_start": 1577,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 429740,
      "end_ms": 430925,
      "text": "不知道待了多少年。",
      "token_start": 1594,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 432080,
      "end_ms": 432480,
      "text": "好了，",
      "token_start": 1602,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 433210,
      "end_ms": 434445,
      "text": "前面九个讲完了，",
      "token_start": 1604,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 435180,
      "end_ms": 436575,
      "text": "该截第一名了，",
      "token_start": 1611,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 437630,
      "end_ms": 439455,
      "text": "可在接之前跟您聊几句。",
      "token_start": 1617,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 439880,
      "end_ms": 440340,
      "text": "评论区，",
      "token_start": 1627,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 440340,
      "end_ms": 442765,
      "text": "不少朋友说看完上集就想出发了。",
      "token_start": 1630,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 443230,
      "end_ms": 445450,
      "text": "可一查发现这些地方要么在高原，",
      "token_start": 1644,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 445450,
      "end_ms": 446850,
      "text": "要么在深山路线，",
      "token_start": 1658,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 446870,
      "end_ms": 451085,
      "text": "不好找到了也不知道该在哪看什么时间看最好。",
      "token_start": 1665,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 451920,
      "end_ms": 452460,
      "text": "确实，",
      "token_start": 1685,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 453380,
      "end_ms": 456285,
      "text": "秋水秘境跟热门景区不一样，",
      "token_start": 1687,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 457170,
      "end_ms": 458330,
      "text": "不是买张门票，",
      "token_start": 1699,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 458370,
      "end_ms": 461775,
      "text": "站在观景台上就能看到最美的那个画面，",
      "token_start": 1705,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 462230,
      "end_ms": 464545,
      "text": "什么时候去站在哪个角度，",
      "token_start": 1722,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 464880,
      "end_ms": 466775,
      "text": "早晨几点钟到湖边，",
      "token_start": 1733,
      "token_end_exclusive": 1741
    },
    {
      "start_ms": 467100,
      "end_ms": 467700,
      "text": "差一点，",
      "token_start": 1741,
      "token_end_exclusive": 1744
    },
    {
      "start_ms": 467700,
      "end_ms": 468995,
      "text": "效果就差一截。",
      "token_start": 1744,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 470070,
      "end_ms": 473305,
      "text": "后来有朋友给我推荐了一本书叫大美中国，",
      "token_start": 1750,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 473680,
      "end_ms": 477225,
      "text": "说是把咱们国家这些值得去的地方全整理了一遍，",
      "token_start": 1768,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 477840,
      "end_ms": 478520,
      "text": "有路线，",
      "token_start": 1789,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 478540,
      "end_ms": 479420,
      "text": "有实拍的图，",
      "token_start": 1792,
      "token_end_exclusive": 1797
    },
    {
      "start_ms": 479420,
      "end_ms": 481140,
      "text": "有当地的风土人情。",
      "token_start": 1797,
      "token_end_exclusive": 1805
    },
    {
      "start_ms": 481220,
      "end_ms": 481920,
      "text": "看得出来，",
      "token_start": 1805,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 481920,
      "end_ms": 483885,
      "text": "编书的人自己跑过这些地方，",
      "token_start": 1809,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 484380,
      "end_ms": 485060,
      "text": "放在家里，",
      "token_start": 1821,
      "token_end_exclusive": 1825
    },
    {
      "start_ms": 485060,
      "end_ms": 485800,
      "text": "平时翻番，",
      "token_start": 1825,
      "token_end_exclusive": 1829
    },
    {
      "start_ms": 485820,
      "end_ms": 486555,
      "text": "长见识，",
      "token_start": 1829,
      "token_end_exclusive": 1832
    },
    {
      "start_ms": 486850,
      "end_ms": 488390,
      "text": "真要出发了当参考，",
      "token_start": 1832,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 488590,
      "end_ms": 489445,
      "text": "也用得上，",
      "token_start": 1840,
      "token_end_exclusive": 1844
    },
    {
      "start_ms": 490320,
      "end_ms": 493225,
      "text": "比到了地方两眼一摸黑瞎转强太多。",
      "token_start": 1844,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 493760,
      "end_ms": 494745,
      "text": "想要的朋友。",
      "token_start": 1859,
      "token_end_exclusive": 1864
    },
    {
      "start_ms": 494990,
      "end_ms": 497150,
      "text": "点左下角头像进橱窗，",
      "token_start": 1864,
      "token_end_exclusive": 1873
    },
    {
      "start_ms": 497470,
      "end_ms": 501135,
      "text": "认准大美中国几十块钱的事儿。",
      "token_start": 1873,
      "token_end_exclusive": 1886
    },
    {
      "start_ms": 502130,
      "end_ms": 503615,
      "text": "好书先说到这儿，",
      "token_start": 1886,
      "token_end_exclusive": 1893
    },
    {
      "start_ms": 503830,
      "end_ms": 505525,
      "text": "咱们收回来接最后一个。",
      "token_start": 1893,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 506710,
      "end_ms": 509095,
      "text": "先在评论区打出四个字，",
      "token_start": 1903,
      "token_end_exclusive": 1913
    },
    {
      "start_ms": 509480,
      "end_ms": 513875,
      "text": "秋水之音打完回来听最后一个第一名。",
      "token_start": 1913,
      "token_end_exclusive": 1929
    },
    {
      "start_ms": 514350,
      "end_ms": 518610,
      "text": "新疆喀纳斯湖阿勒泰喀纳斯这个名字您可能听过，",
      "token_start": 1929,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 518910,
      "end_ms": 521345,
      "text": "可秋天的喀纳斯跟您想的不一样。",
      "token_start": 1950,
      "token_end_exclusive": 1964
    },
    {
      "start_ms": 521850,
      "end_ms": 525945,
      "text": "喀纳斯湖是冰川融水汇成的高山湖泊，",
      "token_start": 1964,
      "token_end_exclusive": 1980
    },
    {
      "start_ms": 526460,
      "end_ms": 528405,
      "text": "湖面海拔一千三百多米，",
      "token_start": 1980,
      "token_end_exclusive": 1990
    },
    {
      "start_ms": 528740,
      "end_ms": 530905,
      "text": "南北长将近二十五公里，",
      "token_start": 1990,
      "token_end_exclusive": 2000
    },
    {
      "start_ms": 531600,
      "end_ms": 533680,
      "text": "这个湖本身就会变色。",
      "token_start": 2000,
      "token_end_exclusive": 2009
    },
    {
      "start_ms": 533760,
      "end_ms": 536155,
      "text": "春天灰绿夏天深绿，",
      "token_start": 2009,
      "token_end_exclusive": 2017
    },
    {
      "start_ms": 536520,
      "end_ms": 539340,
      "text": "秋天变成一种说不上来的蓝绿色，",
      "token_start": 2017,
      "token_end_exclusive": 2031
    },
    {
      "start_ms": 539880,
      "end_ms": 541320,
      "text": "像一块老翡翠，",
      "token_start": 2031,
      "token_end_exclusive": 2037
    },
    {
      "start_ms": 541480,
      "end_ms": 542280,
      "text": "化成了水，",
      "token_start": 2037,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 542720,
      "end_ms": 545200,
      "text": "可光湖水变色不算什么，",
      "token_start": 2041,
      "token_end_exclusive": 2051
    },
    {
      "start_ms": 545900,
      "end_ms": 548800,
      "text": "真正把人看住的是湖两岸的林子。",
      "token_start": 2051,
      "token_end_exclusive": 2065
    },
    {
      "start_ms": 548880,
      "end_ms": 550120,
      "text": "喀纳斯的秋天。",
      "token_start": 2065,
      "token_end_exclusive": 2071
    },
    {
      "start_ms": 550140,
      "end_ms": 551900,
      "text": "大概从九月下旬开始，",
      "token_start": 2071,
      "token_end_exclusive": 2080
    },
    {
      "start_ms": 552280,
      "end_ms": 554120,
      "text": "白桦林最先变色，",
      "token_start": 2080,
      "token_end_exclusive": 2087
    },
    {
      "start_ms": 554500,
      "end_ms": 556580,
      "text": "叶子从绿变到金黄，",
      "token_start": 2087,
      "token_end_exclusive": 2095
    },
    {
      "start_ms": 556620,
      "end_ms": 557580,
      "text": "只要三四天，",
      "token_start": 2095,
      "token_end_exclusive": 2100
    },
    {
      "start_ms": 558120,
      "end_ms": 561060,
      "text": "然后是落叶松变成橘红色。",
      "token_start": 2100,
      "token_end_exclusive": 2111
    },
    {
      "start_ms": 561920,
      "end_ms": 563520,
      "text": "云山和冷杉不变，",
      "token_start": 2111,
      "token_end_exclusive": 2118
    },
    {
      "start_ms": 564020,
      "end_ms": 566370,
      "text": "始终是墨绿的三种颜色，",
      "token_start": 2118,
      "token_end_exclusive": 2128
    },
    {
      "start_ms": 566450,
      "end_ms": 568670,
      "text": "颜色交叉着铺满两岸的山坡，",
      "token_start": 2128,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 568670,
      "end_ms": 569770,
      "text": "金黄橘红，",
      "token_start": 2140,
      "token_end_exclusive": 2144
    },
    {
      "start_ms": 569850,
      "end_ms": 572510,
      "text": "墨绿一层一层的叠着，",
      "token_start": 2144,
      "token_end_exclusive": 2153
    },
    {
      "start_ms": 572830,
      "end_ms": 574970,
      "text": "从山脚一直叠到山腰，",
      "token_start": 2153,
      "token_end_exclusive": 2162
    },
    {
      "start_ms": 575670,
      "end_ms": 577810,
      "text": "湖面把这些颜色全部接住，",
      "token_start": 2162,
      "token_end_exclusive": 2173
    },
    {
      "start_ms": 577810,
      "end_ms": 578730,
      "text": "倒映在水里，",
      "token_start": 2173,
      "token_end_exclusive": 2178
    },
    {
      "start_ms": 579190,
      "end_ms": 583110,
      "text": "水底的蓝绿和岸上的惊红搅在一起，",
      "token_start": 2178,
      "token_end_exclusive": 2193
    },
    {
      "start_ms": 583550,
      "end_ms": 585190,
      "text": "浓烈到不像真的。",
      "token_start": 2193,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 585210,
      "end_ms": 588185,
      "text": "喀纳斯最出名的秋景在神仙湾。",
      "token_start": 2200,
      "token_end_exclusive": 2213
    },
    {
      "start_ms": 588910,
      "end_ms": 590790,
      "text": "清晨八九点钟的时候，",
      "token_start": 2213,
      "token_end_exclusive": 2222
    },
    {
      "start_ms": 591150,
      "end_ms": 593670,
      "text": "河面上会升起一层白雾，",
      "token_start": 2222,
      "token_end_exclusive": 2232
    },
    {
      "start_ms": 594470,
      "end_ms": 597330,
      "text": "雾气贴着水面缓缓飘，",
      "token_start": 2232,
      "token_end_exclusive": 2241
    },
    {
      "start_ms": 598350,
      "end_ms": 602230,
      "text": "两岸的金色白桦林在雾后面若隐若现。",
      "token_start": 2241,
      "token_end_exclusive": 2257
    },
    {
      "start_ms": 602670,
      "end_ms": 604690,
      "text": "太阳从山背后升起来，",
      "token_start": 2257,
      "token_end_exclusive": 2266
    },
    {
      "start_ms": 605090,
      "end_ms": 607310,
      "text": "光线穿过雾气和树梢。",
      "token_start": 2266,
      "token_end_exclusive": 2275
    },
    {
      "start_ms": 607790,
      "end_ms": 608870,
      "text": "到了秋面，",
      "token_start": 2275,
      "token_end_exclusive": 2279
    },
    {
      "start_ms": 609010,
      "end_ms": 611450,
      "text": "像有人在空气里撒了一把金粉，",
      "token_start": 2279,
      "token_end_exclusive": 2292
    },
    {
      "start_ms": 612170,
      "end_ms": 613090,
      "text": "当地牧民说，",
      "token_start": 2292,
      "token_end_exclusive": 2297
    },
    {
      "start_ms": 613090,
      "end_ms": 614610,
      "text": "这是神仙珠的地方。",
      "token_start": 2297,
      "token_end_exclusive": 2305
    },
    {
      "start_ms": 615010,
      "end_ms": 615830,
      "text": "到了秋天，",
      "token_start": 2305,
      "token_end_exclusive": 2309
    },
    {
      "start_ms": 615830,
      "end_ms": 617190,
      "text": "连神仙都舍不得走，",
      "token_start": 2309,
      "token_end_exclusive": 2317
    },
    {
      "start_ms": 617610,
      "end_ms": 620080,
      "text": "可这份好看只有十几天的窗口。",
      "token_start": 2317,
      "token_end_exclusive": 2330
    },
    {
      "start_ms": 620800,
      "end_ms": 622480,
      "text": "九月下旬开始变色，",
      "token_start": 2330,
      "token_end_exclusive": 2338
    },
    {
      "start_ms": 622600,
      "end_ms": 624100,
      "text": "十月上旬最盛，",
      "token_start": 2338,
      "token_end_exclusive": 2344
    },
    {
      "start_ms": 624320,
      "end_ms": 626500,
      "text": "十月中旬叶子就开始落了。",
      "token_start": 2344,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 626900,
      "end_ms": 627520,
      "text": "去早了，",
      "token_start": 2355,
      "token_end_exclusive": 2358
    },
    {
      "start_ms": 627520,
      "end_ms": 628500,
      "text": "林子还是绿的，",
      "token_start": 2358,
      "token_end_exclusive": 2364
    },
    {
      "start_ms": 628500,
      "end_ms": 629360,
      "text": "看不出什么。",
      "token_start": 2364,
      "token_end_exclusive": 2369
    },
    {
      "start_ms": 629640,
      "end_ms": 631040,
      "text": "去晚的叶子落光，",
      "token_start": 2369,
      "token_end_exclusive": 2376
    },
    {
      "start_ms": 631080,
      "end_ms": 632540,
      "text": "只剩光秃秃的枝干，",
      "token_start": 2376,
      "token_end_exclusive": 2384
    },
    {
      "start_ms": 633100,
      "end_ms": 636240,
      "text": "湖水的颜色也会因为降温慢慢变暗，",
      "token_start": 2384,
      "token_end_exclusive": 2399
    },
    {
      "start_ms": 636760,
      "end_ms": 639780,
      "text": "只有中间的十几天颜色是满的，",
      "token_start": 2399,
      "token_end_exclusive": 2412
    },
    {
      "start_ms": 640100,
      "end_ms": 641340,
      "text": "光线是暖的，",
      "token_start": 2412,
      "token_end_exclusive": 2417
    },
    {
      "start_ms": 641780,
      "end_ms": 642940,
      "text": "光气是清的，",
      "token_start": 2417,
      "token_end_exclusive": 2422
    },
    {
      "start_ms": 643380,
      "end_ms": 645640,
      "text": "所有的东西刚刚好碰在一起。",
      "token_start": 2422,
      "token_end_exclusive": 2434
    },
    {
      "start_ms": 646440,
      "end_ms": 648610,
      "text": "有人为了堵着十几天的窗口，",
      "token_start": 2434,
      "token_end_exclusive": 2446
    },
    {
      "start_ms": 648650,
      "end_ms": 649550,
      "text": "从广东飞过，",
      "token_start": 2446,
      "token_end_exclusive": 2451
    },
    {
      "start_ms": 649550,
      "end_ms": 650820,
      "text": "来到了一看，",
      "token_start": 2451,
      "token_end_exclusive": 2456
    },
    {
      "start_ms": 650820,
      "end_ms": 652640,
      "text": "赶上连续阴天颜色出不来，",
      "token_start": 2456,
      "token_end_exclusive": 2467
    },
    {
      "start_ms": 652780,
      "end_ms": 654700,
      "text": "只能在湖边等等了三天。",
      "token_start": 2467,
      "token_end_exclusive": 2477
    },
    {
      "start_ms": 654720,
      "end_ms": 656185,
      "text": "第四天早上放晴了，",
      "token_start": 2477,
      "token_end_exclusive": 2485
    },
    {
      "start_ms": 656940,
      "end_ms": 658320,
      "text": "雾散开的那一刻，",
      "token_start": 2485,
      "token_end_exclusive": 2492
    },
    {
      "start_ms": 658320,
      "end_ms": 659685,
      "text": "整个湖面亮了，",
      "token_start": 2492,
      "token_end_exclusive": 2498
    },
    {
      "start_ms": 660500,
      "end_ms": 662265,
      "text": "那个人蹲在湖边哭了，",
      "token_start": 2498,
      "token_end_exclusive": 2507
    },
    {
      "start_ms": 663090,
      "end_ms": 663955,
      "text": "不是难过，",
      "token_start": 2507,
      "token_end_exclusive": 2511
    },
    {
      "start_ms": 664600,
      "end_ms": 666765,
      "text": "是这辈子没见过这么干净的。",
      "token_start": 2511,
      "token_end_exclusive": 2523
    },
    {
      "start_ms": 666920,
      "end_ms": 669005,
      "text": "是十几天的窗口，",
      "token_start": 2523,
      "token_end_exclusive": 2530
    },
    {
      "start_ms": 669380,
      "end_ms": 670905,
      "text": "一年只给一次，",
      "token_start": 2530,
      "token_end_exclusive": 2536
    },
    {
      "start_ms": 671680,
      "end_ms": 673255,
      "text": "错过了再等一年。",
      "token_start": 2536,
      "token_end_exclusive": 2543
    },
    {
      "start_ms": 674110,
      "end_ms": 676500,
      "text": "这就是喀纳斯排第一的原因。",
      "token_start": 2543,
      "token_end_exclusive": 2555
    },
    {
      "start_ms": 676500,
      "end_ms": 676800,
      "text": "不是，",
      "token_start": 2555,
      "token_end_exclusive": 2557
    },
    {
      "start_ms": 676800,
      "end_ms": 678340,
      "text": "他比别的湖更蓝，",
      "token_start": 2557,
      "token_end_exclusive": 2564
    },
    {
      "start_ms": 678400,
      "end_ms": 679635,
      "text": "更大更有名，",
      "token_start": 2564,
      "token_end_exclusive": 2569
    },
    {
      "start_ms": 680120,
      "end_ms": 684730,
      "text": "是他把最好的自己只拿出来十几天给你看看，",
      "token_start": 2569,
      "token_end_exclusive": 2588
    },
    {
      "start_ms": 684810,
      "end_ms": 685630,
      "text": "不看得到，",
      "token_start": 2588,
      "token_end_exclusive": 2592
    },
    {
      "start_ms": 685830,
      "end_ms": 686905,
      "text": "全凭运气。",
      "token_start": 2592,
      "token_end_exclusive": 2596
    },
    {
      "start_ms": 687910,
      "end_ms": 689910,
      "text": "十个秋水秘境讲完了，",
      "token_start": 2596,
      "token_end_exclusive": 2605
    },
    {
      "start_ms": 689950,
      "end_ms": 690965,
      "text": "您回头想想，",
      "token_start": 2605,
      "token_end_exclusive": 2610
    },
    {
      "start_ms": 691410,
      "end_ms": 692750,
      "text": "如情湖是山间，",
      "token_start": 2610,
      "token_end_exclusive": 2616
    },
    {
      "start_ms": 692830,
      "end_ms": 694595,
      "text": "琴音轻轻响了一声，",
      "token_start": 2616,
      "token_end_exclusive": 2624
    },
    {
      "start_ms": 695030,
      "end_ms": 696450,
      "text": "还龙湖是江湾，",
      "token_start": 2624,
      "token_end_exclusive": 2630
    },
    {
      "start_ms": 696450,
      "end_ms": 697875,
      "text": "红叶输了一地，",
      "token_start": 2630,
      "token_end_exclusive": 2636
    },
    {
      "start_ms": 698440,
      "end_ms": 699800,
      "text": "卧龙潭是幽谷，",
      "token_start": 2636,
      "token_end_exclusive": 2642
    },
    {
      "start_ms": 699800,
      "end_ms": 700780,
      "text": "里藏了一面。",
      "token_start": 2642,
      "token_end_exclusive": 2647
    },
    {
      "start_ms": 700820,
      "end_ms": 703480,
      "text": "玉镜抚仙湖是天光，",
      "token_start": 2647,
      "token_end_exclusive": 2655
    },
    {
      "start_ms": 703540,
      "end_ms": 707050,
      "text": "洗了一壶净水闻县天池是陇南，",
      "token_start": 2655,
      "token_end_exclusive": 2668
    },
    {
      "start_ms": 707050,
      "end_ms": 709970,
      "text": "深山里落了一滴蓝墨错谱。",
      "token_start": 2668,
      "token_end_exclusive": 2679
    },
    {
      "start_ms": 709970,
      "end_ms": 711390,
      "text": "湖是雪山脚下，",
      "token_start": 2679,
      "token_end_exclusive": 2685
    },
    {
      "start_ms": 711410,
      "end_ms": 713385,
      "text": "蹲了一汪不怕人的陵水。",
      "token_start": 2685,
      "token_end_exclusive": 2695
    },
    {
      "start_ms": 714110,
      "end_ms": 718650,
      "text": "然芜湖是高原上打翻了一叠绿墨五彩池，",
      "token_start": 2695,
      "token_end_exclusive": 2712
    },
    {
      "start_ms": 718650,
      "end_ms": 721195,
      "text": "是山坡上摆了几百叠颜料。",
      "token_start": 2712,
      "token_end_exclusive": 2723
    },
    {
      "start_ms": 721730,
      "end_ms": 724110,
      "text": "阿尔山天池是灵海里，",
      "token_start": 2723,
      "token_end_exclusive": 2732
    },
    {
      "start_ms": 724150,
      "end_ms": 725675,
      "text": "镶了一块蓝宝石。",
      "token_start": 2732,
      "token_end_exclusive": 2739
    },
    {
      "start_ms": 726270,
      "end_ms": 729650,
      "text": "喀纳斯是老天爷用十几天的时间烧了一场金色的火，",
      "token_start": 2739,
      "token_end_exclusive": 2761
    },
    {
      "start_ms": 729650,
      "end_ms": 732715,
      "text": "然后一夜收走这十王秋水加一块儿。",
      "token_start": 2761,
      "token_end_exclusive": 2776
    },
    {
      "start_ms": 733540,
      "end_ms": 735215,
      "text": "您说最动人的是什么？",
      "token_start": 2776,
      "token_end_exclusive": 2785
    },
    {
      "start_ms": 736070,
      "end_ms": 739585,
      "text": "我觉得最动人的不是哪汪水最蓝、最青最好看，",
      "token_start": 2785,
      "token_end_exclusive": 2804
    },
    {
      "start_ms": 740240,
      "end_ms": 744080,
      "text": "而是这些水安安静静在那儿等了几百年几千年，",
      "token_start": 2804,
      "token_end_exclusive": 2824
    },
    {
      "start_ms": 744100,
      "end_ms": 745095,
      "text": "甚至几亿年，",
      "token_start": 2824,
      "token_end_exclusive": 2829
    },
    {
      "start_ms": 745680,
      "end_ms": 747320,
      "text": "等的就是秋天那几天，",
      "token_start": 2829,
      "token_end_exclusive": 2838
    },
    {
      "start_ms": 747320,
      "end_ms": 748160,
      "text": "光线对了，",
      "token_start": 2838,
      "token_end_exclusive": 2842
    },
    {
      "start_ms": 748160,
      "end_ms": 748920,
      "text": "颜色对了，",
      "token_start": 2842,
      "token_end_exclusive": 2846
    },
    {
      "start_ms": 748920,
      "end_ms": 749700,
      "text": "雾气对了。",
      "token_start": 2846,
      "token_end_exclusive": 2850
    },
    {
      "start_ms": 749900,
      "end_ms": 751240,
      "text": "有个人站在湖边，",
      "token_start": 2850,
      "token_end_exclusive": 2857
    },
    {
      "start_ms": 751240,
      "end_ms": 752995,
      "text": "看到了水不说话，",
      "token_start": 2857,
      "token_end_exclusive": 2864
    },
    {
      "start_ms": 753390,
      "end_ms": 754270,
      "text": "可秋天到了，",
      "token_start": 2864,
      "token_end_exclusive": 2869
    },
    {
      "start_ms": 754270,
      "end_ms": 755535,
      "text": "他什么都告诉您了，",
      "token_start": 2869,
      "token_end_exclusive": 2877
    },
    {
      "start_ms": 755870,
      "end_ms": 761680,
      "text": "想出发之前先把这些地方看明白的那本大美中国的链接，",
      "token_start": 2877,
      "token_end_exclusive": 2901
    },
    {
      "start_ms": 761680,
      "end_ms": 762860,
      "text": "我放在左下角，",
      "token_start": 2901,
      "token_end_exclusive": 2907
    },
    {
      "start_ms": 762960,
      "end_ms": 764120,
      "text": "觉得有意思的话，",
      "token_start": 2907,
      "token_end_exclusive": 2914
    },
    {
      "start_ms": 764120,
      "end_ms": 764900,
      "text": "帮忙点个赞，",
      "token_start": 2914,
      "token_end_exclusive": 2919
    },
    {
      "start_ms": 764900,
      "end_ms": 765485,
      "text": "转个发，",
      "token_start": 2919,
      "token_end_exclusive": 2922
    },
    {
      "start_ms": 766020,
      "end_ms": 767565,
      "text": "咱们下一期接着聊。",
      "token_start": 2922,
      "token_end_exclusive": 2930
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
