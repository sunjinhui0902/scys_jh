{
  "video_id": "v_e296bf0afb5c1ab0",
  "duration_s": 701.778005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_e296bf0afb5c1ab0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_e296bf0afb5c1ab0.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 3370,
      "text": "你知道中国最适合过冬的小城在哪儿吗？",
      "token_start": 0,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 3410,
      "end_ms": 5190,
      "text": "上一季我讲了十个，",
      "token_start": 17,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5190,
      "end_ms": 8050,
      "text": "好多朋友看完直接订了票，",
      "token_start": 25,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8050,
      "end_ms": 11150,
      "text": "可评论区里有一句话让我愣了下去啊，",
      "token_start": 36,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 11270,
      "end_ms": 12750,
      "text": "人多了，",
      "token_start": 52,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 12810,
      "end_ms": 15890,
      "text": "确实好地方一旦被知道了，",
      "token_start": 55,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 16129,
      "end_ms": 17030,
      "text": "人就来了。",
      "token_start": 66,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 17870,
      "end_ms": 22470,
      "text": "所以今天这十个比上一季更冷门，",
      "token_start": 70,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23230,
      "end_ms": 24750,
      "text": "冷门到什么程度呢？",
      "token_start": 84,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25910,
      "end_ms": 29090,
      "text": "排第一的是一个县级市城，",
      "token_start": 92,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 29130,
      "end_ms": 31300,
      "text": "里面有反法国风情的酒庄，",
      "token_start": 103,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 31780,
      "end_ms": 32740,
      "text": "有野温泉，",
      "token_start": 114,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 33120,
      "end_ms": 34480,
      "text": "还有一片红土地。",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 34960,
      "end_ms": 37240,
      "text": "可您身边随便问一圈，",
      "token_start": 125,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 37260,
      "end_ms": 40220,
      "text": "大部分人连他的名字都说不出来，",
      "token_start": 134,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 40960,
      "end_ms": 41840,
      "text": "到底是哪？",
      "token_start": 148,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 42940,
      "end_ms": 43640,
      "text": "老规矩，",
      "token_start": 152,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 44360,
      "end_ms": 47220,
      "text": "从第十名开始倒着讲讲，",
      "token_start": 155,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 47220,
      "end_ms": 51960,
      "text": "到最后您自个儿盘算盘算开讲之前还是那句话，",
      "token_start": 165,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 52440,
      "end_ms": 55660,
      "text": "劳烦老友们顺手点亮小红心。",
      "token_start": 185,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 56080,
      "end_ms": 60975,
      "text": "评论区打个来了让我看看今天有多少老朋朋友捧场。",
      "token_start": 197,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 62000,
      "end_ms": 62725,
      "text": "第十名，",
      "token_start": 219,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 63640,
      "end_ms": 68225,
      "text": "广东湛江湛江在广东的最西南角，",
      "token_start": 222,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 68730,
      "end_ms": 69670,
      "text": "三面环海，",
      "token_start": 236,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 69670,
      "end_ms": 71335,
      "text": "对面就是海南岛。",
      "token_start": 240,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 72210,
      "end_ms": 75910,
      "text": "好多人去海南坐轮渡都从湛江过，",
      "token_start": 247,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 75990,
      "end_ms": 76790,
      "text": "可就是过了，",
      "token_start": 261,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 76890,
      "end_ms": 77815,
      "text": "没停下来。",
      "token_start": 266,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 78750,
      "end_ms": 80395,
      "text": "湛江冬天什么概念呢？",
      "token_start": 270,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 80720,
      "end_ms": 84615,
      "text": "羽绒服用不上一件薄外套就够了，",
      "token_start": 279,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 85260,
      "end_ms": 87245,
      "text": "跟北海的体感差不多。",
      "token_start": 293,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 87960,
      "end_ms": 89460,
      "text": "可湛江有一样东西，",
      "token_start": 302,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 89460,
      "end_ms": 90855,
      "text": "北海比不了生蚝。",
      "token_start": 310,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 91290,
      "end_ms": 93330,
      "text": "湛江是中国有名的生蚝，",
      "token_start": 317,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 93330,
      "end_ms": 96380,
      "text": "产地全国好多地方吃的生蚝，",
      "token_start": 327,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 96380,
      "end_ms": 98505,
      "text": "其实都是从湛江运过去，",
      "token_start": 339,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 99480,
      "end_ms": 103000,
      "text": "可到了湛江本地价格便宜到您不敢信。",
      "token_start": 349,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 103040,
      "end_ms": 105210,
      "text": "同样的声号运到外地，",
      "token_start": 365,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 105230,
      "end_ms": 106845,
      "text": "价格能翻好几倍。",
      "token_start": 374,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 107290,
      "end_ms": 110590,
      "text": "路边烧烤摊上的炭烤生蚝，",
      "token_start": 381,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 110790,
      "end_ms": 111650,
      "text": "个头大的，",
      "token_start": 392,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 111650,
      "end_ms": 113155,
      "text": "比成年人的巴掌还宽，",
      "token_start": 396,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 113520,
      "end_ms": 115185,
      "text": "一口下去全是汁水。",
      "token_start": 405,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 115800,
      "end_ms": 119000,
      "text": "您要是去市场自己买一麻袋扛回来，",
      "token_start": 413,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 119000,
      "end_ms": 120095,
      "text": "撬开了蒸着吃，",
      "token_start": 428,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 120900,
      "end_ms": 121660,
      "text": "煮汤吃，",
      "token_start": 434,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 122000,
      "end_ms": 123865,
      "text": "生吃随便造，",
      "token_start": 437,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 124410,
      "end_ms": 125455,
      "text": "花不了多少钱。",
      "token_start": 442,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 126420,
      "end_ms": 127540,
      "text": "湛江还有一个地方，",
      "token_start": 448,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 127540,
      "end_ms": 133250,
      "text": "很多人不知道胡光堰那是一个火山口形成的湖水，",
      "token_start": 456,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 133410,
      "end_ms": 134715,
      "text": "是碧绿色的，",
      "token_start": 477,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 134970,
      "end_ms": 137585,
      "text": "安安静静地躺在火山口里面，",
      "token_start": 482,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 138070,
      "end_ms": 139285,
      "text": "周围全是树，",
      "token_start": 494,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 139760,
      "end_ms": 141505,
      "text": "冬天去湖边走一圈儿，",
      "token_start": 499,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 141730,
      "end_ms": 142625,
      "text": "没什么游客，",
      "token_start": 508,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 143440,
      "end_ms": 145080,
      "text": "风从湖面上吹过来，",
      "token_start": 513,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 145080,
      "end_ms": 147300,
      "text": "带着一股潮湿的草木味道，",
      "token_start": 521,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 147380,
      "end_ms": 150155,
      "text": "冬天穿着薄外套在海边溜达，",
      "token_start": 532,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 150580,
      "end_ms": 152345,
      "text": "吹着不冷不热的海风。",
      "token_start": 544,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 153200,
      "end_ms": 155365,
      "text": "这日子搁北方想都不敢想，",
      "token_start": 553,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 156190,
      "end_ms": 157310,
      "text": "湛江排第十，",
      "token_start": 564,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 157310,
      "end_ms": 158155,
      "text": "不是他不好，",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 158550,
      "end_ms": 159990,
      "text": "是后面的更冷门，",
      "token_start": 574,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 159990,
      "end_ms": 160805,
      "text": "更安静。",
      "token_start": 581,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 161400,
      "end_ms": 162020,
      "text": "第九名，",
      "token_start": 584,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 162320,
      "end_ms": 163265,
      "text": "云南蒙自，",
      "token_start": 587,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 164130,
      "end_ms": 167745,
      "text": "蒙自在云南红河州这个名字好多人没听说过，",
      "token_start": 591,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 168520,
      "end_ms": 169680,
      "text": "可以有一样东西，",
      "token_start": 610,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 169680,
      "end_ms": 171435,
      "text": "您一定吃过过桥米线。",
      "token_start": 617,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 172380,
      "end_ms": 176535,
      "text": "过桥米线就是从蒙自来的这是公认的发源地，",
      "token_start": 626,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 177480,
      "end_ms": 182085,
      "text": "可您在别的城市吃的过桥米线跟蒙自本地的比差得远了。",
      "token_start": 645,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 182560,
      "end_ms": 184995,
      "text": "蒙自的过桥米线讲究的是汤，",
      "token_start": 669,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 185440,
      "end_ms": 189165,
      "text": "那个汤是用老母鸡和筒子骨熬出来的，",
      "token_start": 681,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 189540,
      "end_ms": 191705,
      "text": "上面飘着厚厚一层机油，",
      "token_start": 697,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 192110,
      "end_ms": 193495,
      "text": "把热气封在里面，",
      "token_start": 707,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 193970,
      "end_ms": 194850,
      "text": "端上来的时候，",
      "token_start": 714,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 194850,
      "end_ms": 195995,
      "text": "汤看着不冒烟。",
      "token_start": 720,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 196830,
      "end_ms": 199035,
      "text": "可您把生肉片丢进去，",
      "token_start": 726,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 199710,
      "end_ms": 201445,
      "text": "几秒钟就烫手了。",
      "token_start": 735,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 201950,
      "end_ms": 205215,
      "text": "米线是细圆粉滑溜溜的，",
      "token_start": 742,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 206200,
      "end_ms": 207400,
      "text": "从汤里捞起来，",
      "token_start": 752,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 207400,
      "end_ms": 208695,
      "text": "裹着一层浓汤，",
      "token_start": 758,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 209110,
      "end_ms": 210890,
      "text": "连汤带粉吸进嘴里，",
      "token_start": 764,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 211110,
      "end_ms": 212795,
      "text": "鲜到眉毛都跟着动。",
      "token_start": 772,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 213470,
      "end_ms": 218535,
      "text": "同样一碗过桥米线在猛自吃和在外面城市吃，",
      "token_start": 780,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 219310,
      "end_ms": 220930,
      "text": "价格能差出两三倍，",
      "token_start": 799,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 221010,
      "end_ms": 222330,
      "text": "味道更是差。",
      "token_start": 807,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 222330,
      "end_ms": 224990,
      "text": "出十条街蒙自的冬天，",
      "token_start": 812,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 225030,
      "end_ms": 226895,
      "text": "白天太阳出来暖洋洋的，",
      "token_start": 821,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 227340,
      "end_ms": 228925,
      "text": "穿件薄毛衣就行，",
      "token_start": 831,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 229440,
      "end_ms": 230440,
      "text": "早晚凉一点。",
      "token_start": 838,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 230440,
      "end_ms": 231265,
      "text": "加件外套。",
      "token_start": 843,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 232020,
      "end_ms": 234890,
      "text": "蒙自城边有个南湖湖不大，",
      "token_start": 847,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 234930,
      "end_ms": 236045,
      "text": "但水很清。",
      "token_start": 858,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 236540,
      "end_ms": 237020,
      "text": "冬天，",
      "token_start": 862,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 237040,
      "end_ms": 238785,
      "text": "湖边的柳树还是绿的，",
      "token_start": 864,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 239420,
      "end_ms": 241860,
      "text": "当地人早上在湖边打太极，",
      "token_start": 873,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 242260,
      "end_ms": 243485,
      "text": "遛鸟下棋，",
      "token_start": 884,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 244190,
      "end_ms": 245510,
      "text": "您端一碗米线，",
      "token_start": 888,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 245650,
      "end_ms": 247175,
      "text": "坐在湖边的石凳上，",
      "token_start": 894,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 247620,
      "end_ms": 249265,
      "text": "一边吃一边晒太阳，",
      "token_start": 902,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 249930,
      "end_ms": 251770,
      "text": "吃完了沿着湖走一圈，",
      "token_start": 910,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 251790,
      "end_ms": 252585,
      "text": "消消食。",
      "token_start": 919,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 253130,
      "end_ms": 256680,
      "text": "猛自的物价比上一集讲的建水还低一点，",
      "token_start": 922,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 256780,
      "end_ms": 257760,
      "text": "租房便宜，",
      "token_start": 939,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 257860,
      "end_ms": 258995,
      "text": "吃饭更便宜。",
      "token_start": 943,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 259330,
      "end_ms": 260410,
      "text": "早上一碗米线，",
      "token_start": 948,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 260410,
      "end_ms": 261490,
      "text": "中午一碗卷粉，",
      "token_start": 954,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 261530,
      "end_ms": 263990,
      "text": "晚上一碗凉米线三顿下来，",
      "token_start": 960,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 263990,
      "end_ms": 265045,
      "text": "花不了多少钱，",
      "token_start": 971,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 265790,
      "end_ms": 266795,
      "text": "房租不贵，",
      "token_start": 977,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 267220,
      "end_ms": 268405,
      "text": "米线正宗。",
      "token_start": 981,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 268970,
      "end_ms": 270590,
      "text": "全中国只有这个地方，",
      "token_start": 985,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 270610,
      "end_ms": 273065,
      "text": "吃的是最地道的过桥米线，",
      "token_start": 994,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 273590,
      "end_ms": 274570,
      "text": "猛自过冬，",
      "token_start": 1005,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 274870,
      "end_ms": 276415,
      "text": "冲这碗米线就值了。",
      "token_start": 1009,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 276670,
      "end_ms": 278060,
      "text": "我第八名，",
      "token_start": 1017,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 278320,
      "end_ms": 282815,
      "text": "广西、防城港、防城港在广西的最南边，",
      "token_start": 1021,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 283490,
      "end_ms": 286335,
      "text": "面朝北部湾跟北海是邻居，",
      "token_start": 1036,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 286980,
      "end_ms": 289495,
      "text": "可名气只有北海的十分之一。",
      "token_start": 1047,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 289910,
      "end_ms": 292570,
      "text": "防城港的冬天跟北海体感差不多，",
      "token_start": 1059,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 292670,
      "end_ms": 294495,
      "text": "穿件薄外套就行，",
      "token_start": 1073,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 295290,
      "end_ms": 297930,
      "text": "可防城港比北海多了一样东西。",
      "token_start": 1080,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 297930,
      "end_ms": 298415,
      "text": "赶海。",
      "token_start": 1093,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 299230,
      "end_ms": 300345,
      "text": "什么叫赶海呢？",
      "token_start": 1095,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 300670,
      "end_ms": 303065,
      "text": "就是退潮的时候海水退下去。",
      "token_start": 1101,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 303570,
      "end_ms": 305850,
      "text": "礁石和沙滩露出来，",
      "token_start": 1113,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 306250,
      "end_ms": 308730,
      "text": "藏在里面的海鲜全暴露。",
      "token_start": 1121,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 309710,
      "end_ms": 318170,
      "text": "螃蟹、海螺、生蚝、沙虫、海胆卷起裤腿拎个桶下去捡就行了。",
      "token_start": 1131,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 318910,
      "end_ms": 322730,
      "text": "防城港的海岸线长礁石多，",
      "token_start": 1154,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 323630,
      "end_ms": 332210,
      "text": "冬天正好是大潮期退潮退的远漏出来的滩涂大能捡的东西多一个下午，",
      "token_start": 1165,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 332210,
      "end_ms": 334560,
      "text": "弯着腰在滩滩土上翻石头，",
      "token_start": 1195,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 334560,
      "end_ms": 338080,
      "text": "挖沙虫桶装满了回去洗干净直接下锅。",
      "token_start": 1206,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 338380,
      "end_ms": 339040,
      "text": "您想想，",
      "token_start": 1222,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 339240,
      "end_ms": 341320,
      "text": "自己从海里捡回来的海鲜，",
      "token_start": 1225,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 341499,
      "end_ms": 343980,
      "text": "不花一分钱拿回去煮着吃，",
      "token_start": 1236,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 343980,
      "end_ms": 344520,
      "text": "蒸着吃，",
      "token_start": 1247,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 344520,
      "end_ms": 345100,
      "text": "炒着吃。",
      "token_start": 1250,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 345540,
      "end_ms": 348280,
      "text": "那个鲜味跟市场买的不是一回事。",
      "token_start": 1253,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 349180,
      "end_ms": 352180,
      "text": "防城港还有一点别的海边城市少见，",
      "token_start": 1267,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 352180,
      "end_ms": 353500,
      "text": "它是边境城市，",
      "token_start": 1282,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 354360,
      "end_ms": 356440,
      "text": "城里有一条边贸街，",
      "token_start": 1288,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 357360,
      "end_ms": 361420,
      "text": "越南的零食咖啡水果便宜的很，",
      "token_start": 1296,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 361860,
      "end_ms": 363155,
      "text": "日常物价也低，",
      "token_start": 1309,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 363650,
      "end_ms": 365505,
      "text": "租房比北海便宜，",
      "token_start": 1315,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 365930,
      "end_ms": 369350,
      "text": "菜市场的海鲜价格也比北海低一截，",
      "token_start": 1322,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 369450,
      "end_ms": 370350,
      "text": "房租不贵，",
      "token_start": 1337,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 370550,
      "end_ms": 371610,
      "text": "赶海不花钱，",
      "token_start": 1341,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 371870,
      "end_ms": 373295,
      "text": "越南水果当零嘴。",
      "token_start": 1346,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 374110,
      "end_ms": 377090,
      "text": "防城港过冬过的是一种赶海的乐趣，",
      "token_start": 1353,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 377090,
      "end_ms": 378145,
      "text": "不是去买海鲜，",
      "token_start": 1368,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 378370,
      "end_ms": 381240,
      "text": "是自己去捡第七名。",
      "token_start": 1374,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 381580,
      "end_ms": 385935,
      "text": "四川西昌又是四川上一集讲了攀枝花，",
      "token_start": 1382,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 386330,
      "end_ms": 389705,
      "text": "好多朋友说没想到四川还有冬天不冷的地方。",
      "token_start": 1398,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 390460,
      "end_ms": 394375,
      "text": "其实四川南边还藏着一个就是西昌，",
      "token_start": 1417,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 395160,
      "end_ms": 396675,
      "text": "西昌在凉山州，",
      "token_start": 1432,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 397220,
      "end_ms": 398675,
      "text": "当地人叫他越城，",
      "token_start": 1438,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 399140,
      "end_ms": 400585,
      "text": "也有人叫太阳城，",
      "token_start": 1445,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 400920,
      "end_ms": 401585,
      "text": "为什么呢？",
      "token_start": 1452,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 401910,
      "end_ms": 405190,
      "text": "因为西昌一年到头大部分日子都是晴天，",
      "token_start": 1456,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 405270,
      "end_ms": 406715,
      "text": "冬天也不例外。",
      "token_start": 1473,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 407660,
      "end_ms": 410435,
      "text": "别的地方冬天阴沉沉的看不见太阳。",
      "token_start": 1479,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 411010,
      "end_ms": 412495,
      "text": "西昌的天是蓝的，",
      "token_start": 1494,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 412960,
      "end_ms": 413975,
      "text": "太阳是暖的，",
      "token_start": 1501,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 414750,
      "end_ms": 416715,
      "text": "走在街上身上热乎乎的。",
      "token_start": 1506,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 417630,
      "end_ms": 420885,
      "text": "西昌冬天的体感跟攀枝花差不多，",
      "token_start": 1516,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 421430,
      "end_ms": 424095,
      "text": "穿件薄外套晒着太阳刚刚好，",
      "token_start": 1530,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 424550,
      "end_ms": 426930,
      "text": "可西昌比攀枝花多了一样东西。",
      "token_start": 1542,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 426950,
      "end_ms": 430935,
      "text": "白死海翟四海是四川数得着的大湖，",
      "token_start": 1555,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 431530,
      "end_ms": 433125,
      "text": "就在西昌城边上，",
      "token_start": 1570,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 433410,
      "end_ms": 434415,
      "text": "走路就能到。",
      "token_start": 1577,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 434880,
      "end_ms": 437825,
      "text": "冬天的白黑海水面开阔，",
      "token_start": 1582,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 438520,
      "end_ms": 439405,
      "text": "对岸是山，",
      "token_start": 1592,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 440180,
      "end_ms": 442325,
      "text": "山上偶尔飘着一点雾，",
      "token_start": 1596,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 443260,
      "end_ms": 446480,
      "text": "湖边修了一条环湖步道，",
      "token_start": 1605,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 446620,
      "end_ms": 448045,
      "text": "全长几十公里，",
      "token_start": 1615,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 448320,
      "end_ms": 449605,
      "text": "您不用全走完，",
      "token_start": 1621,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 450060,
      "end_ms": 450780,
      "text": "挑一段，",
      "token_start": 1627,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 450980,
      "end_ms": 453025,
      "text": "沿着湖边慢慢溜达，",
      "token_start": 1630,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 453920,
      "end_ms": 454880,
      "text": "左边是湖，",
      "token_start": 1638,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 454980,
      "end_ms": 456125,
      "text": "右边是湿地。",
      "token_start": 1642,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 456990,
      "end_ms": 458410,
      "text": "冬天的湿地里，",
      "token_start": 1647,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 458490,
      "end_ms": 462980,
      "text": "有从北方飞来过冬的候鸟白鹭、海鸥，",
      "token_start": 1653,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 463200,
      "end_ms": 466640,
      "text": "一群一群的在水面上飞西昌。",
      "token_start": 1668,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 466640,
      "end_ms": 467600,
      "text": "还有一个好处，",
      "token_start": 1680,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 467700,
      "end_ms": 468775,
      "text": "火盆烧烤，",
      "token_start": 1686,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 469630,
      "end_ms": 472085,
      "text": "西昌的烧烤在四川是出了名的，",
      "token_start": 1690,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 472710,
      "end_ms": 474975,
      "text": "用一个铁盆装着炭火，",
      "token_start": 1703,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 475430,
      "end_ms": 478775,
      "text": "上面架一张铁网、烤小猪肉，",
      "token_start": 1712,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 479370,
      "end_ms": 480255,
      "text": "考洋芋，",
      "token_start": 1723,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 480820,
      "end_ms": 481945,
      "text": "靠包浆豆腐，",
      "token_start": 1726,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 482640,
      "end_ms": 484255,
      "text": "蘸着当地的辣椒面吃。",
      "token_start": 1731,
      "token_end_exclusive": 1740
    },
    {
      "start_ms": 485310,
      "end_ms": 486390,
      "text": "冬天的晚上，",
      "token_start": 1740,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 486590,
      "end_ms": 488570,
      "text": "坐在街边的烧烤摊上，",
      "token_start": 1745,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 488650,
      "end_ms": 489775,
      "text": "炭火烤着脸，",
      "token_start": 1754,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 490190,
      "end_ms": 491945,
      "text": "手里拿着一串小猪肉，",
      "token_start": 1759,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 492380,
      "end_ms": 494060,
      "text": "旁边的人操着四川话，",
      "token_start": 1768,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 494120,
      "end_ms": 495905,
      "text": "幺五喝六热闹的很，",
      "token_start": 1777,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 496290,
      "end_ms": 497335,
      "text": "租房也不贵，",
      "token_start": 1785,
      "token_end_exclusive": 1790
    },
    {
      "start_ms": 497990,
      "end_ms": 500030,
      "text": "跟攀枝花差不多的价钱。",
      "token_start": 1790,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 500230,
      "end_ms": 501850,
      "text": "白天湖边晒太阳，",
      "token_start": 1800,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 501890,
      "end_ms": 502565,
      "text": "看候鸟，",
      "token_start": 1807,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 503010,
      "end_ms": 504395,
      "text": "晚上吃火盆烧烤。",
      "token_start": 1810,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 505720,
      "end_ms": 508245,
      "text": "上一季的攀枝花赢在水果，",
      "token_start": 1817,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 508910,
      "end_ms": 513085,
      "text": "这一季的西昌赢在那个湖第六名，",
      "token_start": 1828,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 514780,
      "end_ms": 516700,
      "text": "贵州兴义嗯嗯，",
      "token_start": 1842,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 517970,
      "end_ms": 524400,
      "text": "兴义在贵州的西南角属于黔西南州这个城市，",
      "token_start": 1848,
      "token_end_exclusive": 1867
    },
    {
      "start_ms": 524400,
      "end_ms": 526140,
      "text": "很多人没来过也没听过，",
      "token_start": 1867,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 526560,
      "end_ms": 530720,
      "text": "可它藏着一个在中国都排得上号的风景。",
      "token_start": 1877,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 530740,
      "end_ms": 531525,
      "text": "万枫林，",
      "token_start": 1894,
      "token_end_exclusive": 1897
    },
    {
      "start_ms": 531770,
      "end_ms": 533175,
      "text": "什么叫万峰林呢？",
      "token_start": 1897,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 533490,
      "end_ms": 535955,
      "text": "就是山峰密密麻麻多到数不过来，",
      "token_start": 1904,
      "token_end_exclusive": 1918
    },
    {
      "start_ms": 536350,
      "end_ms": 537150,
      "text": "一座挨着，",
      "token_start": 1918,
      "token_end_exclusive": 1922
    },
    {
      "start_ms": 537150,
      "end_ms": 538255,
      "text": "一座排在那里。",
      "token_start": 1922,
      "token_end_exclusive": 1928
    },
    {
      "start_ms": 539170,
      "end_ms": 540890,
      "text": "这些山是喀斯特地貌，",
      "token_start": 1928,
      "token_end_exclusive": 1937
    },
    {
      "start_ms": 541230,
      "end_ms": 542550,
      "text": "每一座都不高，",
      "token_start": 1937,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 542570,
      "end_ms": 543995,
      "text": "但形状各异，",
      "token_start": 1943,
      "token_end_exclusive": 1948
    },
    {
      "start_ms": 544360,
      "end_ms": 545160,
      "text": "像馒头，",
      "token_start": 1948,
      "token_end_exclusive": 1951
    },
    {
      "start_ms": 545480,
      "end_ms": 546280,
      "text": "像宝塔，",
      "token_start": 1951,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 546580,
      "end_ms": 547455,
      "text": "像笔尖，",
      "token_start": 1954,
      "token_end_exclusive": 1957
    },
    {
      "start_ms": 547940,
      "end_ms": 549300,
      "text": "一直排到天边，",
      "token_start": 1957,
      "token_end_exclusive": 1963
    },
    {
      "start_ms": 549380,
      "end_ms": 550265,
      "text": "看不到头。",
      "token_start": 1963,
      "token_end_exclusive": 1967
    },
    {
      "start_ms": 550760,
      "end_ms": 554300,
      "text": "山下面是一片一片的田田，",
      "token_start": 1967,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 554300,
      "end_ms": 556285,
      "text": "里面有弯弯曲曲的河，",
      "token_start": 1978,
      "token_end_exclusive": 1987
    },
    {
      "start_ms": 556730,
      "end_ms": 557935,
      "text": "河边有村庄，",
      "token_start": 1987,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 558720,
      "end_ms": 559160,
      "text": "冬天，",
      "token_start": 1992,
      "token_end_exclusive": 1994
    },
    {
      "start_ms": 559160,
      "end_ms": 561585,
      "text": "稻子收完了田是空的。",
      "token_start": 1994,
      "token_end_exclusive": 2003
    },
    {
      "start_ms": 561840,
      "end_ms": 563460,
      "text": "山是清的雾，",
      "token_start": 2003,
      "token_end_exclusive": 2008
    },
    {
      "start_ms": 563520,
      "end_ms": 565520,
      "text": "从山脚底下慢慢往上爬，",
      "token_start": 2008,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 565900,
      "end_ms": 568185,
      "text": "整个画面像一幅水墨，",
      "token_start": 2018,
      "token_end_exclusive": 2027
    },
    {
      "start_ms": 568830,
      "end_ms": 570290,
      "text": "您在兴义租个房子，",
      "token_start": 2027,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 570290,
      "end_ms": 571470,
      "text": "推开窗户往外看，",
      "token_start": 2035,
      "token_end_exclusive": 2042
    },
    {
      "start_ms": 571470,
      "end_ms": 573350,
      "text": "满眼全是山峰排在眼前。",
      "token_start": 2042,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 573550,
      "end_ms": 577015,
      "text": "这种待遇在别的城市花多少钱都买不来。",
      "token_start": 2052,
      "token_end_exclusive": 2069
    },
    {
      "start_ms": 577870,
      "end_ms": 581125,
      "text": "兴义冬天比前面几个城市凉一点，",
      "token_start": 2069,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 581500,
      "end_ms": 582440,
      "text": "可他是干冷，",
      "token_start": 2083,
      "token_end_exclusive": 2088
    },
    {
      "start_ms": 582440,
      "end_ms": 583255,
      "text": "不是湿冷，",
      "token_start": 2088,
      "token_end_exclusive": 2092
    },
    {
      "start_ms": 584020,
      "end_ms": 585555,
      "text": "太阳一出来就暖了，",
      "token_start": 2092,
      "token_end_exclusive": 2100
    },
    {
      "start_ms": 586200,
      "end_ms": 588475,
      "text": "而且新意的空气特别干净，",
      "token_start": 2100,
      "token_end_exclusive": 2111
    },
    {
      "start_ms": 588930,
      "end_ms": 589690,
      "text": "吸一口气，",
      "token_start": 2111,
      "token_end_exclusive": 2115
    },
    {
      "start_ms": 589710,
      "end_ms": 593445,
      "text": "清清爽爽的跟城市里的空气完全不是一回事。",
      "token_start": 2115,
      "token_end_exclusive": 2134
    },
    {
      "start_ms": 594290,
      "end_ms": 599060,
      "text": "兴义的物价是这十个城市里最低一档租房便宜，",
      "token_start": 2134,
      "token_end_exclusive": 2154
    },
    {
      "start_ms": 599260,
      "end_ms": 600515,
      "text": "吃饭更便宜。",
      "token_start": 2154,
      "token_end_exclusive": 2159
    },
    {
      "start_ms": 601010,
      "end_ms": 602745,
      "text": "当地有一种羊肉粉，",
      "token_start": 2159,
      "token_end_exclusive": 2167
    },
    {
      "start_ms": 603180,
      "end_ms": 605200,
      "text": "冬天早上来一碗汤，",
      "token_start": 2167,
      "token_end_exclusive": 2175
    },
    {
      "start_ms": 605340,
      "end_ms": 606875,
      "text": "是羊骨头熬的。",
      "token_start": 2175,
      "token_end_exclusive": 2181
    },
    {
      "start_ms": 607330,
      "end_ms": 609110,
      "text": "粉是手工切的宽粉，",
      "token_start": 2181,
      "token_end_exclusive": 2189
    },
    {
      "start_ms": 609230,
      "end_ms": 610970,
      "text": "上面盖着大片的羊肉，",
      "token_start": 2189,
      "token_end_exclusive": 2198
    },
    {
      "start_ms": 611390,
      "end_ms": 612350,
      "text": "撒一把葱花，",
      "token_start": 2198,
      "token_end_exclusive": 2203
    },
    {
      "start_ms": 612370,
      "end_ms": 613430,
      "text": "浇一勺辣椒油，",
      "token_start": 2203,
      "token_end_exclusive": 2209
    },
    {
      "start_ms": 613910,
      "end_ms": 615090,
      "text": "热乎乎的下肚，",
      "token_start": 2209,
      "token_end_exclusive": 2215
    },
    {
      "start_ms": 615430,
      "end_ms": 618270,
      "text": "整个人从胃暖到脚底板，",
      "token_start": 2215,
      "token_end_exclusive": 2225
    },
    {
      "start_ms": 619150,
      "end_ms": 620190,
      "text": "花不了多少钱，",
      "token_start": 2225,
      "token_end_exclusive": 2231
    },
    {
      "start_ms": 620510,
      "end_ms": 622150,
      "text": "管一上午的饱和，",
      "token_start": 2231,
      "token_end_exclusive": 2238
    },
    {
      "start_ms": 622150,
      "end_ms": 623950,
      "text": "暖房租便宜，",
      "token_start": 2238,
      "token_end_exclusive": 2243
    },
    {
      "start_ms": 624210,
      "end_ms": 625210,
      "text": "羊肉粉管饱。",
      "token_start": 2243,
      "token_end_exclusive": 2248
    },
    {
      "start_ms": 625210,
      "end_ms": 627070,
      "text": "又管暖推开窗户，",
      "token_start": 2248,
      "token_end_exclusive": 2255
    },
    {
      "start_ms": 627090,
      "end_ms": 627850,
      "text": "满眼是山，",
      "token_start": 2255,
      "token_end_exclusive": 2259
    },
    {
      "start_ms": 628630,
      "end_ms": 629750,
      "text": "兴意排第六。",
      "token_start": 2259,
      "token_end_exclusive": 2264
    },
    {
      "start_ms": 630550,
      "end_ms": 630950,
      "text": "不是，",
      "token_start": 2264,
      "token_end_exclusive": 2266
    },
    {
      "start_ms": 630950,
      "end_ms": 631490,
      "text": "它不够，",
      "token_start": 2266,
      "token_end_exclusive": 2269
    },
    {
      "start_ms": 631490,
      "end_ms": 634610,
      "text": "好是前面五个各有各的绝活。",
      "token_start": 2269,
      "token_end_exclusive": 2281
    },
    {
      "start_ms": 635610,
      "end_ms": 639000,
      "text": "先在评论区打出四个字过冬，",
      "token_start": 2281,
      "token_end_exclusive": 2293
    },
    {
      "start_ms": 639040,
      "end_ms": 640160,
      "text": "秘境打完了，",
      "token_start": 2293,
      "token_end_exclusive": 2298
    },
    {
      "start_ms": 640160,
      "end_ms": 641580,
      "text": "咱们接着讲前五名，",
      "token_start": 2298,
      "token_end_exclusive": 2306
    },
    {
      "start_ms": 641900,
      "end_ms": 644340,
      "text": "一个比一个让人想直接订票。",
      "token_start": 2306,
      "token_end_exclusive": 2318
    },
    {
      "start_ms": 645300,
      "end_ms": 647020,
      "text": "今天讲的这五个城市，",
      "token_start": 2318,
      "token_end_exclusive": 2327
    },
    {
      "start_ms": 647020,
      "end_ms": 650380,
      "text": "您品品湛江的碳烤生蚝便宜到不敢信。",
      "token_start": 2327,
      "token_end_exclusive": 2343
    },
    {
      "start_ms": 650860,
      "end_ms": 652420,
      "text": "蒙自的过桥米线，",
      "token_start": 2343,
      "token_end_exclusive": 2350
    },
    {
      "start_ms": 652500,
      "end_ms": 655960,
      "text": "正宗到别处没法比防城港退潮了，",
      "token_start": 2350,
      "token_end_exclusive": 2364
    },
    {
      "start_ms": 655960,
      "end_ms": 657680,
      "text": "自己去捡不花钱的海鲜。",
      "token_start": 2364,
      "token_end_exclusive": 2374
    },
    {
      "start_ms": 658360,
      "end_ms": 659900,
      "text": "西昌湖边晒太阳，",
      "token_start": 2374,
      "token_end_exclusive": 2381
    },
    {
      "start_ms": 659900,
      "end_ms": 662140,
      "text": "看候鸟轻易推开窗户，",
      "token_start": 2381,
      "token_end_exclusive": 2390
    },
    {
      "start_ms": 662140,
      "end_ms": 663060,
      "text": "满眼全是山。",
      "token_start": 2390,
      "token_end_exclusive": 2395
    },
    {
      "start_ms": 663720,
      "end_ms": 666985,
      "text": "可这五个加一块都比不过前五。",
      "token_start": 2395,
      "token_end_exclusive": 2408
    },
    {
      "start_ms": 667110,
      "end_ms": 670055,
      "text": "武鸣里的那个小城跟三亚共用一片海，",
      "token_start": 2408,
      "token_end_exclusive": 2424
    },
    {
      "start_ms": 670950,
      "end_ms": 673595,
      "text": "房租比三亚便宜太多了。",
      "token_start": 2424,
      "token_end_exclusive": 2434
    },
    {
      "start_ms": 674030,
      "end_ms": 676325,
      "text": "冬天的海滩上愣是看不见几个人，",
      "token_start": 2434,
      "token_end_exclusive": 2448
    },
    {
      "start_ms": 677190,
      "end_ms": 679395,
      "text": "前五名里还有一个客家古城，",
      "token_start": 2448,
      "token_end_exclusive": 2460
    },
    {
      "start_ms": 680200,
      "end_ms": 682200,
      "text": "光早餐就能换着花样吃，",
      "token_start": 2460,
      "token_end_exclusive": 2470
    },
    {
      "start_ms": 682200,
      "end_ms": 683160,
      "text": "一个月不重样。",
      "token_start": 2470,
      "token_end_exclusive": 2476
    },
    {
      "start_ms": 683180,
      "end_ms": 683940,
      "text": "有一个地方。",
      "token_start": 2476,
      "token_end_exclusive": 2481
    },
    {
      "start_ms": 683940,
      "end_ms": 685845,
      "text": "冬天的海滩整片都是你的，",
      "token_start": 2481,
      "token_end_exclusive": 2492
    },
    {
      "start_ms": 686350,
      "end_ms": 688255,
      "text": "夏天花钱都挤不进去，",
      "token_start": 2492,
      "token_end_exclusive": 2501
    },
    {
      "start_ms": 689020,
      "end_ms": 692975,
      "text": "还有一座茶城坐下来能喝一下午的古树茶，",
      "token_start": 2501,
      "token_end_exclusive": 2519
    },
    {
      "start_ms": 693930,
      "end_ms": 697060,
      "text": "下一集已经同步更新点，",
      "token_start": 2519,
      "token_end_exclusive": 2529
    },
    {
      "start_ms": 697060,
      "end_ms": 698040,
      "text": "我头像进主页，",
      "token_start": 2529,
      "token_end_exclusive": 2535
    },
    {
      "start_ms": 698040,
      "end_ms": 701725,
      "text": "第一条就是咱们接着接前五名。",
      "token_start": 2535,
      "token_end_exclusive": 2548
    }
  ],
