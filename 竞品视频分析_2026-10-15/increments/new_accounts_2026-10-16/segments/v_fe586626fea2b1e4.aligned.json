{
  "video_id": "v_fe586626fea2b1e4",
  "duration_s": 377.278005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_fe586626fea2b1e4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_fe586626fea2b1e4.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 3210,
      "text": "您知道我国最动人的十大秋水秘境在哪吗？",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4110,
      "end_ms": 5710,
      "text": "有人提名九寨沟，",
      "token_start": 18,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6370,
      "end_ms": 8290,
      "text": "有人想到抚仙湖，",
      "token_start": 25,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9150,
      "end_ms": 10830,
      "text": "对不住抚仙湖，",
      "token_start": 32,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10830,
      "end_ms": 12890,
      "text": "这类寻常环湖湖泊，",
      "token_start": 38,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12950,
      "end_ms": 17330,
      "text": "排不进前五就连九寨沟也不是榜首。",
      "token_start": 46,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 18050,
      "end_ms": 20190,
      "text": "真正排在榜首的那一处。",
      "token_start": 61,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 20850,
      "end_ms": 22050,
      "text": "雪山环抱，",
      "token_start": 71,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 22270,
      "end_ms": 22770,
      "text": "白桦，",
      "token_start": 75,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 22870,
      "end_ms": 26550,
      "text": "环湖一汪湖水随光影变幻，",
      "token_start": 77,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 26550,
      "end_ms": 31060,
      "text": "蓝绿一年只有十几天的黄山黄金秋色。",
      "token_start": 88,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 31540,
      "end_ms": 33460,
      "text": "晨雾漫过水面的时候，",
      "token_start": 104,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 33860,
      "end_ms": 37280,
      "text": "您说这是不是秋天留给人间的一汪温柔？",
      "token_start": 113,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 37420,
      "end_ms": 37820,
      "text": "今天，",
      "token_start": 130,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 37980,
      "end_ms": 41240,
      "text": "咱们就来盘点中国十大秋水秘境，",
      "token_start": 132,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 42120,
      "end_ms": 45900,
      "text": "倒着数从第十名一路讲到第一名。",
      "token_start": 146,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 46800,
      "end_ms": 49320,
      "text": "老规矩开讲前，",
      "token_start": 160,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 49340,
      "end_ms": 52240,
      "text": "劳烦各位老友顺手点亮红心。",
      "token_start": 166,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 52700,
      "end_ms": 59225,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场。",
      "token_start": 178,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 60080,
      "end_ms": 60780,
      "text": "第十名，",
      "token_start": 200,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 61020,
      "end_ms": 62020,
      "text": "江西庐山，",
      "token_start": 203,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 62160,
      "end_ms": 62840,
      "text": "如情湖，",
      "token_start": 207,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 63140,
      "end_ms": 64075,
      "text": "您没听错，",
      "token_start": 210,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 64770,
      "end_ms": 67805,
      "text": "如情湖放在第十庐山，",
      "token_start": 214,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 68140,
      "end_ms": 74165,
      "text": "韩铁岭镇上的一汪平湖形状像一把握在山间的古琴。",
      "token_start": 223,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 74940,
      "end_ms": 75935,
      "text": "每到十月，",
      "token_start": 245,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 76710,
      "end_ms": 80434,
      "text": "环湖的枫树乌气慢慢染成红黄色，",
      "token_start": 249,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 81130,
      "end_ms": 83235,
      "text": "环湖步道平缓好走，",
      "token_start": 263,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 83690,
      "end_ms": 84815,
      "text": "不用爬陡坡，",
      "token_start": 271,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 85130,
      "end_ms": 86745,
      "text": "慢慢散步很舒心。",
      "token_start": 276,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 87670,
      "end_ms": 88450,
      "text": "可您知道，",
      "token_start": 283,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 88570,
      "end_ms": 91085,
      "text": "如情湖为什么只排第十吗？",
      "token_start": 287,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 92030,
      "end_ms": 92805,
      "text": "名气大，",
      "token_start": 298,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 93290,
      "end_ms": 94035,
      "text": "游客多，",
      "token_start": 301,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 94580,
      "end_ms": 97155,
      "text": "湖边想安安静静待一会儿，",
      "token_start": 304,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 97410,
      "end_ms": 99035,
      "text": "耳边常常人声不断。",
      "token_start": 315,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 99910,
      "end_ms": 100890,
      "text": "但话说回来，",
      "token_start": 323,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 101050,
      "end_ms": 104665,
      "text": "如情湖是很多人初识秋水的地方，",
      "token_start": 328,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 105190,
      "end_ms": 108535,
      "text": "多少人第一次看见彩灵映在湖面，",
      "token_start": 342,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 109030,
      "end_ms": 109795,
      "text": "就是在这里，",
      "token_start": 356,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 112470,
      "end_ms": 115205,
      "text": "您说这算不算秋水秘境的第一课？",
      "token_start": 361,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 116160,
      "end_ms": 117600,
      "text": "如琴湖排第十，",
      "token_start": 375,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 117620,
      "end_ms": 118785,
      "text": "不是湖水不美，",
      "token_start": 381,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 119030,
      "end_ms": 123445,
      "text": "是离我们太近近到常常忽略湖山相伴的清净。",
      "token_start": 387,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 124020,
      "end_ms": 124700,
      "text": "第九名。",
      "token_start": 406,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 124960,
      "end_ms": 129090,
      "text": "辽宁还龙湖还龙湖藏在辽宁还人，",
      "token_start": 409,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 129090,
      "end_ms": 131945,
      "text": "舞女山脚下魂将汇聚而成。",
      "token_start": 423,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 132390,
      "end_ms": 134295,
      "text": "湖面蜿蜒曲折，",
      "token_start": 434,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 134710,
      "end_ms": 135450,
      "text": "秋天一到，",
      "token_start": 440,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 135790,
      "end_ms": 138315,
      "text": "沿岸枫林一层层变红，",
      "token_start": 444,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 138940,
      "end_ms": 141355,
      "text": "倒影沉在碧绿的湖水里面，",
      "token_start": 453,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 141730,
      "end_ms": 147445,
      "text": "可以坐船行在湖上看两岸层林铺展江风缓缓吹过来。",
      "token_start": 464,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 148400,
      "end_ms": 152725,
      "text": "他没有高山海子那种经验的蓝胜在开阔舒展，",
      "token_start": 486,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 154340,
      "end_ms": 155355,
      "text": "江水绵长。",
      "token_start": 505,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 157040,
      "end_ms": 158000,
      "text": "最佳观赏期。",
      "token_start": 509,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 158000,
      "end_ms": 159460,
      "text": "九月底到十月中旬，",
      "token_start": 514,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 159560,
      "end_ms": 161205,
      "text": "北方的秋意来的干脆，",
      "token_start": 522,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 161850,
      "end_ms": 163800,
      "text": "红叶碧水，",
      "token_start": 531,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 164460,
      "end_ms": 165040,
      "text": "远山，",
      "token_start": 535,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 165140,
      "end_ms": 167465,
      "text": "简简单单大气耐看。",
      "token_start": 537,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 168410,
      "end_ms": 169155,
      "text": "第八名，",
      "token_start": 545,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 170620,
      "end_ms": 172745,
      "text": "贵州荔波小七孔卧龙潭，",
      "token_start": 548,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 175750,
      "end_ms": 178295,
      "text": "卧龙潭藏在小七孔峡谷深处，",
      "token_start": 558,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 178800,
      "end_ms": 184240,
      "text": "一潭翡翠色的净水上游有细铺青落秋来，",
      "token_start": 570,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 184240,
      "end_ms": 186405,
      "text": "两岸林木深浅交错，",
      "token_start": 587,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 186930,
      "end_ms": 188535,
      "text": "树叶有绿有黄。",
      "token_start": 595,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 189170,
      "end_ms": 194050,
      "text": "潭水常年保持温润的蓝绿色潭面，",
      "token_start": 601,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 194050,
      "end_ms": 196350,
      "text": "很静风不大的时候，",
      "token_start": 615,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 196610,
      "end_ms": 201315,
      "text": "像一面打磨光滑的玉镜和汹涌的瀑布不一样，",
      "token_start": 623,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 201850,
      "end_ms": 204170,
      "text": "卧龙潭的秋水是内敛的，",
      "token_start": 642,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 204230,
      "end_ms": 206195,
      "text": "藏在山谷里不张扬。",
      "token_start": 652,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 207010,
      "end_ms": 209675,
      "text": "沿着潭边木栈道慢行，",
      "token_start": 660,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 210560,
      "end_ms": 211455,
      "text": "听水声，",
      "token_start": 669,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 211810,
      "end_ms": 212665,
      "text": "看水色，",
      "token_start": 672,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 213270,
      "end_ms": 214830,
      "text": "适合慢慢静下心来，",
      "token_start": 675,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 215010,
      "end_ms": 217975,
      "text": "感受山水第七名。",
      "token_start": 683,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 219100,
      "end_ms": 225875,
      "text": "云南抚仙湖抚香湖在云南玉溪是国内深水大湖，",
      "token_start": 690,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 226520,
      "end_ms": 227380,
      "text": "湖水透亮，",
      "token_start": 710,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 227420,
      "end_ms": 227985,
      "text": "清澈，",
      "token_start": 714,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 228440,
      "end_ms": 229600,
      "text": "晴天的时候，",
      "token_start": 716,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 229860,
      "end_ms": 233945,
      "text": "由岸边的浅绿慢慢过渡到湖心的深蓝。",
      "token_start": 721,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 234780,
      "end_ms": 236910,
      "text": "秋天云南不冷环湖，",
      "token_start": 737,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 236930,
      "end_ms": 238190,
      "text": "时光占道平坦，",
      "token_start": 745,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 238230,
      "end_ms": 238735,
      "text": "绵长，",
      "token_start": 751,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 239260,
      "end_ms": 239920,
      "text": "走累了，",
      "token_start": 753,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 239920,
      "end_ms": 242965,
      "text": "随时能坐下看落日扑在水面。",
      "token_start": 756,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 243410,
      "end_ms": 244350,
      "text": "他没有彩铃，",
      "token_start": 768,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 244390,
      "end_ms": 247675,
      "text": "紧紧环抱胜在湖水本身的通透。",
      "token_start": 773,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 248490,
      "end_ms": 250335,
      "text": "别处秋水看倒影，",
      "token_start": 786,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 250910,
      "end_ms": 252975,
      "text": "抚仙湖看的是水的本色，",
      "token_start": 793,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 253860,
      "end_ms": 255315,
      "text": "天光落在湖面，",
      "token_start": 803,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 255930,
      "end_ms": 257310,
      "text": "干净的能洗去，",
      "token_start": 809,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 257330,
      "end_ms": 258245,
      "text": "心头浮躁。",
      "token_start": 815,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 258530,
      "end_ms": 260105,
      "text": "我们会第六名。",
      "token_start": 819,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 261000,
      "end_ms": 265685,
      "text": "甘肃闻县天池闻县天池藏在陇南深山，",
      "token_start": 825,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 266100,
      "end_ms": 268045,
      "text": "被叫做陇上小九寨。",
      "token_start": 841,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 268720,
      "end_ms": 270855,
      "text": "群山围成天然的湖盆，",
      "token_start": 849,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 271350,
      "end_ms": 274050,
      "text": "湖水晴蓝阴没变换，",
      "token_start": 858,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 274110,
      "end_ms": 275110,
      "text": "不一样的色调。",
      "token_start": 866,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 275950,
      "end_ms": 278065,
      "text": "环湖修了平缓栈道，",
      "token_start": 872,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 278520,
      "end_ms": 280040,
      "text": "不用高强度登山，",
      "token_start": 880,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 280480,
      "end_ms": 281460,
      "text": "慢慢绕行，",
      "token_start": 887,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 281740,
      "end_ms": 284045,
      "text": "就能看遍湖山秋色。",
      "token_start": 891,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 284750,
      "end_ms": 287310,
      "text": "秋实山林彩叶环绕，",
      "token_start": 899,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 287330,
      "end_ms": 288790,
      "text": "湖面深山人少，",
      "token_start": 907,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 289030,
      "end_ms": 289965,
      "text": "十分清静。",
      "token_start": 913,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 290490,
      "end_ms": 292015,
      "text": "没有拥挤的人流，",
      "token_start": 917,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 292380,
      "end_ms": 295595,
      "text": "只有山峰、鸟鸣和一池净水，",
      "token_start": 924,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 296020,
      "end_ms": 299425,
      "text": "是藏在西北不为人知的秋水秘境。",
      "token_start": 935,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 300760,
      "end_ms": 303035,
      "text": "从第十名到第六名。",
      "token_start": 949,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 303510,
      "end_ms": 305430,
      "text": "如晴湖是山间晴湖，",
      "token_start": 957,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 305690,
      "end_ms": 306930,
      "text": "还龙湖是江湾，",
      "token_start": 965,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 306950,
      "end_ms": 307410,
      "text": "红叶，",
      "token_start": 971,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 307690,
      "end_ms": 309510,
      "text": "卧龙潭是幽谷玉潭，",
      "token_start": 973,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 309930,
      "end_ms": 312670,
      "text": "抚仙湖是天光净水文献，",
      "token_start": 981,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 312770,
      "end_ms": 314230,
      "text": "天池是陇南山湖。",
      "token_start": 991,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 315090,
      "end_ms": 316990,
      "text": "可咱们还没讲到最绝的，",
      "token_start": 998,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 317370,
      "end_ms": 319730,
      "text": "接下来第五道第一名更了不得。",
      "token_start": 1008,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 320130,
      "end_ms": 323210,
      "text": "有一处高原圣湖彩铃，",
      "token_start": 1021,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 323270,
      "end_ms": 326070,
      "text": "沿着湖岸一路扑向雪山。",
      "token_start": 1030,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 326190,
      "end_ms": 329430,
      "text": "有一处藏地绿宝石净水，",
      "token_start": 1040,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 329510,
      "end_ms": 330870,
      "text": "映着湖心古寺。",
      "token_start": 1050,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 331570,
      "end_ms": 337960,
      "text": "有一片川西海子彩林净水草甸融为一体。",
      "token_start": 1056,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 338700,
      "end_ms": 340660,
      "text": "有一弯阿尔山天池，",
      "token_start": 1073,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 341520,
      "end_ms": 344480,
      "text": "林海包裹着蓝宝石一样的湖面，",
      "token_start": 1081,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 345020,
      "end_ms": 346880,
      "text": "可排在榜首的那一处。",
      "token_start": 1094,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 347280,
      "end_ms": 348500,
      "text": "雪山环抱，",
      "token_start": 1103,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 349240,
      "end_ms": 353880,
      "text": "白桦环湖一汪湖水随光影变幻，",
      "token_start": 1107,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 354060,
      "end_ms": 357880,
      "text": "蓝绿一年只有十几天的黄金秋色。",
      "token_start": 1120,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 358800,
      "end_ms": 359620,
      "text": "它是哪里？",
      "token_start": 1134,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 360900,
      "end_ms": 363125,
      "text": "它凭什么排在九寨沟前面，",
      "token_start": 1138,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 363470,
      "end_ms": 365595,
      "text": "下一集已经同步更新，",
      "token_start": 1149,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 366090,
      "end_ms": 367690,
      "text": "现在直接点开我的头像，",
      "token_start": 1158,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 367710,
      "end_ms": 368390,
      "text": "进入主页，",
      "token_start": 1168,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 368390,
      "end_ms": 371850,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 1172,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 371950,
      "end_ms": 377225,
      "text": "咱们接着看谁才是秋水秘境真正的天花板。",
      "token_start": 1186,
      "token_end_exclusive": 1204
    }
  ],
