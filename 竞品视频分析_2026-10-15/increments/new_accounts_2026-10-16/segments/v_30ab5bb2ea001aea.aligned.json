{
  "video_id": "v_30ab5bb2ea001aea",
  "duration_s": 439.299002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_30ab5bb2ea001aea.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_30ab5bb2ea001aea.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 2370,
      "text": "上期咱们聊了西湖、千岛湖这些，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 2670,
      "end_ms": 3590,
      "text": "这期接着聊。",
      "token_start": 13,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3590,
      "end_ms": 4770,
      "text": "第十到第六名。",
      "token_start": 18,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5350,
      "end_ms": 7270,
      "text": "这五个里面有一个湖，",
      "token_start": 24,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 7310,
      "end_ms": 9850,
      "text": "每年只每二十天有一个湖，",
      "token_start": 33,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 9930,
      "end_ms": 11730,
      "text": "全年只有大约五十天，",
      "token_start": 44,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11730,
      "end_ms": 13370,
      "text": "能看到湛蓝的真容。",
      "token_start": 53,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 13930,
      "end_ms": 16490,
      "text": "还有一个湖的湖水会在夏天自己变红，",
      "token_start": 61,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 17190,
      "end_ms": 18990,
      "text": "觉得有意思的可以先收藏，",
      "token_start": 77,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 19030,
      "end_ms": 19590,
      "text": "慢慢看，",
      "token_start": 88,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 20370,
      "end_ms": 23130,
      "text": "咱们接着聊第十名。",
      "token_start": 91,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 23430,
      "end_ms": 26430,
      "text": "内蒙古额济纳湖杨林倒影。",
      "token_start": 99,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 26830,
      "end_ms": 27770,
      "text": "你想象一下，",
      "token_start": 110,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 27770,
      "end_ms": 28830,
      "text": "你站在居安海边，",
      "token_start": 115,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 28830,
      "end_ms": 32040,
      "text": "清晨的你的冷空气钻进鼻子里，",
      "token_start": 122,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 32040,
      "end_ms": 34660,
      "text": "带着一丝沙土和枯草的味道。",
      "token_start": 135,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 35500,
      "end_ms": 37820,
      "text": "太阳刚从地平线上升起来，",
      "token_start": 147,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 38600,
      "end_ms": 41900,
      "text": "金色的光斜斜的打在对岸的胡杨林上，",
      "token_start": 158,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 42880,
      "end_ms": 45180,
      "text": "整片林子像被点燃了，",
      "token_start": 174,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 45580,
      "end_ms": 47400,
      "text": "每一片叶子都在发光，",
      "token_start": 183,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 48200,
      "end_ms": 50280,
      "text": "湖面没有一丝波纹，",
      "token_start": 192,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 51060,
      "end_ms": 53800,
      "text": "把整片金林倒映在水里，",
      "token_start": 200,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 54620,
      "end_ms": 59555,
      "text": "天上一个金色的世里水里一个金色的世界，",
      "token_start": 210,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 61050,
      "end_ms": 64045,
      "text": "你站在中间分不清哪个是真的。",
      "token_start": 228,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 64800,
      "end_ms": 67965,
      "text": "但额济纳的观赏期全周期约二十二天，",
      "token_start": 241,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 68430,
      "end_ms": 70915,
      "text": "最佳观赏期只有十一天左右。",
      "token_start": 257,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 71270,
      "end_ms": 71510,
      "text": "嗯，",
      "token_start": 269,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 72060,
      "end_ms": 72500,
      "text": "来早了，",
      "token_start": 270,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 72500,
      "end_ms": 73160,
      "text": "叶子没黄，",
      "token_start": 273,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 73260,
      "end_ms": 73800,
      "text": "来晚了，",
      "token_start": 277,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 73800,
      "end_ms": 74435,
      "text": "全掉了。",
      "token_start": 280,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 75190,
      "end_ms": 76390,
      "text": "现实营业的美，",
      "token_start": 283,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 76650,
      "end_ms": 79805,
      "text": "错过就是一年第九名。",
      "token_start": 289,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 80120,
      "end_ms": 81745,
      "text": "吉林长白山天池，",
      "token_start": 298,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 82690,
      "end_ms": 83790,
      "text": "你坐着越野车，",
      "token_start": 305,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 83810,
      "end_ms": 85185,
      "text": "一路蹒跚上去，",
      "token_start": 311,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 85560,
      "end_ms": 87335,
      "text": "海拔两千一百八十九米，",
      "token_start": 317,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 87650,
      "end_ms": 88630,
      "text": "风越来越大，",
      "token_start": 327,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 88810,
      "end_ms": 90025,
      "text": "温度越来越低。",
      "token_start": 332,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 90360,
      "end_ms": 93285,
      "text": "你国警外套踩着栈道往上走，",
      "token_start": 338,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 93580,
      "end_ms": 94700,
      "text": "心里一直在打鼓，",
      "token_start": 350,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 94700,
      "end_ms": 95705,
      "text": "今天能看到吗？",
      "token_start": 357,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 96080,
      "end_ms": 99205,
      "text": "因为天池全年有二百多天被云雾笼罩，",
      "token_start": 363,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 99680,
      "end_ms": 102805,
      "text": "能看到全貌的概率大约只有三成，",
      "token_start": 379,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 103610,
      "end_ms": 106890,
      "text": "全年能看到清澈湖面的天数只有五十多天。",
      "token_start": 393,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 107030,
      "end_ms": 109945,
      "text": "你走到观景台边缘往下看。",
      "token_start": 411,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 110510,
      "end_ms": 111490,
      "text": "如果运气好，",
      "token_start": 422,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 111670,
      "end_ms": 113095,
      "text": "云雾正好散开，",
      "token_start": 427,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 113730,
      "end_ms": 117285,
      "text": "一池碧蓝的湖水嵌在十六座山峰中间，",
      "token_start": 433,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 118110,
      "end_ms": 120905,
      "text": "男的像一块落在火山口里的宝石，",
      "token_start": 449,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 121360,
      "end_ms": 122800,
      "text": "安静冷冽，",
      "token_start": 463,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 123080,
      "end_ms": 124225,
      "text": "一言不发。",
      "token_start": 467,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 125070,
      "end_ms": 125895,
      "text": "你站在那里，",
      "token_start": 471,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 126220,
      "end_ms": 128180,
      "text": "风从耳边呼啸而过，",
      "token_start": 476,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 128460,
      "end_ms": 129595,
      "text": "你会忽然明白，",
      "token_start": 484,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 129860,
      "end_ms": 130300,
      "text": "为什么？",
      "token_start": 490,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 130300,
      "end_ms": 131040,
      "text": "当地人说，",
      "token_start": 493,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 131060,
      "end_ms": 132825,
      "text": "不是你选择看天池，",
      "token_start": 497,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 133290,
      "end_ms": 134030,
      "text": "是天池，",
      "token_start": 505,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 134070,
      "end_ms": 136580,
      "text": "选择让你看到第八名。",
      "token_start": 508,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 136800,
      "end_ms": 138275,
      "text": "山西运城盐湖，",
      "token_start": 517,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 139170,
      "end_ms": 140345,
      "text": "你站在盐湖边，",
      "token_start": 523,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 140750,
      "end_ms": 143610,
      "text": "夏天的热风从湖面上吹过来，",
      "token_start": 529,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 143610,
      "end_ms": 146065,
      "text": "空气里有一股淡淡的咸味儿，",
      "token_start": 541,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 146830,
      "end_ms": 149795,
      "text": "平时这片湖水是普通的青蓝色。",
      "token_start": 553,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 150090,
      "end_ms": 151910,
      "text": "但每年六到七月，",
      "token_start": 566,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 152170,
      "end_ms": 154865,
      "text": "湖里的杜氏盐藻大量繁殖，",
      "token_start": 573,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 155330,
      "end_ms": 158165,
      "text": "湖水从清澈变成绯红色。",
      "token_start": 584,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 158660,
      "end_ms": 160285,
      "text": "你从空中往下看，",
      "token_start": 594,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 160940,
      "end_ms": 164950,
      "text": "红蓝绿黄白各种颜色，",
      "token_start": 601,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 164950,
      "end_ms": 166250,
      "text": "在岩池上交错，",
      "token_start": 610,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 166530,
      "end_ms": 168685,
      "text": "像一块被打翻的调色盘。",
      "token_start": 616,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 169410,
      "end_ms": 171405,
      "text": "当地人管这叫限定红装，",
      "token_start": 626,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 172210,
      "end_ms": 174625,
      "text": "一年只有夏天的两个月能看到，",
      "token_start": 636,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 175070,
      "end_ms": 179105,
      "text": "错过了就得等明年第七名。",
      "token_start": 649,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 180650,
      "end_ms": 184630,
      "text": "云南泸沽湖清晨七点，",
      "token_start": 660,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 184630,
      "end_ms": 187310,
      "text": "你坐着珠草船从岸边出发，",
      "token_start": 669,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 187830,
      "end_ms": 189950,
      "text": "湖面上飘着一层薄薄的雾，",
      "token_start": 680,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 190670,
      "end_ms": 195750,
      "text": "摩梭船夫站在船尾一桨一桨的划船慢慢驶尽。",
      "token_start": 691,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 195770,
      "end_ms": 196230,
      "text": "湖心，",
      "token_start": 710,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 196470,
      "end_ms": 197550,
      "text": "你低头看水，",
      "token_start": 712,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 197610,
      "end_ms": 199510,
      "text": "水面上开满了白色的小花，",
      "token_start": 717,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 199930,
      "end_ms": 201850,
      "text": "花瓣薄的近乎透明，",
      "token_start": 728,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 202430,
      "end_ms": 204550,
      "text": "黄色的花蕊浮在水面上，",
      "token_start": 736,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 204910,
      "end_ms": 208130,
      "text": "一朵挨着一朵铺满了整片湖面。",
      "token_start": 746,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 208870,
      "end_ms": 210770,
      "text": "黄地人叫它水性杨花，",
      "token_start": 759,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 211130,
      "end_ms": 212590,
      "text": "学名海菜花花，",
      "token_start": 768,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 213560,
      "end_ms": 216480,
      "text": "只在水质极好的湖里才能生长。",
      "token_start": 774,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 216840,
      "end_ms": 218260,
      "text": "清晨七点到十点，",
      "token_start": 787,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 218260,
      "end_ms": 219060,
      "text": "花开最盛，",
      "token_start": 794,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 219420,
      "end_ms": 221260,
      "text": "船在花海里慢慢走，",
      "token_start": 798,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 221280,
      "end_ms": 223780,
      "text": "你伸手就能碰到水面上的花瓣，",
      "token_start": 806,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 224400,
      "end_ms": 226400,
      "text": "凉凉的滑滑的。",
      "token_start": 819,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 227160,
      "end_ms": 228680,
      "text": "除了水声和桨声，",
      "token_start": 825,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 229240,
      "end_ms": 231920,
      "text": "四周安静的向世界还没醒。",
      "token_start": 832,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 232960,
      "end_ms": 233600,
      "text": "第六名，",
      "token_start": 843,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 234860,
      "end_ms": 236640,
      "text": "浙江钱塘江大潮，",
      "token_start": 846,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 237180,
      "end_ms": 238860,
      "text": "农历八月十八前后，",
      "token_start": 853,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 239220,
      "end_ms": 241645,
      "text": "你站在钱塘江边的堤坝上，",
      "token_start": 861,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 242040,
      "end_ms": 243765,
      "text": "人群挤得满满当当。",
      "token_start": 872,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 244570,
      "end_ms": 247710,
      "text": "远处江面上一条细细的白线，",
      "token_start": 880,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 247790,
      "end_ms": 251785,
      "text": "出现那条白线越来越粗越来越近，",
      "token_start": 892,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 252570,
      "end_ms": 255010,
      "text": "像有人把整条江立起来，",
      "token_start": 906,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 255170,
      "end_ms": 256125,
      "text": "推着往前走。",
      "token_start": 916,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 257020,
      "end_ms": 258160,
      "text": "几秒钟之内，",
      "token_start": 921,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 258640,
      "end_ms": 261640,
      "text": "白线变成一堵数米高的水墙，",
      "token_start": 926,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 261760,
      "end_ms": 263960,
      "text": "带着轰隆隆的声音碾压过来，",
      "token_start": 938,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 264300,
      "end_ms": 264980,
      "text": "像打雷，",
      "token_start": 950,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 265180,
      "end_ms": 266400,
      "text": "像千军万马，",
      "token_start": 953,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 266700,
      "end_ms": 267780,
      "text": "像大地在吼，",
      "token_start": 958,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 268120,
      "end_ms": 269740,
      "text": "潮水拍在堤坝上，",
      "token_start": 963,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 270080,
      "end_ms": 271300,
      "text": "浪花溅起几米，",
      "token_start": 970,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 271300,
      "end_ms": 273365,
      "text": "高水雾扑面而来。",
      "token_start": 976,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 274880,
      "end_ms": 276115,
      "text": "你脸上湿了，",
      "token_start": 983,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 276520,
      "end_ms": 277520,
      "text": "嘴里是咸的，",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 277660,
      "end_ms": 279365,
      "text": "整个过程只有几分钟，",
      "token_start": 993,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 280150,
      "end_ms": 281365,
      "text": "潮水过去了，",
      "token_start": 1002,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 281680,
      "end_ms": 282980,
      "text": "江面恢复平静，",
      "token_start": 1007,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 283420,
      "end_ms": 285360,
      "text": "一年之中只有那几天，",
      "token_start": 1013,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 285360,
      "end_ms": 286785,
      "text": "潮水最大最猛，",
      "token_start": 1022,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 287660,
      "end_ms": 290645,
      "text": "其他时候的钱塘江安静的不像话。",
      "token_start": 1028,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 291830,
      "end_ms": 292390,
      "text": "说到这儿，",
      "token_start": 1042,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 292390,
      "end_ms": 292915,
      "text": "停一下，",
      "token_start": 1046,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 293690,
      "end_ms": 295185,
      "text": "咱们聊了额济娜。",
      "token_start": 1049,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 296430,
      "end_ms": 298510,
      "text": "天池盐湖，",
      "token_start": 1056,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 298910,
      "end_ms": 302890,
      "text": "这些你有没有发现一件事儿？",
      "token_start": 1060,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 302890,
      "end_ms": 304630,
      "text": "这些地方美是美，",
      "token_start": 1072,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 304690,
      "end_ms": 306830,
      "text": "但它们都有一个共同点。",
      "token_start": 1079,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 306970,
      "end_ms": 311250,
      "text": "现实鹅济纳的胡杨只美二十天，",
      "token_start": 1089,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 311290,
      "end_ms": 313630,
      "text": "天池一年只漏五十多天，",
      "token_start": 1102,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 313690,
      "end_ms": 315950,
      "text": "盐湖只在夏天变红。",
      "token_start": 1112,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 315950,
      "end_ms": 318910,
      "text": "泸沽湖的花只开两三个月，",
      "token_start": 1120,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 318930,
      "end_ms": 321310,
      "text": "你刷到视频的时候觉得好美，",
      "token_start": 1131,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 321370,
      "end_ms": 324550,
      "text": "但真要去的时候什么时候去怎么走，",
      "token_start": 1143,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 324550,
      "end_ms": 326170,
      "text": "看什么避什么坑，",
      "token_start": 1158,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 326170,
      "end_ms": 326480,
      "text": "观光，",
      "token_start": 1165,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 326480,
      "end_ms": 329240,
      "text": "靠短视频根本记不住时间差。",
      "token_start": 1167,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 329240,
      "end_ms": 331500,
      "text": "一周你看到的就不是仙境，",
      "token_start": 1179,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 331700,
      "end_ms": 332760,
      "text": "是普通湖泊。",
      "token_start": 1190,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 333140,
      "end_ms": 337240,
      "text": "我手边这本大美中国人一生要去的一百零一个地方，",
      "token_start": 1195,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 337500,
      "end_ms": 339700,
      "text": "它不是简单的仙境罗列。",
      "token_start": 1217,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 340080,
      "end_ms": 345320,
      "text": "这本书涵盖了自然风光、历史、文化、民族风情等多个方面。",
      "token_start": 1227,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 345760,
      "end_ms": 349560,
      "text": "从桂城的巍峨壮丽到黄山的仙境奇观。",
      "token_start": 1250,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 350120,
      "end_ms": 353640,
      "text": "从桂林的山水甲天下到九寨沟的人间奇境，",
      "token_start": 1266,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 354140,
      "end_ms": 359015,
      "text": "详细列举了人生中不可错不过的一百零一个绝美景点，",
      "token_start": 1284,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 359370,
      "end_ms": 363655,
      "text": "每一处都配有精美图片和通俗优美的文字描述。",
      "token_start": 1307,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 364130,
      "end_ms": 367700,
      "text": "翻到哪页就知道那个地方长什么样，",
      "token_start": 1327,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 367820,
      "end_ms": 368580,
      "text": "什么季节去，",
      "token_start": 1342,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 368580,
      "end_ms": 369855,
      "text": "最好有什么故事，",
      "token_start": 1347,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 370610,
      "end_ms": 373210,
      "text": "带着孩子翻翻到哪儿，",
      "token_start": 1354,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 373210,
      "end_ms": 376685,
      "text": "讲到哪告诉他这是咱们中国的湖，",
      "token_start": 1363,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 377480,
      "end_ms": 378905,
      "text": "这是咱们中国的山，",
      "token_start": 1377,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 379620,
      "end_ms": 383115,
      "text": "自己翻翻到哪页就想去哪页。",
      "token_start": 1385,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 383570,
      "end_ms": 384225,
      "text": "书不贵。",
      "token_start": 1397,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 384670,
      "end_ms": 388405,
      "text": "一杯奶茶的钱放在家里是一本中国旅行清单，",
      "token_start": 1400,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 388780,
      "end_ms": 393440,
      "text": "也是一本可以跟孩子一起翻的画册链接放在橱窗了。",
      "token_start": 1419,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 393660,
      "end_ms": 395620,
      "text": "喜欢旅行的朋友入一本放手，",
      "token_start": 1441,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 395620,
      "end_ms": 396725,
      "text": "边做个参考。",
      "token_start": 1453,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 397350,
      "end_ms": 397550,
      "text": "好，",
      "token_start": 1458,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 397550,
      "end_ms": 398225,
      "text": "回到正题，",
      "token_start": 1459,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 399500,
      "end_ms": 401585,
      "text": "接下来第五到第一名里，",
      "token_start": 1463,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 402480,
      "end_ms": 403685,
      "text": "有一个瀑布，",
      "token_start": 1473,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 404050,
      "end_ms": 406430,
      "text": "从悬崖上分成三级砸下来，",
      "token_start": 1478,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 406430,
      "end_ms": 407510,
      "text": "水雾升起的时候，",
      "token_start": 1489,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 407510,
      "end_ms": 410355,
      "text": "整个瀑布会消失在一片白茫茫。",
      "token_start": 1496,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 410940,
      "end_ms": 413355,
      "text": "有一个地方的水律的不像水，",
      "token_start": 1509,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 413640,
      "end_ms": 415015,
      "text": "像液态的翡翠，",
      "token_start": 1521,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 415440,
      "end_ms": 417875,
      "text": "还有一个地方的湖水难道不真实？",
      "token_start": 1527,
      "token_end_exclusive": 1541
    },
    {
      "start_ms": 418480,
      "end_ms": 419440,
      "text": "你站在湖边，",
      "token_start": 1541,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 419440,
      "end_ms": 423325,
      "text": "会怀疑自己的眼睛可排在榜首的那个水井。",
      "token_start": 1546,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 423960,
      "end_ms": 426675,
      "text": "你走进去的第一反应不是好美，",
      "token_start": 1564,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 427140,
      "end_ms": 428875,
      "text": "是这地方不应该存在。",
      "token_start": 1577,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 429900,
      "end_ms": 432025,
      "text": "下一集已经同步更新，",
      "token_start": 1586,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 432470,
      "end_ms": 433790,
      "text": "现在直接点开我的头像，",
      "token_start": 1595,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 433810,
      "end_ms": 434515,
      "text": "进入主页，",
      "token_start": 1605,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 435430,
      "end_ms": 436875,
      "text": "第一条视频就是下一集，",
      "token_start": 1609,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 437240,
      "end_ms": 439075,
      "text": "感兴趣的朋友可以关注后续。",
      "token_start": 1619,
      "token_end_exclusive": 1631
    }
  ],
