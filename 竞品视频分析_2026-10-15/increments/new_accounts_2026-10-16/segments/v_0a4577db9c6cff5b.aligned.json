{
  "video_id": "v_0a4577db9c6cff5b",
  "duration_s": 754.672993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_0a4577db9c6cff5b.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_0a4577db9c6cff5b.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 250,
      "end_ms": 830,
      "text": "有一本书，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1050,
      "end_ms": 5610,
      "text": "它是由一位改变中国命运的科学家钱学森院士亲自点题，",
      "token_start": 4,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 6050,
      "end_ms": 7790,
      "text": "一位化学家放弃实验室，",
      "token_start": 28,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 7790,
      "end_ms": 10630,
      "text": "前途用三十多年行走江湖完成的。",
      "token_start": 38,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 11110,
      "end_ms": 13150,
      "text": "他在学术圈内部被反复讨论，",
      "token_start": 52,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 13330,
      "end_ms": 15710,
      "text": "却在普通读者的书架上几乎缺席。",
      "token_start": 64,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 16010,
      "end_ms": 16970,
      "text": "不是因为它不好，",
      "token_start": 78,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 17470,
      "end_ms": 19310,
      "text": "而是因为他太反常识，",
      "token_start": 85,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 19550,
      "end_ms": 20470,
      "text": "反常识到会，",
      "token_start": 94,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 20470,
      "end_ms": 25170,
      "text": "让你过去二三十年对道这个字的理解发生一场彻底的坍塌。",
      "token_start": 99,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 25650,
      "end_ms": 26010,
      "text": "作者，",
      "token_start": 124,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 26010,
      "end_ms": 30340,
      "text": "胡福琛是中国社会科学院哲学研究所研究员、博士生导师，",
      "token_start": 126,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 30620,
      "end_ms": 33520,
      "text": "全国老子道学文化研究会创会会长。",
      "token_start": 150,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 33920,
      "end_ms": 37400,
      "text": "但就是这个享受国务院政府特殊津贴的体制内学者，",
      "token_start": 165,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 37620,
      "end_ms": 39520,
      "text": "用他化学系出身的理科生，",
      "token_start": 187,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 39520,
      "end_ms": 43340,
      "text": "大脑做了一件让整个中文学术圈坐立不安的事。",
      "token_start": 198,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 43780,
      "end_ms": 46500,
      "text": "他把道学从江湖术士的挂摊上，",
      "token_start": 218,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 46700,
      "end_ms": 48420,
      "text": "从假道学的固纸堆里，",
      "token_start": 231,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 48600,
      "end_ms": 54100,
      "text": "从西方哲学坐标系下的东方神秘主义标签中硬生生拽了出来，",
      "token_start": 240,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 54180,
      "end_ms": 55500,
      "text": "拍在桌上说，",
      "token_start": 266,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 55820,
      "end_ms": 57400,
      "text": "你们全都看错了。",
      "token_start": 271,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 57420,
      "end_ms": 61810,
      "text": "今天这条文字我会拆出这本书里最颠覆的五个底层认知。",
      "token_start": 278,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 61990,
      "end_ms": 62870,
      "text": "但我要提前警告，",
      "token_start": 302,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 62870,
      "end_ms": 69090,
      "text": "你看完后你可能会推翻过去二十年、三十年对中国传统文化奉为归孽的理解。",
      "token_start": 309,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 69150,
      "end_ms": 70565,
      "text": "如果没准备好被冒犯，",
      "token_start": 341,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 70830,
      "end_ms": 72005,
      "text": "现在划走还来得及。",
      "token_start": 350,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 72400,
      "end_ms": 73515,
      "text": "如果你选择留下来，",
      "token_start": 358,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 73670,
      "end_ms": 74925,
      "text": "那我们开始进入正题。",
      "token_start": 366,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 75160,
      "end_ms": 78005,
      "text": "第一层颠覆道学不是道家，",
      "token_start": 375,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 78340,
      "end_ms": 79160,
      "text": "更不是道叫，",
      "token_start": 386,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 79480,
      "end_ms": 80820,
      "text": "你连名字都叫错了。",
      "token_start": 391,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 80820,
      "end_ms": 82425,
      "text": "你有没有发现一个诡异的现象，",
      "token_start": 399,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 82780,
      "end_ms": 85525,
      "text": "所有中国人都能说两句道可道非常道，",
      "token_start": 412,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 85980,
      "end_ms": 88465,
      "text": "但没人能说清楚道学到底是什么。",
      "token_start": 428,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 88810,
      "end_ms": 90090,
      "text": "中小学课本告诉你，",
      "token_start": 442,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 90170,
      "end_ms": 91910,
      "text": "道家是诸子百家之一，",
      "token_start": 450,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 92050,
      "end_ms": 93750,
      "text": "代表人物老子庄子，",
      "token_start": 459,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 93930,
      "end_ms": 95395,
      "text": "主张清净无为。",
      "token_start": 467,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 95870,
      "end_ms": 97195,
      "text": "大学哲学系告诉你，",
      "token_start": 473,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 97520,
      "end_ms": 99900,
      "text": "道教是中国本土宗教东汉。",
      "token_start": 481,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 99900,
      "end_ms": 103690,
      "text": "张道林创立讲究炼丹修仙这两句话，",
      "token_start": 492,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 103870,
      "end_ms": 105430,
      "text": "把道学切成了一句，",
      "token_start": 507,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 105430,
      "end_ms": 106190,
      "text": "只有骨架，",
      "token_start": 515,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 106190,
      "end_ms": 107370,
      "text": "没有蟹肉的标本。",
      "token_start": 519,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 107510,
      "end_ms": 110914,
      "text": "吴富琛在道学入门开篇就砸碎了这套分类。",
      "token_start": 526,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 111370,
      "end_ms": 111945,
      "text": "他指出，",
      "token_start": 544,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 112300,
      "end_ms": 115075,
      "text": "道学之名始建于隋书经籍制，",
      "token_start": 547,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 115450,
      "end_ms": 117790,
      "text": "原指老子创立的有关道的学说，",
      "token_start": 559,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 117990,
      "end_ms": 120460,
      "text": "涵盖哲学的道家、宗教学的道教，",
      "token_start": 572,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 120560,
      "end_ms": 123215,
      "text": "以及属于人体生命科学范围的内丹学。",
      "token_start": 585,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 123570,
      "end_ms": 125610,
      "text": "这三个东西从来不是并列关系，",
      "token_start": 601,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 125810,
      "end_ms": 127965,
      "text": "是一个根系上的三棵枝干，",
      "token_start": 614,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 128310,
      "end_ms": 130995,
      "text": "你砍掉任何一棵整棵树都活不成，",
      "token_start": 625,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 131450,
      "end_ms": 133835,
      "text": "更狠的是他对假道学的清算。",
      "token_start": 639,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 134390,
      "end_ms": 139275,
      "text": "元代托托把周敦颐二城朱熹塞进宋史道学传。",
      "token_start": 651,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 139690,
      "end_ms": 140090,
      "text": "从此，",
      "token_start": 670,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 140170,
      "end_ms": 143895,
      "text": "程朱理学鸠占雀巢成了道学的正统代言。",
      "token_start": 672,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 144770,
      "end_ms": 146365,
      "text": "胡富琛毫不客气的指出，",
      "token_start": 689,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 146690,
      "end_ms": 149450,
      "text": "自明代李治至清末皆有人揭露，",
      "token_start": 699,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 149470,
      "end_ms": 151975,
      "text": "将宋明理学称作道学之伪，",
      "token_start": 712,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 152420,
      "end_ms": 152800,
      "text": "指出，",
      "token_start": 723,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 152800,
      "end_ms": 155695,
      "text": "仅有老子庄子的学说才是真道学。",
      "token_start": 725,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 156090,
      "end_ms": 158690,
      "text": "你今天在国学班上背的存天理，",
      "token_start": 739,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 158690,
      "end_ms": 159290,
      "text": "灭人欲，",
      "token_start": 752,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 159530,
      "end_ms": 161270,
      "text": "跟老子道法自然，",
      "token_start": 755,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 161310,
      "end_ms": 162570,
      "text": "压根儿不是一回事。",
      "token_start": 762,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 162630,
      "end_ms": 165070,
      "text": "一个是给皇权递刀子的伦理枷锁。",
      "token_start": 770,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 165330,
      "end_ms": 168410,
      "text": "一个是教你在天地间站着做人的生命哲学，",
      "token_start": 784,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 168670,
      "end_ms": 170445,
      "text": "这听上去像学术考据，",
      "token_start": 802,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 170820,
      "end_ms": 173085,
      "text": "但他的杀伤力远超你的想象。",
      "token_start": 811,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 173490,
      "end_ms": 176255,
      "text": "当你把程朱理学误认作道学正统，",
      "token_start": 823,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 176600,
      "end_ms": 179245,
      "text": "你整个文化坐标系的原点就偏了。",
      "token_start": 837,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 179810,
      "end_ms": 181150,
      "text": "你以为是儒道互补，",
      "token_start": 851,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 181550,
      "end_ms": 183970,
      "text": "其实你一直被伪道学喂养了。",
      "token_start": 859,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 183970,
      "end_ms": 184570,
      "text": "七百年。",
      "token_start": 871,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 185450,
      "end_ms": 186250,
      "text": "胡富琛说。",
      "token_start": 874,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 186550,
      "end_ms": 187450,
      "text": "他写这本书，",
      "token_start": 878,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 187570,
      "end_ms": 188990,
      "text": "就是为了为道学，",
      "token_start": 883,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 189070,
      "end_ms": 191510,
      "text": "证明不是争一个学术标签，",
      "token_start": 890,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 191890,
      "end_ms": 195290,
      "text": "是要把被篡改的文明源代码重新翻出来。",
      "token_start": 901,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 195310,
      "end_ms": 195790,
      "text": "第二层，",
      "token_start": 918,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 195790,
      "end_ms": 196950,
      "text": "颠覆道学，",
      "token_start": 921,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 197030,
      "end_ms": 198270,
      "text": "不是弱者的哲学，",
      "token_start": 925,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 198490,
      "end_ms": 200250,
      "text": "是真正强者的哲学。",
      "token_start": 932,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 200310,
      "end_ms": 202330,
      "text": "你脑子里是不是自动蹦出了一幅画面？",
      "token_start": 940,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 202750,
      "end_ms": 204670,
      "text": "深山老林白发老道，",
      "token_start": 956,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 204870,
      "end_ms": 205810,
      "text": "打坐冥想，",
      "token_start": 964,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 205950,
      "end_ms": 206770,
      "text": "不问世事，",
      "token_start": 968,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 207330,
      "end_ms": 210020,
      "text": "这就是主流叙事给你植入的道学形象。",
      "token_start": 972,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 210460,
      "end_ms": 213020,
      "text": "胡福琛用一句话把这张图撕了。",
      "token_start": 988,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 213220,
      "end_ms": 215300,
      "text": "道学不是消极的哲学，",
      "token_start": 1001,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 215300,
      "end_ms": 216920,
      "text": "而是积极的哲学，",
      "token_start": 1010,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 216920,
      "end_ms": 218840,
      "text": "不是弱者的哲学，",
      "token_start": 1017,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 218840,
      "end_ms": 221180,
      "text": "而是真正强者的哲学。",
      "token_start": 1024,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 221180,
      "end_ms": 223080,
      "text": "他在书里做了一个惊人的概念，",
      "token_start": 1033,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 223080,
      "end_ms": 231860,
      "text": "翻转道学的核心思想是建构一个模拟自然界或者人体生命的自组织自调节的最优的自动化系统。",
      "token_start": 1046,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 232400,
      "end_ms": 235460,
      "text": "这个系统几乎天地人之道，",
      "token_start": 1087,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 235820,
      "end_ms": 237920,
      "text": "无亲无疏大功。",
      "token_start": 1098,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 238000,
      "end_ms": 240070,
      "text": "大慈是一种万物，",
      "token_start": 1104,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 240130,
      "end_ms": 242735,
      "text": "将自化的自然之治的社会。",
      "token_start": 1111,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 243430,
      "end_ms": 244545,
      "text": "你读三遍这句话，",
      "token_start": 1122,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 244860,
      "end_ms": 246965,
      "text": "再想想清静无为四个字，",
      "token_start": 1129,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 247390,
      "end_ms": 250150,
      "text": "你会发现无为根本不是不作为，",
      "token_start": 1139,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 250450,
      "end_ms": 252530,
      "text": "是不妄为不强为，",
      "token_start": 1152,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 252770,
      "end_ms": 254365,
      "text": "不逆规律而为，",
      "token_start": 1159,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 254770,
      "end_ms": 256430,
      "text": "这是最高级的战略思维，",
      "token_start": 1165,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 256550,
      "end_ms": 257455,
      "text": "不是躺平。",
      "token_start": 1175,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 257980,
      "end_ms": 273170,
      "text": "胡福琛把道学拆解为八大支柱人行道、哲学、政治、管理学、文艺、审美学、医药、养生学、宗教、伦理学、自然生态学、单道性命、学方技术、数学、八根柱子，",
      "token_start": 1179,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 273170,
      "end_ms": 275840,
      "text": "撑起来的是一座完整的文明殿堂，",
      "token_start": 1236,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 276120,
      "end_ms": 279665,
      "text": "涵盖哲学、治国、养生、民俗科技。",
      "token_start": 1250,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 279980,
      "end_ms": 281415,
      "text": "你告诉我这叫消极，",
      "token_start": 1262,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 282240,
      "end_ms": 288075,
      "text": "这是把宇宙社会生命当做一个整体来经营的顶级的系统论。",
      "token_start": 1270,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 288540,
      "end_ms": 291040,
      "text": "你总说传统文化博大精深，",
      "token_start": 1295,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 291460,
      "end_ms": 292455,
      "text": "可你有没有想过，",
      "token_start": 1306,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 292750,
      "end_ms": 297870,
      "text": "你所谓的博大到底是被切割成旅游景点和养生鸡汤之后的残渣，",
      "token_start": 1313,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 298010,
      "end_ms": 301055,
      "text": "还是本来那个贯通天地人的完整体系？",
      "token_start": 1340,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 301460,
      "end_ms": 302895,
      "text": "胡福琛的答案很明确，",
      "token_start": 1356,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 303440,
      "end_ms": 308945,
      "text": "道学是参天地藏化玉贯中西通古今的大学问。",
      "token_start": 1365,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 309430,
      "end_ms": 310870,
      "text": "你把最硬的骨头丢了，",
      "token_start": 1384,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 311030,
      "end_ms": 312150,
      "text": "只剪了顺其自然。",
      "token_start": 1393,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 312150,
      "end_ms": 313630,
      "text": "这根软刺当安慰剂。",
      "token_start": 1400,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 313870,
      "end_ms": 316750,
      "text": "第三层颠覆西方哲学的主课二分，",
      "token_start": 1408,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 316850,
      "end_ms": 318470,
      "text": "在道学面前碎了一地。",
      "token_start": 1422,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 318790,
      "end_ms": 322850,
      "text": "你从小被教育唯物主义和唯心主义是哲学的两大阵营，",
      "token_start": 1431,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 323230,
      "end_ms": 324390,
      "text": "物质决定意识，",
      "token_start": 1454,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 324590,
      "end_ms": 326250,
      "text": "意识反作用于物质。",
      "token_start": 1460,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 326970,
      "end_ms": 332770,
      "text": "这套框架让你觉得所有哲学问题最终都能归到谁决定谁的战队上不负琛，",
      "token_start": 1468,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 332850,
      "end_ms": 337090,
      "text": "用化学背景和系统科学思维捅破了这层窗户纸。",
      "token_start": 1499,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 337250,
      "end_ms": 337630,
      "text": "他说，",
      "token_start": 1519,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 337990,
      "end_ms": 342740,
      "text": "西方哲学自苏格拉底到黑格尔都以罗格斯中心论创立体系，",
      "token_start": 1521,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 343060,
      "end_ms": 345620,
      "text": "主克二分的思维模式被牢固确立，",
      "token_start": 1546,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 346140,
      "end_ms": 349680,
      "text": "但中国哲学是一种究天人之际的学说。",
      "token_start": 1560,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 350060,
      "end_ms": 352080,
      "text": "即使是将天地的内容，",
      "token_start": 1576,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 352080,
      "end_ms": 353820,
      "text": "包括在一起的自然之天，",
      "token_start": 1585,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 354200,
      "end_ms": 356320,
      "text": "也和西方哲学中的自然界不一样。",
      "token_start": 1595,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 356680,
      "end_ms": 358600,
      "text": "中国哲学家为自然之天，",
      "token_start": 1609,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 358680,
      "end_ms": 361100,
      "text": "也是有灵性有意志的人，",
      "token_start": 1619,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 361160,
      "end_ms": 362360,
      "text": "不能逆天而行。",
      "token_start": 1629,
      "token_end_exclusive": 1635
    },
    {
      "start_ms": 362540,
      "end_ms": 366680,
      "text": "他提出了一个让物理学界都得侧目的框架两重世界。",
      "token_start": 1635,
      "token_end_exclusive": 1657
    },
    {
      "start_ms": 366900,
      "end_ms": 368400,
      "text": "四个阴阳宇宙中，",
      "token_start": 1657,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 368400,
      "end_ms": 373765,
      "text": "除了我们这个有形有相有质可观察、可测量的现实世界之外，",
      "token_start": 1664,
      "token_end_exclusive": 1689
    },
    {
      "start_ms": 374280,
      "end_ms": 376700,
      "text": "还有一个无形、无相、无质，",
      "token_start": 1689,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 376860,
      "end_ms": 380645,
      "text": "无法观察、难以测量的虚无、空灵的世界，",
      "token_start": 1699,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 381210,
      "end_ms": 383245,
      "text": "两重世界都是关系的实在。",
      "token_start": 1715,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 383560,
      "end_ms": 385020,
      "text": "但前一虫为实体，",
      "token_start": 1726,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 385240,
      "end_ms": 386655,
      "text": "后一虫为虚体，",
      "token_start": 1733,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 387170,
      "end_ms": 388765,
      "text": "人体是一个小宇宙，",
      "token_start": 1739,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 389290,
      "end_ms": 390810,
      "text": "先天的人体称作法，",
      "token_start": 1747,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 390830,
      "end_ms": 393505,
      "text": "身后天的人体称作色参，",
      "token_start": 1755,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 394060,
      "end_ms": 396775,
      "text": "先天世界和后天世界都由阴阳组成，",
      "token_start": 1765,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 397070,
      "end_ms": 398290,
      "text": "这就是四个阴阳，",
      "token_start": 1780,
      "token_end_exclusive": 1787
    },
    {
      "start_ms": 398570,
      "end_ms": 399530,
      "text": "这不是玄学。",
      "token_start": 1787,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 399690,
      "end_ms": 404965,
      "text": "胡富琛用信息论、系统科学和现代物理学做了严格的数学推演。",
      "token_start": 1792,
      "token_end_exclusive": 1818
    },
    {
      "start_ms": 405350,
      "end_ms": 410165,
      "text": "宇宙中的信息能量物质可以按一定数学关系相互转化，",
      "token_start": 1818,
      "token_end_exclusive": 1841
    },
    {
      "start_ms": 410460,
      "end_ms": 411840,
      "text": "在孤立系统中守恒。",
      "token_start": 1841,
      "token_end_exclusive": 1849
    },
    {
      "start_ms": 412200,
      "end_ms": 414040,
      "text": "基本粒子同时具有波动性，",
      "token_start": 1849,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 414200,
      "end_ms": 417010,
      "text": "粒子性选择性选择性，",
      "token_start": 1860,
      "token_end_exclusive": 1869
    },
    {
      "start_ms": 417010,
      "end_ms": 418785,
      "text": "本质上是一种心灵特征。",
      "token_start": 1869,
      "token_end_exclusive": 1879
    },
    {
      "start_ms": 419460,
      "end_ms": 420940,
      "text": "宇宙小致基本粒子，",
      "token_start": 1879,
      "token_end_exclusive": 1887
    },
    {
      "start_ms": 420960,
      "end_ms": 423320,
      "text": "大智银河系自创生起，",
      "token_start": 1887,
      "token_end_exclusive": 1896
    },
    {
      "start_ms": 423400,
      "end_ms": 425415,
      "text": "就有核目的性的选择趋势。",
      "token_start": 1896,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 425690,
      "end_ms": 426345,
      "text": "换句话说，",
      "token_start": 1907,
      "token_end_exclusive": 1911
    },
    {
      "start_ms": 426730,
      "end_ms": 428490,
      "text": "你以为道学在讲玄虚，",
      "token_start": 1911,
      "token_end_exclusive": 1920
    },
    {
      "start_ms": 428850,
      "end_ms": 432835,
      "text": "其实他在讲一套连现代科学都还没消化完的宇宙模型。",
      "token_start": 1920,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 433420,
      "end_ms": 435200,
      "text": "你嘲笑阴阳五行是迷信，",
      "token_start": 1943,
      "token_end_exclusive": 1953
    },
    {
      "start_ms": 435400,
      "end_ms": 436285,
      "text": "你有没有想过，",
      "token_start": 1953,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 436650,
      "end_ms": 443390,
      "text": "可能是你的科学观太窄窄到容不下一套比笛卡尔早了两千年的心物依缘。",
      "token_start": 1959,
      "token_end_exclusive": 1990
    },
    {
      "start_ms": 443390,
      "end_ms": 445170,
      "text": "论第四层颠覆单道，",
      "token_start": 1990,
      "token_end_exclusive": 1998
    },
    {
      "start_ms": 445190,
      "end_ms": 445985,
      "text": "不是修仙，",
      "token_start": 1998,
      "token_end_exclusive": 2002
    },
    {
      "start_ms": 446300,
      "end_ms": 450105,
      "text": "是被江湖和伟学联手封杀的顶级生命科学。",
      "token_start": 2002,
      "token_end_exclusive": 2020
    },
    {
      "start_ms": 450840,
      "end_ms": 452760,
      "text": "市面上所有讲单道的书，",
      "token_start": 2020,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 452800,
      "end_ms": 454120,
      "text": "要么是秘传口诀，",
      "token_start": 2030,
      "token_end_exclusive": 2037
    },
    {
      "start_ms": 454120,
      "end_ms": 455265,
      "text": "大公开的猎奇，",
      "token_start": 2037,
      "token_end_exclusive": 2043
    },
    {
      "start_ms": 455670,
      "end_ms": 458690,
      "text": "要么是三天结单七天出神的江湖骗术，",
      "token_start": 2043,
      "token_end_exclusive": 2059
    },
    {
      "start_ms": 458750,
      "end_ms": 460710,
      "text": "你被这两种东西夹击了几十年，",
      "token_start": 2059,
      "token_end_exclusive": 2072
    },
    {
      "start_ms": 460910,
      "end_ms": 461890,
      "text": "结论只有一个，",
      "token_start": 2072,
      "token_end_exclusive": 2078
    },
    {
      "start_ms": 462190,
      "end_ms": 463175,
      "text": "单道是假的。",
      "token_start": 2078,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 463750,
      "end_ms": 466175,
      "text": "胡福琛做了一件前无古人的事儿。",
      "token_start": 2083,
      "token_end_exclusive": 2097
    },
    {
      "start_ms": 466810,
      "end_ms": 467670,
      "text": "一九八零年，",
      "token_start": 2097,
      "token_end_exclusive": 2102
    },
    {
      "start_ms": 467750,
      "end_ms": 469490,
      "text": "他接受钱学森院士的委托，",
      "token_start": 2102,
      "token_end_exclusive": 2113
    },
    {
      "start_ms": 469770,
      "end_ms": 471295,
      "text": "为人体科学做贡献，",
      "token_start": 2113,
      "token_end_exclusive": 2121
    },
    {
      "start_ms": 471690,
      "end_ms": 473130,
      "text": "跋涉江湖遍迹，",
      "token_start": 2121,
      "token_end_exclusive": 2127
    },
    {
      "start_ms": 473130,
      "end_ms": 474710,
      "text": "山林倾覆康葬，",
      "token_start": 2127,
      "token_end_exclusive": 2133
    },
    {
      "start_ms": 474930,
      "end_ms": 475825,
      "text": "出入禅秘。",
      "token_start": 2133,
      "token_end_exclusive": 2137
    },
    {
      "start_ms": 476150,
      "end_ms": 477250,
      "text": "历时二十六年，",
      "token_start": 2137,
      "token_end_exclusive": 2143
    },
    {
      "start_ms": 477450,
      "end_ms": 482210,
      "text": "以现代科学和中西哲学精神分析学、中西医学的视角，",
      "token_start": 2143,
      "token_end_exclusive": 2165
    },
    {
      "start_ms": 482250,
      "end_ms": 483690,
      "text": "破译内丹学的奥秘。",
      "token_start": 2165,
      "token_end_exclusive": 2173
    },
    {
      "start_ms": 483770,
      "end_ms": 485530,
      "text": "一个南开化学系毕业的人，",
      "token_start": 2173,
      "token_end_exclusive": 2184
    },
    {
      "start_ms": 485710,
      "end_ms": 489960,
      "text": "把丹金当化学实验记录来读考证文献源流，",
      "token_start": 2184,
      "token_end_exclusive": 2202
    },
    {
      "start_ms": 490200,
      "end_ms": 491500,
      "text": "辨别后世赋会，",
      "token_start": 2202,
      "token_end_exclusive": 2208
    },
    {
      "start_ms": 491760,
      "end_ms": 494035,
      "text": "运用信息论与系统科学思想，",
      "token_start": 2208,
      "token_end_exclusive": 2220
    },
    {
      "start_ms": 494290,
      "end_ms": 497565,
      "text": "将散乱如碎片的单晶概念进行逻辑归类。",
      "token_start": 2220,
      "token_end_exclusive": 2237
    },
    {
      "start_ms": 498630,
      "end_ms": 508085,
      "text": "他出版了单道法诀十二讲分数自身阴阳清净单法、虚空阴阳丹、法西派单法等三家四派修炼体系，",
      "token_start": 2237,
      "token_end_exclusive": 2277
    },
    {
      "start_ms": 508450,
      "end_ms": 511385,
      "text": "归纳南宗北宗等九派单法要诀。",
      "token_start": 2277,
      "token_end_exclusive": 2290
    },
    {
      "start_ms": 511810,
      "end_ms": 513825,
      "text": "但他做这件事的代价是巨大的。",
      "token_start": 2290,
      "token_end_exclusive": 2303
    },
    {
      "start_ms": 514570,
      "end_ms": 515350,
      "text": "学术界说，",
      "token_start": 2303,
      "token_end_exclusive": 2307
    },
    {
      "start_ms": 515430,
      "end_ms": 518540,
      "text": "他把学术搞成了玄学修行界说，",
      "token_start": 2307,
      "token_end_exclusive": 2320
    },
    {
      "start_ms": 518540,
      "end_ms": 520425,
      "text": "他把秘传泄露给了凡人，",
      "token_start": 2320,
      "token_end_exclusive": 2330
    },
    {
      "start_ms": 520840,
      "end_ms": 522340,
      "text": "两边都不认他有人拿。",
      "token_start": 2330,
      "token_end_exclusive": 2339
    },
    {
      "start_ms": 522340,
      "end_ms": 524180,
      "text": "他和张志顺道长比较说，",
      "token_start": 2339,
      "token_end_exclusive": 2349
    },
    {
      "start_ms": 524180,
      "end_ms": 525120,
      "text": "他修炼几十年，",
      "token_start": 2349,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 525140,
      "end_ms": 526515,
      "text": "精神状态还不如普通人。",
      "token_start": 2355,
      "token_end_exclusive": 2365
    },
    {
      "start_ms": 527020,
      "end_ms": 528175,
      "text": "胡福琛自己说，",
      "token_start": 2365,
      "token_end_exclusive": 2371
    },
    {
      "start_ms": 528540,
      "end_ms": 529855,
      "text": "他干冒诸多诽谤，",
      "token_start": 2371,
      "token_end_exclusive": 2378
    },
    {
      "start_ms": 530160,
      "end_ms": 532825,
      "text": "将单道绝学从天上搬到人间，",
      "token_start": 2378,
      "token_end_exclusive": 2390
    },
    {
      "start_ms": 533110,
      "end_ms": 534510,
      "text": "从江湖文化改造，",
      "token_start": 2390,
      "token_end_exclusive": 2397
    },
    {
      "start_ms": 534510,
      "end_ms": 536610,
      "text": "为学术文化更无意忘传。",
      "token_start": 2397,
      "token_end_exclusive": 2407
    },
    {
      "start_ms": 536630,
      "end_ms": 538030,
      "text": "匪人使之得法后，",
      "token_start": 2407,
      "token_end_exclusive": 2414
    },
    {
      "start_ms": 538090,
      "end_ms": 540050,
      "text": "以邪教或是邪道骗财，",
      "token_start": 2414,
      "token_end_exclusive": 2423
    },
    {
      "start_ms": 540450,
      "end_ms": 543450,
      "text": "而是要借此培养和成就一批道学人才，",
      "token_start": 2423,
      "token_end_exclusive": 2439
    },
    {
      "start_ms": 543750,
      "end_ms": 546145,
      "text": "将新道学文化推向全世界。",
      "token_start": 2439,
      "token_end_exclusive": 2450
    },
    {
      "start_ms": 546700,
      "end_ms": 547100,
      "text": "这段话，",
      "token_start": 2450,
      "token_end_exclusive": 2453
    },
    {
      "start_ms": 547100,
      "end_ms": 547835,
      "text": "你仔细读，",
      "token_start": 2453,
      "token_end_exclusive": 2457
    },
    {
      "start_ms": 548110,
      "end_ms": 550715,
      "text": "会发现他根本不是要证明单道灵不灵。",
      "token_start": 2457,
      "token_end_exclusive": 2473
    },
    {
      "start_ms": 551090,
      "end_ms": 555045,
      "text": "他要证明的是一个被江湖骗子糟蹋了两千年的东西，",
      "token_start": 2473,
      "token_end_exclusive": 2495
    },
    {
      "start_ms": 555330,
      "end_ms": 558455,
      "text": "能不能用现代学术的方法论把它抢救回来，",
      "token_start": 2495,
      "token_end_exclusive": 2513
    },
    {
      "start_ms": 558710,
      "end_ms": 561270,
      "text": "让他从迷信变成可研究的对象。",
      "token_start": 2513,
      "token_end_exclusive": 2526
    },
    {
      "start_ms": 561390,
      "end_ms": 562470,
      "text": "你骂他是迷信，",
      "token_start": 2526,
      "token_end_exclusive": 2532
    },
    {
      "start_ms": 562670,
      "end_ms": 565370,
      "text": "你根本没给他被认真对待的机会。",
      "token_start": 2532,
      "token_end_exclusive": 2546
    },
    {
      "start_ms": 565550,
      "end_ms": 566110,
      "text": "第五层，",
      "token_start": 2546,
      "token_end_exclusive": 2549
    },
    {
      "start_ms": 566110,
      "end_ms": 567640,
      "text": "颠覆道学，",
      "token_start": 2549,
      "token_end_exclusive": 2553
    },
    {
      "start_ms": 567720,
      "end_ms": 568580,
      "text": "不是中国的，",
      "token_start": 2553,
      "token_end_exclusive": 2558
    },
    {
      "start_ms": 568720,
      "end_ms": 570460,
      "text": "是全人类的文化战略。",
      "token_start": 2558,
      "token_end_exclusive": 2567
    },
    {
      "start_ms": 570460,
      "end_ms": 571235,
      "text": "你可能会问，",
      "token_start": 2567,
      "token_end_exclusive": 2572
    },
    {
      "start_ms": 571670,
      "end_ms": 572270,
      "text": "说来说去，",
      "token_start": 2572,
      "token_end_exclusive": 2576
    },
    {
      "start_ms": 572270,
      "end_ms": 574305,
      "text": "不还是弘扬传统文化那一套吗？",
      "token_start": 2576,
      "token_end_exclusive": 2589
    },
    {
      "start_ms": 574860,
      "end_ms": 576815,
      "text": "胡福琛的答案比这狠十倍。",
      "token_start": 2589,
      "token_end_exclusive": 2600
    },
    {
      "start_ms": 577060,
      "end_ms": 577525,
      "text": "他说，",
      "token_start": 2600,
      "token_end_exclusive": 2602
    },
    {
      "start_ms": 578020,
      "end_ms": 578960,
      "text": "创立新道学，",
      "token_start": 2602,
      "token_end_exclusive": 2607
    },
    {
      "start_ms": 579100,
      "end_ms": 585295,
      "text": "是中华民族在世界历史潮流中审时度势、应变、自强的唯一可行的文化战略。",
      "token_start": 2607,
      "token_end_exclusive": 2638
    },
    {
      "start_ms": 585670,
      "end_ms": 586110,
      "text": "注意，",
      "token_start": 2638,
      "token_end_exclusive": 2640
    },
    {
      "start_ms": 586290,
      "end_ms": 588285,
      "text": "他用的词是唯一可行，",
      "token_start": 2640,
      "token_end_exclusive": 2649
    },
    {
      "start_ms": 588750,
      "end_ms": 590205,
      "text": "这不是文化自信的口号，",
      "token_start": 2649,
      "token_end_exclusive": 2659
    },
    {
      "start_ms": 590520,
      "end_ms": 592895,
      "text": "是一个学者对文明存亡的判断。",
      "token_start": 2659,
      "token_end_exclusive": 2672
    },
    {
      "start_ms": 593470,
      "end_ms": 596790,
      "text": "他把新道学定义为中国文化的第三次重构，",
      "token_start": 2672,
      "token_end_exclusive": 2690
    },
    {
      "start_ms": 597210,
      "end_ms": 603350,
      "text": "以对道学这一全人类共同的原生态文化进行综合创新和现代诠释为基础，",
      "token_start": 2690,
      "token_end_exclusive": 2721
    },
    {
      "start_ms": 603890,
      "end_ms": 606225,
      "text": "吸收儒学佛学中的合理因素。",
      "token_start": 2721,
      "token_end_exclusive": 2733
    },
    {
      "start_ms": 606530,
      "end_ms": 609010,
      "text": "将西方现代文明的精华吸收进来，",
      "token_start": 2733,
      "token_end_exclusive": 2747
    },
    {
      "start_ms": 609210,
      "end_ms": 614110,
      "text": "与中华文明融合为有机整体创立及古今中外文明之精华。",
      "token_start": 2747,
      "token_end_exclusive": 2771
    },
    {
      "start_ms": 614310,
      "end_ms": 616190,
      "text": "有时代精神的新道学，",
      "token_start": 2771,
      "token_end_exclusive": 2780
    },
    {
      "start_ms": 616290,
      "end_ms": 617090,
      "text": "普世文明，",
      "token_start": 2780,
      "token_end_exclusive": 2784
    },
    {
      "start_ms": 617390,
      "end_ms": 619790,
      "text": "以解决全世界共同面对的问题，",
      "token_start": 2784,
      "token_end_exclusive": 2797
    },
    {
      "start_ms": 620370,
      "end_ms": 621290,
      "text": "你听出来了吗？",
      "token_start": 2797,
      "token_end_exclusive": 2803
    },
    {
      "start_ms": 621530,
      "end_ms": 623610,
      "text": "他说的不是中国要输出文化。",
      "token_start": 2803,
      "token_end_exclusive": 2815
    },
    {
      "start_ms": 624090,
      "end_ms": 624810,
      "text": "他说的是，",
      "token_start": 2815,
      "token_end_exclusive": 2819
    },
    {
      "start_ms": 625110,
      "end_ms": 627050,
      "text": "人类只有这一条路，",
      "token_start": 2819,
      "token_end_exclusive": 2827
    },
    {
      "start_ms": 627050,
      "end_ms": 633850,
      "text": "可以走生态危机、精神危机、文明冲突、西方主客二分的思维模式制造了这些问题。",
      "token_start": 2827,
      "token_end_exclusive": 2860
    },
    {
      "start_ms": 634230,
      "end_ms": 636940,
      "text": "而道学的天人合一、两重世界，",
      "token_start": 2860,
      "token_end_exclusive": 2872
    },
    {
      "start_ms": 637080,
      "end_ms": 637900,
      "text": "自然之治，",
      "token_start": 2872,
      "token_end_exclusive": 2876
    },
    {
      "start_ms": 638120,
      "end_ms": 641240,
      "text": "是唯一能提供系统性解决方案的思想资源。",
      "token_start": 2876,
      "token_end_exclusive": 2894
    },
    {
      "start_ms": 641320,
      "end_ms": 642320,
      "text": "胡富琛还指出，",
      "token_start": 2894,
      "token_end_exclusive": 2900
    },
    {
      "start_ms": 642680,
      "end_ms": 648000,
      "text": "道学文化的新科学观必将为二十一世纪的新科学革命指明方向，",
      "token_start": 2900,
      "token_end_exclusive": 2927
    },
    {
      "start_ms": 648220,
      "end_ms": 650820,
      "text": "使科学和哲学、宗教相统一，",
      "token_start": 2927,
      "token_end_exclusive": 2938
    },
    {
      "start_ms": 651040,
      "end_ms": 653140,
      "text": "成为大家可以广泛了解的学问。",
      "token_start": 2938,
      "token_end_exclusive": 2951
    },
    {
      "start_ms": 653220,
      "end_ms": 657820,
      "text": "他把道学从地方性知识提升到了普适性方案的高度。",
      "token_start": 2951,
      "token_end_exclusive": 2973
    },
    {
      "start_ms": 658120,
      "end_ms": 660860,
      "text": "你还在争论国学该不该进课堂的时候，",
      "token_start": 2973,
      "token_end_exclusive": 2989
    },
    {
      "start_ms": 661000,
      "end_ms": 664820,
      "text": "他已经把道学放到了整个人类文明演化的棋盘上。",
      "token_start": 2989,
      "token_end_exclusive": 3010
    },
    {
      "start_ms": 664880,
      "end_ms": 665780,
      "text": "读完道学入门，",
      "token_start": 3010,
      "token_end_exclusive": 3016
    },
    {
      "start_ms": 666040,
      "end_ms": 668245,
      "text": "你可能发现书名起的太朴素了。",
      "token_start": 3016,
      "token_end_exclusive": 3029
    },
    {
      "start_ms": 668770,
      "end_ms": 670050,
      "text": "这不是一本入门读物，",
      "token_start": 3029,
      "token_end_exclusive": 3038
    },
    {
      "start_ms": 670310,
      "end_ms": 676075,
      "text": "是一本关于人如何在一个被规律支配的世界里看清自己位置的生存手册。",
      "token_start": 3038,
      "token_end_exclusive": 3069
    },
    {
      "start_ms": 676380,
      "end_ms": 677460,
      "text": "无为不是重点，",
      "token_start": 3069,
      "token_end_exclusive": 3075
    },
    {
      "start_ms": 677620,
      "end_ms": 678975,
      "text": "八大支柱不是重点，",
      "token_start": 3075,
      "token_end_exclusive": 3083
    },
    {
      "start_ms": 679340,
      "end_ms": 680920,
      "text": "升国同构不是重点，",
      "token_start": 3083,
      "token_end_exclusive": 3091
    },
    {
      "start_ms": 681020,
      "end_ms": 684745,
      "text": "重点是那个从化学系转身走向江湖的学者。",
      "token_start": 3091,
      "token_end_exclusive": 3109
    },
    {
      "start_ms": 685190,
      "end_ms": 687540,
      "text": "在钱学森四十年的注视下面，",
      "token_start": 3109,
      "token_end_exclusive": 3121
    },
    {
      "start_ms": 687540,
      "end_ms": 692285,
      "text": "对一个充斥着伪气功、假道学和认知混乱的世界说，",
      "token_start": 3121,
      "token_end_exclusive": 3142
    },
    {
      "start_ms": 692740,
      "end_ms": 693935,
      "text": "我不服从标签，",
      "token_start": 3142,
      "token_end_exclusive": 3148
    },
    {
      "start_ms": 694260,
      "end_ms": 695315,
      "text": "我只服从事实。",
      "token_start": 3148,
      "token_end_exclusive": 3154
    },
    {
      "start_ms": 695980,
      "end_ms": 697005,
      "text": "他看见了什么呢？",
      "token_start": 3154,
      "token_end_exclusive": 3161
    },
    {
      "start_ms": 697680,
      "end_ms": 699240,
      "text": "他看见每一个顺其自然，",
      "token_start": 3161,
      "token_end_exclusive": 3171
    },
    {
      "start_ms": 699240,
      "end_ms": 701670,
      "text": "背后都藏着不敢面对的怯懦。",
      "token_start": 3171,
      "token_end_exclusive": 3183
    },
    {
      "start_ms": 701710,
      "end_ms": 702750,
      "text": "每一个想开点，",
      "token_start": 3183,
      "token_end_exclusive": 3189
    },
    {
      "start_ms": 702750,
      "end_ms": 703150,
      "text": "背后，",
      "token_start": 3189,
      "token_end_exclusive": 3191
    },
    {
      "start_ms": 703330,
      "end_ms": 705170,
      "text": "都藏着不愿深究的懒惰。",
      "token_start": 3191,
      "token_end_exclusive": 3201
    },
    {
      "start_ms": 705270,
      "end_ms": 709495,
      "text": "每一个个人选择背后都藏着一套你从未看清的规律，",
      "token_start": 3201,
      "token_end_exclusive": 3223
    },
    {
      "start_ms": 709830,
      "end_ms": 712295,
      "text": "而你有幸可以学会看懂这一切。",
      "token_start": 3223,
      "token_end_exclusive": 3236
    },
    {
      "start_ms": 712920,
      "end_ms": 717465,
      "text": "这本书里有一句话是胡福琛在阐述道学核心思想时写的，",
      "token_start": 3236,
      "token_end_exclusive": 3260
    },
    {
      "start_ms": 717780,
      "end_ms": 718775,
      "text": "我想把它送给你。",
      "token_start": 3260,
      "token_end_exclusive": 3267
    },
    {
      "start_ms": 719080,
      "end_ms": 721345,
      "text": "道学不是让你变得超凡脱俗，",
      "token_start": 3267,
      "token_end_exclusive": 3279
    },
    {
      "start_ms": 721810,
      "end_ms": 724935,
      "text": "让你超凡脱俗的是你的修行和悟性，",
      "token_start": 3279,
      "token_end_exclusive": 3294
    },
    {
      "start_ms": 725500,
      "end_ms": 728850,
      "text": "但倒学可以让你少犯一种错误那种，",
      "token_start": 3294,
      "token_end_exclusive": 3309
    },
    {
      "start_ms": 728850,
      "end_ms": 732334,
      "text": "因为你不知道自己在被什么推着走而犯的错误。",
      "token_start": 3309,
      "token_end_exclusive": 3329
    },
    {
      "start_ms": 733270,
      "end_ms": 734935,
      "text": "如果你读到这里还没有划走，",
      "token_start": 3329,
      "token_end_exclusive": 3341
    },
    {
      "start_ms": 735300,
      "end_ms": 738425,
      "text": "如果你隐约觉得过去对道的理解可能出了问题，",
      "token_start": 3341,
      "token_end_exclusive": 3361
    },
    {
      "start_ms": 739000,
      "end_ms": 743855,
      "text": "如果你愿意给自己一个机会去重新认识这套被误解了几千年的认知系统，",
      "token_start": 3361,
      "token_end_exclusive": 3392
    },
    {
      "start_ms": 744250,
      "end_ms": 747065,
      "text": "那么这本道学入门值得你带回家。",
      "token_start": 3392,
      "token_end_exclusive": 3406
    },
    {
      "start_ms": 747480,
      "end_ms": 749095,
      "text": "它不是一本让你舒服的书，",
      "token_start": 3406,
      "token_end_exclusive": 3417
    },
    {
      "start_ms": 749410,
      "end_ms": 751295,
      "text": "但它可能是一本让你清醒的书。",
      "token_start": 3417,
      "token_end_exclusive": 3430
    },
    {
      "start_ms": 751600,
      "end_ms": 752300,
      "text": "我是小海龟，",
      "token_start": 3430,
      "token_end_exclusive": 3435
    },
    {
      "start_ms": 752480,
      "end_ms": 753940,
      "text": "欢迎持续关注我们，",
      "token_start": 3435,
      "token_end_exclusive": 3443
    },
    {
      "start_ms": 753940,
      "end_ms": 754545,
      "text": "下本书见。",
      "token_start": 3443,
      "token_end_exclusive": 3447
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
