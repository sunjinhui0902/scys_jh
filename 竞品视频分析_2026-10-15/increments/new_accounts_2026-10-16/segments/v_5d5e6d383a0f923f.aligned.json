{
  "video_id": "v_5d5e6d383a0f923f",
  "duration_s": 487.387007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_5d5e6d383a0f923f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_5d5e6d383a0f923f.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 370,
      "end_ms": 5590,
      "text": "本视频八分钟讲解钱目中国历代政治得失中十个核心观点，",
      "token_start": 0,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5750,
      "end_ms": 7210,
      "text": "建议先收藏再观看。",
      "token_start": 25,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 7750,
      "end_ms": 9110,
      "text": "你有没有过这样的时刻，",
      "token_start": 33,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9590,
      "end_ms": 10610,
      "text": "翻开历史课本，",
      "token_start": 43,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 11030,
      "end_ms": 13130,
      "text": "只觉得皇帝更替、制度变迁，",
      "token_start": 49,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 13490,
      "end_ms": 14870,
      "text": "像一锅煮糊的粥，",
      "token_start": 60,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 15530,
      "end_ms": 18510,
      "text": "看不清哪个朝代真正改变了中国人的命运。",
      "token_start": 67,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 18710,
      "end_ms": 22350,
      "text": "我们背了那么多科举制、郡县制、三省六部制，",
      "token_start": 85,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 22650,
      "end_ms": 25930,
      "text": "却不知道这些制度背后藏着怎样的挣扎与妥协。",
      "token_start": 103,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 26550,
      "end_ms": 28510,
      "text": "你明明对传统文化有敬畏，",
      "token_start": 123,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 28750,
      "end_ms": 34820,
      "text": "却一不小心被五千年专制黑暗的论断裹挟那种状态叫历史失语，",
      "token_start": 134,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 35240,
      "end_ms": 36500,
      "text": "但你自己都没察觉。",
      "token_start": 161,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 37020,
      "end_ms": 41640,
      "text": "钱穆先生的中国历代政治得失就是一把劈开历史迷雾的刀。",
      "token_start": 169,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 42240,
      "end_ms": 45120,
      "text": "这位被誉为最后一位通儒的国学大师，",
      "token_start": 194,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 45380,
      "end_ms": 49540,
      "text": "在一九五二年用五次演讲炸翻了当时主流的历史观。",
      "token_start": 210,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 50080,
      "end_ms": 50500,
      "text": "他说，",
      "token_start": 232,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 50980,
      "end_ms": 54260,
      "text": "中国政治不是一句封建专制就能概括的，",
      "token_start": 234,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 54680,
      "end_ms": 56960,
      "text": "每个制度诞生时都充满理想，",
      "token_start": 251,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 57180,
      "end_ms": 59000,
      "text": "都试图解决当下的困境。",
      "token_start": 263,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 59060,
      "end_ms": 63175,
      "text": "今天我们就来解如这本宝宝小书里藏着的十大核心观点。",
      "token_start": 273,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 63400,
      "end_ms": 64065,
      "text": "观点一，",
      "token_start": 297,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 64500,
      "end_ms": 65895,
      "text": "制度是长出来的，",
      "token_start": 300,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 66110,
      "end_ms": 67135,
      "text": "不是画出来的。",
      "token_start": 307,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 67620,
      "end_ms": 70015,
      "text": "钱穆开篇就甩出一个颠覆性认知，",
      "token_start": 313,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 70380,
      "end_ms": 73695,
      "text": "中国历代政治制度从来不是某个天才设计的，",
      "token_start": 327,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 73970,
      "end_ms": 75910,
      "text": "而是从土壤里生长出来的。",
      "token_start": 346,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 75950,
      "end_ms": 77090,
      "text": "汉朝搞郡县制，",
      "token_start": 357,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 77210,
      "end_ms": 79105,
      "text": "是因为周朝分封制玩崩了。",
      "token_start": 363,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 79610,
      "end_ms": 82920,
      "text": "唐朝用科举制是因为贵族集团尾大不掉，",
      "token_start": 374,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 83000,
      "end_ms": 84920,
      "text": "每个制度在诞生时都是解药，",
      "token_start": 391,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 85160,
      "end_ms": 87165,
      "text": "只是时间久了变成新病灶。",
      "token_start": 403,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 87930,
      "end_ms": 91000,
      "text": "就像你家里那张传了三代的木头桌子边，",
      "token_start": 414,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 91000,
      "end_ms": 91825,
      "text": "角膜亮了，",
      "token_start": 431,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 92120,
      "end_ms": 93075,
      "text": "笋头松动了，",
      "token_start": 435,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 93400,
      "end_ms": 95700,
      "text": "但每道痕迹都是生活的见证，",
      "token_start": 440,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 95880,
      "end_ms": 96880,
      "text": "制度也会包浆，",
      "token_start": 452,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 97160,
      "end_ms": 97985,
      "text": "也会开裂，",
      "token_start": 458,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 98270,
      "end_ms": 99525,
      "text": "但不能因为他救了。",
      "token_start": 462,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 99680,
      "end_ms": 100575,
      "text": "就骂他是废品。",
      "token_start": 470,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 101140,
      "end_ms": 101745,
      "text": "观点二，",
      "token_start": 476,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 102130,
      "end_ms": 105880,
      "text": "黄泉与象泉的千年拔河最精彩的解读。",
      "token_start": 479,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 105940,
      "end_ms": 108340,
      "text": "在汉代宰相制钱穆说，",
      "token_start": 495,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 108560,
      "end_ms": 111335,
      "text": "汉代宰相是秘书处长错，",
      "token_start": 504,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 111790,
      "end_ms": 114670,
      "text": "那是真正的一人之下万人之上。",
      "token_start": 514,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 114750,
      "end_ms": 116050,
      "text": "皇帝诏书没有宰相，",
      "token_start": 527,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 116050,
      "end_ms": 117085,
      "text": "附属就是废纸。",
      "token_start": 535,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 117520,
      "end_ms": 118945,
      "text": "宰相不仅有行政权，",
      "token_start": 541,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 119230,
      "end_ms": 120635,
      "text": "才能封驳皇帝意见，",
      "token_start": 549,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 120980,
      "end_ms": 122720,
      "text": "直到汉武帝搞内朝夺权，",
      "token_start": 557,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 123080,
      "end_ms": 125255,
      "text": "宰相才慢慢变成磕头大臣。",
      "token_start": 567,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 125830,
      "end_ms": 128295,
      "text": "这就像公司CEO和董事会的关系，",
      "token_start": 578,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 128750,
      "end_ms": 133270,
      "text": "最初董事会能制约CEO.后来CEO把自己的助理提拔成高管，",
      "token_start": 591,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 133490,
      "end_ms": 134810,
      "text": "慢慢架空了董事会。",
      "token_start": 614,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 134950,
      "end_ms": 136825,
      "text": "这场权力博弈持续千年，",
      "token_start": 622,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 137150,
      "end_ms": 142945,
      "text": "直到明朝朱元璋彻底废除宰相制观点单科举不是八股文的锅，",
      "token_start": 632,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 143410,
      "end_ms": 144450,
      "text": "提到科举就骂，",
      "token_start": 658,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 144450,
      "end_ms": 146345,
      "text": "八股文前目冷笑。",
      "token_start": 664,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 146860,
      "end_ms": 148340,
      "text": "唐代科举考诗赋，",
      "token_start": 671,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 148640,
      "end_ms": 149700,
      "text": "宋代考精益，",
      "token_start": 678,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 149940,
      "end_ms": 151505,
      "text": "明代才定型为八股。",
      "token_start": 683,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 152010,
      "end_ms": 153425,
      "text": "在门阀世袭的年代，",
      "token_start": 691,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 153760,
      "end_ms": 156495,
      "text": "科举让寒门子弟能靠着读书改命，",
      "token_start": 699,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 156860,
      "end_ms": 158815,
      "text": "这简直是颠覆性的社会革命。",
      "token_start": 713,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 159120,
      "end_ms": 160835,
      "text": "就像现在高考再被诟病，",
      "token_start": 725,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 161090,
      "end_ms": 163495,
      "text": "仍是底层跨越阶层最公平的路径。",
      "token_start": 735,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 164300,
      "end_ms": 167515,
      "text": "唐代有人唱着太宗皇帝珍长册，",
      "token_start": 749,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 167840,
      "end_ms": 169785,
      "text": "赚得英雄尽白头，",
      "token_start": 762,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 170430,
      "end_ms": 173715,
      "text": "皇帝用考试这把锁链拴住天下聪明人，",
      "token_start": 769,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 174000,
      "end_ms": 175880,
      "text": "但也给了他们向上的阶梯。",
      "token_start": 785,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 176000,
      "end_ms": 176695,
      "text": "观点四，",
      "token_start": 796,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 177330,
      "end_ms": 179770,
      "text": "赋税制度是王朝的呼吸节奏，",
      "token_start": 799,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 180050,
      "end_ms": 182885,
      "text": "租庸调制两税法一条编法。",
      "token_start": 811,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 183240,
      "end_ms": 187025,
      "text": "这些枯燥名词被钱穆讲成了王朝的生命体征报告。",
      "token_start": 822,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 187630,
      "end_ms": 191885,
      "text": "唐代租庸调向现代个税每人交定量的两步。",
      "token_start": 843,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 192350,
      "end_ms": 192870,
      "text": "不劳役，",
      "token_start": 861,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 192990,
      "end_ms": 194365,
      "text": "但随着土地兼并严重，",
      "token_start": 864,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 194610,
      "end_ms": 195490,
      "text": "安史之乱后，",
      "token_start": 873,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 195530,
      "end_ms": 196310,
      "text": "不得不改行。",
      "token_start": 878,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 196350,
      "end_ms": 199775,
      "text": "两税法从按人收费变成按财产收费。",
      "token_start": 883,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 200210,
      "end_ms": 202625,
      "text": "最震撼的是明朝一条编法，",
      "token_start": 898,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 203040,
      "end_ms": 205640,
      "text": "张居正把田赋徭役杂税，",
      "token_start": 909,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 205780,
      "end_ms": 206880,
      "text": "折成银两征收，",
      "token_start": 919,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 207000,
      "end_ms": 208140,
      "text": "看似简化税制，",
      "token_start": 925,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 208240,
      "end_ms": 209615,
      "text": "却埋下致命隐患。",
      "token_start": 931,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 210030,
      "end_ms": 212010,
      "text": "农民要卖粮、换银交税，",
      "token_start": 938,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 212250,
      "end_ms": 215460,
      "text": "中间被商人盘剥一层白银流通不足时，",
      "token_start": 947,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 215600,
      "end_ms": 216825,
      "text": "甚至要卖儿卖女。",
      "token_start": 963,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 217200,
      "end_ms": 220420,
      "text": "一个好处衷如何一步步变成百姓的枷索。",
      "token_start": 970,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 220540,
      "end_ms": 221345,
      "text": "观点五，",
      "token_start": 987,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 221760,
      "end_ms": 223985,
      "text": "军队是王朝的免疫系统，",
      "token_start": 990,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 224410,
      "end_ms": 226755,
      "text": "府兵制牧兵制位所制。",
      "token_start": 1000,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 227380,
      "end_ms": 230345,
      "text": "每个军事制度都是王朝的免疫系统重建。",
      "token_start": 1009,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 230780,
      "end_ms": 233240,
      "text": "唐代府兵制最精妙士兵，",
      "token_start": 1026,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 233240,
      "end_ms": 236980,
      "text": "平时种地战时自备武器出征国家省了军费，",
      "token_start": 1036,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 237080,
      "end_ms": 238515,
      "text": "还避免了军阀割据。",
      "token_start": 1054,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 239000,
      "end_ms": 240140,
      "text": "但随着战争延长，",
      "token_start": 1062,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 240420,
      "end_ms": 241560,
      "text": "农民不堪重负，",
      "token_start": 1069,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 241800,
      "end_ms": 242620,
      "text": "终于崩溃。",
      "token_start": 1075,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 242840,
      "end_ms": 245355,
      "text": "宋朝的杯酒释兵权看似聪明，",
      "token_start": 1079,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 245590,
      "end_ms": 247005,
      "text": "却导致军事积弱。",
      "token_start": 1091,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 247450,
      "end_ms": 248755,
      "text": "钱穆痛心疾首，",
      "token_start": 1098,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 249280,
      "end_ms": 252000,
      "text": "赵匡胤为防军阀割禁绝武将掌权，",
      "token_start": 1104,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 252300,
      "end_ms": 253685,
      "text": "结果文人带兵打仗，",
      "token_start": 1118,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 253910,
      "end_ms": 255490,
      "text": "对外战争胜率不到三成，",
      "token_start": 1126,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 255670,
      "end_ms": 259155,
      "text": "过度防御的免疫系统反而让王朝死于并发症。",
      "token_start": 1136,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 259500,
      "end_ms": 260020,
      "text": "观点六，",
      "token_start": 1155,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 260380,
      "end_ms": 262265,
      "text": "地方政府的三明治困境，",
      "token_start": 1158,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 262640,
      "end_ms": 265900,
      "text": "钱穆用央帝关系解构历代王朝死穴。",
      "token_start": 1168,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 266040,
      "end_ms": 270925,
      "text": "汉代郡守能自主辟暑疗蜀唐代刺史甚至有就地处决权。",
      "token_start": 1183,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 271510,
      "end_ms": 272210,
      "text": "到明清时，",
      "token_start": 1206,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 272450,
      "end_ms": 274970,
      "text": "县令连修个桥都要上报地方，",
      "token_start": 1210,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 274970,
      "end_ms": 276390,
      "text": "活力被层层掐灭。",
      "token_start": 1222,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 276490,
      "end_ms": 278470,
      "text": "这就像大公司病创业期，",
      "token_start": 1229,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 278530,
      "end_ms": 280070,
      "text": "各地分公司大胆创新，",
      "token_start": 1239,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 280370,
      "end_ms": 280950,
      "text": "壮大后，",
      "token_start": 1248,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 280970,
      "end_ms": 282265,
      "text": "总部拼命收权，",
      "token_start": 1251,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 282610,
      "end_ms": 284810,
      "text": "最后所有决策都要等红头文件，",
      "token_start": 1257,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 284930,
      "end_ms": 286895,
      "text": "明朝县令薪资低到要饿死，",
      "token_start": 1270,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 287260,
      "end_ms": 289640,
      "text": "清官海瑞母亲过寿才能买两斤肉。",
      "token_start": 1281,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 289940,
      "end_ms": 290965,
      "text": "如何不贪污？",
      "token_start": 1295,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 291400,
      "end_ms": 294115,
      "text": "关键七、历史的眼镜不能反着戴。",
      "token_start": 1300,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 294550,
      "end_ms": 297605,
      "text": "钱穆最狠批驳是历史倒视镜现象，",
      "token_start": 1313,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 297910,
      "end_ms": 300615,
      "text": "拿着现代民主标准去审判古代制度，",
      "token_start": 1327,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 300930,
      "end_ms": 301790,
      "text": "就像骂古人，",
      "token_start": 1342,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 301810,
      "end_ms": 302830,
      "text": "为什么不用手机？",
      "token_start": 1347,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 303110,
      "end_ms": 304905,
      "text": "郡县制在秦朝是进步，",
      "token_start": 1354,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 305280,
      "end_ms": 306785,
      "text": "科举在隋唐是革命。",
      "token_start": 1363,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 307170,
      "end_ms": 308910,
      "text": "不能因为他们后来僵化了，",
      "token_start": 1371,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 308910,
      "end_ms": 309930,
      "text": "就否定全部。",
      "token_start": 1382,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 310570,
      "end_ms": 311250,
      "text": "他比喻说，",
      "token_start": 1387,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 311570,
      "end_ms": 316090,
      "text": "我们不能因为长大穿了四十三码鞋就骂童年穿的布鞋是废物，",
      "token_start": 1391,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 316190,
      "end_ms": 319090,
      "text": "每个制度都曾是与时代搏斗的智慧结晶。",
      "token_start": 1417,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 319650,
      "end_ms": 319990,
      "text": "观点。",
      "token_start": 1434,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 319990,
      "end_ms": 321790,
      "text": "八、制度疲倦症，",
      "token_start": 1436,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 322390,
      "end_ms": 324710,
      "text": "每个王朝都死于代谢衰竭，",
      "token_start": 1442,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 325210,
      "end_ms": 326810,
      "text": "钱穆提出惊人冻见。",
      "token_start": 1453,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 327170,
      "end_ms": 330270,
      "text": "每个制度执行到后期都会出现制度疲倦，",
      "token_start": 1461,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 330830,
      "end_ms": 332430,
      "text": "好比新官上任三把火，",
      "token_start": 1478,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 332750,
      "end_ms": 334170,
      "text": "三个月后开始摸鱼。",
      "token_start": 1487,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 334330,
      "end_ms": 336230,
      "text": "明代锦衣卫最初是监察精英，",
      "token_start": 1495,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 336230,
      "end_ms": 338160,
      "text": "后其变成特务组织。",
      "token_start": 1507,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 338540,
      "end_ms": 340800,
      "text": "清代八骑兵入关时骁勇善战，",
      "token_start": 1515,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 341040,
      "end_ms": 342700,
      "text": "百年后连马都骑不上。",
      "token_start": 1527,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 342980,
      "end_ms": 344080,
      "text": "这不是道德滑坡，",
      "token_start": 1536,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 344360,
      "end_ms": 345940,
      "text": "而是制度性代谢衰竭，",
      "token_start": 1543,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 346260,
      "end_ms": 347680,
      "text": "缺乏自我更新机制，",
      "token_start": 1552,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 347900,
      "end_ms": 349660,
      "text": "就像人体衰老不可避免。",
      "token_start": 1560,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 350280,
      "end_ms": 350860,
      "text": "观点九，",
      "token_start": 1570,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 351460,
      "end_ms": 354460,
      "text": "谁在给历史化妆最刺骨的观点？",
      "token_start": 1573,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 354520,
      "end_ms": 356500,
      "text": "关于历史书写钱穆说，",
      "token_start": 1586,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 356860,
      "end_ms": 359140,
      "text": "二十四史是胜利者的日记，",
      "token_start": 1595,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 359500,
      "end_ms": 361600,
      "text": "但失败者未必没有道理。",
      "token_start": 1606,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 362260,
      "end_ms": 363640,
      "text": "秦始皇焚书坑儒，",
      "token_start": 1616,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 363840,
      "end_ms": 365500,
      "text": "却统一了文字、度量衡。",
      "token_start": 1623,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 366160,
      "end_ms": 367550,
      "text": "武则天篡堂自立，",
      "token_start": 1632,
      "token_end_exclusive": 1639
    },
    {
      "start_ms": 367730,
      "end_ms": 369105,
      "text": "却打破门阀垄断。",
      "token_start": 1639,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 369550,
      "end_ms": 372305,
      "text": "我们要看清历史化妆术下的真容颜。",
      "token_start": 1646,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 372790,
      "end_ms": 373590,
      "text": "他比喻历史，",
      "token_start": 1661,
      "token_end_exclusive": 1666
    },
    {
      "start_ms": 373650,
      "end_ms": 375465,
      "text": "像被反复涂改的羊皮卷，",
      "token_start": 1666,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 375940,
      "end_ms": 377720,
      "text": "我们需要用刀刮开表层，",
      "token_start": 1676,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 378040,
      "end_ms": 379805,
      "text": "看见那些被覆盖的笔记。",
      "token_start": 1686,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 380220,
      "end_ms": 380795,
      "text": "观点时，",
      "token_start": 1696,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 381190,
      "end_ms": 383385,
      "text": "中国政治的血脉从未断绝。",
      "token_start": 1699,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 383700,
      "end_ms": 385865,
      "text": "终极观点落在文化延续性上。",
      "token_start": 1710,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 386650,
      "end_ms": 389385,
      "text": "钱穆反对满清误国三百年的论调。",
      "token_start": 1722,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 390010,
      "end_ms": 393340,
      "text": "满清继承明志明继承元志元，",
      "token_start": 1736,
      "token_end_exclusive": 1748
    },
    {
      "start_ms": 393340,
      "end_ms": 394225,
      "text": "继承宋治，",
      "token_start": 1748,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 394560,
      "end_ms": 397000,
      "text": "每个朝代都在前朝基础上修修补补。",
      "token_start": 1752,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 397280,
      "end_ms": 399465,
      "text": "中华政治有着惊人的延续性，",
      "token_start": 1767,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 399870,
      "end_ms": 401570,
      "text": "就像长江流经各省段，",
      "token_start": 1779,
      "token_end_exclusive": 1788
    },
    {
      "start_ms": 401590,
      "end_ms": 402210,
      "text": "名字不同，",
      "token_start": 1788,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 402470,
      "end_ms": 404135,
      "text": "但水脉从未断绝。",
      "token_start": 1792,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 404510,
      "end_ms": 405950,
      "text": "这种延续性不是守旧，",
      "token_start": 1799,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 406190,
      "end_ms": 407575,
      "text": "而是文明的韧性。",
      "token_start": 1808,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 408110,
      "end_ms": 409585,
      "text": "钱穆在书末写道，",
      "token_start": 1815,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 410090,
      "end_ms": 413105,
      "text": "任何一制度绝不会绝对有利而无弊，",
      "token_start": 1822,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 413410,
      "end_ms": 415395,
      "text": "也不会绝对有弊而无利。",
      "token_start": 1837,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 415700,
      "end_ms": 416440,
      "text": "我们读历史，",
      "token_start": 1847,
      "token_end_exclusive": 1852
    },
    {
      "start_ms": 416640,
      "end_ms": 417805,
      "text": "不是为了骂祖宗，",
      "token_start": 1852,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 418150,
      "end_ms": 420110,
      "text": "而是理解每个选择背后的艰难。",
      "token_start": 1859,
      "token_end_exclusive": 1872
    },
    {
      "start_ms": 420130,
      "end_ms": 420615,
      "text": "权衡。",
      "token_start": 1872,
      "token_end_exclusive": 1874
    },
    {
      "start_ms": 420950,
      "end_ms": 423085,
      "text": "这本书写于一九五二年的香港，",
      "token_start": 1874,
      "token_end_exclusive": 1887
    },
    {
      "start_ms": 423450,
      "end_ms": 425105,
      "text": "当时钱穆流亡海外，",
      "token_start": 1887,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 425380,
      "end_ms": 427085,
      "text": "在新亚书院毕露蓝旅。",
      "token_start": 1895,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 428080,
      "end_ms": 433005,
      "text": "他目睹中国传统文化被全盘否定痛心疾首的写下这些演讲，",
      "token_start": 1904,
      "token_end_exclusive": 1929
    },
    {
      "start_ms": 433380,
      "end_ms": 436385,
      "text": "试图唤回国人对历史的温情与敬意。",
      "token_start": 1929,
      "token_end_exclusive": 1944
    },
    {
      "start_ms": 437010,
      "end_ms": 439365,
      "text": "如果你觉得自己活在制度的夹缝中，",
      "token_start": 1944,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 439730,
      "end_ms": 443395,
      "text": "不妨看看历代官员如何在与制度的博弈中寻找空间。",
      "token_start": 1959,
      "token_end_exclusive": 1981
    },
    {
      "start_ms": 444110,
      "end_ms": 445325,
      "text": "如果你对现实失望，",
      "token_start": 1981,
      "token_end_exclusive": 1989
    },
    {
      "start_ms": 445620,
      "end_ms": 447935,
      "text": "不妨看看那些曾经努力过的改革者。",
      "token_start": 1989,
      "token_end_exclusive": 2004
    },
    {
      "start_ms": 448660,
      "end_ms": 449475,
      "text": "商鞅车裂，",
      "token_start": 2004,
      "token_end_exclusive": 2008
    },
    {
      "start_ms": 449730,
      "end_ms": 454915,
      "text": "王安石罢相张居正掘坟改变制度从来是九死一生，",
      "token_start": 2008,
      "token_end_exclusive": 2029
    },
    {
      "start_ms": 455360,
      "end_ms": 458340,
      "text": "最终极的启示或许是没有完美的制度，",
      "token_start": 2029,
      "token_end_exclusive": 2045
    },
    {
      "start_ms": 458500,
      "end_ms": 460760,
      "text": "只有不断自省和调整的智慧。",
      "token_start": 2045,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 460920,
      "end_ms": 461715,
      "text": "制度会老，",
      "token_start": 2057,
      "token_end_exclusive": 2061
    },
    {
      "start_ms": 462010,
      "end_ms": 463595,
      "text": "但革新可以重生，",
      "token_start": 2061,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 464470,
      "end_ms": 466635,
      "text": "就像那棵生长千年的银杏树，",
      "token_start": 2068,
      "token_end_exclusive": 2080
    },
    {
      "start_ms": 467040,
      "end_ms": 468740,
      "text": "树干中空了树梢，",
      "token_start": 2080,
      "token_end_exclusive": 2087
    },
    {
      "start_ms": 468820,
      "end_ms": 469875,
      "text": "还会发出新芽。",
      "token_start": 2087,
      "token_end_exclusive": 2093
    },
    {
      "start_ms": 470640,
      "end_ms": 471360,
      "text": "今天的我们，",
      "token_start": 2093,
      "token_end_exclusive": 2098
    },
    {
      "start_ms": 471420,
      "end_ms": 472905,
      "text": "站在历史链条的末端，",
      "token_start": 2098,
      "token_end_exclusive": 2107
    },
    {
      "start_ms": 473240,
      "end_ms": 474915,
      "text": "也站在新链条的起点。",
      "token_start": 2107,
      "token_end_exclusive": 2116
    },
    {
      "start_ms": 475730,
      "end_ms": 476810,
      "text": "你准备如何理解？",
      "token_start": 2116,
      "token_end_exclusive": 2123
    },
    {
      "start_ms": 476810,
      "end_ms": 480535,
