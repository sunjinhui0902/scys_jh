{
  "video_id": "v_fa9448dfccdd4269",
  "duration_s": 481.327007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_fa9448dfccdd4269.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_fa9448dfccdd4269.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 1110,
      "text": "八分钟讲解，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1110,
      "end_ms": 2350,
      "text": "余春台穷通宝剑，",
      "token_start": 5,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2430,
      "end_ms": 3310,
      "text": "你敢相信吗？",
      "token_start": 12,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 3550,
      "end_ms": 6190,
      "text": "余春台晚年做过一件非常奇怪的事情，",
      "token_start": 17,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 6330,
      "end_ms": 8630,
      "text": "直到今天依然被无数人误解。",
      "token_start": 33,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 8870,
      "end_ms": 9290,
      "text": "原来，",
      "token_start": 45,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 9490,
      "end_ms": 12230,
      "text": "他不仅精通诗词、文学、术术命理，",
      "token_start": 47,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 12510,
      "end_ms": 15970,
      "text": "还悄悄的干了一件让整个命理学界都闭嘴的事儿。",
      "token_start": 60,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 16290,
      "end_ms": 20610,
      "text": "他用清代学者的方式去打碎江湖命师千年不传的秘密。",
      "token_start": 81,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 20950,
      "end_ms": 22890,
      "text": "而帮他完成这项秘密任务的人，",
      "token_start": 104,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 22890,
      "end_ms": 27490,
      "text": "就叫徐乐无一位浙江武元东海出身的世家子弟，",
      "token_start": 117,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 27670,
      "end_ms": 28590,
      "text": "清朝光绪年间，",
      "token_start": 137,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 28590,
      "end_ms": 32960,
      "text": "余春台在楚鲁南得到了一本江湖救籍蓝江网。",
      "token_start": 143,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 33300,
      "end_ms": 35960,
      "text": "这本书相传为明代江湖命师所传，",
      "token_start": 162,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 36240,
      "end_ms": 38220,
      "text": "是江湖人士压箱底的秘本。",
      "token_start": 176,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 38540,
      "end_ms": 39240,
      "text": "数百年来，",
      "token_start": 187,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 39260,
      "end_ms": 40740,
      "text": "由于传抄错误甚多，",
      "token_start": 191,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 40940,
      "end_ms": 42060,
      "text": "早已面目全非。",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 42700,
      "end_ms": 44040,
      "text": "有人向他推荐此书，",
      "token_start": 205,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 44240,
      "end_ms": 45820,
      "text": "建议他为此书做著书，",
      "token_start": 213,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 46140,
      "end_ms": 49720,
      "text": "填补子平命理学在调后论命法上的一块空白。",
      "token_start": 222,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 50060,
      "end_ms": 51080,
      "text": "余春台批阅后，",
      "token_start": 241,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 51080,
      "end_ms": 51440,
      "text": "发现，",
      "token_start": 247,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 51740,
      "end_ms": 53180,
      "text": "此书论述精细，",
      "token_start": 249,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 53360,
      "end_ms": 54200,
      "text": "取舍得当，",
      "token_start": 255,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 54440,
      "end_ms": 56660,
      "text": "便以毕生经历反复研读，",
      "token_start": 259,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 56900,
      "end_ms": 58520,
      "text": "潜心挖掘其中奥义。",
      "token_start": 269,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 58940,
      "end_ms": 59895,
      "text": "他删繁就简，",
      "token_start": 277,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 60150,
      "end_ms": 61850,
      "text": "细加编辑重新命名，",
      "token_start": 282,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 61850,
      "end_ms": 63445,
      "text": "为琼通宝剑，",
      "token_start": 290,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 63980,
      "end_ms": 66660,
      "text": "终结了这本书数百年的手抄本历史。",
      "token_start": 295,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 66780,
      "end_ms": 68380,
      "text": "当时全中国没几个人，",
      "token_start": 310,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 68380,
      "end_ms": 69945,
      "text": "能看懂这本江湖秘本，",
      "token_start": 319,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 70190,
      "end_ms": 71555,
      "text": "但徐乐无看懂了。",
      "token_start": 328,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 72070,
      "end_ms": 72790,
      "text": "民国时期，",
      "token_start": 335,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 73010,
      "end_ms": 74870,
      "text": "徐乐武反复研读此书，",
      "token_start": 339,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 75050,
      "end_ms": 76410,
      "text": "不禁岿然而叹。",
      "token_start": 348,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 76610,
      "end_ms": 78010,
      "text": "斯书毅力深邃，",
      "token_start": 354,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 78230,
      "end_ms": 80600,
      "text": "因文字拙陋为世所倾，",
      "token_start": 360,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 80940,
      "end_ms": 81905,
      "text": "甚为可惜，",
      "token_start": 369,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 82260,
      "end_ms": 83620,
      "text": "声恐淹没失传。",
      "token_start": 373,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 84060,
      "end_ms": 85120,
      "text": "勉为评著，",
      "token_start": 379,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 85320,
      "end_ms": 89740,
      "text": "他将实战经验结合推命法则添补加注逻辑清晰，",
      "token_start": 383,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 89960,
      "end_ms": 91205,
      "text": "哲学思想浓厚，",
      "token_start": 403,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 91510,
      "end_ms": 94135,
      "text": "将书名改为造化原药瓶注。",
      "token_start": 409,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 94460,
      "end_ms": 94805,
      "text": "从此，",
      "token_start": 420,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 95110,
      "end_ms": 99190,
      "text": "穷通宝剑与三命通会滴天髓子凭真权，",
      "token_start": 422,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 99390,
      "end_ms": 101335,
      "text": "并称为命学四书，",
      "token_start": 438,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 101730,
      "end_ms": 102470,
      "text": "成为命理学。",
      "token_start": 445,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 102470,
      "end_ms": 104530,
      "text": "史上一座难以超越的方碑，",
      "token_start": 450,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 104730,
      "end_ms": 107055,
      "text": "余春台和徐乐无究竟做了什么？",
      "token_start": 461,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 107520,
      "end_ms": 111795,
      "text": "他们把千年江湖秘传第一次拉进了学术殿堂。",
      "token_start": 474,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 112070,
      "end_ms": 114290,
      "text": "这本书以月令气候为基准，",
      "token_start": 493,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 114450,
      "end_ms": 116275,
      "text": "构建调后论命法，",
      "token_start": 504,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 116650,
      "end_ms": 118855,
      "text": "通过五行生克调后寒暖，",
      "token_start": 511,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 119270,
      "end_ms": 121070,
      "text": "提出食干实物说，",
      "token_start": 521,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 121370,
      "end_ms": 125195,
      "text": "形成甲庚丁、循环系统等五大技术框架。",
      "token_start": 528,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 125670,
      "end_ms": 126095,
      "text": "其中，",
      "token_start": 544,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 126220,
      "end_ms": 129780,
      "text": "甲庚丁三干之间存在非丁不以造庚，",
      "token_start": 546,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 130060,
      "end_ms": 132220,
      "text": "非庚不能造假的循环，",
      "token_start": 561,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 132240,
      "end_ms": 132980,
      "text": "生刻关系，",
      "token_start": 570,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 133140,
      "end_ms": 133965,
      "text": "缺一不可。",
      "token_start": 574,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 134310,
      "end_ms": 136290,
      "text": "全书以阴阳五行为经，",
      "token_start": 578,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 136570,
      "end_ms": 137705,
      "text": "以月令为伪，",
      "token_start": 587,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 138020,
      "end_ms": 138900,
      "text": "辅以寒暖，",
      "token_start": 592,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 138920,
      "end_ms": 139475,
      "text": "调厚。",
      "token_start": 596,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 139810,
      "end_ms": 140650,
      "text": "以官为首，",
      "token_start": 598,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 140870,
      "end_ms": 141830,
      "text": "以财为次，",
      "token_start": 602,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 142030,
      "end_ms": 142945,
      "text": "独树一帜。",
      "token_start": 606,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 143460,
      "end_ms": 145960,
      "text": "他的论述模式具有查字典式的特点，",
      "token_start": 610,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 146100,
      "end_ms": 147885,
      "text": "被称为子平之模范。",
      "token_start": 625,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 148210,
      "end_ms": 152905,
      "text": "将八字五十二万种变化简化为特定季节干支配伍规则，",
      "token_start": 633,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 153370,
      "end_ms": 158475,
      "text": "形成某日干生于某月干透或支藏某某物的论断形式。",
      "token_start": 656,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 158870,
      "end_ms": 159990,
      "text": "更令人震撼的是，",
      "token_start": 678,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 160090,
      "end_ms": 163410,
      "text": "这本书首次提出调后这一独特的论明。",
      "token_start": 685,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 163410,
      "end_ms": 168585,
      "text": "方法论命的主要依据是立足每月的实际气候与日主之间的关系，",
      "token_start": 701,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 169010,
      "end_ms": 175730,
      "text": "依实际天时气候情况优先于月令秉兽之正五行来论述命局春木虚火，",
      "token_start": 728,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 175730,
      "end_ms": 178270,
      "text": "暖夏木耐水润秋木，",
      "token_start": 757,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 178330,
      "end_ms": 180855,
      "text": "用金雕冬木借火驱寒。",
      "token_start": 765,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 181340,
      "end_ms": 186795,
      "text": "其核心在于通过月令气候与日主关系分析天干原相的造化机理，",
      "token_start": 774,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 187110,
      "end_ms": 189390,
      "text": "强调调后用神的动态平衡。",
      "token_start": 801,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 189590,
      "end_ms": 190530,
      "text": "徐乐武曾说，",
      "token_start": 812,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 190990,
      "end_ms": 191950,
      "text": "此书看法，",
      "token_start": 817,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 192130,
      "end_ms": 193970,
      "text": "尽托旧事命书之槽，",
      "token_start": 821,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 193970,
      "end_ms": 195670,
      "text": "旧四正四篇，",
      "token_start": 829,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 195970,
      "end_ms": 198575,
      "text": "吉凶神煞盖型平除，",
      "token_start": 834,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 199000,
      "end_ms": 202040,
      "text": "专从实干性情理气进退配合，",
      "token_start": 842,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 202040,
      "end_ms": 203140,
      "text": "喜记而定，",
      "token_start": 854,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 203160,
      "end_ms": 204195,
      "text": "格局之高下。",
      "token_start": 858,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 204730,
      "end_ms": 205825,
      "text": "洗法出于经验，",
      "token_start": 863,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 206060,
      "end_ms": 207515,
      "text": "发钱人所未发。",
      "token_start": 869,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 208070,
      "end_ms": 208520,
      "text": "然而，",
      "token_start": 875,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 208640,
      "end_ms": 210035,
      "text": "这条路走的并不容易，",
      "token_start": 877,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 210290,
      "end_ms": 212070,
      "text": "余春台生平已不可考，",
      "token_start": 886,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 212430,
      "end_ms": 214930,
      "text": "现存文献只有徐乐无在叙中说，",
      "token_start": 895,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 215190,
      "end_ms": 217070,
      "text": "他是光绪年间的楚南人，",
      "token_start": 908,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 217250,
      "end_ms": 220130,
      "text": "我们只知道他热衷于诗词、文学和术数。",
      "token_start": 918,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 220130,
      "end_ms": 222190,
      "text": "命理在得到兰江网后，",
      "token_start": 934,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 222330,
      "end_ms": 224545,
      "text": "以毕生经历反复研读，",
      "token_start": 943,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 224850,
      "end_ms": 225670,
      "text": "潜心挖掘。",
      "token_start": 952,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 225670,
      "end_ms": 227490,
      "text": "其中奥义细加编卷，",
      "token_start": 956,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 227730,
      "end_ms": 228635,
      "text": "删繁就简，",
      "token_start": 964,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 228920,
      "end_ms": 230320,
      "text": "最终编撰成书。",
      "token_start": 968,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 230520,
      "end_ms": 231920,
      "text": "此书去粗取精，",
      "token_start": 974,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 232120,
      "end_ms": 232980,
      "text": "言简意明，",
      "token_start": 980,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 233140,
      "end_ms": 233920,
      "text": "层次分明，",
      "token_start": 984,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 234100,
      "end_ms": 234995,
      "text": "井然有序。",
      "token_start": 988,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 235290,
      "end_ms": 238895,
      "text": "但当时的命理学界充斥着各种江湖术士和假丹师，",
      "token_start": 992,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 239310,
      "end_ms": 241030,
      "text": "一本来自江湖秘本的书。",
      "token_start": 1013,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 241310,
      "end_ms": 242965,
      "text": "要想被正统学界接受，",
      "token_start": 1023,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 243260,
      "end_ms": 244175,
      "text": "谈何容易。",
      "token_start": 1032,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 244690,
      "end_ms": 245810,
      "text": "于春台一介书生，",
      "token_start": 1036,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 246010,
      "end_ms": 246955,
      "text": "断人饭碗，",
      "token_start": 1043,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 247280,
      "end_ms": 248420,
      "text": "江湖上有人骂他，",
      "token_start": 1047,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 248580,
      "end_ms": 249505,
      "text": "有人威胁他。",
      "token_start": 1054,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 249740,
      "end_ms": 250605,
      "text": "但他没有放弃。",
      "token_start": 1059,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 251230,
      "end_ms": 257755,
      "text": "他将四十年的治学心血全部押进了这本最通俗、最严谨、最正统的命理经典。",
      "token_start": 1065,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 258110,
      "end_ms": 258850,
      "text": "民国时期，",
      "token_start": 1096,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 259090,
      "end_ms": 261425,
      "text": "徐乐无接过余春台的衣波。",
      "token_start": 1100,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 261940,
      "end_ms": 263500,
      "text": "这位出身氏族的学者，",
      "token_start": 1111,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 263580,
      "end_ms": 265340,
      "text": "早年从政后居上海，",
      "token_start": 1120,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 265420,
      "end_ms": 267625,
      "text": "专研命理从事职业算命。",
      "token_start": 1128,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 267960,
      "end_ms": 271000,
      "text": "四十年代曾南下香港常住高级酒店，",
      "token_start": 1138,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 271000,
      "end_ms": 272330,
      "text": "为人算命局势，",
      "token_start": 1153,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 272390,
      "end_ms": 277540,
      "text": "是近代子平命理家中书房派的代表对子评古籍用功甚深，",
      "token_start": 1159,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 277860,
      "end_ms": 281040,
      "text": "并整理订正完善子评古典理论。",
      "token_start": 1183,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 281120,
      "end_ms": 283660,
      "text": "他自评八字断自己死于戊子，",
      "token_start": 1196,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 283660,
      "end_ms": 286170,
      "text": "年后果然足于戊子年。",
      "token_start": 1208,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 286330,
      "end_ms": 288670,
      "text": "民国时与袁术山为千里，",
      "token_start": 1217,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 288670,
      "end_ms": 289155,
      "text": "齐名，",
      "token_start": 1227,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 289470,
      "end_ms": 290550,
      "text": "为近代命理学。",
      "token_start": 1229,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 290550,
      "end_ms": 293930,
      "text": "大家徐乐无在评注琼通宝剑时，",
      "token_start": 1235,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 294190,
      "end_ms": 297890,
      "text": "将实战经验结合推命法则添补加注，",
      "token_start": 1248,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 298050,
      "end_ms": 298895,
      "text": "逻辑清晰，",
      "token_start": 1263,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 299260,
      "end_ms": 300405,
      "text": "哲学思想浓厚，",
      "token_start": 1267,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 300900,
      "end_ms": 302885,
      "text": "书后附有增补乐坛赋。",
      "token_start": 1273,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 303290,
      "end_ms": 306670,
      "text": "四书子平两篇皆征验平断之法。",
      "token_start": 1282,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 306770,
      "end_ms": 307450,
      "text": "民国以来，",
      "token_start": 1295,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 307670,
      "end_ms": 310690,
      "text": "本书一直被视子平命理学必读经典。",
      "token_start": 1299,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 310770,
      "end_ms": 314510,
      "text": "但真正让人动容的是这本书背后的传承精神。",
      "token_start": 1314,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 314890,
      "end_ms": 317210,
      "text": "余春台和徐乐无两代学者，",
      "token_start": 1333,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 317390,
      "end_ms": 321210,
      "text": "用毕生心血守护着中华命理学的正统脉络。",
      "token_start": 1344,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 321550,
      "end_ms": 323190,
      "text": "他们没有把知识藏在深山，",
      "token_start": 1362,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 323490,
      "end_ms": 325410,
      "text": "没有用玄虚来收割信徒，",
      "token_start": 1373,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 325750,
      "end_ms": 329050,
      "text": "而是把千年秘传写成普通人能读懂的文字。",
      "token_start": 1383,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 329190,
      "end_ms": 333005,
      "text": "琼通宝剑是诸多命理著作中内容最易懂的一部古籍。",
      "token_start": 1401,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 333580,
      "end_ms": 334420,
      "text": "更重要的是，",
      "token_start": 1423,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 334580,
      "end_ms": 338180,
      "text": "他首次提出调后这一独特的论命方法。",
      "token_start": 1428,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 338620,
      "end_ms": 341900,
      "text": "他让命理学从江湖迷信走向学术殿堂，",
      "token_start": 1444,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 342200,
      "end_ms": 345060,
      "text": "让普通人也能接触到正统的命理知识。",
      "token_start": 1460,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 345100,
      "end_ms": 347100,
      "text": "现代学者对此书的评价极高。",
      "token_start": 1476,
      "token_end_exclusive": 1488
    },
    {
      "start_ms": 347520,
      "end_ms": 348360,
      "text": "有学者指出，",
      "token_start": 1488,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 348680,
      "end_ms": 354640,
      "text": "琼通宝剑的用神调后论是以反映人类生活的四柱八字为五行生克的方式，",
      "token_start": 1493,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 354960,
      "end_ms": 357200,
      "text": "指向了阴阳平衡的中和境界，",
      "token_start": 1524,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 357420,
      "end_ms": 360620,
      "text": "从而能够造成生态主义的可待续生活的余地。",
      "token_start": 1536,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 360760,
      "end_ms": 362300,
      "text": "若以治学眼光视之，",
      "token_start": 1555,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 362620,
      "end_ms": 364490,
      "text": "渊海子平偏于法式，",
      "token_start": 1563,
      "token_end_exclusive": 1571
    },
    {
      "start_ms": 364490,
      "end_ms": 364945,
      "text": "纲目，",
      "token_start": 1571,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 365320,
      "end_ms": 366900,
      "text": "低天水偏于毅力，",
      "token_start": 1573,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 366900,
      "end_ms": 369045,
      "text": "提炼琼通宝剑，",
      "token_start": 1580,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 369300,
      "end_ms": 373385,
      "text": "则更着重时令气候与调后配合之操作层面，",
      "token_start": 1586,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 373690,
      "end_ms": 379705,
      "text": "故在子贫学发展史上具有承前启后、由格局而进入气候论的枢纽意义。",
      "token_start": 1604,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 380340,
      "end_ms": 382175,
      "text": "中国命理学界有一句老话，",
      "token_start": 1633,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 382760,
      "end_ms": 384240,
      "text": "论命者为八字，",
      "token_start": 1644,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 384240,
      "end_ms": 386000,
      "text": "有服役格局，",
      "token_start": 1650,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 386340,
      "end_ms": 388325,
      "text": "那英调后诸说，",
      "token_start": 1655,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 388840,
      "end_ms": 391000,
      "text": "而以此书为调后之学。",
      "token_start": 1661,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 391140,
      "end_ms": 396665,
      "text": "民间另有抄本、造化、玄耀与此书当属同一来源而颇有异同。",
      "token_start": 1670,
      "token_end_exclusive": 1694
    },
    {
      "start_ms": 397140,
      "end_ms": 399080,
      "text": "但余春台和徐乐无的贡献，",
      "token_start": 1694,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 399260,
      "end_ms": 400885,
      "text": "不仅仅是学术上的，",
      "token_start": 1705,
      "token_end_exclusive": 1713
    },
    {
      "start_ms": 401240,
      "end_ms": 402080,
      "text": "他们的精神，",
      "token_start": 1713,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 402220,
      "end_ms": 404375,
      "text": "是一种对中华文明的守护。",
      "token_start": 1718,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 404700,
      "end_ms": 407660,
      "text": "他们把千年秘传从江湖迷信中拉出来，",
      "token_start": 1729,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 407820,
      "end_ms": 410700,
      "text": "把断裂的命理脉络一根一根接回去，",
      "token_start": 1745,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 410940,
      "end_ms": 413020,
      "text": "把真正的学问留给后人。",
      "token_start": 1760,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 413140,
      "end_ms": 414785,
      "text": "他们用最通俗的语言，",
      "token_start": 1770,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 415110,
      "end_ms": 416470,
      "text": "讲最严谨的道理，",
      "token_start": 1779,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 416630,
      "end_ms": 419370,
      "text": "让普通人有机会接触到正统的命理学，",
      "token_start": 1786,
      "token_end_exclusive": 1802
    },
    {
      "start_ms": 419630,
      "end_ms": 421415,
      "text": "而不是被江湖神棍收割。",
      "token_start": 1802,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 421680,
      "end_ms": 423185,
      "text": "不是被劣质白话欺骗，",
      "token_start": 1812,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 423430,
      "end_ms": 424595,
      "text": "不是越修越偏。",
      "token_start": 1821,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 425200,
      "end_ms": 427725,
      "text": "这本书的价值不在于它能预测什么，",
      "token_start": 1827,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 427990,
      "end_ms": 429910,
      "text": "而在于他教会你如何思考。",
      "token_start": 1842,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 430110,
      "end_ms": 430790,
      "text": "他告诉你，",
      "token_start": 1853,
      "token_end_exclusive": 1857
    },
    {
      "start_ms": 431010,
      "end_ms": 432625,
      "text": "命理学的根源在哪里，",
      "token_start": 1857,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 432870,
      "end_ms": 433705,
      "text": "脉络怎么走，",
      "token_start": 1866,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 433940,
      "end_ms": 434800,
      "text": "逻辑是什么，",
      "token_start": 1871,
      "token_end_exclusive": 1876
    },
    {
      "start_ms": 434820,
      "end_ms": 435745,
      "text": "误区在哪里？",
      "token_start": 1876,
      "token_end_exclusive": 1881
    },
    {
      "start_ms": 435930,
      "end_ms": 436805,
      "text": "他没有迷信，",
      "token_start": 1881,
      "token_end_exclusive": 1886
    },
    {
      "start_ms": 437170,
      "end_ms": 438085,
      "text": "没有玄虚，",
      "token_start": 1886,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 438580,
      "end_ms": 441340,
      "text": "只有一位清代学者和一位民国学者，",
      "token_start": 1890,
      "token_end_exclusive": 1905
    },
    {
      "start_ms": 441400,
      "end_ms": 443720,
      "text": "把道学的根源单道的脉络。",
      "token_start": 1905,
      "token_end_exclusive": 1916
    },
    {
      "start_ms": 443900,
      "end_ms": 444840,
      "text": "内丹的逻辑，",
      "token_start": 1916,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 444960,
      "end_ms": 445885,
      "text": "历史的误区，",
      "token_start": 1921,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 446160,
      "end_ms": 448165,
      "text": "用大白话讲的明明白白。",
      "token_start": 1926,
      "token_end_exclusive": 1936
    },
    {
      "start_ms": 448530,
      "end_ms": 449230,
      "text": "在这个领域，",
      "token_start": 1936,
      "token_end_exclusive": 1941
    },
    {
      "start_ms": 449430,
      "end_ms": 450565,
      "text": "有学术地位的，",
      "token_start": 1941,
      "token_end_exclusive": 1947
    },
    {
      "start_ms": 450760,
      "end_ms": 452735,
      "text": "没有余春台那般江湖实证，",
      "token_start": 1947,
      "token_end_exclusive": 1958
    },
    {
      "start_ms": 453140,
      "end_ms": 454275,
      "text": "有江湖实证的，",
      "token_start": 1958,
      "token_end_exclusive": 1964
    },
    {
      "start_ms": 454470,
      "end_ms": 458155,
      "text": "没有徐乐无那般科学严谨、有科学严谨的，",
      "token_start": 1964,
      "token_end_exclusive": 1981
    },
    {
      "start_ms": 458490,
      "end_ms": 460970,
      "text": "没有穷通宝剑那般正统道统。",
      "token_start": 1981,
      "token_end_exclusive": 1993
    },
    {
      "start_ms": 461170,
      "end_ms": 462630,
      "text": "如果你厌倦了江湖骗术，",
      "token_start": 1993,
      "token_end_exclusive": 2003
    },
    {
      "start_ms": 462650,
      "end_ms": 463830,
      "text": "不想被伪学收割，",
      "token_start": 2003,
      "token_end_exclusive": 2010
    },
    {
      "start_ms": 464090,
      "end_ms": 465965,
      "text": "想踏踏实实亲近命理学，",
      "token_start": 2010,
      "token_end_exclusive": 2020
    },
    {
      "start_ms": 466280,
      "end_ms": 468945,
      "text": "那这本书值得放在枕边相伴一生，",
      "token_start": 2020,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 469600,
      "end_ms": 471140,
      "text": "余春台和徐乐无花了。",
      "token_start": 2034,
      "token_end_exclusive": 2043
    },
    {
      "start_ms": 471140,
      "end_ms": 472520,
      "text": "两代人跨越，",
      "token_start": 2043,
      "token_end_exclusive": 2048
    },
    {
