{
  "video_id": "v_cbb3ad669fcfbba1",
  "duration_s": 742.296961,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_cbb3ad669fcfbba1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_cbb3ad669fcfbba1.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 2730,
      "text": "你去博物馆的时候有没有过这种经历？",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3270,
      "end_ms": 5430,
      "text": "你本来是去接受文化熏陶的，",
      "token_start": 16,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 5970,
      "end_ms": 7210,
      "text": "结果逛着逛着，",
      "token_start": 28,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8029,
      "end_ms": 9730,
      "text": "突然被一件文物逗笑，",
      "token_start": 34,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11070,
      "end_ms": 12190,
      "text": "你站在他面前，",
      "token_start": 43,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 12710,
      "end_ms": 15770,
      "text": "忍不住想掏出手机拍下来发给朋友。",
      "token_start": 49,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 16370,
      "end_ms": 17870,
      "text": "他们不是镇馆之宝，",
      "token_start": 64,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 17990,
      "end_ms": 19050,
      "text": "不是最贵的，",
      "token_start": 72,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 19130,
      "end_ms": 20430,
      "text": "不是最古老的，",
      "token_start": 77,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 21090,
      "end_ms": 23190,
      "text": "但他们有一个共同的名字，",
      "token_start": 83,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 23210,
      "end_ms": 23850,
      "text": "显眼包。",
      "token_start": 94,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 24270,
      "end_ms": 26130,
      "text": "央视纪录片馆藏显眼包，",
      "token_start": 97,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 26130,
      "end_ms": 28170,
      "text": "专门为他们拍了一整季。",
      "token_start": 107,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 28170,
      "end_ms": 31960,
      "text": "聚焦各大文博物馆中形态生动，",
      "token_start": 117,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 32060,
      "end_ms": 33340,
      "text": "富有喜感的文物，",
      "token_start": 130,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 33640,
      "end_ms": 37340,
      "text": "用简短明快的解说讲述他们的前世今生。",
      "token_start": 137,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 38080,
      "end_ms": 41540,
      "text": "今天咱们就来盘点中国十大博物馆里的显眼包。",
      "token_start": 154,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 42540,
      "end_ms": 45120,
      "text": "上集先看五件表情管理失败了。",
      "token_start": 174,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 45380,
      "end_ms": 49680,
      "text": "第一件山东博物馆雅丑乐，",
      "token_start": 187,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 50520,
      "end_ms": 51460,
      "text": "你去看他的脸。",
      "token_start": 198,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 52660,
      "end_ms": 55540,
      "text": "方脸圆睁的双目，",
      "token_start": 204,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 56620,
      "end_ms": 57520,
      "text": "嘴角上扬，",
      "token_start": 211,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 58380,
      "end_ms": 60010,
      "text": "翻出两排整整齐齐。",
      "token_start": 215,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 60070,
      "end_ms": 61455,
      "text": "鸡的牙齿不是普通的牙，",
      "token_start": 223,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 62510,
      "end_ms": 64625,
      "text": "是城墙垛口一样的形状。",
      "token_start": 233,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 65070,
      "end_ms": 68005,
      "text": "他在笑笑的非常生动，",
      "token_start": 243,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 68730,
      "end_ms": 70575,
      "text": "但你别被这张脸骗了，",
      "token_start": 252,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 70740,
      "end_ms": 71515,
      "text": "他是一把鱼。",
      "token_start": 261,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 72040,
      "end_ms": 74075,
      "text": "越是什么在殷商时代，",
      "token_start": 266,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 74370,
      "end_ms": 76415,
      "text": "越是战场上的杀伐利器，",
      "token_start": 275,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 76990,
      "end_ms": 79585,
      "text": "也是王权与君权的至高象征。",
      "token_start": 285,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 80080,
      "end_ms": 84585,
      "text": "甲骨文里的王字就是府乐的象形尚书。",
      "token_start": 297,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 84990,
      "end_ms": 85230,
      "text": "墓。",
      "token_start": 313,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 85290,
      "end_ms": 85995,
      "text": "事记载，",
      "token_start": 314,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 86670,
      "end_ms": 89390,
      "text": "周王左杖黄越右柄，",
      "token_start": 317,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 89510,
      "end_ms": 93695,
      "text": "白火以辉以月号令诸侯决胜牧野。",
      "token_start": 325,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 94470,
      "end_ms": 95490,
      "text": "三千多年前，",
      "token_start": 339,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 95770,
      "end_ms": 97010,
      "text": "谁手里握着月，",
      "token_start": 344,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 97190,
      "end_ms": 98335,
      "text": "谁就握着天下。",
      "token_start": 350,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 98850,
      "end_ms": 99750,
      "text": "一九六五年，",
      "token_start": 356,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 99970,
      "end_ms": 104095,
      "text": "考古学者在青州苏布屯发现了一座商代大墓，",
      "token_start": 361,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 104690,
      "end_ms": 116585,
      "text": "是迄今为止除安阳阴墟以外规模最大、规格最高的商代墓葬亚丑月出土于一号墓牧师北壁靠近北墓道口的田土中，",
      "token_start": 380,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 117200,
      "end_ms": 118865,
      "text": "通常三十二点七厘米，",
      "token_start": 428,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 119320,
      "end_ms": 119560,
      "text": "刃，",
      "token_start": 437,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 119620,
      "end_ms": 121385,
      "text": "宽三十四点五厘米，",
      "token_start": 438,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 121770,
      "end_ms": 123915,
      "text": "肩宽二十三点三厘米，",
      "token_start": 446,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 124300,
      "end_ms": 127315,
      "text": "两侧对称飞棱线条刚毅，",
      "token_start": 455,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 127890,
      "end_ms": 130750,
      "text": "在人面门口部两侧刻着雅行。",
      "token_start": 465,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 130770,
      "end_ms": 133355,
      "text": "外框和丑字组成的铭文。",
      "token_start": 477,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 134150,
      "end_ms": 135525,
      "text": "学界普遍认为，",
      "token_start": 487,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 135960,
      "end_ms": 138120,
      "text": "亚子情况代表特殊身份，",
      "token_start": 493,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 138120,
      "end_ms": 140770,
      "text": "地位很可能是武官的身份。",
      "token_start": 503,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 140770,
      "end_ms": 145990,
      "text": "灰烬丑则是商代东方某个方国或显赫家族的祖号。",
      "token_start": 514,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 146150,
      "end_ms": 153985,
      "text": "这方铭文为宋代以来备受关注的亚丑青铜器群提供了明确的出土地点，",
      "token_start": 535,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 154730,
      "end_ms": 160835,
      "text": "证实了青州一带是商代亚丑族群的核心活动区。",
      "token_start": 565,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 161470,
      "end_ms": 162830,
      "text": "你站在他面前，",
      "token_start": 585,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 162970,
      "end_ms": 165935,
      "text": "看着那张凝丽中透着天真的笑脸，",
      "token_start": 591,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 166350,
      "end_ms": 171320,
      "text": "会忍不住想三千年前的人铸造这把月的时候，",
      "token_start": 605,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 171500,
      "end_ms": 172615,
      "text": "心里在想什么？",
      "token_start": 624,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 173920,
      "end_ms": 174565,
      "text": "是敬畏，",
      "token_start": 630,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 175090,
      "end_ms": 180295,
      "text": "还是也感受到了他传递出的那种属于远古的原始的力量。",
      "token_start": 633,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 181310,
      "end_ms": 185800,
      "text": "第二件甘肃省博物馆红奔马，",
      "token_start": 657,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 185920,
      "end_ms": 188435,
      "text": "你从小就在旅游标志上见过他。",
      "token_start": 669,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 189060,
      "end_ms": 191260,
      "text": "侧面看一匹骏马，",
      "token_start": 682,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 191260,
      "end_ms": 194455,
      "text": "三足腾空彝足踏在飞鸟背上，",
      "token_start": 689,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 194780,
      "end_ms": 195800,
      "text": "昂首嘶鸣，",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 196080,
      "end_ms": 197105,
      "text": "气势磅礴。",
      "token_start": 705,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 198000,
      "end_ms": 201724,
      "text": "一九六九年出土于甘肃武威擂台汉墓，",
      "token_start": 709,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 202040,
      "end_ms": 204085,
      "text": "马高三十四点五厘米，",
      "token_start": 725,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 204690,
      "end_ms": 206325,
      "text": "长四十四点五厘米，",
      "token_start": 734,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 206900,
      "end_ms": 208555,
      "text": "重七点一五千克。",
      "token_start": 742,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 209380,
      "end_ms": 210225,
      "text": "一九八三年，",
      "token_start": 749,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 211100,
      "end_ms": 214375,
      "text": "同奔马形象被确定为中国旅游标志。",
      "token_start": 754,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 215250,
      "end_ms": 218335,
      "text": "但是你绕到正面看一下，",
      "token_start": 769,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 218790,
      "end_ms": 220365,
      "text": "参观者绕到正面，",
      "token_start": 779,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 220850,
      "end_ms": 223170,
      "text": "便会看到一个意想不到的画面。",
      "token_start": 786,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 223190,
      "end_ms": 224470,
      "text": "骏马歪着脑袋，",
      "token_start": 799,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 224470,
      "end_ms": 225975,
      "text": "嘴巴撇向一侧，",
      "token_start": 805,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 226750,
      "end_ms": 229815,
      "text": "袁征的双眼透出几分天然的呆萌，",
      "token_start": 811,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 230830,
      "end_ms": 234875,
      "text": "正面的憨态与侧面的英姿判若两木。",
      "token_start": 825,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 235840,
      "end_ms": 236360,
      "text": "网友说，",
      "token_start": 840,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 236360,
      "end_ms": 237815,
      "text": "他如果不是来搞笑的，",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 238100,
      "end_ms": 241200,
      "text": "那就一定是内心住着一个顽皮的小孩。",
      "token_start": 852,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 241880,
      "end_ms": 245915,
      "text": "甘肃省博物馆把它的正面照做成了绿马玩偶，",
      "token_start": 868,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 246250,
      "end_ms": 248385,
      "text": "在文创展厅里很受欢迎，",
      "token_start": 887,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 248810,
      "end_ms": 253455,
      "text": "但同奔马真正的厉害之处藏在他的力学设计里。",
      "token_start": 897,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 254020,
      "end_ms": 257465,
      "text": "马身着了一点集中于超聂飞鸟的一族之上，",
      "token_start": 917,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 258260,
      "end_ms": 262200,
      "text": "飞鸟的躯体以及展开的双翅扩大了着地面积，",
      "token_start": 935,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 262220,
      "end_ms": 263275,
      "text": "稳定了重心，",
      "token_start": 954,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 263740,
      "end_ms": 267165,
      "text": "其造型完全符合现代力学的平衡原理。",
      "token_start": 959,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 268000,
      "end_ms": 269680,
      "text": "经过科学仪器检测，",
      "token_start": 975,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 270220,
      "end_ms": 275600,
      "text": "铸造工艺为陶犯铸造铸接法工匠先驻马身，",
      "token_start": 983,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 275820,
      "end_ms": 280845,
      "text": "再与马尾马腿提下飞鸟等部件分别组合。",
      "token_start": 1001,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 281310,
      "end_ms": 281750,
      "text": "同时，",
      "token_start": 1018,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 282010,
      "end_ms": 285710,
      "text": "在马腿内夹入专门制作的铁心骨之后，",
      "token_start": 1020,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 285930,
      "end_ms": 288495,
      "text": "浇铸铜业铸成铁骨铜腿。",
      "token_start": 1036,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 289840,
      "end_ms": 293575,
      "text": "两千年前的工匠用逃饭和铁心，",
      "token_start": 1046,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 294040,
      "end_ms": 296740,
      "text": "让一匹奔腾的马稳稳站立了。",
      "token_start": 1059,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 296740,
      "end_ms": 298620,
      "text": "两千年至今，",
      "token_start": 1071,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 298620,
      "end_ms": 301440,
      "text": "其右前蹄底还可见残留的锈蚀。",
      "token_start": 1076,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 301440,
      "end_ms": 301840,
      "text": "铁鞋，",
      "token_start": 1089,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 302000,
      "end_ms": 303465,
      "text": "你站在他正面。",
      "token_start": 1091,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 304180,
      "end_ms": 306500,
      "text": "看着他歪头咧嘴的样子，",
      "token_start": 1097,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 307280,
      "end_ms": 311120,
      "text": "会想起生活中那些明明很严肃的场合，",
      "token_start": 1107,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 311120,
      "end_ms": 313320,
      "text": "表情却不受控制的瞬间。",
      "token_start": 1123,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 314940,
      "end_ms": 319300,
      "text": "两千年前的工匠把这种真实感凝固了下来。",
      "token_start": 1133,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 320740,
      "end_ms": 321400,
      "text": "第三件，",
      "token_start": 1151,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 322520,
      "end_ms": 326600,
      "text": "河南博物院绿釉立兹陶狗。",
      "token_start": 1154,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 327260,
      "end_ms": 331880,
      "text": "它的原型是中华田园犬双耳前顷，",
      "token_start": 1165,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 333420,
      "end_ms": 334375,
      "text": "双目元征，",
      "token_start": 1179,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 336410,
      "end_ms": 337610,
      "text": "颈下系着铃铛，",
      "token_start": 1183,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 338070,
      "end_ms": 339530,
      "text": "四肢矫健有力，",
      "token_start": 1189,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 339830,
      "end_ms": 343850,
      "text": "背上甚至贴心的设计了便于抓握的拱形扉。",
      "token_start": 1195,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 344470,
      "end_ms": 348330,
      "text": "一九七七年出土于河南周口项城蛤蟆寨汉墓群，",
      "token_start": 1213,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 348470,
      "end_ms": 350370,
      "text": "高三十二点五厘米，",
      "token_start": 1233,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 350610,
      "end_ms": 351850,
      "text": "长二十八厘米，",
      "token_start": 1241,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 352010,
      "end_ms": 353110,
      "text": "宽十六厘米，",
      "token_start": 1247,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 353390,
      "end_ms": 354550,
      "text": "通体石绿釉，",
      "token_start": 1252,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 354810,
      "end_ms": 355990,
      "text": "现藏河南博物院。",
      "token_start": 1257,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 356550,
      "end_ms": 360770,
      "text": "东汉工匠显然是照着身边那只活生生的大黄捏的，",
      "token_start": 1264,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 361170,
      "end_ms": 365265,
      "text": "连尾巴卷曲的弧度都拿捏的恰到好处。",
      "token_start": 1285,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 365950,
      "end_ms": 369575,
      "text": "他身上的绿釉以同为着色剂烧成，",
      "token_start": 1301,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 369970,
      "end_ms": 371075,
      "text": "用今天的话说，",
      "token_start": 1315,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 371570,
      "end_ms": 374255,
      "text": "古人给他染了一身纯天然绿毛，",
      "token_start": 1321,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 374770,
      "end_ms": 378605,
      "text": "可别小看这抹绿作为随葬名器，",
      "token_start": 1334,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 379410,
      "end_ms": 384400,
      "text": "绿柚荔枝、桃狗承载着古人视死如是生的生死观。",
      "token_start": 1347,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 384440,
      "end_ms": 386540,
      "text": "主人希望到了另一个世界，",
      "token_start": 1367,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 386840,
      "end_ms": 388220,
      "text": "那只看家护院，",
      "token_start": 1378,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 388320,
      "end_ms": 391405,
      "text": "朝夕相伴的忠犬依然守在身边。",
      "token_start": 1384,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 392160,
      "end_ms": 393060,
      "text": "正因如此，",
      "token_start": 1397,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 393400,
      "end_ms": 395480,
      "text": "他不卑不亢的保持着立姿，",
      "token_start": 1401,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 395480,
      "end_ms": 397825,
      "text": "像一个警惕又可靠的卫士，",
      "token_start": 1412,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 398380,
      "end_ms": 400985,
      "text": "目光跨越千年依然坚定。",
      "token_start": 1423,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 401460,
      "end_ms": 406515,
      "text": "但很多观众看到他的第一反应是和我家旺财一模一样。",
      "token_start": 1433,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 407240,
      "end_ms": 408875,
      "text": "他被做成了毛绒玩具，",
      "token_start": 1456,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 409170,
      "end_ms": 409925,
      "text": "很受欢迎。",
      "token_start": 1465,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 410910,
      "end_ms": 413765,
      "text": "河南博物院管他叫汉代旺财，",
      "token_start": 1469,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 414180,
      "end_ms": 416605,
      "text": "你看着他那双圆睁的眼睛，",
      "token_start": 1481,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 417260,
      "end_ms": 420020,
      "text": "会觉得他下一秒就要冲你摇尾巴。",
      "token_start": 1492,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 420100,
      "end_ms": 420795,
      "text": "第四件，",
      "token_start": 1506,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 421210,
      "end_ms": 423915,
      "text": "中国国家博物馆击鼓说唱咏，",
      "token_start": 1509,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 424740,
      "end_ms": 425685,
      "text": "你看他的样子。",
      "token_start": 1521,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 426070,
      "end_ms": 427790,
      "text": "咧嘴嬉笑塌腰，",
      "token_start": 1527,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 427790,
      "end_ms": 428285,
      "text": "扭胯，",
      "token_start": 1533,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 428690,
      "end_ms": 429665,
      "text": "左臂环抱，",
      "token_start": 1535,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 429960,
      "end_ms": 430895,
      "text": "一面贬鼓，",
      "token_start": 1539,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 431290,
      "end_ms": 432905,
      "text": "右手举着鼓槌，",
      "token_start": 1543,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 433280,
      "end_ms": 434295,
      "text": "一只脚还翘着。",
      "token_start": 1549,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 434750,
      "end_ms": 437175,
      "text": "这是一个正在表演的瞬间。",
      "token_start": 1555,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 438150,
      "end_ms": 440995,
      "text": "东汉文物高五十六厘米，",
      "token_start": 1566,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 441720,
      "end_ms": 444200,
      "text": "一九五七年出土于四川成都，",
      "token_start": 1576,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 444220,
      "end_ms": 447655,
      "text": "天回山献葬中国国家博物馆。",
      "token_start": 1588,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 448460,
      "end_ms": 450095,
      "text": "他叫改为其忧。",
      "token_start": 1600,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 450670,
      "end_ms": 452945,
      "text": "还有在春秋战国时期已经出现，",
      "token_start": 1606,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 453380,
      "end_ms": 457640,
      "text": "他们侍奉君主以逗笑的方式为君主排遣无聊。",
      "token_start": 1619,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 457780,
      "end_ms": 458965,
      "text": "在宫廷宴会上，",
      "token_start": 1638,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 459410,
      "end_ms": 459850,
      "text": "筛优，",
      "token_start": 1644,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 460010,
      "end_ms": 461255,
      "text": "往往是灵魂人物，",
      "token_start": 1646,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 461570,
      "end_ms": 464025,
      "text": "以幽默的话语、滑稽的表演，",
      "token_start": 1653,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 464250,
      "end_ms": 465635,
      "text": "我的宾客的欢笑，",
      "token_start": 1664,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 466270,
      "end_ms": 467190,
      "text": "有些GDU,",
      "token_start": 1671,
      "token_end_exclusive": 1674
    },
    {
      "start_ms": 467370,
      "end_ms": 469130,
      "text": "也利用他们的特殊身份，",
      "token_start": 1674,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 469270,
      "end_ms": 470935,
      "text": "依靠口舌之力。",
      "token_start": 1684,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 471460,
      "end_ms": 474090,
      "text": "正话反说反话，",
      "token_start": 1690,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 474090,
      "end_ms": 477565,
      "text": "正说在取悦君主的同时，",
      "token_start": 1696,
      "token_end_exclusive": 1706
    },
    {
      "start_ms": 478210,
      "end_ms": 481285,
      "text": "也对君主一些错误的想法进行封建。",
      "token_start": 1706,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 482260,
      "end_ms": 485745,
      "text": "秦始皇时期有一个著名的改西攸叫幽。",
      "token_start": 1721,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 486800,
      "end_ms": 489970,
      "text": "秦始皇曾计划大兴怨忧幽枕，",
      "token_start": 1737,
      "token_end_exclusive": 1749
    },
    {
      "start_ms": 489970,
      "end_ms": 490310,
      "text": "便说，",
      "token_start": 1749,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 490310,
      "end_ms": 491665,
      "text": "皇上的想法很好，",
      "token_start": 1751,
      "token_end_exclusive": 1758
    },
    {
      "start_ms": 492070,
      "end_ms": 494675,
      "text": "原有修好后放进许多禽兽，",
      "token_start": 1758,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 495120,
      "end_ms": 497560,
      "text": "敌人从东方进攻放出麋鹿，",
      "token_start": 1769,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 497560,
      "end_ms": 499285,
      "text": "用脚就能把他们顶回去。",
      "token_start": 1780,
      "token_end_exclusive": 1790
    },
    {
      "start_ms": 499770,
      "end_ms": 501585,
      "text": "秦始皇听了就打消了念头。",
      "token_start": 1790,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 502270,
      "end_ms": 503205,
      "text": "到了汉代，",
      "token_start": 1801,
      "token_end_exclusive": 1805
    },
    {
      "start_ms": 503980,
      "end_ms": 508715,
      "text": "担忧大致以调学滑稽、讽刺的表演为主，",
      "token_start": 1805,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 509020,
      "end_ms": 513275,
      "text": "皇室贵族豪富大力蓄养师忧之风甚盛。",
      "token_start": 1821,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 513960,
      "end_ms": 515920,
      "text": "汉武帝蚩尤诛儒之孝，",
      "token_start": 1837,
      "token_end_exclusive": 1846
    },
    {
      "start_ms": 516720,
      "end_ms": 521765,
      "text": "不乏于前丞相田庚爱唱优巧匠之术。",
      "token_start": 1846,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 522570,
      "end_ms": 525995,
      "text": "东汉工匠把一个人逗笑全场的瞬间，",
      "token_start": 1861,
      "token_end_exclusive": 1876
    },
    {
      "start_ms": 526530,
      "end_ms": 528595,
      "text": "用陶土凝固了下来。",
      "token_start": 1876,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 529270,
      "end_ms": 530485,
      "text": "你站在他面前，",
      "token_start": 1884,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 530830,
      "end_ms": 535330,
      "text": "会忍不住想两千年前他逗笑过多少人，",
      "token_start": 1890,
      "token_end_exclusive": 1906
    },
    {
      "start_ms": 535390,
      "end_ms": 538515,
      "text": "那些人笑的时候是什么样子？",
      "token_start": 1906,
      "token_end_exclusive": 1918
    },
    {
      "start_ms": 539280,
      "end_ms": 544665,
      "text": "第五件三星堆博物馆青铜粽木面具，",
      "token_start": 1918,
      "token_end_exclusive": 1933
    },
    {
      "start_ms": 544980,
      "end_ms": 546455,
      "text": "他的眼睛是凸出来的，",
      "token_start": 1933,
      "token_end_exclusive": 1942
    },
    {
      "start_ms": 547410,
      "end_ms": 550125,
      "text": "突出多少十六厘米，",
      "token_start": 1942,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 551310,
      "end_ms": 555075,
      "text": "耳朵大的像翅膀向两侧展开六十八厘米。",
      "token_start": 1950,
      "token_end_exclusive": 1967
    },
    {
      "start_ms": 555890,
      "end_ms": 559515,
      "text": "一九八六年出土于三星堆遗址二号祭祀坑，",
      "token_start": 1967,
      "token_end_exclusive": 1985
    },
    {
      "start_ms": 560000,
      "end_ms": 561645,
      "text": "通高六十六厘米，",
      "token_start": 1985,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 561910,
      "end_ms": 563505,
      "text": "宽一百三十八厘米，",
      "token_start": 1992,
      "token_end_exclusive": 2000
    },
    {
      "start_ms": 564160,
      "end_ms": 568275,
      "text": "被誉为面具之王献葬三星堆博物馆。",
      "token_start": 2000,
      "token_end_exclusive": 2015
    },
    {
      "start_ms": 573980,
      "end_ms": 574500,
      "text": "网友说，",
      "token_start": 2015,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 574500,
      "end_ms": 575560,
      "text": "他眼球暴凸，",
      "token_start": 2018,
      "token_end_exclusive": 2023
    },
    {
      "start_ms": 575580,
      "end_ms": 579310,
      "text": "顺风耳是古蜀人眼里的外星偶像，",
      "token_start": 2023,
      "token_end_exclusive": 2037
    },
    {
      "start_ms": 579390,
      "end_ms": 583105,
      "text": "但CT断层扫描显示了一个令人震惊的事实。",
      "token_start": 2037,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 583510,
      "end_ms": 586195,
      "text": "他突出的眼球并非整体浇筑，",
      "token_start": 2055,
      "token_end_exclusive": 2067
    },
    {
      "start_ms": 586530,
      "end_ms": 590345,
      "text": "而是由十六组微型榫卯构件嵌套而成，",
      "token_start": 2067,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 590970,
      "end_ms": 593295,
      "text": "瞳孔处是有放射状太阳纹。",
      "token_start": 2083,
      "token_end_exclusive": 2094
    },
    {
      "start_ms": 593830,
      "end_ms": 599150,
      "text": "三千多年前的古蜀人用分体铸造和榫卯嵌套的工艺，",
      "token_start": 2094,
      "token_end_exclusive": 2116
    },
    {
      "start_ms": 599310,
      "end_ms": 602555,
      "text": "做出了一个眼睛能伸出十六厘米的面具。",
      "token_start": 2116,
      "token_end_exclusive": 2133
    },
    {
      "start_ms": 603340,
      "end_ms": 607675,
      "text": "面具的造型特征与华阳国志记载的蚕虫纵目传说吻合，",
      "token_start": 2133,
      "token_end_exclusive": 2156
    },
    {
      "start_ms": 608190,
      "end_ms": 613455,
      "text": "学界推测他可能是第一代蜀王禅从的神像突出的双眼。",
      "token_start": 2156,
      "token_end_exclusive": 2179
    },
    {
      "start_ms": 613850,
      "end_ms": 615310,
      "text": "是对太阳的崇拜。",
      "token_start": 2179,
      "token_end_exclusive": 2186
    },
    {
      "start_ms": 616230,
      "end_ms": 617230,
      "text": "古蜀人认为，",
      "token_start": 2186,
      "token_end_exclusive": 2191
    },
    {
      "start_ms": 617610,
      "end_ms": 620110,
      "text": "看得远的人离神更近，",
      "token_start": 2191,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 620890,
      "end_ms": 626330,
      "text": "他们把对神明的想象铸成了一副凡人无法拥有的面孔。",
      "token_start": 2200,
      "token_end_exclusive": 2223
    },
    {
      "start_ms": 626750,
      "end_ms": 628910,
      "text": "三星堆文明本身就是一个谜，",
      "token_start": 2223,
      "token_end_exclusive": 2235
    },
    {
      "start_ms": 629610,
      "end_ms": 631710,
      "text": "它和中原文明同时存在，",
      "token_start": 2235,
      "token_end_exclusive": 2245
    },
    {
      "start_ms": 632010,
      "end_ms": 633570,
      "text": "但风格完全不同，",
      "token_start": 2245,
      "token_end_exclusive": 2252
    },
    {
      "start_ms": 634230,
      "end_ms": 640750,
      "text": "它和青铜面具、青铜神树黄金权杖都带着一种不属于中原的美。",
      "token_start": 2252,
      "token_end_exclusive": 2278
    },
    {
      "start_ms": 641110,
      "end_ms": 643465,
      "text": "它证明了一件事儿中，",
      "token_start": 2278,
      "token_end_exclusive": 2287
    },
    {
      "start_ms": 643660,
      "end_ms": 645560,
      "text": "中华文明不是一条河，",
      "token_start": 2287,
      "token_end_exclusive": 2296
    },
    {
      "start_ms": 646180,
      "end_ms": 647060,
      "text": "是一片海。",
      "token_start": 2296,
      "token_end_exclusive": 2300
    },
    {
      "start_ms": 648340,
      "end_ms": 649940,
      "text": "你站在他面前，",
      "token_start": 2300,
      "token_end_exclusive": 2306
    },
    {
      "start_ms": 650220,
      "end_ms": 652500,
      "text": "仰头看那双突出的眼睛，",
      "token_start": 2306,
      "token_end_exclusive": 2316
    },
    {
      "start_ms": 652980,
      "end_ms": 656340,
      "text": "会觉得他真的在看着很远很远的地方。",
      "token_start": 2316,
      "token_end_exclusive": 2332
    },
    {
      "start_ms": 657260,
      "end_ms": 658020,
      "text": "说到这儿，",
      "token_start": 2332,
      "token_end_exclusive": 2336
    },
    {
      "start_ms": 658300,
      "end_ms": 659380,
      "text": "我想停一下，",
      "token_start": 2336,
      "token_end_exclusive": 2341
    },
    {
      "start_ms": 661160,
      "end_ms": 662500,
      "text": "你有没有发现一件事，",
      "token_start": 2341,
      "token_end_exclusive": 2350
    },
    {
      "start_ms": 663800,
      "end_ms": 669440,
      "text": "这五件显眼包没有一件是随便长压丑越的笑脸，",
      "token_start": 2350,
      "token_end_exclusive": 2370
    },
    {
      "start_ms": 669740,
      "end_ms": 673215,
      "text": "是权力与威严的另一种表达。",
      "token_start": 2370,
      "token_end_exclusive": 2382
    },
    {
      "start_ms": 674220,
      "end_ms": 676265,
      "text": "同奔马正面的憨态，",
      "token_start": 2382,
      "token_end_exclusive": 2390
    },
    {
      "start_ms": 676630,
      "end_ms": 680405,
      "text": "是汉代工匠对力学和动态的极致掌控。",
      "token_start": 2390,
      "token_end_exclusive": 2406
    },
    {
      "start_ms": 680950,
      "end_ms": 682525,
      "text": "绿柚讨狗的认真，",
      "token_start": 2406,
      "token_end_exclusive": 2413
    },
    {
      "start_ms": 682880,
      "end_ms": 685555,
      "text": "是东汉人对陪伴的理解。",
      "token_start": 2413,
      "token_end_exclusive": 2423
    },
    {
      "start_ms": 686500,
      "end_ms": 688200,
      "text": "击鼓说唱咏的夸张，",
      "token_start": 2423,
      "token_end_exclusive": 2431
    },
    {
      "start_ms": 688260,
      "end_ms": 691335,
      "text": "是两千年前中国喜剧的起点。",
      "token_start": 2431,
      "token_end_exclusive": 2443
    },
    {
      "start_ms": 692260,
      "end_ms": 694025,
      "text": "重木面具的怪异，",
      "token_start": 2443,
      "token_end_exclusive": 2450
    },
    {
      "start_ms": 694490,
      "end_ms": 697145,
      "text": "是古蜀人对太阳的崇拜，",
      "token_start": 2450,
      "token_end_exclusive": 2460
    },
    {
      "start_ms": 697800,
      "end_ms": 700055,
      "text": "古人比我们想象的有趣的多。",
      "token_start": 2460,
      "token_end_exclusive": 2472
    },
    {
      "start_ms": 700540,
      "end_ms": 703195,
      "text": "他们不是只会板着脸做李器，",
      "token_start": 2472,
      "token_end_exclusive": 2484
    },
    {
      "start_ms": 703800,
      "end_ms": 705625,
      "text": "他们会笑、会玩儿，",
      "token_start": 2484,
      "token_end_exclusive": 2491
    },
    {
      "start_ms": 705920,
      "end_ms": 708145,
      "text": "会把生活里最生动的瞬间，",
      "token_start": 2491,
      "token_end_exclusive": 2502
    },
    {
      "start_ms": 708600,
      "end_ms": 709360,
      "text": "用青铜，",
      "token_start": 2502,
      "token_end_exclusive": 2505
    },
    {
      "start_ms": 709640,
      "end_ms": 712505,
      "text": "用陶土用玉凝固下来，",
      "token_start": 2505,
      "token_end_exclusive": 2514
    },
    {
      "start_ms": 713200,
      "end_ms": 715590,
      "text": "留给我们下集。",
      "token_start": 2514,
      "token_end_exclusive": 2520
    },
    {
      "start_ms": 715810,
      "end_ms": 718415,
      "text": "咱们来看另外五件显眼包，",
      "token_start": 2520,
      "token_end_exclusive": 2531
    },
    {
      "start_ms": 718850,
      "end_ms": 719995,
      "text": "他们不靠表情，",
      "token_start": 2531,
      "token_end_exclusive": 2537
    },
    {
      "start_ms": 720420,
      "end_ms": 721205,
      "text": "靠造型，",
      "token_start": 2537,
      "token_end_exclusive": 2540
    },
    {
      "start_ms": 721990,
      "end_ms": 723675,
      "text": "有一件长得像路游器，",
      "token_start": 2540,
      "token_end_exclusive": 2549
    },
    {
      "start_ms": 724270,
      "end_ms": 727030,
      "text": "有一件向开会时集体罚站的姿势，",
      "token_start": 2549,
      "token_end_exclusive": 2563
    },
    {
      "start_ms": 727190,
      "end_ms": 728685,
      "text": "还有一件圆滚滚的，",
      "token_start": 2563,
      "token_end_exclusive": 2571
    },
    {
      "start_ms": 729650,
      "end_ms": 730725,
      "text": "你猜他是什么？",
      "token_start": 2571,
      "token_end_exclusive": 2577
    },
    {
      "start_ms": 731610,
      "end_ms": 733785,
      "text": "下一集已经同步更新，",
      "token_start": 2577,
      "token_end_exclusive": 2586
    },
    {
      "start_ms": 734550,
      "end_ms": 735670,
      "text": "点开我的头像，",
      "token_start": 2586,
      "token_end_exclusive": 2592
    },
    {
      "start_ms": 735690,
      "end_ms": 736455,
      "text": "进入主页，",
      "token_start": 2592,
      "token_end_exclusive": 2596
    },
    {
      "start_ms": 737340,
      "end_ms": 739295,
      "text": "第一条视频就是下一集，",
      "token_start": 2596,
      "token_end_exclusive": 2606
    },
    {
      "start_ms": 740220,
      "end_ms": 742195,
      "text": "感兴趣的朋友可以关注后续。",
      "token_start": 2606,
      "token_end_exclusive": 2618
    }
  ],
