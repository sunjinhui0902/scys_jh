{
  "video_id": "v_4f4d5d796acb8bf2",
  "duration_s": 603.998005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_4f4d5d796acb8bf2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_4f4d5d796acb8bf2.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 410,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 410,
      "end_ms": 3270,
      "text": "咱们看了五件表情管理失败的显眼包，",
      "token_start": 2,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3690,
      "end_ms": 5350,
      "text": "这一集咱们来看另外五件，",
      "token_start": 18,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6290,
      "end_ms": 8029,
      "text": "他们不靠脸靠造型，",
      "token_start": 29,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 8750,
      "end_ms": 10030,
      "text": "他们最想说的是，",
      "token_start": 37,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 10030,
      "end_ms": 11430,
      "text": "你猜我是干什么用的？",
      "token_start": 44,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11690,
      "end_ms": 16850,
      "text": "第一件安徽博物院云纹铜五柱器。",
      "token_start": 53,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 16850,
      "end_ms": 20490,
      "text": "它的造型是一个方形的底座，",
      "token_start": 67,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 20490,
      "end_ms": 23590,
      "text": "上面竖着五根等高的柱子。",
      "token_start": 79,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 23590,
      "end_ms": 26110,
      "text": "你第一眼看到它，",
      "token_start": 90,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26110,
      "end_ms": 29210,
      "text": "会觉得它像一台路由器。",
      "token_start": 97,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 29210,
      "end_ms": 32440,
      "text": "瓦子网友就是这么叫它的青铜路由器。",
      "token_start": 107,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 33060,
      "end_ms": 39820,
      "text": "西周青铜器一九五九年出土于安徽屯溪义齐献葬安徽博物院。",
      "token_start": 123,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 40600,
      "end_ms": 42260,
      "text": "但它到底是什么？",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 42920,
      "end_ms": 43880,
      "text": "没有人知道，",
      "token_start": 156,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 44600,
      "end_ms": 46800,
      "text": "安徽博物院官网明确写着，",
      "token_start": 161,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 47460,
      "end_ms": 49020,
      "text": "不见于朱家住路，",
      "token_start": 172,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 49400,
      "end_ms": 50340,
      "text": "用途待考，",
      "token_start": 179,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 51100,
      "end_ms": 52540,
      "text": "通高三十一厘米，",
      "token_start": 183,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 52900,
      "end_ms": 55240,
      "text": "其中筑高十六点五厘米，",
      "token_start": 190,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 55900,
      "end_ms": 57820,
      "text": "重五点二五公斤。",
      "token_start": 200,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 58700,
      "end_ms": 69070,
      "text": "器上有五五根原助分裂于长方形的脊级上距离户等下围空腔方坐四角，",
      "token_start": 207,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 69110,
      "end_ms": 69590,
      "text": "非圆，",
      "token_start": 237,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 69610,
      "end_ms": 70230,
      "text": "无棱鱼，",
      "token_start": 239,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 70530,
      "end_ms": 71465,
      "text": "四壁微谷。",
      "token_start": 242,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 71840,
      "end_ms": 74970,
      "text": "安徽博物院副院长黎志说过一段话，",
      "token_start": 246,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 75050,
      "end_ms": 77485,
      "text": "文物的定名都是有相关规范的。",
      "token_start": 261,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 77880,
      "end_ms": 79825,
      "text": "这件文物没有正式定名，",
      "token_start": 274,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 80430,
      "end_ms": 82390,
      "text": "就是因为他一没有铭文，",
      "token_start": 284,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 82610,
      "end_ms": 83990,
      "text": "二没有文献记载。",
      "token_start": 294,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 84230,
      "end_ms": 86305,
      "text": "三没有类似文物做参考。",
      "token_start": 301,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 86740,
      "end_ms": 88505,
      "text": "之所以称为捂助器，",
      "token_start": 311,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 88980,
      "end_ms": 92860,
      "text": "就是因为不清楚它的功能不得已，",
      "token_start": 319,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 92940,
      "end_ms": 95345,
      "text": "才依据器型、外表和纹饰特征。",
      "token_start": 333,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 95640,
      "end_ms": 97185,
      "text": "取一个临时名称，",
      "token_start": 345,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 98190,
      "end_ms": 102400,
      "text": "考古工作者曾对他做过事敲测音五柱，",
      "token_start": 352,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 102480,
      "end_ms": 103955,
      "text": "发音各不相同，",
      "token_start": 368,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 104480,
      "end_ms": 106335,
      "text": "或与古乐五音有关，",
      "token_start": 374,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 106910,
      "end_ms": 109450,
      "text": "每处不同部位也有不同声音。",
      "token_start": 382,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 109570,
      "end_ms": 109930,
      "text": "发掘。",
      "token_start": 394,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 109930,
      "end_ms": 110530,
      "text": "报告认为，",
      "token_start": 396,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 110670,
      "end_ms": 115555,
      "text": "这件铜器可能与音律和校正音高有密切关系。",
      "token_start": 400,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 116250,
      "end_ms": 122305,
      "text": "但由于发掘时没有见到附近有管乐器的腐朽残迹为之佐证，",
      "token_start": 419,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 122860,
      "end_ms": 125095,
      "text": "因此也不能肯定这是一件乐器。",
      "token_start": 444,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 125990,
      "end_ms": 129634,
      "text": "有学者从他的形状向甲骨文的纸质推测，",
      "token_start": 457,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 130110,
      "end_ms": 132875,
      "text": "可能与古人的生育繁衍观念有关。",
      "token_start": 474,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 134150,
      "end_ms": 135395,
      "text": "三千年过去了，",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 135770,
      "end_ms": 139495,
      "text": "这件青铜器仍然在问每一个站在他面前的人，",
      "token_start": 494,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 139950,
      "end_ms": 141405,
      "text": "你猜我是干什么用？",
      "token_start": 513,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 142480,
      "end_ms": 144800,
      "text": "如果说捂住器是个猜不透的谜，",
      "token_start": 521,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 145120,
      "end_ms": 149655,
      "text": "那下面这件姿势更让人摸不着头脑。",
      "token_start": 534,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 150460,
      "end_ms": 151145,
      "text": "第二件，",
      "token_start": 549,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 152120,
      "end_ms": 155535,
      "text": "安徽博物院青铜贵的勇，",
      "token_start": 552,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 156400,
      "end_ms": 158215,
      "text": "他们是一组青铜小人。",
      "token_start": 562,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 159540,
      "end_ms": 160540,
      "text": "一九六五年，",
      "token_start": 571,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 160560,
      "end_ms": 163925,
      "text": "出土于安徽屯溪一起土墩墓，",
      "token_start": 576,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 164290,
      "end_ms": 166075,
      "text": "通高约十五厘米，",
      "token_start": 588,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 166870,
      "end_ms": 169055,
      "text": "同仁作答疑作状，",
      "token_start": 595,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 169540,
      "end_ms": 171320,
      "text": "双手上举袁氏，",
      "token_start": 602,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 171660,
      "end_ms": 174225,
      "text": "托举物间身材脚矮，",
      "token_start": 608,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 174710,
      "end_ms": 175985,
      "text": "且裸体无事。",
      "token_start": 616,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 176590,
      "end_ms": 178535,
      "text": "四是古代男人的习俗，",
      "token_start": 621,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 179220,
      "end_ms": 181475,
      "text": "他们的姿势高度统一，",
      "token_start": 630,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 181910,
      "end_ms": 182855,
      "text": "双膝跪地，",
      "token_start": 639,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 183300,
      "end_ms": 184275,
      "text": "双臂举起，",
      "token_start": 643,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 184550,
      "end_ms": 185415,
      "text": "腰部挺直，",
      "token_start": 647,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 185720,
      "end_ms": 187825,
      "text": "表情虔诚一组四件，",
      "token_start": 651,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 188170,
      "end_ms": 191150,
      "text": "出土时分布在土墩木四角王佑管，",
      "token_start": 659,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 191150,
      "end_ms": 192605,
      "text": "这叫集体行为艺术。",
      "token_start": 673,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 192970,
      "end_ms": 194435,
      "text": "但他们不是行为艺术。",
      "token_start": 681,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 194880,
      "end_ms": 196115,
      "text": "研究人员推测，",
      "token_start": 690,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 196570,
      "end_ms": 199205,
      "text": "他们可能是大型李器的附属构建，",
      "token_start": 696,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 199830,
      "end_ms": 204785,
      "text": "是研究先秦时期祭祀等礼仪活动的重要食物遗存。",
      "token_start": 710,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 205360,
      "end_ms": 206965,
      "text": "他们跪了两千多年了，",
      "token_start": 731,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 207330,
      "end_ms": 208655,
      "text": "他们不是在等领导，",
      "token_start": 740,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 209020,
      "end_ms": 209985,
      "text": "他们是在等神，",
      "token_start": 748,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 210690,
      "end_ms": 212030,
      "text": "你站在他们面前，",
      "token_start": 754,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 212230,
      "end_ms": 214235,
      "text": "看着那一排排跪着的背影，",
      "token_start": 761,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 214660,
      "end_ms": 217585,
      "text": "会感受到一种庄重的仪式感。",
      "token_start": 772,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 218080,
      "end_ms": 226690,
      "text": "第三件安徽博物院守门暗遁武士陶俑，",
      "token_start": 784,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 226770,
      "end_ms": 229830,
      "text": "他们是一对一个张口古墓，",
      "token_start": 800,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 230190,
      "end_ms": 232875,
      "text": "面带笑容一个树木怒市，",
      "token_start": 811,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 233420,
      "end_ms": 234515,
      "text": "表情严厉，",
      "token_start": 821,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 235070,
      "end_ms": 236010,
      "text": "一个负责喜，",
      "token_start": 825,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 236510,
      "end_ms": 237350,
      "text": "一个负责怒。",
      "token_start": 830,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 237570,
      "end_ms": 239125,
      "text": "他们的工作是守门，",
      "token_start": 835,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 239660,
      "end_ms": 245415,
      "text": "一个笑着手一个怒着手分工明确隋代文物。",
      "token_start": 843,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 245720,
      "end_ms": 248660,
      "text": "一九七三年出土于安徽合肥郊区，",
      "token_start": 861,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 248680,
      "end_ms": 249895,
      "text": "隋开皇六年末，",
      "token_start": 875,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 250620,
      "end_ms": 251975,
      "text": "高五十厘米。",
      "token_start": 881,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 252640,
      "end_ms": 256575,
      "text": "献葬安徽博物院用陶俑陪葬。",
      "token_start": 886,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 257010,
      "end_ms": 259875,
      "text": "在秦至唐代贵族墓葬中叫流行，",
      "token_start": 898,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 260400,
      "end_ms": 263420,
      "text": "主要根据各时期官吏的形象雕塑而成，",
      "token_start": 911,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 263440,
      "end_ms": 266725,
      "text": "以显示死者生前显赫的地位。",
      "token_start": 927,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 267350,
      "end_ms": 269760,
      "text": "这两件守门武是有以手按顿，",
      "token_start": 939,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 269880,
      "end_ms": 271360,
      "text": "以手执兵器所执，",
      "token_start": 951,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 271360,
      "end_ms": 272365,
      "text": "兵器已脱落。",
      "token_start": 958,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 272790,
      "end_ms": 274820,
      "text": "出土时分布在墓中，",
      "token_start": 963,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 275360,
      "end_ms": 278205,
      "text": "该墓共出土了近四十件桃塑，",
      "token_start": 971,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 278650,
      "end_ms": 283405,
      "text": "为研究隋代的墓葬习俗和陶塑艺术提供了宝贵的实物资料。",
      "token_start": 983,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 283950,
      "end_ms": 285110,
      "text": "你站在他们面前，",
      "token_start": 1008,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 285310,
      "end_ms": 289755,
      "text": "会忍不住想一千四百年前他们守的是哪扇门？",
      "token_start": 1015,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 290350,
      "end_ms": 293515,
      "text": "那扇门后面住着什么人？",
      "token_start": 1034,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 293820,
      "end_ms": 295665,
      "text": "第四届南京博物院。",
      "token_start": 1044,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 296980,
      "end_ms": 298020,
      "text": "珠形陶罐，",
      "token_start": 1052,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 298240,
      "end_ms": 299620,
      "text": "它们是一组陶罐，",
      "token_start": 1056,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 299740,
      "end_ms": 302080,
      "text": "用陶泥制作大小不一，",
      "token_start": 1063,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 302740,
      "end_ms": 304240,
      "text": "造型是珠的样子。",
      "token_start": 1072,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 304380,
      "end_ms": 309620,
      "text": "来自高邮龙求装遗址新石器时代文物九只，",
      "token_start": 1079,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 309920,
      "end_ms": 313980,
      "text": "憨态可掬的小猪最大一只长十六厘米，",
      "token_start": 1097,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 314340,
      "end_ms": 316200,
      "text": "最小仅六点五厘米，",
      "token_start": 1113,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 316560,
      "end_ms": 318480,
      "text": "从大到小依次排列，",
      "token_start": 1121,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 318640,
      "end_ms": 320160,
      "text": "有的抿嘴拱鼻，",
      "token_start": 1129,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 320460,
      "end_ms": 321580,
      "text": "有的笑的眯眼，",
      "token_start": 1135,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 321760,
      "end_ms": 322720,
      "text": "还有的皱着眉。",
      "token_start": 1141,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 323180,
      "end_ms": 325060,
      "text": "它们的背部设有注水口，",
      "token_start": 1147,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 325220,
      "end_ms": 326375,
      "text": "肚子是空的，",
      "token_start": 1157,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 326770,
      "end_ms": 327490,
      "text": "可以装水。",
      "token_start": 1162,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 328350,
      "end_ms": 331430,
      "text": "这组文物兼具艺术性和实用性，",
      "token_start": 1166,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 331990,
      "end_ms": 334130,
      "text": "它的背部有注水口，",
      "token_start": 1179,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 334730,
      "end_ms": 337050,
      "text": "能用作盛水器装水，",
      "token_start": 1187,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 337150,
      "end_ms": 338790,
      "text": "别以为它们只是摆设。",
      "token_start": 1195,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 339690,
      "end_ms": 343810,
      "text": "猪形陶罐的造型与当时家猪饲养业发达有关，",
      "token_start": 1204,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 344570,
      "end_ms": 348190,
      "text": "它们的体型虽然与野猪仍有些近似，",
      "token_start": 1223,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 348630,
      "end_ms": 350930,
      "text": "但头部已经明显变短，",
      "token_start": 1238,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 351350,
      "end_ms": 354110,
      "text": "应是人工饲养驯化的结果。",
      "token_start": 1247,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 354470,
      "end_ms": 356905,
      "text": "距今约六千至七千年前钱，",
      "token_start": 1258,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 357180,
      "end_ms": 358740,
      "text": "中国人已经开始养猪，",
      "token_start": 1269,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 358980,
      "end_ms": 360580,
      "text": "还把猪做成了罐子。",
      "token_start": 1278,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 360740,
      "end_ms": 368475,
      "text": "这些猪形陶罐是江南地区新石器时代、稻作农业和家畜饲养业发达的一个缩影。",
      "token_start": 1286,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 368950,
      "end_ms": 371065,
      "text": "你看着他们圆滚滚的肚子，",
      "token_start": 1319,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 371550,
      "end_ms": 374110,
      "text": "会想起小时候用的存钱罐。",
      "token_start": 1330,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 374230,
      "end_ms": 374830,
      "text": "第五件，",
      "token_start": 1341,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 375010,
      "end_ms": 376010,
      "text": "南京博物院，",
      "token_start": 1344,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 376130,
      "end_ms": 377665,
      "text": "南唐人首余深勇。",
      "token_start": 1349,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 378180,
      "end_ms": 380935,
      "text": "它的造型是一个人的头，",
      "token_start": 1356,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 381590,
      "end_ms": 383445,
      "text": "接在一条鱼的身体上，",
      "token_start": 1366,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 384180,
      "end_ms": 385140,
      "text": "人脸安详，",
      "token_start": 1375,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 385440,
      "end_ms": 387915,
      "text": "余身有鳞尾巴翘起，",
      "token_start": 1379,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 388440,
      "end_ms": 390060,
      "text": "他是人还是鱼，",
      "token_start": 1387,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 390260,
      "end_ms": 391905,
      "text": "他是神还是怪？",
      "token_start": 1393,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 392530,
      "end_ms": 395250,
      "text": "南唐文物出土于南唐开国皇帝，",
      "token_start": 1399,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 395510,
      "end_ms": 396445,
      "text": "李清龄，",
      "token_start": 1412,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 396820,
      "end_ms": 398225,
      "text": "通高十五厘米，",
      "token_start": 1415,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 398480,
      "end_ms": 399685,
      "text": "长三十五厘米，",
      "token_start": 1421,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 400030,
      "end_ms": 401785,
      "text": "献葬南京博物院。",
      "token_start": 1427,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 402320,
      "end_ms": 406655,
      "text": "他属于唐宋墓葬中随葬器物的一种，",
      "token_start": 1434,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 407290,
      "end_ms": 409235,
      "text": "也被称作夷鱼，",
      "token_start": 1449,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 409670,
      "end_ms": 412630,
      "text": "主要作用是振木、辟邪、吉祥压。",
      "token_start": 1455,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 412630,
      "end_ms": 416430,
      "text": "盛山海经中描述海神人面，",
      "token_start": 1467,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 416430,
      "end_ms": 421485,
      "text": "而鱼身无足人手于神勇的造型可能来源于此。",
      "token_start": 1478,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 422400,
      "end_ms": 425265,
      "text": "而南唐是五代十国时期的一个王朝，",
      "token_start": 1497,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 425770,
      "end_ms": 427250,
      "text": "只有三十八年历史，",
      "token_start": 1512,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 427330,
      "end_ms": 430805,
      "text": "但留下了中国文学史上最璀璨的词。",
      "token_start": 1520,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 431570,
      "end_ms": 434025,
      "text": "李煜就是南唐最后一位君主，",
      "token_start": 1535,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 434460,
      "end_ms": 436015,
      "text": "这件人手于身勇，",
      "token_start": 1547,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 436880,
      "end_ms": 438100,
      "text": "有学者推测，",
      "token_start": 1554,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 438200,
      "end_ms": 440980,
      "text": "可能是南唐人对死后世界的一种想象。",
      "token_start": 1559,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 441000,
      "end_ms": 444805,
      "text": "仁死变成鱼游向另一个世界。",
      "token_start": 1575,
      "token_end_exclusive": 1587
    },
    {
      "start_ms": 445220,
      "end_ms": 447620,
      "text": "你看着他安详的人脸和鱼的身体，",
      "token_start": 1587,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 447620,
      "end_ms": 450485,
      "text": "会想起山海经里那些奇奇怪怪的生物。",
      "token_start": 1601,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 451350,
      "end_ms": 451975,
      "text": "说到这儿，",
      "token_start": 1617,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 452170,
      "end_ms": 453345,
      "text": "我想再停一下，",
      "token_start": 1621,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 454240,
      "end_ms": 455135,
      "text": "你发现了吗？",
      "token_start": 1627,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 456030,
      "end_ms": 457610,
      "text": "下集这五件显眼包，",
      "token_start": 1632,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 457850,
      "end_ms": 460745,
      "text": "每一件都在问我们同一个问题，",
      "token_start": 1640,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 461170,
      "end_ms": 462435,
      "text": "你猜我是干什么用的？",
      "token_start": 1653,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 462790,
      "end_ms": 468775,
      "text": "云文铜五注器出土六十多年了无数青铜器研究专家对他进行研究，",
      "token_start": 1662,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 469310,
      "end_ms": 472245,
      "text": "至今仍停留在推理的空间内。",
      "token_start": 1690,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 472690,
      "end_ms": 475260,
      "text": "青铜贵喜有跪了。",
      "token_start": 1702,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 475260,
      "end_ms": 478720,
      "text": "两千多年分布在土墩木四角，",
      "token_start": 1709,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 479740,
      "end_ms": 481180,
      "text": "不知道在守护什么。",
      "token_start": 1721,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 481240,
      "end_ms": 482260,
      "text": "守门武士勇，",
      "token_start": 1729,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 482440,
      "end_ms": 483280,
      "text": "一个笑一个，",
      "token_start": 1734,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 483280,
      "end_ms": 483520,
      "text": "怒，",
      "token_start": 1739,
      "token_end_exclusive": 1740
    },
    {
      "start_ms": 483660,
      "end_ms": 484460,
      "text": "分工明确，",
      "token_start": 1740,
      "token_end_exclusive": 1744
    },
    {
      "start_ms": 484460,
      "end_ms": 486020,
      "text": "但不知道守的是哪扇门。",
      "token_start": 1744,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 486880,
      "end_ms": 489560,
      "text": "珠形陶罐装水的，",
      "token_start": 1754,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 489640,
      "end_ms": 497580,
      "text": "但长得像猪镇人鱼身勇人的头鱼的身体、震目、辟邪的遗鱼。",
      "token_start": 1761,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 498480,
      "end_ms": 500640,
      "text": "这些显眼包不只是有趣，",
      "token_start": 1785,
      "token_end_exclusive": 1795
    },
    {
      "start_ms": 500880,
      "end_ms": 502180,
      "text": "他们是有趣的泥。",
      "token_start": 1795,
      "token_end_exclusive": 1802
    },
    {
      "start_ms": 502600,
      "end_ms": 507150,
      "text": "他们让我们看到古人的世界比我们想象的复杂的多。",
      "token_start": 1802,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 507810,
      "end_ms": 508670,
      "text": "他们有礼器，",
      "token_start": 1824,
      "token_end_exclusive": 1829
    },
    {
      "start_ms": 509130,
      "end_ms": 510830,
      "text": "有兵器、有乐器，",
      "token_start": 1829,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 511130,
      "end_ms": 512450,
      "text": "但他们也有疑问，",
      "token_start": 1835,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 512590,
      "end_ms": 514190,
      "text": "有想象、有幽默。",
      "token_start": 1842,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 514730,
      "end_ms": 517950,
      "text": "他们会把一个陶罐做成猪的样子，",
      "token_start": 1848,
      "token_end_exclusive": 1862
    },
    {
      "start_ms": 518010,
      "end_ms": 520290,
      "text": "会把一个人做成鱼的身体，",
      "token_start": 1862,
      "token_end_exclusive": 1873
    },
    {
      "start_ms": 521010,
      "end_ms": 523750,
      "text": "会做一个五根柱子的青铜器，",
      "token_start": 1873,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 523770,
      "end_ms": 525790,
      "text": "然后不告诉后人他是干什么。",
      "token_start": 1885,
      "token_end_exclusive": 1897
    },
    {
      "start_ms": 526670,
      "end_ms": 531110,
      "text": "这些谜散落在全国的博物馆里，",
      "token_start": 1897,
      "token_end_exclusive": 1910
    },
    {
      "start_ms": 531510,
      "end_ms": 532870,
      "text": "你去了安徽博物院，",
      "token_start": 1910,
      "token_end_exclusive": 1918
    },
    {
      "start_ms": 533330,
      "end_ms": 535330,
      "text": "能看到跪列俑和守门武士。",
      "token_start": 1918,
      "token_end_exclusive": 1929
    },
    {
      "start_ms": 535330,
      "end_ms": 537660,
      "text": "你去了南京博物院，",
      "token_start": 1929,
      "token_end_exclusive": 1937
    },
    {
      "start_ms": 537840,
      "end_ms": 540660,
      "text": "能看到猪型陶罐和人首余申勇，",
      "token_start": 1937,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 541420,
      "end_ms": 542520,
      "text": "但你到了现场，",
      "token_start": 1950,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 542900,
      "end_ms": 544265,
      "text": "可能只看到了他们，",
      "token_start": 1956,
      "token_end_exclusive": 1964
    },
    {
      "start_ms": 544650,
      "end_ms": 547795,
      "text": "却不知道他们背后的年代用途。",
      "token_start": 1964,
      "token_end_exclusive": 1977
    },
    {
      "start_ms": 548150,
      "end_ms": 548945,
      "text": "出土背景，",
      "token_start": 1977,
      "token_end_exclusive": 1981
    },
    {
      "start_ms": 549740,
      "end_ms": 551200,
      "text": "你不知道那件五铸器，",
      "token_start": 1981,
      "token_end_exclusive": 1990
    },
    {
      "start_ms": 551200,
      "end_ms": 553060,
      "text": "为什么没有人知道它的用途？",
      "token_start": 1990,
      "token_end_exclusive": 2002
    },
    {
      "start_ms": 553060,
      "end_ms": 554860,
      "text": "你不知道那件人手于神俑，",
      "token_start": 2002,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 554860,
      "end_ms": 558805,
      "text": "为什么出现在南唐开国皇帝的零目的？",
      "token_start": 2013,
      "token_end_exclusive": 2029
    },
    {
      "start_ms": 559850,
      "end_ms": 560290,
      "text": "最后，",
      "token_start": 2029,
      "token_end_exclusive": 2031
    },
    {
      "start_ms": 560850,
      "end_ms": 562005,
      "text": "我想问你一个问题，",
      "token_start": 2031,
      "token_end_exclusive": 2039
    },
    {
      "start_ms": 562950,
      "end_ms": 565455,
      "text": "上集的显眼包靠表情，",
      "token_start": 2039,
      "token_end_exclusive": 2048
    },
    {
      "start_ms": 566110,
      "end_ms": 568235,
      "text": "下集的显眼包靠造型，",
      "token_start": 2048,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 568640,
