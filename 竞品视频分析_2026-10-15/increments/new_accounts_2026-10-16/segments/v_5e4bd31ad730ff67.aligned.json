{
  "video_id": "v_5e4bd31ad730ff67",
  "duration_s": 629.470952,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_5e4bd31ad730ff67.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_5e4bd31ad730ff67.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 330,
      "end_ms": 2490,
      "text": "十分钟讲解亚里士多德形而上学。",
      "token_start": 0,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 2690,
      "end_ms": 4770,
      "text": "今天我们要讲的是一本名字很硬，",
      "token_start": 14,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 4930,
      "end_ms": 6570,
      "text": "内容也硬的格牙的书，",
      "token_start": 28,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 6970,
      "end_ms": 8850,
      "text": "亚里士多德的形而上学。",
      "token_start": 37,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 9090,
      "end_ms": 11430,
      "text": "那么什么是形而上学？",
      "token_start": 47,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 11670,
      "end_ms": 13370,
      "text": "你有没有觉得这个词很别扭，",
      "token_start": 56,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 13470,
      "end_ms": 14990,
      "text": "扭像被人当面去理解它，",
      "token_start": 68,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 14990,
      "end_ms": 15570,
      "text": "含含义。",
      "token_start": 78,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 15570,
      "end_ms": 16250,
      "text": "但因因你，",
      "token_start": 81,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 16250,
      "end_ms": 17730,
      "text": "你可能从开始就读错了，",
      "token_start": 85,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 18090,
      "end_ms": 18990,
      "text": "很像正们熟悉，",
      "token_start": 95,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 18990,
      "end_ms": 20990,
      "text": "是形而字学，",
      "token_start": 101,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 21630,
      "end_ms": 24330,
      "text": "就和我们熟悉的物理学数学学一样，",
      "token_start": 106,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 24350,
      "end_ms": 26390,
      "text": "专专门研究形而上的学问。",
      "token_start": 121,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 26410,
      "end_ms": 28110,
      "text": "但看形而上学这四个字，",
      "token_start": 132,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 28130,
      "end_ms": 29450,
      "text": "就像被人当面扔过来，",
      "token_start": 142,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 29450,
      "end_ms": 30440,
      "text": "一句判觉，",
      "token_start": 151,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 30700,
      "end_ms": 32500,
      "text": "去研究那些看不见、摸不着，",
      "token_start": 155,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 32700,
      "end_ms": 33840,
      "text": "跟你今天吃什么，",
      "token_start": 166,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 33840,
      "end_ms": 35620,
      "text": "明天干什么毫无关系的东西，",
      "token_start": 173,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 36220,
      "end_ms": 37360,
      "text": "谁会干这种事儿。",
      "token_start": 185,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 37620,
      "end_ms": 38960,
      "text": "一个不愁吃穿的贵族，",
      "token_start": 192,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 39340,
      "end_ms": 41300,
      "text": "一个把求知当饭吃的怪人，",
      "token_start": 201,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 41600,
      "end_ms": 43640,
      "text": "还是一个在别人眼里活得挺正常，",
      "token_start": 212,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 43840,
      "end_ms": 45380,
      "text": "却总觉得世界底下藏着。",
      "token_start": 226,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 45380,
      "end_ms": 46380,
      "text": "另一层东西的人，",
      "token_start": 236,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 46640,
      "end_ms": 49620,
      "text": "亚里士多德把这个问题写成了一整套追问，",
      "token_start": 243,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 49640,
      "end_ms": 51060,
      "text": "不是从几张照片开始，",
      "token_start": 261,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 51180,
      "end_ms": 52480,
      "text": "而是从一句话开始，",
      "token_start": 270,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 53040,
      "end_ms": 55000,
      "text": "求知是所有人的本性。",
      "token_start": 278,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 55200,
      "end_ms": 56740,
      "text": "这句话听起来像在夸人，",
      "token_start": 287,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 57020,
      "end_ms": 58660,
      "text": "其实是一句很重的判断。",
      "token_start": 297,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 59140,
      "end_ms": 60735,
      "text": "他等于说你活着，",
      "token_start": 307,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 61030,
      "end_ms": 62150,
      "text": "你就想知道点什么。",
      "token_start": 314,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 62150,
      "end_ms": 63875,
      "text": "你不光想知道明天的天气，",
      "token_start": 322,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 64140,
      "end_ms": 65785,
      "text": "你还想知道为什么会有明天，",
      "token_start": 333,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 66100,
      "end_ms": 67800,
      "text": "为什么会有为什么这个东西。",
      "token_start": 345,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 67880,
      "end_ms": 68800,
      "text": "亚里士多德说，",
      "token_start": 357,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 69120,
      "end_ms": 70280,
      "text": "对感觉的喜爱，",
      "token_start": 363,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 70280,
      "end_ms": 73170,
      "text": "就是证明人们甚至离开实用而喜爱。",
      "token_start": 369,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 73170,
      "end_ms": 76470,
      "text": "感觉本身喜爱视觉尤胜于其他，",
      "token_start": 384,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 76550,
      "end_ms": 78015,
      "text": "不仅是在实际活动中，",
      "token_start": 397,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 78350,
      "end_ms": 80330,
      "text": "就在并不打算做什么的时候，",
      "token_start": 406,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 80350,
      "end_ms": 83240,
      "text": "我们也更愿意观看这段话放到今天。",
      "token_start": 418,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 83380,
      "end_ms": 85535,
      "text": "就像一个人刷手机刷到凌晨三点，",
      "token_start": 433,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 85880,
      "end_ms": 87705,
      "text": "他并没有在找什么具体的东西，",
      "token_start": 447,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 87960,
      "end_ms": 88915,
      "text": "他只是停不下来。",
      "token_start": 460,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 89570,
      "end_ms": 90650,
      "text": "求知这件事儿，",
      "token_start": 467,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 90650,
      "end_ms": 92865,
      "text": "有时候确实像一种停不下来的东西。",
      "token_start": 473,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 93250,
      "end_ms": 95090,
      "text": "在翻开那十四卷的正文之前，",
      "token_start": 488,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 95450,
      "end_ms": 96490,
      "text": "先说两句作者，",
      "token_start": 500,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 96490,
      "end_ms": 97170,
      "text": "亚里士多德，",
      "token_start": 506,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 97250,
      "end_ms": 99815,
      "text": "他是古希腊哲学里一个极特殊的存在。",
      "token_start": 511,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 100190,
      "end_ms": 101495,
      "text": "出生在斯塔吉拉，",
      "token_start": 527,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 101800,
      "end_ms": 104115,
      "text": "父亲是马其顿国王的宫廷医师，",
      "token_start": 534,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 104570,
      "end_ms": 108325,
      "text": "十八岁到雅典进入柏拉图的学员一呆就是二十年。",
      "token_start": 547,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 108670,
      "end_ms": 109190,
      "text": "按理说，",
      "token_start": 568,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 109510,
      "end_ms": 112365,
      "text": "他应该走一条稳妥的柏拉图弟子路线，",
      "token_start": 571,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 112740,
      "end_ms": 113855,
      "text": "继承老师的思想，",
      "token_start": 587,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 114170,
      "end_ms": 114970,
      "text": "写写对话录，",
      "token_start": 594,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 115170,
      "end_ms": 116690,
      "text": "做一个温和的追随者。",
      "token_start": 599,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 116750,
      "end_ms": 118710,
      "text": "可他的人生几乎从中间开始，",
      "token_start": 608,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 118730,
      "end_ms": 119970,
      "text": "就在往反方向跑。",
      "token_start": 620,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 120010,
      "end_ms": 120970,
      "text": "柏拉图逝世后，",
      "token_start": 627,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 121110,
      "end_ms": 122225,
      "text": "他离开了学园，",
      "token_start": 633,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 122560,
      "end_ms": 124425,
      "text": "后来甚至做了亚历山大的老师，",
      "token_start": 639,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 124920,
      "end_ms": 127725,
      "text": "他回来之后创办了自己的学员叫吕克昂。",
      "token_start": 652,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 128140,
      "end_ms": 130335,
      "text": "每天带着学生在廊下边走边讲，",
      "token_start": 669,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 130850,
      "end_ms": 135195,
      "text": "他什么都写逻辑学、物理学、生物学、伦理学、政治学，",
      "token_start": 682,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 135510,
      "end_ms": 137015,
      "text": "还有这本形而上学。",
      "token_start": 702,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 137390,
      "end_ms": 138330,
      "text": "他留下的著作，",
      "token_start": 710,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 138410,
      "end_ms": 141775,
      "text": "像是把一个人能想到的所有问题都摊在桌子上。",
      "token_start": 716,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 142090,
      "end_ms": 143655,
      "text": "一个一个拆开来看，",
      "token_start": 736,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 143940,
      "end_ms": 146275,
      "text": "他不像柏拉图那样写戏剧性的对话。",
      "token_start": 744,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 146640,
      "end_ms": 149300,
      "text": "他的语气更干、更硬、更直接，",
      "token_start": 759,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 149720,
      "end_ms": 152920,
      "text": "像是一个人在对着墙壁反复推敲自己的困惑。",
      "token_start": 770,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 152940,
      "end_ms": 153755,
      "text": "读他的书，",
      "token_start": 789,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 154090,
      "end_ms": 154530,
      "text": "像在看，",
      "token_start": 793,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 154530,
      "end_ms": 157545,
      "text": "一个人把世界的骨架一根一根拆下来，",
      "token_start": 796,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 157780,
      "end_ms": 158905,
      "text": "再试着装回去，",
      "token_start": 812,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 159170,
      "end_ms": 160005,
      "text": "不是为了炫耀，",
      "token_start": 818,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 160400,
      "end_ms": 164810,
      "text": "而是因为他实在忍不住想知道这些东西到底是怎么连在一起的。",
      "token_start": 824,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 164890,
      "end_ms": 167870,
      "text": "形而上学不是一本从头到尾一气呵成的书，",
      "token_start": 851,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 167970,
      "end_ms": 172575,
      "text": "它更像是亚里士多德在不同时期写下的十几组杂记的汇编。",
      "token_start": 869,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 173130,
      "end_ms": 174890,
      "text": "古代编者把他们凑在一起，",
      "token_start": 894,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 175050,
      "end_ms": 176130,
      "text": "凑出了十四卷。",
      "token_start": 905,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 176190,
      "end_ms": 179955,
      "text": "第一卷回顾以前的哲学家关于世界本源问题的看法，",
      "token_start": 911,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 180350,
      "end_ms": 183710,
      "text": "指出探究事物存在和发展原因的重要性。",
      "token_start": 933,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 183770,
      "end_ms": 186635,
      "text": "第三卷提出了十四个有待解决的哲学难题，",
      "token_start": 950,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 186950,
      "end_ms": 188010,
      "text": "被称为难题。",
      "token_start": 968,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 188010,
      "end_ms": 189310,
      "text": "卷第七卷解释，",
      "token_start": 973,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 189330,
      "end_ms": 190130,
      "text": "实体学说。",
      "token_start": 979,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 190330,
      "end_ms": 195320,
      "text": "第八九卷讨论质量和形式、潜能和现实的范畴及其辩证关系。",
      "token_start": 983,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 195460,
      "end_ms": 198785,
      "text": "第十二卷讲宇宙的总因提出了神学思想，",
      "token_start": 1008,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 199080,
      "end_ms": 201255,
      "text": "整本书没有一条从头顺到尾的线。",
      "token_start": 1025,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 201540,
      "end_ms": 204490,
      "text": "那你读下去会发现所有那些散开的追问，",
      "token_start": 1039,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 204610,
      "end_ms": 206305,
      "text": "最后都指向同一个问题，",
      "token_start": 1056,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 206890,
      "end_ms": 208330,
      "text": "存在之为存在，",
      "token_start": 1066,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 208610,
      "end_ms": 209470,
      "text": "到底是什么？",
      "token_start": 1072,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 209470,
      "end_ms": 211085,
      "text": "回到亚里士多德自己的追问，",
      "token_start": 1077,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 211430,
      "end_ms": 213210,
      "text": "他一开始做的事儿是回头看，",
      "token_start": 1089,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 213350,
      "end_ms": 217430,
      "text": "他在第一卷里把从泰勒斯到柏拉图的前人全部过了一遍，",
      "token_start": 1101,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 217630,
      "end_ms": 218590,
      "text": "像一个后来者，",
      "token_start": 1125,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 218590,
      "end_ms": 221750,
      "text": "站在前人搭好的架子旁边一个一个检查，",
      "token_start": 1131,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 221750,
      "end_ms": 222925,
      "text": "那些架子牢不牢。",
      "token_start": 1148,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 223570,
      "end_ms": 224565,
      "text": "他发现一个问题，",
      "token_start": 1155,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 225170,
      "end_ms": 227190,
      "text": "以前的哲学家都在找本源，",
      "token_start": 1162,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 227610,
      "end_ms": 229265,
      "text": "找万物由什么构成？",
      "token_start": 1173,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 229810,
      "end_ms": 231925,
      "text": "有人说水有人说气，",
      "token_start": 1181,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 232370,
      "end_ms": 233070,
      "text": "有人说火，",
      "token_start": 1189,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 233390,
      "end_ms": 234070,
      "text": "有人说树，",
      "token_start": 1193,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 234270,
      "end_ms": 234890,
      "text": "但亚里士多，",
      "token_start": 1197,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 234890,
      "end_ms": 235585,
      "text": "觉得这不够。",
      "token_start": 1202,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 235970,
      "end_ms": 237575,
      "text": "你说水是万物的本源，",
      "token_start": 1207,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 237950,
      "end_ms": 239650,
      "text": "那水为什么能变成桌子，",
      "token_start": 1216,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 239650,
      "end_ms": 240230,
      "text": "变成人，",
      "token_start": 1226,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 240310,
      "end_ms": 241525,
      "text": "变成天上的星星？",
      "token_start": 1229,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 241910,
      "end_ms": 244255,
      "text": "光有一个东西解释不了变化。",
      "token_start": 1236,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 244660,
      "end_ms": 245060,
      "text": "于是，",
      "token_start": 1248,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 245180,
      "end_ms": 247425,
      "text": "他提出了一个更完整的答案框架。",
      "token_start": 1250,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 247830,
      "end_ms": 248745,
      "text": "四英说，",
      "token_start": 1264,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 249130,
      "end_ms": 252985,
      "text": "一个事物之所以成为他背后有四样东西在起作用。",
      "token_start": 1267,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 253520,
      "end_ms": 259130,
      "text": "治疗音是它由什么做成形式音是它是什么动力音，",
      "token_start": 1288,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 259330,
      "end_ms": 260575,
      "text": "是什么让它开始？",
      "token_start": 1309,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 261090,
      "end_ms": 262870,
      "text": "目的因是他为了什么？",
      "token_start": 1316,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 262890,
      "end_ms": 264165,
      "text": "拿一张桌子来说，",
      "token_start": 1325,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 264590,
      "end_ms": 265865,
      "text": "木头是治疗音，",
      "token_start": 1332,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 266280,
      "end_ms": 268905,
      "text": "桌子的形状和结构是形式音，",
      "token_start": 1338,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 269270,
      "end_ms": 270645,
      "text": "木匠是动力音，",
      "token_start": 1350,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 271020,
      "end_ms": 271860,
      "text": "用来放东西，",
      "token_start": 1356,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 272020,
      "end_ms": 274210,
      "text": "写字吃饭是目的音，",
      "token_start": 1361,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 274310,
      "end_ms": 275850,
      "text": "听起来简单的像废话。",
      "token_start": 1369,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 276070,
      "end_ms": 277865,
      "text": "但亚里士多德真正的意思是，",
      "token_start": 1378,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 278210,
      "end_ms": 280650,
      "text": "这四样东西里前两样是一对儿，",
      "token_start": 1390,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 280650,
      "end_ms": 281945,
      "text": "后两样是一对儿。",
      "token_start": 1403,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 282260,
      "end_ms": 285180,
      "text": "质量和形式的关系才是他要说的核心。",
      "token_start": 1410,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 285320,
      "end_ms": 287195,
      "text": "木头是潜在的桌子，",
      "token_start": 1426,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 287500,
      "end_ms": 288425,
      "text": "他还不是桌子，",
      "token_start": 1434,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 288700,
      "end_ms": 290460,
      "text": "但他有成为桌子的可能性。",
      "token_start": 1440,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 290540,
      "end_ms": 292600,
      "text": "当木匠把形式加在木头上，",
      "token_start": 1451,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 292920,
      "end_ms": 295180,
      "text": "木头就从潜能变成了现实。",
      "token_start": 1462,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 295540,
      "end_ms": 297200,
      "text": "种子是树的潜能，",
      "token_start": 1473,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 297600,
      "end_ms": 299120,
      "text": "树是种子的现实。",
      "token_start": 1480,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 299320,
      "end_ms": 303235,
      "text": "一块大理石在米开朗基罗动手之前只是石头。",
      "token_start": 1487,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 303690,
      "end_ms": 305450,
      "text": "大卫象已经在石头里了，",
      "token_start": 1506,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 305550,
      "end_ms": 306590,
      "text": "只是还没有出来。",
      "token_start": 1516,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 306630,
      "end_ms": 308870,
      "text": "这就是亚里士多德对变化的解释。",
      "token_start": 1523,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 309130,
      "end_ms": 310850,
      "text": "变化不是从无到有，",
      "token_start": 1537,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 311130,
      "end_ms": 312990,
      "text": "而是从潜能到现实，",
      "token_start": 1545,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 313190,
      "end_ms": 315630,
      "text": "一个东西成为他本该成为的样子。",
      "token_start": 1553,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 315850,
      "end_ms": 318450,
      "text": "这个过程它叫做引得来西，",
      "token_start": 1567,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 318910,
      "end_ms": 321730,
      "text": "也就是实现这个框架听起来很温和，",
      "token_start": 1578,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 321970,
      "end_ms": 322930,
      "text": "甚至有点乐观。",
      "token_start": 1593,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 323050,
      "end_ms": 326230,
      "text": "他好像在说万物都有一个内在的方向，",
      "token_start": 1599,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 326570,
      "end_ms": 327590,
      "text": "只要给他条件，",
      "token_start": 1615,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 327750,
      "end_ms": 329210,
      "text": "他就会朝着那个方向长。",
      "token_start": 1621,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 329350,
      "end_ms": 332150,
      "text": "但亚里士多德把这个框架推到极致的时候，",
      "token_start": 1631,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 332370,
      "end_ms": 333960,
      "text": "结论就变得很不安。",
      "token_start": 1649,
      "token_end_exclusive": 1657
    },
    {
      "start_ms": 333960,
      "end_ms": 336540,
      "text": "如果一切运动都是从潜能到现实，",
      "token_start": 1657,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 336800,
      "end_ms": 338460,
      "text": "那么运动的源头是什么？",
      "token_start": 1671,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 338680,
      "end_ms": 340800,
      "text": "现实不可能来自于纯粹的潜能，",
      "token_start": 1681,
      "token_end_exclusive": 1694
    },
    {
      "start_ms": 341080,
      "end_ms": 342880,
      "text": "因为潜能本身不会自己动，",
      "token_start": 1694,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 343000,
      "end_ms": 344080,
      "text": "一定有一个东西，",
      "token_start": 1705,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 344180,
      "end_ms": 345880,
      "text": "它已经是纯粹的现实，",
      "token_start": 1712,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 346120,
      "end_ms": 348560,
      "text": "它不包含任何未实现的可能性。",
      "token_start": 1721,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 348900,
      "end_ms": 349460,
      "text": "他不动，",
      "token_start": 1734,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 349840,
      "end_ms": 351140,
      "text": "但它让别的东西动，",
      "token_start": 1737,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 351240,
      "end_ms": 353420,
      "text": "这就是第十二卷里那个著名的概念，",
      "token_start": 1745,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 353560,
      "end_ms": 354800,
      "text": "不动的推动者。",
      "token_start": 1760,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 355100,
      "end_ms": 357900,
      "text": "亚里士多德把这个不动的推动者称为神，",
      "token_start": 1766,
      "token_end_exclusive": 1783
    },
    {
      "start_ms": 358420,
      "end_ms": 361260,
      "text": "但他的神不是圣经里的那个创造者。",
      "token_start": 1783,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 361780,
      "end_ms": 363325,
      "text": "这个神不创造世界，",
      "token_start": 1798,
      "token_end_exclusive": 1806
    },
    {
      "start_ms": 363570,
      "end_ms": 364570,
      "text": "不关心世界，",
      "token_start": 1806,
      "token_end_exclusive": 1811
    },
    {
      "start_ms": 364650,
      "end_ms": 365570,
      "text": "不爱世界。",
      "token_start": 1811,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 365570,
      "end_ms": 367250,
      "text": "他只是作为一个最终的目的，",
      "token_start": 1815,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 367250,
      "end_ms": 368870,
      "text": "因在吸引着一切，",
      "token_start": 1827,
      "token_end_exclusive": 1834
    },
    {
      "start_ms": 369190,
      "end_ms": 370610,
      "text": "像一个永远够不到，",
      "token_start": 1834,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 370690,
      "end_ms": 372630,
      "text": "但永远在牵引着你的东西，",
      "token_start": 1842,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 372770,
      "end_ms": 374350,
      "text": "万物都在朝着它运动，",
      "token_start": 1853,
      "token_end_exclusive": 1862
    },
    {
      "start_ms": 374630,
      "end_ms": 377165,
      "text": "像被爱着的对象吸引着爱者一样。",
      "token_start": 1862,
      "token_end_exclusive": 1876
    },
    {
      "start_ms": 377410,
      "end_ms": 378550,
      "text": "这个画面非常奇怪，",
      "token_start": 1876,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 378750,
      "end_ms": 379485,
      "text": "也非常冷。",
      "token_start": 1884,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 379840,
      "end_ms": 382805,
      "text": "一个完美的自足的不动的东西，",
      "token_start": 1888,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 383090,
      "end_ms": 385075,
      "text": "让整个宇宙在它周围旋转。",
      "token_start": 1901,
      "token_end_exclusive": 1912
    },
    {
      "start_ms": 385390,
      "end_ms": 387650,
      "text": "亚里士多德自己也知道这个说法有多极端，",
      "token_start": 1912,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 387910,
      "end_ms": 388695,
      "text": "但他认为，",
      "token_start": 1930,
      "token_end_exclusive": 1934
    },
    {
      "start_ms": 388980,
      "end_ms": 392620,
      "text": "如果一切都在运动而运动的链条不能无限倒退，",
      "token_start": 1934,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 392820,
      "end_ms": 394700,
      "text": "就必须有一个不动的起点。",
      "token_start": 1954,
      "token_end_exclusive": 1965
    },
    {
      "start_ms": 395040,
      "end_ms": 397039,
      "text": "这个起点不是时间上的第一秒，",
      "token_start": 1965,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 397320,
      "end_ms": 398880,
      "text": "而是逻辑上的第一个。",
      "token_start": 1978,
      "token_end_exclusive": 1987
    },
    {
      "start_ms": 398880,
      "end_ms": 399840,
      "text": "如果只看概念，",
      "token_start": 1987,
      "token_end_exclusive": 1993
    },
    {
      "start_ms": 399920,
      "end_ms": 402880,
      "text": "会觉得亚里士多德是一个冷静的系统建造者。",
      "token_start": 1993,
      "token_end_exclusive": 2012
    },
    {
      "start_ms": 402940,
      "end_ms": 404885,
      "text": "但如果你想一想他追问的方式，",
      "token_start": 2012,
      "token_end_exclusive": 2025
    },
    {
      "start_ms": 405150,
      "end_ms": 407855,
      "text": "你会发现它的底色是一种很深的惊奇。",
      "token_start": 2025,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 408400,
      "end_ms": 408740,
      "text": "他问，",
      "token_start": 2041,
      "token_end_exclusive": 2043
    },
    {
      "start_ms": 408740,
      "end_ms": 409725,
      "text": "存在是什么？",
      "token_start": 2043,
      "token_end_exclusive": 2048
    },
    {
      "start_ms": 410030,
      "end_ms": 411475,
      "text": "不是因为他已经有了答案，",
      "token_start": 2048,
      "token_end_exclusive": 2059
    },
    {
      "start_ms": 411810,
      "end_ms": 414825,
      "text": "而是因为他真的不明白为什么会有东西存在，",
      "token_start": 2059,
      "token_end_exclusive": 2078
    },
    {
      "start_ms": 415080,
      "end_ms": 416345,
      "text": "而不是什么都没有。",
      "token_start": 2078,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 416850,
      "end_ms": 417570,
      "text": "他问一个东西，",
      "token_start": 2086,
      "token_end_exclusive": 2092
    },
    {
      "start_ms": 417570,
      "end_ms": 420195,
      "text": "为什么是他不是因为他觉得这理所当然，",
      "token_start": 2092,
      "token_end_exclusive": 2109
    },
    {
      "start_ms": 420510,
      "end_ms": 422490,
      "text": "而是因为他觉得这极其奇怪。",
      "token_start": 2109,
      "token_end_exclusive": 2121
    },
    {
      "start_ms": 422490,
      "end_ms": 424090,
      "text": "世界上有桌子、有树，",
      "token_start": 2121,
      "token_end_exclusive": 2129
    },
    {
      "start_ms": 424450,
      "end_ms": 425955,
      "text": "有人有星星，",
      "token_start": 2129,
      "token_end_exclusive": 2134
    },
    {
      "start_ms": 426470,
      "end_ms": 427910,
      "text": "这些东西凭什么存在？",
      "token_start": 2134,
      "token_end_exclusive": 2143
    },
    {
      "start_ms": 428070,
      "end_ms": 429150,
      "text": "凭什么是这个样子，",
      "token_start": 2143,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 429150,
      "end_ms": 430145,
      "text": "而不是另一个样子？",
      "token_start": 2151,
      "token_end_exclusive": 2159
    },
    {
      "start_ms": 430650,
      "end_ms": 434070,
      "text": "这些问题没有一个能靠日常经验回答日常经验，",
      "token_start": 2159,
      "token_end_exclusive": 2179
    },
    {
      "start_ms": 434070,
      "end_ms": 437760,
      "text": "只告诉你有不告诉你为什么有亚里士多德做的事儿，",
      "token_start": 2179,
      "token_end_exclusive": 2201
    },
    {
      "start_ms": 437760,
      "end_ms": 440205,
      "text": "就是在这个有的底下继续往下挖。",
      "token_start": 2201,
      "token_end_exclusive": 2215
    },
    {
      "start_ms": 440620,
      "end_ms": 442185,
      "text": "这种追问的代价是什么？",
      "token_start": 2215,
      "token_end_exclusive": 2225
    },
    {
      "start_ms": 442570,
      "end_ms": 444915,
      "text": "是你一旦开始问存在是什么，",
      "token_start": 2225,
      "token_end_exclusive": 2237
    },
    {
      "start_ms": 445230,
      "end_ms": 447890,
      "text": "你就很难再回到只管过日子的状态。",
      "token_start": 2237,
      "token_end_exclusive": 2252
    },
    {
      "start_ms": 447930,
      "end_ms": 449710,
      "text": "你会在看到一张桌子的时候，",
      "token_start": 2252,
      "token_end_exclusive": 2264
    },
    {
      "start_ms": 449870,
      "end_ms": 451505,
      "text": "想到木头和形式，",
      "token_start": 2264,
      "token_end_exclusive": 2271
    },
    {
      "start_ms": 451890,
      "end_ms": 454695,
      "text": "看到一棵树的时候想到潜能和现实。",
      "token_start": 2271,
      "token_end_exclusive": 2286
    },
    {
      "start_ms": 455050,
      "end_ms": 457685,
      "text": "看到一个人想到实体和属性，",
      "token_start": 2286,
      "token_end_exclusive": 2298
    },
    {
      "start_ms": 458100,
      "end_ms": 459285,
      "text": "世界的表面还在，",
      "token_start": 2298,
      "token_end_exclusive": 2305
    },
    {
      "start_ms": 459550,
      "end_ms": 460470,
      "text": "但底下多了一层。",
      "token_start": 2305,
      "token_end_exclusive": 2312
    },
    {
      "start_ms": 460470,
      "end_ms": 461565,
      "text": "你拆不掉的东西，",
      "token_start": 2312,
      "token_end_exclusive": 2319
    },
    {
      "start_ms": 462210,
      "end_ms": 464895,
      "text": "亚里士多德自己大概也感受到了这种负担。",
      "token_start": 2319,
      "token_end_exclusive": 2337
    },
    {
      "start_ms": 465200,
      "end_ms": 467875,
      "text": "他在形而上学第三卷里列出十四个难题，",
      "token_start": 2337,
      "token_end_exclusive": 2354
    },
    {
      "start_ms": 468240,
      "end_ms": 469260,
      "text": "有些他回答了，",
      "token_start": 2354,
      "token_end_exclusive": 2360
    },
    {
      "start_ms": 469280,
      "end_ms": 470865,
      "text": "有些他自己也没完全解决。",
      "token_start": 2360,
      "token_end_exclusive": 2371
    },
    {
      "start_ms": 471650,
      "end_ms": 472550,
      "text": "整本书读下来，",
      "token_start": 2371,
      "token_end_exclusive": 2377
    },
    {
      "start_ms": 472550,
      "end_ms": 475155,
      "text": "你会觉得这个人不是在给你一个封闭的体系，",
      "token_start": 2377,
      "token_end_exclusive": 2396
    },
    {
      "start_ms": 475500,
      "end_ms": 477840,
      "text": "而是在给你一个开放的追问方式。",
      "token_start": 2396,
      "token_end_exclusive": 2410
    },
    {
      "start_ms": 477980,
      "end_ms": 479345,
      "text": "他教你的不是结论，",
      "token_start": 2410,
      "token_end_exclusive": 2418
    },
    {
      "start_ms": 479720,
      "end_ms": 484185,
      "text": "而是怎么在一件事上一直往下问问到不能再问为止。",
      "token_start": 2418,
      "token_end_exclusive": 2440
    },
    {
      "start_ms": 484520,
      "end_ms": 486540,
      "text": "为什么两千多年后还有人读这本书？",
      "token_start": 2440,
      "token_end_exclusive": 2455
    },
    {
      "start_ms": 486680,
      "end_ms": 489340,
      "text": "因为我们大多数人不会像亚里士多德那样极端，",
      "token_start": 2455,
      "token_end_exclusive": 2475
    },
    {
      "start_ms": 489700,
      "end_ms": 491960,
      "text": "却都多少懂一点他的那种感觉。",
      "token_start": 2475,
      "token_end_exclusive": 2488
    },
    {
      "start_ms": 492080,
      "end_ms": 493560,
      "text": "你有时候会突然停下来，",
      "token_start": 2488,
      "token_end_exclusive": 2498
    },
    {
      "start_ms": 493580,
      "end_ms": 494760,
      "text": "看着手里的杯子，",
      "token_start": 2498,
      "token_end_exclusive": 2505
    },
    {
      "start_ms": 494840,
      "end_ms": 495865,
      "text": "或者窗外的树，",
      "token_start": 2505,
      "token_end_exclusive": 2511
    },
    {
      "start_ms": 496140,
      "end_ms": 497300,
      "text": "或者对面坐着的人，",
      "token_start": 2511,
      "token_end_exclusive": 2519
    },
    {
      "start_ms": 497560,
      "end_ms": 499565,
      "text": "心里冒出一个毫无用处的念头。",
      "token_start": 2519,
      "token_end_exclusive": 2532
    },
    {
      "start_ms": 500060,
      "end_ms": 501325,
      "text": "这个东西到底是什么？",
      "token_start": 2532,
      "token_end_exclusive": 2541
    },
    {
      "start_ms": 501750,
      "end_ms": 502865,
      "text": "我到底是什么？",
      "token_start": 2541,
      "token_end_exclusive": 2547
    },
    {
      "start_ms": 503100,
      "end_ms": 504800,
      "text": "这种感觉持续不了几秒钟，",
      "token_start": 2547,
      "token_end_exclusive": 2558
    },
    {
      "start_ms": 504980,
      "end_ms": 506645,
      "text": "你就被下一件事推走了。",
      "token_start": 2558,
      "token_end_exclusive": 2568
    },
    {
      "start_ms": 506940,
      "end_ms": 508160,
      "text": "但亚里士多德没有走，",
      "token_start": 2568,
      "token_end_exclusive": 2577
    },
    {
      "start_ms": 508420,
      "end_ms": 511995,
      "text": "他坐在那里把这个虽而上学里没有故事，",
      "token_start": 2577,
      "token_end_exclusive": 2594
    },
    {
      "start_ms": 512370,
      "end_ms": 513235,
      "text": "没有人物，",
      "token_start": 2594,
      "token_end_exclusive": 2598
    },
    {
      "start_ms": 513620,
      "end_ms": 514495,
      "text": "没有情节。",
      "token_start": 2598,
      "token_end_exclusive": 2602
    },
    {
      "start_ms": 515100,
      "end_ms": 518675,
      "text": "他有的只是一连串的追问和一个不肯停下来的人，",
      "token_start": 2602,
      "token_end_exclusive": 2623
    },
    {
      "start_ms": 519160,
      "end_ms": 520440,
      "text": "他不教你如何成功，",
      "token_start": 2623,
      "token_end_exclusive": 2631
    },
    {
      "start_ms": 520660,
      "end_ms": 521835,
      "text": "不教你怎么幸福，",
      "token_start": 2631,
      "token_end_exclusive": 2638
    },
    {
      "start_ms": 522150,
      "end_ms": 523555,
      "text": "甚至不教你怎么做人。",
      "token_start": 2638,
      "token_end_exclusive": 2647
    },
    {
      "start_ms": 524180,
      "end_ms": 529440,
      "text": "他做的事是另一件把最抽象、最不实用、最不体面的困惑，",
      "token_start": 2647,
      "token_end_exclusive": 2670
    },
    {
      "start_ms": 529700,
      "end_ms": 531215,
      "text": "赤裸裸的摊在桌子上，",
      "token_start": 2670,
      "token_end_exclusive": 2679
    },
    {
      "start_ms": 531540,
      "end_ms": 535205,
      "text": "让你看见一个人是如何在一件事上一点一点往下挖的。",
      "token_start": 2679,
      "token_end_exclusive": 2702
    },
    {
      "start_ms": 536060,
      "end_ms": 536995,
      "text": "而奇怪的是，",
      "token_start": 2702,
      "token_end_exclusive": 2707
    },
    {
      "start_ms": 537420,
      "end_ms": 538740,
      "text": "很多人在堵到这里时，",
      "token_start": 2707,
      "token_end_exclusive": 2716
    },
    {
      "start_ms": 539100,
      "end_ms": 541335,
      "text": "反而会生出一点微妙的安慰。",
      "token_start": 2716,
      "token_end_exclusive": 2728
    },
    {
      "start_ms": 541930,
      "end_ms": 546035,
      "text": "因为你发现原来不是只有你在某些时刻觉得这个世界不对劲，",
      "token_start": 2728,
      "token_end_exclusive": 2754
    },
    {
      "start_ms": 546470,
      "end_ms": 548675,
      "text": "觉得存在这件事儿本身就很奇怪，",
      "token_start": 2754,
      "token_end_exclusive": 2768
    },
    {
      "start_ms": 549170,
      "end_ms": 550345,
      "text": "有人比你更极端，",
      "token_start": 2768,
      "token_end_exclusive": 2775
    },
    {
      "start_ms": 550710,
      "end_ms": 551335,
      "text": "更固执，",
      "token_start": 2775,
      "token_end_exclusive": 2778
    },
    {
      "start_ms": 551750,
      "end_ms": 552755,
      "text": "更不放过自己。",
      "token_start": 2778,
      "token_end_exclusive": 2784
    },
    {
      "start_ms": 553920,
      "end_ms": 555515,
      "text": "但他把这些东西写出来了，",
      "token_start": 2784,
      "token_end_exclusive": 2795
    },
    {
      "start_ms": 556100,
      "end_ms": 559085,
      "text": "你在他的追问里反而看到了自己还在好奇，",
      "token_start": 2795,
      "token_end_exclusive": 2813
    },
    {
      "start_ms": 559390,
      "end_ms": 560165,
      "text": "还在发问，",
      "token_start": 2813,
      "token_end_exclusive": 2817
    },
    {
      "start_ms": 560460,
      "end_ms": 562945,
      "text": "还没有完全被日常吞掉的那一部分，",
      "token_start": 2817,
      "token_end_exclusive": 2832
    },
    {
      "start_ms": 563490,
      "end_ms": 565945,
      "text": "你不一定会走到追问存在这一步。",
      "token_start": 2832,
      "token_end_exclusive": 2846
    },
    {
      "start_ms": 566430,
      "end_ms": 568485,
      "text": "但你大概在某些时刻问过自己，",
      "token_start": 2846,
      "token_end_exclusive": 2859
    },
    {
      "start_ms": 568800,
      "end_ms": 570320,
      "text": "这一切到底是怎么回事？",
      "token_start": 2859,
      "token_end_exclusive": 2869
    },
    {
      "start_ms": 570520,
      "end_ms": 572345,
      "text": "我到底知不知道我在说什么？",
      "token_start": 2869,
      "token_end_exclusive": 2881
    },
    {
      "start_ms": 572840,
      "end_ms": 574805,
      "text": "形而上学不是来替你回答的，",
      "token_start": 2881,
      "token_end_exclusive": 2893
    },
    {
      "start_ms": 575090,
      "end_ms": 576775,
      "text": "也不是来教你怎么活的。",
      "token_start": 2893,
      "token_end_exclusive": 2903
    },
    {
      "start_ms": 577290,
      "end_ms": 579125,
      "text": "它更像一面很硬的镜子，",
      "token_start": 2903,
      "token_end_exclusive": 2913
    },
    {
      "start_ms": 579700,
      "end_ms": 582175,
      "text": "照出来的不是你最想给别人看的样子，",
      "token_start": 2913,
      "token_end_exclusive": 2929
    },
    {
      "start_ms": 582940,
      "end_ms": 587665,
      "text": "而是你有时候偷偷躲着不想面对的那一面困惑不安。",
      "token_start": 2929,
      "token_end_exclusive": 2951
    },
    {
      "start_ms": 588080,
      "end_ms": 589385,
      "text": "对为什么的执念？",
      "token_start": 2951,
      "token_end_exclusive": 2958
    },
    {
      "start_ms": 589980,
      "end_ms": 593065,
      "text": "但看到他并不代表你就已经是个哲学家了，",
      "token_start": 2958,
      "token_end_exclusive": 2976
    },
    {
      "start_ms": 593590,
      "end_ms": 595390,
      "text": "反而说明你还有力气。",
      "token_start": 2976,
      "token_end_exclusive": 2985
    },
    {
      "start_ms": 595510,
      "end_ms": 597145,
      "text": "对世界诚实一小会儿，",
      "token_start": 2985,
      "token_end_exclusive": 2994
    },
    {
      "start_ms": 597570,
      "end_ms": 601410,
      "text": "亚里士多德没有学会停止追问他在最极端的思辨里，",
      "token_start": 2994,
      "token_end_exclusive": 3016
    },
    {
      "start_ms": 601410,
      "end_ms": 603865,
      "text": "把这件事交代完就离开了这个世界。",
      "token_start": 3016,
      "token_end_exclusive": 3031
    },
    {
      "start_ms": 604190,
      "end_ms": 607760,
      "text": "而你还在这个世界上还在和日常的琐事，",
      "token_start": 3031,
      "token_end_exclusive": 3048
    },
    {
      "start_ms": 608040,
      "end_ms": 610505,
      "text": "别人的期待、生活的重担周旋。",
      "token_start": 3048,
      "token_end_exclusive": 3060
    },
    {
      "start_ms": 611020,
      "end_ms": 613915,
      "text": "也许这本书对我们最大的意义就在于让你知道，",
      "token_start": 3060,
      "token_end_exclusive": 3080
    },
    {
      "start_ms": 614360,
      "end_ms": 615595,
      "text": "哪怕你不那么实用，",
      "token_start": 3080,
      "token_end_exclusive": 3088
    },
    {
      "start_ms": 615950,
      "end_ms": 619495,
      "text": "你也仍然有资格在人间里一边做着手上该做的事，",
      "token_start": 3088,
      "token_end_exclusive": 3109
    },
    {
      "start_ms": 620060,
      "end_ms": 623425,
      "text": "一边在某个安静的瞬间继续试着问一句，",
      "token_start": 3109,
      "token_end_exclusive": 3126
    },
    {
      "start_ms": 624230,
      "end_ms": 625665,
      "text": "这到底是怎么回事？",
      "token_start": 3126,
      "token_end_exclusive": 3134
    },
    {
      "start_ms": 626080,
      "end_ms": 626845,
      "text": "我是小海龟，",
      "token_start": 3134,
      "token_end_exclusive": 3139
    },
    {
      "start_ms": 627170,
      "end_ms": 629325,
      "text": "欢迎持续关注我们下本书见。",
      "token_start": 3139,
      "token_end_exclusive": 3151
    }
  ],
