{
  "video_id": "v_cc8397da3c3f0c8a",
  "duration_s": 656.94,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_cc8397da3c3f0c8a.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_cc8397da3c3f0c8a.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 3450,
      "text": "你知道中国最离奇经历的十件国宝是哪一件吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4390,
      "end_ms": 5030,
      "text": "有人说，",
      "token_start": 20,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5030,
      "end_ms": 7870,
      "text": "富春山居图被主人扔进火里，",
      "token_start": 23,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 7870,
      "end_ms": 8830,
      "text": "要烧了殉葬，",
      "token_start": 35,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9570,
      "end_ms": 11050,
      "text": "不子拿命去抢，",
      "token_start": 40,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12010,
      "end_ms": 13150,
      "text": "烧成了两半。",
      "token_start": 46,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13570,
      "end_ms": 14230,
      "text": "有人说，",
      "token_start": 51,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 14270,
      "end_ms": 17290,
      "text": "圆明园的兽首被一把火烧没了，",
      "token_start": 54,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 17290,
      "end_ms": 19430,
      "text": "流落海外错了，",
      "token_start": 67,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 19690,
      "end_ms": 22470,
      "text": "富春山居图好歹抢出来了。",
      "token_start": 73,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 22910,
      "end_ms": 28470,
      "text": "兽首好歹找回来几个有正最倒霉的那件国宝，",
      "token_start": 84,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 28870,
      "end_ms": 30000,
      "text": "不是差点毁了，",
      "token_start": 103,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 30280,
      "end_ms": 31380,
      "text": "是真的没了，",
      "token_start": 109,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 31560,
      "end_ms": 32220,
      "text": "消失了。",
      "token_start": 114,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 32220,
      "end_ms": 35040,
      "text": "八十多年全世界都在找到，",
      "token_start": 117,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 35040,
      "end_ms": 36740,
      "text": "今天一点线索都没有，",
      "token_start": 128,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 36740,
      "end_ms": 37560,
      "text": "活不见物，",
      "token_start": 137,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 37560,
      "end_ms": 39200,
      "text": "死不见归他是谁？",
      "token_start": 141,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 39760,
      "end_ms": 40220,
      "text": "今天，",
      "token_start": 148,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 40220,
      "end_ms": 42140,
      "text": "咱们就来盘点中国实践，",
      "token_start": 150,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 42360,
      "end_ms": 43880,
      "text": "差点被毁掉的国宝。",
      "token_start": 160,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 44720,
      "end_ms": 45440,
      "text": "老规矩，",
      "token_start": 168,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 45620,
      "end_ms": 46440,
      "text": "开讲之前，",
      "token_start": 171,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 46660,
      "end_ms": 48120,
      "text": "劳烦您点个红心，",
      "token_start": 175,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 48420,
      "end_ms": 51300,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 182,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 51580,
      "end_ms": 56320,
      "text": "马踏飞燕甘肃无畏这件国宝的诞生够传奇，",
      "token_start": 194,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 56640,
      "end_ms": 58660,
      "text": "可它出土之后的遭遇更离谱。",
      "token_start": 212,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 58960,
      "end_ms": 59915,
      "text": "一九六九年，",
      "token_start": 224,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 60360,
      "end_ms": 63395,
      "text": "武威擂台一群农民挖房攻洞，",
      "token_start": 229,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 63860,
      "end_ms": 65895,
      "text": "挖进了一座东汉古墓，",
      "token_start": 241,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 66540,
      "end_ms": 72190,
      "text": "里面出了一大批同马同车同人两百多件。",
      "token_start": 250,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 72290,
      "end_ms": 74405,
      "text": "当时没有专业考古人员在场，",
      "token_start": 267,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 74770,
      "end_ms": 76350,
      "text": "这批东西被搬出来，",
      "token_start": 279,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 76350,
      "end_ms": 77805,
      "text": "堆在公社库房里，",
      "token_start": 287,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 78400,
      "end_ms": 80935,
      "text": "没人知道里面有什么了不得的东西，",
      "token_start": 294,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 81720,
      "end_ms": 82725,
      "text": "就那么扔着，",
      "token_start": 309,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 83140,
      "end_ms": 85435,
      "text": "跟一堆废铜烂铁搁在一起，",
      "token_start": 314,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 86000,
      "end_ms": 87905,
      "text": "这一扔就是好几年。",
      "token_start": 325,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 88880,
      "end_ms": 90015,
      "text": "一九七一年，",
      "token_start": 333,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 90310,
      "end_ms": 92715,
      "text": "郭沫若陪外宾到甘肃访问，",
      "token_start": 338,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 93530,
      "end_ms": 95055,
      "text": "有人跟他提了一嘴，",
      "token_start": 349,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 95780,
      "end_ms": 97605,
      "text": "说武威出了一批铜器，",
      "token_start": 357,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 98570,
      "end_ms": 102695,
      "text": "要不要看看郭沫若一看，",
      "token_start": 366,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 103270,
      "end_ms": 108165,
      "text": "在那堆东西里一眼就盯上了一批踩着飞鸟的铜马，",
      "token_start": 376,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 109230,
      "end_ms": 109890,
      "text": "当场说，",
      "token_start": 397,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 109910,
      "end_ms": 110590,
      "text": "这个不得了，",
      "token_start": 400,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 110670,
      "end_ms": 113575,
      "text": "这匹马才从废铜堆里被认出来。",
      "token_start": 405,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 114170,
      "end_ms": 114935,
      "text": "您想想，",
      "token_start": 418,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 115610,
      "end_ms": 116710,
      "text": "要不是郭沫若，",
      "token_start": 421,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 116710,
      "end_ms": 118115,
      "text": "正好来了甘肃，",
      "token_start": 427,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 118750,
      "end_ms": 120455,
      "text": "正好有人提了一嘴，",
      "token_start": 433,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 121270,
      "end_ms": 123185,
      "text": "正好他愿意去看一眼。",
      "token_start": 441,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 124100,
      "end_ms": 127355,
      "text": "这匹马还不知道要在库房里吃多少年灰。",
      "token_start": 450,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 127870,
      "end_ms": 129925,
      "text": "后来他成了中国旅游标志，",
      "token_start": 467,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 130400,
      "end_ms": 132095,
      "text": "代言了中国四十多年，",
      "token_start": 478,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 132810,
      "end_ms": 134305,
      "text": "可当年差一步，",
      "token_start": 487,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 134840,
      "end_ms": 137715,
      "text": "他可能就被当成废铜回炉话了。",
      "token_start": 493,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 138770,
      "end_ms": 141325,
      "text": "四十多年的中国旅游标志就没了。",
      "token_start": 506,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 141790,
      "end_ms": 144460,
      "text": "一匹铜马出土之后，",
      "token_start": 520,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 144460,
      "end_ms": 146435,
      "text": "在废铜堆里扔了好几年，",
      "token_start": 528,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 147200,
      "end_ms": 148900,
      "text": "被一个人的遗眼救了，",
      "token_start": 538,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 148900,
      "end_ms": 150335,
      "text": "您说这算不算命大？",
      "token_start": 547,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 151940,
      "end_ms": 152785,
      "text": "第九名，",
      "token_start": 555,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 153770,
      "end_ms": 156695,
      "text": "太阳神鸟金氏四川成都，",
      "token_start": 558,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 157750,
      "end_ms": 162995,
      "text": "二零零一年成都金沙遗址推土机在平整工地。",
      "token_start": 568,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 163860,
      "end_ms": 165660,
      "text": "司机看见翻出来的图里，",
      "token_start": 587,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 165660,
      "end_ms": 166875,
      "text": "有个东西反光，",
      "token_start": 597,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 167360,
      "end_ms": 168105,
      "text": "喊了一声，",
      "token_start": 603,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 168500,
      "end_ms": 171970,
      "text": "考古队的人跑过来扒开腿一看一小团。",
      "token_start": 607,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 171990,
      "end_ms": 174455,
      "text": "皱巴巴的东西跟泥疙瘩粘在一起，",
      "token_start": 623,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 174820,
      "end_ms": 177085,
      "text": "灰扑扑的看不出是什么，",
      "token_start": 637,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 178770,
      "end_ms": 181540,
      "text": "差一点真的就差那么一铲子。",
      "token_start": 647,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 182260,
      "end_ms": 184100,
      "text": "推土机再往前推一下，",
      "token_start": 659,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 184340,
      "end_ms": 188700,
      "text": "这东西就被碾进土里运到渣土厂爆掉了，",
      "token_start": 668,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 188740,
      "end_ms": 191940,
      "text": "拿回实验室清理一点一点展开，",
      "token_start": 685,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 192940,
      "end_ms": 194440,
      "text": "所有人都不说话了。",
      "token_start": 698,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 195160,
      "end_ms": 199840,
      "text": "一张薄如蝉翼的金箔厚度只有零点零二厘米，",
      "token_start": 706,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 199840,
      "end_ms": 201640,
      "text": "比一张纸还薄，",
      "token_start": 725,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 201640,
      "end_ms": 205280,
      "text": "上面镂空刻着太阳和四只飞鸟。",
      "token_start": 731,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 205280,
      "end_ms": 208080,
      "text": "三千年前的古蜀人做的，",
      "token_start": 744,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 208080,
      "end_ms": 212110,
      "text": "后来他他被选为中国文化遗产标志，",
      "token_start": 754,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 212970,
      "end_ms": 219190,
      "text": "全中国所有跟文化遗产有关的官方场合用的都是这个图案。",
      "token_start": 769,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 219630,
      "end_ms": 221050,
      "text": "可您回过头想想，",
      "token_start": 794,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 221770,
      "end_ms": 225070,
      "text": "这件东西是从推土机底下捡回来的，",
      "token_start": 801,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 225930,
      "end_ms": 227170,
      "text": "工地上那么多土，",
      "token_start": 816,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 227230,
      "end_ms": 228130,
      "text": "那么多石头，",
      "token_start": 823,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 228290,
      "end_ms": 230390,
      "text": "司机要是没看见那一下反光，",
      "token_start": 828,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 231010,
      "end_ms": 233090,
      "text": "要是那天阴天没有太阳，",
      "token_start": 840,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 233490,
      "end_ms": 237170,
      "text": "这片金箔就跟渣土一起被倒进了垃圾场，",
      "token_start": 850,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 238350,
      "end_ms": 243055,
      "text": "中国文化遗产的标志差点被当建筑垃圾埋了。",
      "token_start": 867,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 243650,
      "end_ms": 244775,
      "text": "您说后不后怕？",
      "token_start": 886,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 245730,
      "end_ms": 246445,
      "text": "第八名，",
      "token_start": 892,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 247460,
      "end_ms": 252395,
      "text": "兵马俑陕西西安兵马俑没被毁掉，",
      "token_start": 895,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 253220,
      "end_ms": 256135,
      "text": "几千个陶俑好好的站在坑里，",
      "token_start": 909,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 257280,
      "end_ms": 258960,
      "text": "可他失去了一样东西，",
      "token_start": 921,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 259360,
      "end_ms": 261080,
      "text": "永远找不回来的颜色。",
      "token_start": 930,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 261860,
      "end_ms": 264715,
      "text": "一九七四年兵马俑刚出土的时候，",
      "token_start": 939,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 265100,
      "end_ms": 268760,
      "text": "不是您今天在博物馆里看到的灰扑扑的土色。",
      "token_start": 953,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 268840,
      "end_ms": 271950,
      "text": "它们是带颜色的红的袍子，",
      "token_start": 972,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 272110,
      "end_ms": 274415,
      "text": "绿的裤子、纸的铠甲，",
      "token_start": 983,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 274730,
      "end_ms": 275335,
      "text": "粉的脸，",
      "token_start": 991,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 275810,
      "end_ms": 278205,
      "text": "一个个跟真人似的花花绿绿，",
      "token_start": 994,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 279190,
      "end_ms": 281150,
      "text": "可陶俑从土里挖出来，",
      "token_start": 1006,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 281450,
      "end_ms": 284360,
      "text": "接触了空气表面的彩绘涂层，",
      "token_start": 1015,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 284400,
      "end_ms": 286720,
      "text": "迅速氧化几分钟，",
      "token_start": 1027,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 287060,
      "end_ms": 289000,
      "text": "颜色就没了一片，",
      "token_start": 1034,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 289060,
      "end_ms": 290285,
      "text": "一片往下脱落，",
      "token_start": 1041,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 290630,
      "end_ms": 291605,
      "text": "拦都拦不住。",
      "token_start": 1047,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 292430,
      "end_ms": 297305,
      "text": "考古人员眼睁睁看着一个彩色的将军俑变成了灰色的泥人，",
      "token_start": 1052,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 297810,
      "end_ms": 298615,
      "text": "什么都做不了。",
      "token_start": 1077,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 299480,
      "end_ms": 301115,
      "text": "后来技术改进了，",
      "token_start": 1083,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 302170,
      "end_ms": 303350,
      "text": "新挖出来的蛹，",
      "token_start": 1090,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 303390,
      "end_ms": 304810,
      "text": "能做一些保护处理。",
      "token_start": 1096,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 304830,
      "end_ms": 306615,
      "text": "可早期出土的那批。",
      "token_start": 1104,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 307520,
      "end_ms": 309540,
      "text": "颜色已经永远回不来了。",
      "token_start": 1112,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 310300,
      "end_ms": 312540,
      "text": "您今天去西安看兵马俑，",
      "token_start": 1122,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 312920,
      "end_ms": 315100,
      "text": "看到的是一支灰色的军队，",
      "token_start": 1132,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 316000,
      "end_ms": 317680,
      "text": "可两千两百年前，",
      "token_start": 1143,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 318000,
      "end_ms": 319560,
      "text": "他们是一支彩色的军，",
      "token_start": 1150,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 320060,
      "end_ms": 321220,
      "text": "红红绿绿，",
      "token_start": 1159,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 321440,
      "end_ms": 322460,
      "text": "威风凛凛。",
      "token_start": 1163,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 322940,
      "end_ms": 325220,
      "text": "这些颜色等了两千两百年，",
      "token_start": 1167,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 325520,
      "end_ms": 327440,
      "text": "重见天日的那一刻，",
      "token_start": 1178,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 328140,
      "end_ms": 329460,
      "text": "几分钟就消失。",
      "token_start": 1186,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 330540,
      "end_ms": 332040,
      "text": "兵马俑没有被毁，",
      "token_start": 1192,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 333000,
      "end_ms": 334980,
      "text": "可他最惊艳的那一面，",
      "token_start": 1199,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 335440,
      "end_ms": 341290,
      "text": "我们永远看不到一支两千两百年前的彩色军队，",
      "token_start": 1208,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 341630,
      "end_ms": 343690,
      "text": "重见天日的那一刻，",
      "token_start": 1228,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 343890,
      "end_ms": 345530,
      "text": "失去了所有颜色。",
      "token_start": 1236,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 345690,
      "end_ms": 347990,
      "text": "您说这算不算另一种毁掉？",
      "token_start": 1243,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 349350,
      "end_ms": 350090,
      "text": "第七名，",
      "token_start": 1254,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 350550,
      "end_ms": 351650,
      "text": "四羊方尊，",
      "token_start": 1257,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 352850,
      "end_ms": 353930,
      "text": "湖南宁乡，",
      "token_start": 1261,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 354930,
      "end_ms": 355950,
      "text": "一九三八年，",
      "token_start": 1265,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 356130,
      "end_ms": 360150,
      "text": "湖南宁乡一个农民在山坡上种红薯刨出来。",
      "token_start": 1270,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 361450,
      "end_ms": 362410,
      "text": "三千年前，",
      "token_start": 1288,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 362470,
      "end_ms": 363730,
      "text": "商朝的青铜器，",
      "token_start": 1292,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 364230,
      "end_ms": 366785,
      "text": "四个羊头从弃身探出来，",
      "token_start": 1298,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 367180,
      "end_ms": 368085,
      "text": "一次浇筑，",
      "token_start": 1308,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 368430,
      "end_ms": 369485,
      "text": "精美绝伦。",
      "token_start": 1312,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 370060,
      "end_ms": 372605,
      "text": "可他刚出土就赶上了日本人打仗，",
      "token_start": 1316,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 373340,
      "end_ms": 374645,
      "text": "当地人把它藏着，",
      "token_start": 1330,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 374940,
      "end_ms": 376275,
      "text": "转移了好几个地方。",
      "token_start": 1337,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 376730,
      "end_ms": 379335,
      "text": "后来存放在长沙一个银行的仓库里，",
      "token_start": 1345,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 380120,
      "end_ms": 382990,
      "text": "日军轰炸长沙一颗炸弹落下来，",
      "token_start": 1360,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 383010,
      "end_ms": 387570,
      "text": "仓库炸四阳方尊被炸成了二十多块，",
      "token_start": 1373,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 387570,
      "end_ms": 389735,
      "text": "碎片碎了一地。",
      "token_start": 1388,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 390510,
      "end_ms": 396045,
      "text": "这一岁就是好几年碎片散落在不同的人手里，",
      "token_start": 1394,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 396870,
      "end_ms": 398165,
      "text": "有的被捡走了，",
      "token_start": 1413,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 398610,
      "end_ms": 399805,
      "text": "有的混在废墟里，",
      "token_start": 1419,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 400290,
      "end_ms": 403130,
      "text": "一直到后来文物部门费了很大力气，",
      "token_start": 1426,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 403130,
      "end_ms": 404755,
      "text": "把碎片一块一块找回来。",
      "token_start": 1441,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 405460,
      "end_ms": 407295,
      "text": "请修复师一块一块对，",
      "token_start": 1451,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 407660,
      "end_ms": 408520,
      "text": "一块一块拼，",
      "token_start": 1460,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 408800,
      "end_ms": 409795,
      "text": "一块一块焊，",
      "token_start": 1465,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 410290,
      "end_ms": 412205,
      "text": "拼了很长时间才复原。",
      "token_start": 1470,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 413070,
      "end_ms": 416575,
      "text": "您今天在国家博物馆看到的四羊方尊，",
      "token_start": 1479,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 417510,
      "end_ms": 418230,
      "text": "仔细看，",
      "token_start": 1495,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 418230,
      "end_ms": 420070,
      "text": "还能看到修复的痕迹。",
      "token_start": 1498,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 420290,
      "end_ms": 421190,
      "text": "三千年前，",
      "token_start": 1507,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 421250,
      "end_ms": 423805,
      "text": "商朝工匠一次铸成的东西，",
      "token_start": 1511,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 424400,
      "end_ms": 426765,
      "text": "扛过了三千年的风风雨雨，",
      "token_start": 1522,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 427230,
      "end_ms": 429850,
      "text": "最后差点毁在一颗炸弹底下。",
      "token_start": 1533,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 430870,
      "end_ms": 434470,
      "text": "一件三千年前的青铜器种红薯，",
      "token_start": 1545,
      "token_end_exclusive": 1558
    },
    {
      "start_ms": 434530,
      "end_ms": 437330,
      "text": "刨出来的被炸弹炸成了二十多块，",
      "token_start": 1558,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 437570,
      "end_ms": 439070,
      "text": "又一块一块拼回来。",
      "token_start": 1572,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 439810,
      "end_ms": 441390,
      "text": "您说这东西命硬不硬？",
      "token_start": 1580,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 442270,
      "end_ms": 450090,
      "text": "第六名清明上河图北京故宫博物院这幅画您听过太多次了，",
      "token_start": 1589,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 450350,
      "end_ms": 453210,
      "text": "可您未必知道他这九百年是怎么活。",
      "token_start": 1614,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 453210,
      "end_ms": 453610,
      "text": "下来。",
      "token_start": 1629,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 454630,
      "end_ms": 456935,
      "text": "张择端画完之后献给了宋徽宗，",
      "token_start": 1631,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 457180,
      "end_ms": 459140,
      "text": "宋徽宗在上面盖了章，",
      "token_start": 1644,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 459600,
      "end_ms": 460520,
      "text": "写了题签，",
      "token_start": 1653,
      "token_end_exclusive": 1657
    },
    {
      "start_ms": 461320,
      "end_ms": 465620,
      "text": "然后靖康之变金兵打进汴京，",
      "token_start": 1657,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 466260,
      "end_ms": 468960,
      "text": "皇宫里的东西被抢了个精光，",
      "token_start": 1669,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 469740,
      "end_ms": 472740,
      "text": "清明上河图就此流落民间。",
      "token_start": 1681,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 473260,
      "end_ms": 474060,
      "text": "从那以后，",
      "token_start": 1692,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 474480,
      "end_ms": 477880,
      "text": "这幅画就开始了他九百年的颠沛流离。",
      "token_start": 1696,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 478300,
      "end_ms": 479380,
      "text": "元朝的时候，",
      "token_start": 1712,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 479560,
      "end_ms": 480940,
      "text": "他在民间辗转，",
      "token_start": 1717,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 481300,
      "end_ms": 482740,
      "text": "有人偷偷藏着，",
      "token_start": 1723,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 482740,
      "end_ms": 483680,
      "text": "不敢拿出来，",
      "token_start": 1729,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 483940,
      "end_ms": 485780,
      "text": "有人高价转首倒卖。",
      "token_start": 1734,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 486280,
      "end_ms": 488490,
      "text": "有一个庄稼表将拿到了这幅画，",
      "token_start": 1742,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 489310,
      "end_ms": 490310,
      "text": "偷偷临摹了，",
      "token_start": 1755,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 490310,
      "end_ms": 491070,
      "text": "一幅赝品，",
      "token_start": 1760,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 491870,
      "end_ms": 493890,
      "text": "把真画换下来卖了。",
      "token_start": 1764,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 494050,
      "end_ms": 496570,
      "text": "这幅画差点就此下落不明，",
      "token_start": 1772,
      "token_end_exclusive": 1783
    },
    {
      "start_ms": 496750,
      "end_ms": 498670,
      "text": "明朝的时候更凶险。",
      "token_start": 1783,
      "token_end_exclusive": 1791
    },
    {
      "start_ms": 498950,
      "end_ms": 501890,
      "text": "大奸臣严嵩父子搜刮天下名画，",
      "token_start": 1791,
      "token_end_exclusive": 1804
    },
    {
      "start_ms": 502250,
      "end_ms": 508450,
      "text": "把清明上河图弄到了手严嵩倒台之后被抄家画被收进了，",
      "token_start": 1804,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 508450,
      "end_ms": 508890,
      "text": "皇宫，",
      "token_start": 1828,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 509190,
      "end_ms": 510570,
      "text": "算是暂时安全。",
      "token_start": 1830,
      "token_end_exclusive": 1836
    },
    {
      "start_ms": 511290,
      "end_ms": 512730,
      "text": "可到了清朝末年，",
      "token_start": 1836,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 513650,
      "end_ms": 514530,
      "text": "溥仪退位，",
      "token_start": 1843,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 515250,
      "end_ms": 519880,
      "text": "他把宫里一批最值前的书画偷偷带出了紫禁城，",
      "token_start": 1847,
      "token_end_exclusive": 1867
    },
    {
      "start_ms": 520800,
      "end_ms": 522940,
      "text": "夹在行李里运到了天津。",
      "token_start": 1867,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 523780,
      "end_ms": 526160,
      "text": "后来又带到了东北、长春，",
      "token_start": 1877,
      "token_end_exclusive": 1887
    },
    {
      "start_ms": 526700,
      "end_ms": 530780,
      "text": "日本战败伪满洲国的皇宫乱成一团。",
      "token_start": 1887,
      "token_end_exclusive": 1902
    },
    {
      "start_ms": 531180,
      "end_ms": 535620,
      "text": "溥仪跑了手下的人开始哄抢宫里的东西，",
      "token_start": 1902,
      "token_end_exclusive": 1919
    },
    {
      "start_ms": 535660,
      "end_ms": 540160,
      "text": "清明上河图差点就在这场混乱中被撕烂或者丢掉。",
      "token_start": 1919,
      "token_end_exclusive": 1940
    },
    {
      "start_ms": 540720,
      "end_ms": 542260,
      "text": "后来几经周折，",
      "token_start": 1940,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 542640,
      "end_ms": 544840,
      "text": "才被找回来送进了故宫博物院。",
      "token_start": 1946,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 546140,
      "end_ms": 548630,
      "text": "九百年换了几十个主人，",
      "token_start": 1959,
      "token_end_exclusive": 1969
    },
    {
      "start_ms": 548990,
      "end_ms": 553910,
      "text": "经历了灭国、战乱、抄家偷盗、哄抢，",
      "token_start": 1969,
      "token_end_exclusive": 1982
    },
    {
      "start_ms": 554290,
      "end_ms": 556550,
      "text": "好几次都是在最后一刻。",
      "token_start": 1982,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 556550,
      "end_ms": 557610,
      "text": "被抢救回来，",
      "token_start": 1992,
      "token_end_exclusive": 1997
    },
    {
      "start_ms": 557930,
      "end_ms": 559190,
      "text": "您说他是命硬，",
      "token_start": 1997,
      "token_end_exclusive": 2003
    },
    {
      "start_ms": 559190,
      "end_ms": 560310,
      "text": "还是老天爷舍不得，",
      "token_start": 2003,
      "token_end_exclusive": 2011
    },
    {
      "start_ms": 560310,
      "end_ms": 563090,
      "text": "让他没先在评论区打出四个字，",
      "token_start": 2011,
      "token_end_exclusive": 2024
    },
    {
      "start_ms": 563090,
      "end_ms": 564010,
      "text": "命悬一线，",
      "token_start": 2024,
      "token_end_exclusive": 2028
    },
    {
      "start_ms": 564910,
      "end_ms": 566190,
      "text": "打完了咱们接着讲，",
      "token_start": 2028,
      "token_end_exclusive": 2036
    },
    {
      "start_ms": 566190,
      "end_ms": 569330,
      "text": "因为接下来的前五名才是真正让人心疼的。",
      "token_start": 2036,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 570230,
      "end_ms": 571790,
      "text": "从第十到第六，",
      "token_start": 2054,
      "token_end_exclusive": 2060
    },
    {
      "start_ms": 572330,
      "end_ms": 577620,
      "text": "马踏飞燕在废铜堆里差点回炉太阳神灵鸟，",
      "token_start": 2060,
      "token_end_exclusive": 2078
    },
    {
      "start_ms": 577620,
      "end_ms": 579240,
      "text": "差点被推土机碾成，",
      "token_start": 2078,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 579260,
      "end_ms": 581900,
      "text": "渣土兵马俑几分钟丢了，",
      "token_start": 2086,
      "token_end_exclusive": 2096
    },
    {
      "start_ms": 581900,
      "end_ms": 583860,
      "text": "等了两千两百年的颜色。",
      "token_start": 2096,
      "token_end_exclusive": 2106
    },
    {
      "start_ms": 584700,
      "end_ms": 587440,
      "text": "四、阳方尊被炸弹炸成了二十多块，",
      "token_start": 2106,
      "token_end_exclusive": 2120
    },
    {
      "start_ms": 587440,
      "end_ms": 588940,
      "text": "又一块块拼回来。",
      "token_start": 2120,
      "token_end_exclusive": 2127
    },
    {
      "start_ms": 589780,
      "end_ms": 591760,
      "text": "清明上河图九百年死了，",
      "token_start": 2127,
      "token_end_exclusive": 2137
    },
    {
      "start_ms": 591760,
      "end_ms": 592760,
      "text": "好几回又活了，",
      "token_start": 2137,
      "token_end_exclusive": 2143
    },
    {
      "start_ms": 592760,
      "end_ms": 594640,
      "text": "好几回够惊险了吧。",
      "token_start": 2143,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 595540,
      "end_ms": 599100,
      "text": "可跟前五名比这些算运气好的，",
      "token_start": 2151,
      "token_end_exclusive": 2164
    },
    {
      "start_ms": 599780,
      "end_ms": 601080,
      "text": "起码东西还在。",
      "token_start": 2164,
      "token_end_exclusive": 2170
    },
    {
      "start_ms": 602240,
      "end_ms": 606440,
      "text": "接下来有一件国宝被人用锯子锯成了好几块，",
      "token_start": 2170,
      "token_end_exclusive": 2189
    },
    {
      "start_ms": 606440,
      "end_ms": 608690,
      "text": "卖到了外国，",
      "token_start": 2189,
      "token_end_exclusive": 2194
    },
    {
      "start_ms": 608710,
      "end_ms": 610750,
      "text": "到今天没回来。",
      "token_start": 2194,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 610750,
      "end_ms": 614650,
      "text": "有一部书原本一万一千多册，",
      "token_start": 2200,
      "token_end_exclusive": 2212
    },
    {
      "start_ms": 615490,
      "end_ms": 617830,
      "text": "今天全世界只剩四百多册，",
      "token_start": 2212,
      "token_end_exclusive": 2223
    },
    {
      "start_ms": 619410,
      "end_ms": 623930,
      "text": "有一个洞窟壁画被外国人整面整面接走了。",
      "token_start": 2223,
      "token_end_exclusive": 2241
    },
    {
      "start_ms": 624870,
      "end_ms": 625710,
      "text": "有一幅画，",
      "token_start": 2241,
      "token_end_exclusive": 2245
    },
    {
      "start_ms": 626450,
      "end_ms": 629810,
      "text": "主人临死前要把它扔进火里烧了，",
      "token_start": 2245,
      "token_end_exclusive": 2259
    },
    {
      "start_ms": 629810,
      "end_ms": 630330,
      "text": "殉葬，",
      "token_start": 2259,
      "token_end_exclusive": 2261
    },
    {
      "start_ms": 631090,
      "end_ms": 632890,
      "text": "可排在第一的那件，",
      "token_start": 2261,
      "token_end_exclusive": 2269
    },
    {
      "start_ms": 634390,
      "end_ms": 635590,
      "text": "不是差点毁，",
      "token_start": 2269,
      "token_end_exclusive": 2274
    },
    {
      "start_ms": 635770,
      "end_ms": 636935,
      "text": "是真的没了，",
      "token_start": 2274,
      "token_end_exclusive": 2279
    },
    {
      "start_ms": 637520,
      "end_ms": 638100,
      "text": "消失了。",
      "token_start": 2279,
      "token_end_exclusive": 2282
    },
    {
      "start_ms": 638100,
      "end_ms": 641960,
      "text": "八十多年全世界都在找活不见物，",
      "token_start": 2282,
      "token_end_exclusive": 2296
    },
    {
      "start_ms": 641980,
      "end_ms": 642660,
      "text": "死不见灰。",
      "token_start": 2296,
      "token_end_exclusive": 2300
    },
    {
      "start_ms": 643460,
      "end_ms": 645780,
      "text": "下一集已经同步更新，",
      "token_start": 2300,
      "token_end_exclusive": 2309
    },
    {
      "start_ms": 646380,
      "end_ms": 648400,
      "text": "现在直接点开我的头像，",
      "token_start": 2309,
      "token_end_exclusive": 2319
    },
    {
      "start_ms": 648460,
      "end_ms": 649240,
      "text": "进入主页，",
      "token_start": 2319,
      "token_end_exclusive": 2323
    },
    {
      "start_ms": 650740,
      "end_ms": 654200,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 2323,
      "token_end_exclusive": 2337
    },
    {
      "start_ms": 655120,
      "end_ms": 656865,
      "text": "看看中国到底丢了什么。",
      "token_start": 2337,
      "token_end_exclusive": 2347
    }
