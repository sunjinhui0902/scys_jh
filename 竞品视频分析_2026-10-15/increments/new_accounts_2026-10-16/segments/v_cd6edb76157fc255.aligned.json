{
  "video_id": "v_cd6edb76157fc255",
  "duration_s": 785.37,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_cd6edb76157fc255.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_cd6edb76157fc255.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 590,
      "text": "老朋友，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 2270,
      "end_ms": 3930,
      "text": "咱们接着上一集的话题，",
      "token_start": 3,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 5090,
      "end_ms": 9550,
      "text": "上次咱们盘点国内藏在水边的十大人间仙境。",
      "token_start": 13,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 10510,
      "end_ms": 12490,
      "text": "从第十讲到第六，",
      "token_start": 32,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 13690,
      "end_ms": 18190,
      "text": "好多朋友看完视频在评论区跟我聊，",
      "token_start": 39,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 18670,
      "end_ms": 18910,
      "text": "说，",
      "token_start": 54,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 18950,
      "end_ms": 20350,
      "text": "千岛湖水下沉了，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 20350,
      "end_ms": 21290,
      "text": "两座古城，",
      "token_start": 62,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 21910,
      "end_ms": 23630,
      "text": "自己去游玩好几趟，",
      "token_start": 66,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 24270,
      "end_ms": 26610,
      "text": "完全不知道还有这么一段往事。",
      "token_start": 74,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 27050,
      "end_ms": 29190,
      "text": "我今天跟大伙儿掏心窝子，",
      "token_start": 87,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 29190,
      "end_ms": 35140,
      "text": "说榜单剩下的前五名一处胜过一处，",
      "token_start": 98,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 35680,
      "end_ms": 38140,
      "text": "特别是排在第一名的秘境，",
      "token_start": 113,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 38560,
      "end_ms": 40880,
      "text": "去过的老游客回来跟我描述，",
      "token_start": 124,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 40940,
      "end_ms": 42860,
      "text": "那湖水不是咱们常见的蓝，",
      "token_start": 136,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 43160,
      "end_ms": 44840,
      "text": "也不是普通草木的绿，",
      "token_start": 147,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 45080,
      "end_ms": 46560,
      "text": "是翡翠的颜色，",
      "token_start": 156,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 46920,
      "end_ms": 48840,
      "text": "而且不是单单一块翡翠，",
      "token_start": 162,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 49020,
      "end_ms": 49920,
      "text": "一片水洼，",
      "token_start": 172,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 50100,
      "end_ms": 53980,
      "text": "一块一个颜色好几块翡翠铺在大地上。",
      "token_start": 176,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 54600,
      "end_ms": 56680,
      "text": "十多年前这个地方路很难走，",
      "token_start": 192,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 57360,
      "end_ms": 59495,
      "text": "普通车子根本不好进去。",
      "token_start": 204,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 60100,
      "end_ms": 60985,
      "text": "直到今天，",
      "token_start": 214,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 61690,
      "end_ms": 64445,
      "text": "还有很多朋友从来没听过这个地名，",
      "token_start": 218,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 65560,
      "end_ms": 66835,
      "text": "咱们慢慢往下说，",
      "token_start": 233,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67570,
      "end_ms": 69345,
      "text": "看看这地方到底是哪里。",
      "token_start": 240,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 69780,
      "end_ms": 71530,
      "text": "第五名嗯，",
      "token_start": 250,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 71840,
      "end_ms": 73535,
      "text": "长白山天池，",
      "token_start": 254,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 75180,
      "end_ms": 77460,
      "text": "吉林延边的长白山，",
      "token_start": 259,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 77600,
      "end_ms": 78945,
      "text": "大伙儿都听过长白山，",
      "token_start": 267,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 79850,
      "end_ms": 81215,
      "text": "冬天大雪纷飞，",
      "token_start": 276,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 81690,
      "end_ms": 83765,
      "text": "山里还有温热的温泉，",
      "token_start": 282,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 84240,
      "end_ms": 85280,
      "text": "可他能上榜，",
      "token_start": 291,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 85420,
      "end_ms": 88200,
      "text": "最动人的就是山顶。",
      "token_start": 296,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 88200,
      "end_ms": 89285,
      "text": "那汪天池，",
      "token_start": 304,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 90260,
      "end_ms": 94825,
      "text": "天池是火山喷发之后留下的大坑，",
      "token_start": 308,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 95230,
      "end_ms": 99300,
      "text": "积攒雨水融雪形成的湖两千多米，",
      "token_start": 322,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 99300,
      "end_ms": 101230,
      "text": "高山顶上一圈，",
      "token_start": 336,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 101510,
      "end_ms": 102410,
      "text": "灰黑色，",
      "token_start": 342,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 102430,
      "end_ms": 105150,
      "text": "火山岩石团团围住，",
      "token_start": 345,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 105150,
      "end_ms": 108255,
      "text": "湖水就好像大山睁开的眼睛。",
      "token_start": 353,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 109150,
      "end_ms": 111555,
      "text": "天池的地方性子孤傲，",
      "token_start": 365,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 111880,
      "end_ms": 113720,
      "text": "一年里头大半时间，",
      "token_start": 374,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 113760,
      "end_ms": 114595,
      "text": "云雾缭绕，",
      "token_start": 382,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 114880,
      "end_ms": 117660,
      "text": "能清清楚楚看见整个湖面的日子，",
      "token_start": 386,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 117660,
      "end_ms": 118480,
      "text": "不多不少。",
      "token_start": 400,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 118500,
      "end_ms": 120495,
      "text": "朋友攒了很久的心愿，",
      "token_start": 404,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 121150,
      "end_ms": 123225,
      "text": "千里迢迢坐车爬山，",
      "token_start": 413,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 123960,
      "end_ms": 125625,
      "text": "好不容易到山顶，",
      "token_start": 421,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 126180,
      "end_ms": 127960,
      "text": "眼前白茫茫一片，",
      "token_start": 428,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 127960,
      "end_ms": 128685,
      "text": "大雾，",
      "token_start": 435,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 129260,
      "end_ms": 130435,
      "text": "啥都看不见，",
      "token_start": 437,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 131140,
      "end_ms": 132645,
      "text": "只能遗憾下山。",
      "token_start": 442,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 133710,
      "end_ms": 134970,
      "text": "可老天爷赏脸，",
      "token_start": 448,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 135350,
      "end_ms": 136330,
      "text": "云雾散开，",
      "token_start": 454,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 136330,
      "end_ms": 136850,
      "text": "那一刻，",
      "token_start": 458,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 137210,
      "end_ms": 139135,
      "text": "谁看了都会心头一震。",
      "token_start": 461,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 139690,
      "end_ms": 141875,
      "text": "那湖水蓝的温润又深邃，",
      "token_start": 470,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 142360,
      "end_ms": 143120,
      "text": "不是大海，",
      "token_start": 480,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 143120,
      "end_ms": 144405,
      "text": "那种开阔的蓝，",
      "token_start": 484,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 144940,
      "end_ms": 147575,
      "text": "是像把整块蓝宝石融化，",
      "token_start": 490,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 148110,
      "end_ms": 150105,
      "text": "静静的沉在火山口里，",
      "token_start": 500,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 150670,
      "end_ms": 152030,
      "text": "周围光秃秃岩壁，",
      "token_start": 509,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 152030,
      "end_ms": 153025,
      "text": "没有一棵树，",
      "token_start": 516,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 153520,
      "end_ms": 157245,
      "text": "简简单单反倒衬得湖水干净安宁。",
      "token_start": 521,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 158320,
      "end_ms": 160555,
      "text": "看着看着心里都安静下来，",
      "token_start": 535,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 161400,
      "end_ms": 162505,
      "text": "想看天池，",
      "token_start": 546,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 162900,
      "end_ms": 163925,
      "text": "全靠缘分。",
      "token_start": 550,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 164890,
      "end_ms": 166265,
      "text": "有幸见过一次。",
      "token_start": 554,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 167070,
      "end_ms": 168965,
      "text": "很多人多少年过去，",
      "token_start": 560,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 169520,
      "end_ms": 173095,
      "text": "还记得那一幕火山造就大坑，",
      "token_start": 568,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 173940,
      "end_ms": 175380,
      "text": "盛满一池蓝宝石，",
      "token_start": 580,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 175840,
      "end_ms": 177735,
      "text": "常年云雾遮挡，",
      "token_start": 587,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 178030,
      "end_ms": 179365,
      "text": "不愿轻易示人。",
      "token_start": 593,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 180240,
      "end_ms": 180900,
      "text": "第四名，",
      "token_start": 599,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 181140,
      "end_ms": 182260,
      "text": "荔波小七孔，",
      "token_start": 602,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 182580,
      "end_ms": 187780,
      "text": "贵州黔南荔波县听名字带个小字，",
      "token_start": 607,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 187960,
      "end_ms": 188960,
      "text": "可千万别小看。",
      "token_start": 621,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 188960,
      "end_ms": 197880,
      "text": "这小七孔名字来自一座清代道光年间修建的七孔古石桥，",
      "token_start": 627,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 198760,
      "end_ms": 199620,
      "text": "七个桥洞，",
      "token_start": 651,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 200140,
      "end_ms": 201780,
      "text": "静静立在水上。",
      "token_start": 655,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 201880,
      "end_ms": 205180,
      "text": "桥下的水是温润的翡翠绿，",
      "token_start": 661,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 205840,
      "end_ms": 207460,
      "text": "阳光照进水里，",
      "token_start": 672,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 207800,
      "end_ms": 212630,
      "text": "水底石头都泛着淡淡的绿光小七孔。",
      "token_start": 678,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 212630,
      "end_ms": 214970,
      "text": "真正的美不在这座小桥，",
      "token_start": 693,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 215930,
      "end_ms": 217610,
      "text": "走进景区深处，",
      "token_start": 703,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 218150,
      "end_ms": 220910,
      "text": "一路都是层层叠叠的叠水瀑布，",
      "token_start": 709,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 221450,
      "end_ms": 222210,
      "text": "千万年，",
      "token_start": 722,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 222210,
      "end_ms": 223170,
      "text": "流水冲刷，",
      "token_start": 725,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 223250,
      "end_ms": 230050,
      "text": "石灰岩冲出一级一级天然台阶水流顺着台阶一层层往下落，",
      "token_start": 729,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 230470,
      "end_ms": 231910,
      "text": "形态各不相同。",
      "token_start": 754,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 232450,
      "end_ms": 235070,
      "text": "有的像一整片白莲垂落，",
      "token_start": 760,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 235610,
      "end_ms": 237830,
      "text": "有的散成无数细水珠。",
      "token_start": 770,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 238550,
      "end_ms": 240400,
      "text": "台阶长满青青台，",
      "token_start": 779,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 240420,
      "end_ms": 244530,
      "text": "小草流水从绿色植物之间穿过，",
      "token_start": 786,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 244610,
      "end_ms": 246170,
      "text": "白色水花落在青苔，",
      "token_start": 799,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 246170,
      "end_ms": 249875,
      "text": "上面沿着木质栈道往前走，",
      "token_start": 807,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 250500,
      "end_ms": 252180,
      "text": "左右都是流水，",
      "token_start": 818,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 252240,
      "end_ms": 252665,
      "text": "瀑布，",
      "token_start": 824,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 252990,
      "end_ms": 254505,
      "text": "水汽扑面而来，",
      "token_start": 826,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 255090,
      "end_ms": 260090,
      "text": "脸上一直润润的水流奔腾喧嚣，",
      "token_start": 832,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 260350,
      "end_ms": 261210,
      "text": "流进水潭，",
      "token_start": 845,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 261730,
      "end_ms": 263675,
      "text": "一下子就安静下来，",
      "token_start": 849,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 264620,
      "end_ms": 266555,
      "text": "水潭颜色各不相同，",
      "token_start": 857,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 267210,
      "end_ms": 269330,
      "text": "显处翠绿深处，",
      "token_start": 865,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 269390,
      "end_ms": 269885,
      "text": "墨绿，",
      "token_start": 871,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 270190,
      "end_ms": 271605,
      "text": "阳光洒落水面，",
      "token_start": 873,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 272130,
      "end_ms": 273775,
      "text": "还会泛一层金光。",
      "token_start": 879,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 274610,
      "end_ms": 278905,
      "text": "景区里面卧龙潭更是一绝，",
      "token_start": 886,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 279270,
      "end_ms": 280830,
      "text": "湖水是淡淡的乳，",
      "token_start": 897,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 280830,
      "end_ms": 281575,
      "text": "蓝色，",
      "token_start": 904,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 282140,
      "end_ms": 283120,
      "text": "水面平滑，",
      "token_start": 906,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 283500,
      "end_ms": 284815,
      "text": "几乎没有波纹。",
      "token_start": 910,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 285260,
      "end_ms": 287240,
      "text": "看着就像凝固的蓝色果冻，",
      "token_start": 916,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 287380,
      "end_ms": 290435,
      "text": "一座古桥连着层层瀑布，",
      "token_start": 927,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 290750,
      "end_ms": 293425,
      "text": "一潭又一潭色彩不一样的碧水。",
      "token_start": 937,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 294220,
      "end_ms": 296025,
      "text": "第三名九寨沟。",
      "token_start": 950,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 296790,
      "end_ms": 298330,
      "text": "不少老朋友会疑惑，",
      "token_start": 956,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 298650,
      "end_ms": 301270,
      "text": "九寨沟旺季到处都是游客，",
      "token_start": 964,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 301750,
      "end_ms": 302770,
      "text": "怎么还排第三？",
      "token_start": 975,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 303270,
      "end_ms": 303890,
      "text": "实话讲，",
      "token_start": 981,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 304230,
      "end_ms": 308390,
      "text": "暑假国庆九寨沟人确实多，",
      "token_start": 984,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 309070,
      "end_ms": 310550,
      "text": "但九寨沟上榜，",
      "token_start": 995,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 310590,
      "end_ms": 313050,
      "text": "比拼的不是清静，",
      "token_start": 1001,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 313350,
      "end_ms": 314130,
      "text": "是湖水。",
      "token_start": 1008,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 314950,
      "end_ms": 316350,
      "text": "国内这么多水景，",
      "token_start": 1011,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 317130,
      "end_ms": 318090,
      "text": "很多风光，",
      "token_start": 1018,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 318110,
      "end_ms": 320710,
      "text": "摄影师都说论水的色彩，",
      "token_start": 1022,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 321070,
      "end_ms": 322450,
      "text": "很难找到对手，",
      "token_start": 1032,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 322850,
      "end_ms": 325090,
      "text": "山谷里散落上百个海子。",
      "token_start": 1038,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 325570,
      "end_ms": 328220,
      "text": "海子就是当当地人对湖泊的叫法。",
      "token_start": 1048,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 328340,
      "end_ms": 330260,
      "text": "湖水通透见底，",
      "token_start": 1062,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 330360,
      "end_ms": 331340,
      "text": "颜色丰富，",
      "token_start": 1068,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 331900,
      "end_ms": 333200,
      "text": "五花海最出名，",
      "token_start": 1072,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 333560,
      "end_ms": 336240,
      "text": "站在高处往下望湖面，",
      "token_start": 1078,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 336380,
      "end_ms": 339240,
      "text": "就像大自然亲手调出来的调色盘，",
      "token_start": 1087,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 339740,
      "end_ms": 341520,
      "text": "蓝绿鹅黄，",
      "token_start": 1101,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 341860,
      "end_ms": 343600,
      "text": "深棕交错在一起。",
      "token_start": 1105,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 344040,
      "end_ms": 345820,
      "text": "之所以色彩这么丰富，",
      "token_start": 1112,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 346100,
      "end_ms": 348160,
      "text": "是湖底概化沉积物，",
      "token_start": 1121,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 348820,
      "end_ms": 350000,
      "text": "还有各式各样，",
      "token_start": 1129,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 350040,
      "end_ms": 353180,
      "text": "水草、藻类共同造就水深。",
      "token_start": 1135,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 353260,
      "end_ms": 354320,
      "text": "水浅不一样，",
      "token_start": 1145,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 354640,
      "end_ms": 356265,
      "text": "颜色就跟着变化，",
      "token_start": 1150,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 357620,
      "end_ms": 360115,
      "text": "九寨沟还有一样难得的景致。",
      "token_start": 1157,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 360570,
      "end_ms": 361470,
      "text": "水中倒影，",
      "token_start": 1169,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 361510,
      "end_ms": 362570,
      "text": "群山环抱，",
      "token_start": 1173,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 362570,
      "end_ms": 365245,
      "text": "海子风很难吹进来，",
      "token_start": 1177,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 365910,
      "end_ms": 368170,
      "text": "水面常年安稳平静。",
      "token_start": 1185,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 368330,
      "end_ms": 369285,
      "text": "等到秋天，",
      "token_start": 1193,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 369750,
      "end_ms": 371610,
      "text": "山上树叶变红变黄，",
      "token_start": 1197,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 371870,
      "end_ms": 374115,
      "text": "山林的色彩完整倒映水面，",
      "token_start": 1205,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 374850,
      "end_ms": 377110,
      "text": "水底的蓝绿叠加水面，",
      "token_start": 1216,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 377110,
      "end_ms": 380975,
      "text": "红黄秋色一汪湖水装下万千色彩。",
      "token_start": 1225,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 381600,
      "end_ms": 384015,
      "text": "为啥九寨沟水色这么好看，",
      "token_start": 1239,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 384480,
      "end_ms": 385965,
      "text": "属于盖华地貌，",
      "token_start": 1250,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 386810,
      "end_ms": 388445,
      "text": "水里溶解碳酸钙，",
      "token_start": 1256,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 389190,
      "end_ms": 390925,
      "text": "常年沉积湖底，",
      "token_start": 1263,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 391280,
      "end_ms": 393295,
      "text": "铺成一层乳白色底板，",
      "token_start": 1269,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 394000,
      "end_ms": 395545,
      "text": "光线穿过清水，",
      "token_start": 1278,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 395950,
      "end_ms": 401135,
      "text": "打在白色底板反射回来水色变得鲜亮梦幻。",
      "token_start": 1284,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 401660,
      "end_ms": 406700,
      "text": "咱们可以避开暑假国庆高峰挑担，",
      "token_start": 1302,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 406820,
      "end_ms": 409640,
      "text": "既来坐上观光车，",
      "token_start": 1316,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 409780,
      "end_ms": 411425,
      "text": "找一处人少的湖边，",
      "token_start": 1323,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 411900,
      "end_ms": 413835,
      "text": "静静看看水底光影，",
      "token_start": 1331,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 414280,
      "end_ms": 417205,
      "text": "这份景色值得一趟远行。",
      "token_start": 1339,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 417970,
      "end_ms": 421920,
      "text": "一条山谷百个海子湖湖，",
      "token_start": 1349,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 422000,
      "end_ms": 422965,
      "text": "色彩不一样，",
      "token_start": 1359,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 423810,
      "end_ms": 424945,
      "text": "独一份的美，",
      "token_start": 1364,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 425400,
      "end_ms": 426945,
      "text": "别处很难寻。",
      "token_start": 1369,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 428030,
      "end_ms": 428655,
      "text": "第二名，",
      "token_start": 1374,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 429450,
      "end_ms": 435280,
      "text": "杨卓雍错西藏山南杨卓雍错藏语，",
      "token_start": 1377,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 435280,
      "end_ms": 438735,
      "text": "意思是碧玉湖单单碧玉两个字，",
      "token_start": 1391,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 439030,
      "end_ms": 440785,
      "text": "还不足以形容他的美。",
      "token_start": 1404,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 442320,
      "end_ms": 443385,
      "text": "从拉萨出发，",
      "token_start": 1413,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 443900,
      "end_ms": 445385,
      "text": "翻过冈巴拉山口，",
      "token_start": 1418,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 445880,
      "end_ms": 447975,
      "text": "站在山顶往下望去，",
      "token_start": 1425,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 448440,
      "end_ms": 450880,
      "text": "大片湖水静静铺展。",
      "token_start": 1433,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 450920,
      "end_ms": 451875,
      "text": "山谷之间，",
      "token_start": 1441,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 452890,
      "end_ms": 453750,
      "text": "湖水浓郁，",
      "token_start": 1445,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 453770,
      "end_ms": 455235,
      "text": "带着淡淡的绿意，",
      "token_start": 1449,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 456130,
      "end_ms": 457235,
      "text": "微风拂过，",
      "token_start": 1456,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 457830,
      "end_ms": 459405,
      "text": "细碎波纹闪动，",
      "token_start": 1460,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 460110,
      "end_ms": 461335,
      "text": "蓝绿交替，",
      "token_start": 1466,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 462170,
      "end_ms": 465135,
      "text": "像柔软绸缎轻轻抖动。",
      "token_start": 1470,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 466020,
      "end_ms": 470285,
      "text": "最奇妙的湖水颜色会变，",
      "token_start": 1479,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 471320,
      "end_ms": 472285,
      "text": "不同时辰，",
      "token_start": 1489,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 474000,
      "end_ms": 476585,
      "text": "不同天气站在不同位置，",
      "token_start": 1493,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 477320,
      "end_ms": 479885,
      "text": "看到的湖水色彩完全不一样。",
      "token_start": 1503,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 480780,
      "end_ms": 485005,
      "text": "清晨偏深蓝正午转为翠绿，",
      "token_start": 1515,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 485540,
      "end_ms": 486100,
      "text": "阴天，",
      "token_start": 1526,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 486280,
      "end_ms": 487500,
      "text": "整片湖面，",
      "token_start": 1528,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 487520,
      "end_ms": 492465,
      "text": "灰蓝云层裂开缝隙阳光落下去，",
      "token_start": 1532,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 492900,
      "end_ms": 496235,
      "text": "被光照到那片湖水瞬间变成宝石蓝，",
      "token_start": 1545,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 497040,
      "end_ms": 501490,
      "text": "其余地方依旧暗沉扬捉雍措，",
      "token_start": 1560,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 501550,
      "end_ms": 502610,
      "text": "海拔四千多，",
      "token_start": 1572,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 502770,
      "end_ms": 503670,
      "text": "湖面广阔，",
      "token_start": 1577,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 503930,
      "end_ms": 505370,
      "text": "湖岸线弯弯曲曲，",
      "token_start": 1581,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 505370,
      "end_ms": 506375,
      "text": "缠绕群山，",
      "token_start": 1588,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 506890,
      "end_ms": 508305,
      "text": "换一个观景位置，",
      "token_start": 1592,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 508590,
      "end_ms": 510205,
      "text": "湖泊模样就变了。",
      "token_start": 1599,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 510500,
      "end_ms": 513060,
      "text": "他不像茶卡盐湖是镜面，",
      "token_start": 1606,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 513120,
      "end_ms": 517315,
      "text": "天地也不像九寨沟是静止的调色盘，",
      "token_start": 1616,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 518150,
      "end_ms": 519950,
      "text": "长期住在西藏的老乡，",
      "token_start": 1631,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 519950,
      "end_ms": 520190,
      "text": "说，",
      "token_start": 1640,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 520570,
      "end_ms": 522935,
      "text": "羊湖是一块活着的宝石，",
      "token_start": 1641,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 523490,
      "end_ms": 525775,
      "text": "色彩跟着光线天气流转，",
      "token_start": 1651,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 526530,
      "end_ms": 529085,
      "text": "你在山口静静站上一小时，",
      "token_start": 1661,
      "token_end_exclusive": 1672
    },
    {
      "start_ms": 529570,
      "end_ms": 532145,
      "text": "就能看见好几种不一样的蓝，",
      "token_start": 1672,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 533130,
      "end_ms": 534310,
      "text": "静静看着，",
      "token_start": 1684,
      "token_end_exclusive": 1688
    },
    {
      "start_ms": 534590,
      "end_ms": 536825,
      "text": "心里什么烦恼都放下了。",
      "token_start": 1688,
      "token_end_exclusive": 1698
    },
    {
      "start_ms": 537740,
      "end_ms": 540640,
      "text": "四千多米高原湖水灵动，",
      "token_start": 1698,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 541320,
      "end_ms": 543020,
      "text": "光影时时变化，",
      "token_start": 1708,
      "token_end_exclusive": 1714
    },
    {
      "start_ms": 543240,
      "end_ms": 544960,
      "text": "评论区打出四个字，",
      "token_start": 1714,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 545360,
      "end_ms": 546845,
      "text": "水边仙境。",
      "token_start": 1722,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 547690,
      "end_ms": 549125,
      "text": "咱们揭晓榜首，",
      "token_start": 1726,
      "token_end_exclusive": 1732
    },
    {
      "start_ms": 549810,
      "end_ms": 552915,
      "text": "就是开篇说的早年无路，",
      "token_start": 1732,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 553670,
      "end_ms": 555935,
      "text": "很多人从没听过的秘境。",
      "token_start": 1742,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 557040,
      "end_ms": 557775,
      "text": "第一名，",
      "token_start": 1752,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 559110,
      "end_ms": 561185,
      "text": "大柴蛋翡翠湖，",
      "token_start": 1755,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 561680,
      "end_ms": 567885,
      "text": "青海海西大柴蛋地名朴素藏在戈壁滩上。",
      "token_start": 1761,
      "token_end_exclusive": 1778
    },
    {
      "start_ms": 568690,
      "end_ms": 572374,
      "text": "翡翠湖原本是开采矿物的化工盐湖，",
      "token_start": 1778,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 573140,
      "end_ms": 574445,
      "text": "当年是矿区，",
      "token_start": 1793,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 575200,
      "end_ms": 576495,
      "text": "不是旅游景点。",
      "token_start": 1798,
      "token_end_exclusive": 1804
    },
    {
      "start_ms": 578050,
      "end_ms": 579350,
      "text": "矿产开采之后，",
      "token_start": 1804,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 579790,
      "end_ms": 584735,
      "text": "留下大大小小矿坑雨水积雪慢慢积在坑中，",
      "token_start": 1810,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 585220,
      "end_ms": 586555,
      "text": "造就这片奇景。",
      "token_start": 1828,
      "token_end_exclusive": 1834
    },
    {
      "start_ms": 587210,
      "end_ms": 587450,
      "text": "嗯，",
      "token_start": 1834,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 587720,
      "end_ms": 591070,
      "text": "翡翠湖不是单独一个湖戈壁滩，",
      "token_start": 1835,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 591110,
      "end_ms": 591695,
      "text": "散落，",
      "token_start": 1848,
      "token_end_exclusive": 1850
    },
    {
      "start_ms": 591960,
      "end_ms": 593195,
      "text": "大大小小水洼，",
      "token_start": 1850,
      "token_end_exclusive": 1856
    },
    {
      "start_ms": 593540,
      "end_ms": 596435,
      "text": "每个水洼矿物质成分浓度不一样，",
      "token_start": 1856,
      "token_end_exclusive": 1870
    },
    {
      "start_ms": 596960,
      "end_ms": 600445,
      "text": "一池一个颜色翠绿湛蓝，",
      "token_start": 1870,
      "token_end_exclusive": 1880
    },
    {
      "start_ms": 600840,
      "end_ms": 601280,
      "text": "墨绿，",
      "token_start": 1880,
      "token_end_exclusive": 1882
    },
    {
      "start_ms": 601540,
      "end_ms": 602040,
      "text": "乳白，",
      "token_start": 1882,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 602380,
      "end_ms": 603465,
      "text": "蓝绿交织。",
      "token_start": 1884,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 604290,
      "end_ms": 605070,
      "text": "十多年前，",
      "token_start": 1888,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 605070,
      "end_ms": 606490,
      "text": "这里只有矿区土路，",
      "token_start": 1892,
      "token_end_exclusive": 1900
    },
    {
      "start_ms": 606850,
      "end_ms": 608590,
      "text": "普通轿车很难通行，",
      "token_start": 1900,
      "token_end_exclusive": 1908
    },
    {
      "start_ms": 609450,
      "end_ms": 610630,
      "text": "游客稀少，",
      "token_start": 1908,
      "token_end_exclusive": 1912
    },
    {
      "start_ms": 611350,
      "end_ms": 612670,
      "text": "道路修好之后，",
      "token_start": 1912,
      "token_end_exclusive": 1918
    },
    {
      "start_ms": 613170,
      "end_ms": 615010,
      "text": "美景才慢慢传开。",
      "token_start": 1918,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 615990,
      "end_ms": 617890,
      "text": "翡翠湖最美的时刻，",
      "token_start": 1925,
      "token_end_exclusive": 1933
    },
    {
      "start_ms": 618130,
      "end_ms": 619190,
      "text": "无风傍晚，",
      "token_start": 1933,
      "token_end_exclusive": 1937
    },
    {
      "start_ms": 619630,
      "end_ms": 620690,
      "text": "夕阳下沉，",
      "token_start": 1937,
      "token_end_exclusive": 1941
    },
    {
      "start_ms": 621650,
      "end_ms": 623870,
      "text": "金色柔光铺满大地，",
      "token_start": 1941,
      "token_end_exclusive": 1949
    },
    {
      "start_ms": 624490,
      "end_ms": 626390,
      "text": "各色水洼闪闪发亮。",
      "token_start": 1949,
      "token_end_exclusive": 1957
    },
    {
      "start_ms": 627050,
      "end_ms": 631010,
      "text": "远处隔壁荒原雪山遥遥伫立。",
      "token_start": 1957,
      "token_end_exclusive": 1969
    },
    {
      "start_ms": 631910,
      "end_ms": 633450,
      "text": "很多到访的朋友说，",
      "token_start": 1969,
      "token_end_exclusive": 1977
    },
    {
      "start_ms": 633550,
      "end_ms": 634420,
      "text": "站在这这里，",
      "token_start": 1977,
      "token_end_exclusive": 1982
    },
    {
      "start_ms": 634540,
      "end_ms": 637760,
      "text": "恍惚之间不像身在人间，",
      "token_start": 1982,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 638520,
      "end_ms": 640880,
      "text": "但翡翠湖最触动我的，",
      "token_start": 1992,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 641280,
      "end_ms": 642900,
      "text": "不是惊艳的水色，",
      "token_start": 2001,
      "token_end_exclusive": 2008
    },
    {
      "start_ms": 643400,
      "end_ms": 644640,
      "text": "而是它的故事。",
      "token_start": 2008,
      "token_end_exclusive": 2014
    },
    {
      "start_ms": 645600,
      "end_ms": 648660,
      "text": "这片美景不是大自然。",
      "token_start": 2014,
      "token_end_exclusive": 2023
    },
    {
      "start_ms": 648680,
      "end_ms": 650319,
      "text": "亿万年精心雕琢，",
      "token_start": 2023,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 650860,
      "end_ms": 652480,
      "text": "是人采矿结束，",
      "token_start": 2030,
      "token_end_exclusive": 2036
    },
    {
      "start_ms": 652520,
      "end_ms": 653260,
      "text": "离开之后，",
      "token_start": 2036,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 653560,
      "end_ms": 655480,
      "text": "大自然慢慢孕育出来。",
      "token_start": 2040,
      "token_end_exclusive": 2049
    },
    {
      "start_ms": 655720,
      "end_ms": 658280,
      "text": "矿坑是人玩积水，",
      "token_start": 2049,
      "token_end_exclusive": 2056
    },
    {
      "start_ms": 658400,
      "end_ms": 659180,
      "text": "是雨雪，",
      "token_start": 2056,
      "token_end_exclusive": 2059
    },
    {
      "start_ms": 659220,
      "end_ms": 659720,
      "text": "汇集，",
      "token_start": 2059,
      "token_end_exclusive": 2061
    },
    {
      "start_ms": 660420,
      "end_ms": 662780,
      "text": "缤纷色彩是矿物，",
      "token_start": 2061,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 662780,
      "end_ms": 663915,
      "text": "只遇上阳光，",
      "token_start": 2068,
      "token_end_exclusive": 2073
    },
    {
      "start_ms": 664050,
      "end_ms": 667130,
      "text": "能造就当地老矿工。",
      "token_start": 2073,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 667150,
      "end_ms": 668935,
      "text": "回忆开采年代，",
      "token_start": 2081,
      "token_end_exclusive": 2087
    },
    {
      "start_ms": 669510,
      "end_ms": 671190,
      "text": "这里只是一片荒滩。",
      "token_start": 2087,
      "token_end_exclusive": 2095
    },
    {
      "start_ms": 671250,
      "end_ms": 673255,
      "text": "矿坑没人觉得好看，",
      "token_start": 2095,
      "token_end_exclusive": 2103
    },
    {
      "start_ms": 674100,
      "end_ms": 676595,
      "text": "等到矿亭人走岁月流转，",
      "token_start": 2103,
      "token_end_exclusive": 2113
    },
    {
      "start_ms": 677140,
      "end_ms": 677860,
      "text": "坑中水，",
      "token_start": 2113,
      "token_end_exclusive": 2116
    },
    {
      "start_ms": 678100,
      "end_ms": 681420,
      "text": "慢慢长成翡翠人撤去水，",
      "token_start": 2116,
      "token_end_exclusive": 2126
    },
    {
      "start_ms": 681480,
      "end_ms": 683425,
      "text": "会集美景自生。",
      "token_start": 2126,
      "token_end_exclusive": 2132
    },
    {
      "start_ms": 683800,
      "end_ms": 687755,
      "text": "废弃矿坑化作戈壁滩上的水边仙境。",
      "token_start": 2132,
      "token_end_exclusive": 2147
    },
    {
      "start_ms": 688720,
      "end_ms": 689400,
      "text": "十个地方，",
      "token_start": 2147,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 689620,
      "end_ms": 690735,
      "text": "咱们全部讲完。",
      "token_start": 2151,
      "token_end_exclusive": 2157
    },
    {
      "start_ms": 691090,
      "end_ms": 693110,
      "text": "霞浦贪涂岸边，",
      "token_start": 2157,
      "token_end_exclusive": 2163
    },
    {
      "start_ms": 693190,
      "end_ms": 697105,
      "text": "看日出就是天然画卷茶卡盐湖。",
      "token_start": 2163,
      "token_end_exclusive": 2176
    },
    {
      "start_ms": 697510,
      "end_ms": 698455,
      "text": "走到深处，",
      "token_start": 2176,
      "token_end_exclusive": 2180
    },
    {
      "start_ms": 698770,
      "end_ms": 700525,
      "text": "天地融为一体，",
      "token_start": 2180,
      "token_end_exclusive": 2186
    },
    {
      "start_ms": 701220,
      "end_ms": 702905,
      "text": "千岛湖碧波之下，",
      "token_start": 2186,
      "token_end_exclusive": 2193
    },
    {
      "start_ms": 703380,
      "end_ms": 706235,
      "text": "沉睡着两座古城泸沽湖。",
      "token_start": 2193,
      "token_end_exclusive": 2203
    },
    {
      "start_ms": 706620,
      "end_ms": 709925,
      "text": "水质纯净水里能开出鲜花，",
      "token_start": 2203,
      "token_end_exclusive": 2214
    },
    {
      "start_ms": 710530,
      "end_ms": 714455,
      "text": "恩施、平山、峡谷、清水拖着小船，",
      "token_start": 2214,
      "token_end_exclusive": 2226
    },
    {
      "start_ms": 714950,
      "end_ms": 718150,
      "text": "仿佛悬浮空中长白山天池云雾，",
      "token_start": 2226,
      "token_end_exclusive": 2239
    },
    {
      "start_ms": 718190,
      "end_ms": 722465,
      "text": "守护一池蓝宝石、荔波、小溪、孔古桥之后，",
      "token_start": 2239,
      "token_end_exclusive": 2255
    },
    {
      "start_ms": 723100,
      "end_ms": 724200,
      "text": "层层瀑布，",
      "token_start": 2255,
      "token_end_exclusive": 2259
    },
    {
      "start_ms": 724260,
      "end_ms": 725205,
      "text": "绵延不绝。",
      "token_start": 2259,
      "token_end_exclusive": 2263
    },
    {
      "start_ms": 726040,
      "end_ms": 727735,
      "text": "九寨沟摆个海子，",
      "token_start": 2263,
      "token_end_exclusive": 2270
    },
    {
      "start_ms": 728100,
      "end_ms": 729575,
      "text": "色彩各有千秋，",
      "token_start": 2270,
      "token_end_exclusive": 2276
    },
    {
      "start_ms": 730200,
      "end_ms": 731440,
      "text": "阳卓拥错，",
      "token_start": 2276,
      "token_end_exclusive": 2280
    },
    {
      "start_ms": 731600,
      "end_ms": 732805,
      "text": "湖水灵动，",
      "token_start": 2280,
      "token_end_exclusive": 2284
    },
    {
      "start_ms": 733210,
      "end_ms": 735175,
      "text": "随时变换色彩。",
      "token_start": 2284,
      "token_end_exclusive": 2290
    },
    {
      "start_ms": 736080,
      "end_ms": 738375,
      "text": "翡翠湖矿场废弃之后，",
      "token_start": 2290,
      "token_end_exclusive": 2299
    },
    {
      "start_ms": 738770,
      "end_ms": 740815,
      "text": "大自然绘就的翡翠秘境，",
      "token_start": 2299,
      "token_end_exclusive": 2309
    },
    {
      "start_ms": 741700,
      "end_ms": 745335,
      "text": "这十处美景全都以水而生，",
      "token_start": 2309,
      "token_end_exclusive": 2320
    },
    {
      "start_ms": 746250,
      "end_ms": 749985,
      "text": "有的人一辈子都不知道他们的存在，",
      "token_start": 2320,
      "token_end_exclusive": 2335
    },
    {
      "start_ms": 750450,
      "end_ms": 752005,
      "text": "有的人千里奔赴，",
      "token_start": 2335,
      "token_end_exclusive": 2342
    },
    {
      "start_ms": 752350,
      "end_ms": 753130,
      "text": "遇上大雾，",
      "token_start": 2342,
      "token_end_exclusive": 2346
    },
    {
      "start_ms": 753150,
      "end_ms": 754015,
      "text": "空手而归。",
      "token_start": 2346,
      "token_end_exclusive": 2350
    },
    {
      "start_ms": 754320,
      "end_ms": 755805,
      "text": "也有人猜准时节，",
      "token_start": 2350,
      "token_end_exclusive": 2357
    },
    {
      "start_ms": 756100,
      "end_ms": 757520,
      "text": "站在最合适的地点，",
      "token_start": 2357,
      "token_end_exclusive": 2365
    },
    {
      "start_ms": 757520,
      "end_ms": 758515,
      "text": "望着水面，",
      "token_start": 2365,
      "token_end_exclusive": 2369
    },
    {
      "start_ms": 758970,
      "end_ms": 762175,
      "text": "安安静静一句话都说不出来。",
      "token_start": 2369,
      "token_end_exclusive": 2381
    },
    {
      "start_ms": 763260,
      "end_ms": 766235,
      "text": "这条视频转发给你的老伙计，",
      "token_start": 2381,
      "token_end_exclusive": 2393
    },
    {
      "start_ms": 767030,
      "end_ms": 770290,
      "text": "就是总念叨退休之后不知道去哪游玩的。",
      "token_start": 2393,
      "token_end_exclusive": 2410
    },
    {
      "start_ms": 770290,
      "end_ms": 772135,
      "text": "老朋友跟他说，",
      "token_start": 2410,
      "token_end_exclusive": 2416
    },
    {
      "start_ms": 772590,
      "end_ms": 774635,
      "text": "别总愁没有好去处。",
      "token_start": 2416,
      "token_end_exclusive": 2424
    },
    {
      "start_ms": 775210,
      "end_ms": 778050,
      "text": "十个地方挑一处带上老伴出发，",
      "token_start": 2424,
      "token_end_exclusive": 2437
    },
    {
      "start_ms": 778470,
      "end_ms": 781455,
      "text": "单单坐在水边静静发呆一阵子，",
      "token_start": 2437,
      "token_end_exclusive": 2450
    },
    {
      "start_ms": 781800,
      "end_ms": 785295,
      "text": "这趟旅途就直了。",
      "token_start": 2450,
      "token_end_exclusive": 2457
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
