{
  "video_id": "v_7199f8033bb838af",
  "duration_s": 711.390998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_7199f8033bb838af.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_7199f8033bb838af.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 5070,
      "text": "你知道最该带家人去一次的地方是哪儿吗？",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5070,
      "end_ms": 9630,
      "text": "有人说马尔代夫有人说日本马尔代夫确实好看，",
      "token_start": 18,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10330,
      "end_ms": 13410,
      "text": "下那地方适合小年轻拍照发朋友圈。",
      "token_start": 38,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13830,
      "end_ms": 20150,
      "text": "带着爸妈去老两口在沙滩上晒一天晒完了也不知道看了什么。",
      "token_start": 53,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 20910,
      "end_ms": 22290,
      "text": "日本更不用说了，",
      "token_start": 79,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 22690,
      "end_ms": 25410,
      "text": "带着家里老人坐飞机折腾大半天，",
      "token_start": 86,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 26310,
      "end_ms": 27990,
      "text": "下了飞机一个字看不懂，",
      "token_start": 100,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 28390,
      "end_ms": 31000,
      "text": "吃饭要蹲在榻榻米上面跪的膝盖疼，",
      "token_start": 110,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 31420,
      "end_ms": 33040,
      "text": "逛个景点全是台阶，",
      "token_start": 125,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 33060,
      "end_ms": 35240,
      "text": "腿脚不好的走半天就不想动了。",
      "token_start": 133,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 36080,
      "end_ms": 38960,
      "text": "钱花了不少老人累得够呛，",
      "token_start": 146,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 39760,
      "end_ms": 40240,
      "text": "回来问，",
      "token_start": 157,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 40240,
      "end_ms": 40880,
      "text": "好玩吗？",
      "token_start": 160,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 41000,
      "end_ms": 41600,
      "text": "说还行，",
      "token_start": 163,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 42500,
      "end_ms": 44220,
      "text": "这叫带家人旅游吗？",
      "token_start": 166,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 44960,
      "end_ms": 46560,
      "text": "这叫带家人受罪。",
      "token_start": 174,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 46980,
      "end_ms": 48920,
      "text": "真正该带家人去的地方，",
      "token_start": 181,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 48920,
      "end_ms": 49740,
      "text": "不用出国，",
      "token_start": 191,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 50280,
      "end_ms": 52060,
      "text": "还在榜首的那个地方。",
      "token_start": 195,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 52460,
      "end_ms": 56200,
      "text": "墙上的壁画正在以肉眼可见的速度消失。",
      "token_start": 204,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 56680,
      "end_ms": 58420,
      "text": "据研究人员监测，",
      "token_start": 221,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 58980,
      "end_ms": 62775,
      "text": "今年看到的颜色和十年后看到的已经不一样，",
      "token_start": 228,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 63320,
      "end_ms": 65225,
      "text": "再不带家人去看一眼，",
      "token_start": 247,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 65620,
      "end_ms": 67875,
      "text": "有些东西这辈子就真没了，",
      "token_start": 256,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 68030,
      "end_ms": 68955,
      "text": "到底是哪儿？",
      "token_start": 267,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 69270,
      "end_ms": 71530,
      "text": "从第十个开始倒着讲讲，",
      "token_start": 272,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 71530,
      "end_ms": 72845,
      "text": "到第一个您自己品，",
      "token_start": 282,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 73100,
      "end_ms": 73680,
      "text": "还是咱们的。",
      "token_start": 290,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 73680,
      "end_ms": 74235,
      "text": "老规矩。",
      "token_start": 295,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 75010,
      "end_ms": 75630,
      "text": "开讲前，",
      "token_start": 298,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 75630,
      "end_ms": 79850,
      "text": "劳烦各位老友顺手点亮红心评论区，",
      "token_start": 301,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 79850,
      "end_ms": 84805,
      "text": "打个来了让我看看今天又有多少知音来捧场。",
      "token_start": 316,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 86140,
      "end_ms": 86885,
      "text": "第十名，",
      "token_start": 335,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 87210,
      "end_ms": 91880,
      "text": "青海湖青海省青海湖，",
      "token_start": 338,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 91880,
      "end_ms": 94265,
      "text": "很多人觉得青海湖不就是个大湖吗？",
      "token_start": 347,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 96110,
      "end_ms": 97195,
      "text": "有什么好看的？",
      "token_start": 362,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 97470,
      "end_ms": 100355,
      "text": "八就是好看。",
      "token_start": 368,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 101640,
      "end_ms": 102700,
      "text": "据公开资料，",
      "token_start": 373,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 102720,
      "end_ms": 106400,
      "text": "青海湖是中国面积数一数二的湖水域，",
      "token_start": 378,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 106420,
      "end_ms": 108345,
      "text": "面积四千多平方公里，",
      "token_start": 394,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 108920,
      "end_ms": 110955,
      "text": "四千多平方公里是什么概念？",
      "token_start": 403,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 111580,
      "end_ms": 113820,
      "text": "站在湖边往对岸看看，",
      "token_start": 415,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 113820,
      "end_ms": 117025,
      "text": "不到头跟站在海边一模一样。",
      "token_start": 424,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 117570,
      "end_ms": 118810,
      "text": "可它不是海水，",
      "token_start": 436,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 118870,
      "end_ms": 119505,
      "text": "是蓝的，",
      "token_start": 442,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 120000,
      "end_ms": 121100,
      "text": "不是海水那种。",
      "token_start": 445,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 121100,
      "end_ms": 123800,
      "text": "深蓝是一种从浅到深，",
      "token_start": 451,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 124380,
      "end_ms": 125780,
      "text": "从绿到蓝，",
      "token_start": 460,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 126020,
      "end_ms": 127700,
      "text": "慢慢过渡的颜色，",
      "token_start": 464,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 128600,
      "end_ms": 129780,
      "text": "干净的不像话。",
      "token_start": 471,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 130200,
      "end_ms": 134400,
      "text": "不少去过的人都说带家人去青海湖比较推荐。",
      "token_start": 477,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 134400,
      "end_ms": 135800,
      "text": "七八月份那会儿，",
      "token_start": 496,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 135800,
      "end_ms": 137440,
      "text": "环湖的油菜花全开，",
      "token_start": 503,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 137540,
      "end_ms": 139660,
      "text": "金黄色的花田从脚底下，",
      "token_start": 511,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 139860,
      "end_ms": 141020,
      "text": "一直铺到湖边，",
      "token_start": 521,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 141920,
      "end_ms": 144440,
      "text": "花田尽头就是蓝色的湖水，",
      "token_start": 527,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 145200,
      "end_ms": 146900,
      "text": "湖水上面是雪山，",
      "token_start": 538,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 148000,
      "end_ms": 149080,
      "text": "黄蓝白。",
      "token_start": 545,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 150190,
      "end_ms": 150430,
      "text": "唉，",
      "token_start": 548,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 150450,
      "end_ms": 153150,
      "text": "三种颜色从近到远排开，",
      "token_start": 549,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 153550,
      "end_ms": 155430,
      "text": "中间没有一根电线杆，",
      "token_start": 559,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 155770,
      "end_ms": 157230,
      "text": "没有一栋楼挡着，",
      "token_start": 568,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 157970,
      "end_ms": 158850,
      "text": "干干净净，",
      "token_start": 575,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 158850,
      "end_ms": 160050,
      "text": "就是三条色带。",
      "token_start": 579,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 160850,
      "end_ms": 163510,
      "text": "为什么说青海湖适合带家人？",
      "token_start": 585,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 164050,
      "end_ms": 165310,
      "text": "因为他不用爬山，",
      "token_start": 597,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 166090,
      "end_ms": 167170,
      "text": "不用走台阶，",
      "token_start": 604,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 167650,
      "end_ms": 168490,
      "text": "不用排队，",
      "token_start": 609,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 169010,
      "end_ms": 170690,
      "text": "环湖公路是平的，",
      "token_start": 613,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 171070,
      "end_ms": 172730,
      "text": "开着车走走停停，",
      "token_start": 620,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 173030,
      "end_ms": 174510,
      "text": "哪好看就停下来。",
      "token_start": 627,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 174890,
      "end_ms": 176790,
      "text": "老人小孩下车就能看，",
      "token_start": 634,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 176950,
      "end_ms": 179245,
      "text": "湖边有大片的草地，",
      "token_start": 643,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 179820,
      "end_ms": 180540,
      "text": "铺张毯子，",
      "token_start": 651,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 180540,
      "end_ms": 181960,
      "text": "坐下来什么都不干，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 182500,
      "end_ms": 184120,
      "text": "光看着那个蓝色发呆，",
      "token_start": 663,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 184260,
      "end_ms": 185800,
      "text": "一坐就是一下午，",
      "token_start": 672,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 186500,
      "end_ms": 189320,
      "text": "很多景点是要费力气去征服的，",
      "token_start": 679,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 189560,
      "end_ms": 190700,
      "text": "青海湖不用，",
      "token_start": 692,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 191060,
      "end_ms": 192380,
      "text": "他就在那等着你，",
      "token_start": 697,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 192700,
      "end_ms": 193920,
      "text": "平平整整的，",
      "token_start": 704,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 194040,
      "end_ms": 194820,
      "text": "谁都能看，",
      "token_start": 709,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 195060,
      "end_ms": 196020,
      "text": "谁都走得到。",
      "token_start": 713,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 196380,
      "end_ms": 198240,
      "text": "带着腿脚不太好的爸妈，",
      "token_start": 718,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 198560,
      "end_ms": 201580,
      "text": "带着跑不动的小孩往湖边一坐，",
      "token_start": 728,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 202120,
      "end_ms": 202900,
      "text": "风一吹，",
      "token_start": 741,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 203360,
      "end_ms": 204520,
      "text": "什么都看见了，",
      "token_start": 744,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 205280,
      "end_ms": 206920,
      "text": "就冲这份不费劲，",
      "token_start": 750,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 207640,
      "end_ms": 211240,
      "text": "他值得排第十第九名，",
      "token_start": 757,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 211400,
      "end_ms": 212540,
      "text": "凤凰古城，",
      "token_start": 766,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 212980,
      "end_ms": 220880,
      "text": "湖南湘西凤凰古城沈从文先生的老家就是写边城那位凤凰古城。",
      "token_start": 770,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 220880,
      "end_ms": 222000,
      "text": "好看不是好看，",
      "token_start": 797,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 222060,
      "end_ms": 223740,
      "text": "在白天是好看。",
      "token_start": 803,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 223800,
      "end_ms": 227560,
      "text": "在傍晚太阳快落山的时候，",
      "token_start": 809,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 227900,
      "end_ms": 230440,
      "text": "沱江的水变成一种暗金色，",
      "token_start": 820,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 231040,
      "end_ms": 233180,
      "text": "两岸的吊脚楼亮起灯来，",
      "token_start": 831,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 233500,
      "end_ms": 235400,
      "text": "灯光倒映在水面上。",
      "token_start": 841,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 235580,
      "end_ms": 240865,
      "text": "一晃一晃的您带着家里人沿着江边的石板路漫慢走，",
      "token_start": 849,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 241320,
      "end_ms": 242940,
      "text": "脚底下是老被人踩了，",
      "token_start": 871,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 242940,
      "end_ms": 244695,
      "text": "不知道多少年的青是吧？",
      "token_start": 880,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 245030,
      "end_ms": 247170,
      "text": "旁边是一家挨一家的小店，",
      "token_start": 890,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 247310,
      "end_ms": 249780,
      "text": "卖姜糖的、卖银饰的，",
      "token_start": 901,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 249860,
      "end_ms": 250875,
      "text": "卖腊肉的，",
      "token_start": 909,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 251400,
      "end_ms": 252940,
      "text": "空气里一会儿是甜的。",
      "token_start": 913,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 252940,
      "end_ms": 253885,
      "text": "一会儿是咸的，",
      "token_start": 922,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 254650,
      "end_ms": 255325,
      "text": "走累了，",
      "token_start": 928,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 255510,
      "end_ms": 257030,
      "text": "就在江边找个馆子，",
      "token_start": 931,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 257030,
      "end_ms": 260565,
      "text": "坐下来点一条沱江里的小鱼，",
      "token_start": 939,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 261060,
      "end_ms": 263280,
      "text": "一碗酸汤一盘血，",
      "token_start": 951,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 263340,
      "end_ms": 265610,
      "text": "把鸭花不了多少钱，",
      "token_start": 958,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 265630,
      "end_ms": 267700,
      "text": "一桌菜吃着饭，",
      "token_start": 966,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 267720,
      "end_ms": 270100,
      "text": "看着江上的乌篷船慢慢划过去，",
      "token_start": 972,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 270540,
      "end_ms": 271445,
      "text": "凤凰不大。",
      "token_start": 985,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 272420,
      "end_ms": 274255,
      "text": "据当地旅游资料介绍，",
      "token_start": 989,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 274800,
      "end_ms": 277935,
      "text": "古城核心区走一圈也就两三公里，",
      "token_start": 998,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 278870,
      "end_ms": 279870,
      "text": "可就这么巴掌，",
      "token_start": 1012,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 279870,
      "end_ms": 283550,
      "text": "大一个地方走哪儿都是弯弯绕绕的巷子，",
      "token_start": 1018,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 283610,
      "end_ms": 287005,
      "text": "走哪都有人坐在门口播花生聊天，",
      "token_start": 1035,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 287720,
      "end_ms": 289315,
      "text": "不敢路不打卡，",
      "token_start": 1049,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 290060,
      "end_ms": 291155,
      "text": "一家人慢慢逛，",
      "token_start": 1055,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 291470,
      "end_ms": 292810,
      "text": "饿了就吃累了，",
      "token_start": 1061,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 292810,
      "end_ms": 294845,
      "text": "就做天黑了看灯，",
      "token_start": 1067,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 295160,
      "end_ms": 296615,
      "text": "这才叫代家人出来。",
      "token_start": 1074,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 297110,
      "end_ms": 299690,
      "text": "沈从文先生写凤凰写了一辈子，",
      "token_start": 1082,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 300430,
      "end_ms": 302570,
      "text": "他常说自己就是个乡下人，",
      "token_start": 1095,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 303270,
      "end_ms": 305430,
      "text": "您带着家里人去凤凰走一趟，",
      "token_start": 1106,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 305430,
      "end_ms": 306590,
      "text": "就明白这句话了。",
      "token_start": 1118,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 306590,
      "end_ms": 308730,
      "text": "那个地方不让您觉得自己在旅游，",
      "token_start": 1125,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 309090,
      "end_ms": 311470,
      "text": "让您觉得自己在过日子。",
      "token_start": 1139,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 312430,
      "end_ms": 313210,
      "text": "第八名，",
      "token_start": 1149,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 313630,
      "end_ms": 314890,
      "text": "黄果树瀑布，",
      "token_start": 1152,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 315230,
      "end_ms": 317230,
      "text": "贵州安顺黄果树瀑布，",
      "token_start": 1157,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 317570,
      "end_ms": 319090,
      "text": "中国人说起瀑布来，",
      "token_start": 1166,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 319090,
      "end_ms": 321350,
      "text": "大多数人第一个想到的就是它。",
      "token_start": 1174,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 322010,
      "end_ms": 326310,
      "text": "黄果树瀑布据实测数据高将近七十八米，",
      "token_start": 1187,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 326840,
      "end_ms": 327960,
      "text": "宽超过一百米，",
      "token_start": 1204,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 328460,
      "end_ms": 332520,
      "text": "一百米宽的水帘从七十八米高的地方直直砸下来。",
      "token_start": 1210,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 332520,
      "end_ms": 333300,
      "text": "是什么感觉？",
      "token_start": 1231,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 334300,
      "end_ms": 335860,
      "text": "您还没走到跟前，",
      "token_start": 1236,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 336900,
      "end_ms": 338980,
      "text": "先听见了轰隆隆的声音，",
      "token_start": 1243,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 339000,
      "end_ms": 341140,
      "text": "像打雷越走越响。",
      "token_start": 1253,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 341620,
      "end_ms": 343400,
      "text": "等走到观埔台的时候，",
      "token_start": 1260,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 343760,
      "end_ms": 348920,
      "text": "水砸到底下溅起来的雾气直接扑到脸上几分钟，",
      "token_start": 1269,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 348960,
      "end_ms": 349880,
      "text": "衣服就潮了。",
      "token_start": 1289,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 349900,
      "end_ms": 351720,
      "text": "黄果树为什么适合带家人？",
      "token_start": 1294,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 352320,
      "end_ms": 353980,
      "text": "因为他是中国少有的，",
      "token_start": 1305,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 353980,
      "end_ms": 355740,
      "text": "不用受罪就能看到的。",
      "token_start": 1314,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 355740,
      "end_ms": 358805,
      "text": "大瀑布景区里面有扶梯，",
      "token_start": 1323,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 359350,
      "end_ms": 361455,
      "text": "有栈道、有观光车，",
      "token_start": 1333,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 362290,
      "end_ms": 363870,
      "text": "从入口到瀑布跟前，",
      "token_start": 1340,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 363870,
      "end_ms": 365365,
      "text": "基本不用爬什么台阶。",
      "token_start": 1348,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 365800,
      "end_ms": 367560,
      "text": "老人坐着观光车到了，",
      "token_start": 1357,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 367560,
      "end_ms": 368920,
      "text": "观瀑台下来，",
      "token_start": 1366,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 368920,
      "end_ms": 369825,
      "text": "站两分钟，",
      "token_start": 1371,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 370180,
      "end_ms": 371985,
      "text": "瀑布的水雾扑一脸，",
      "token_start": 1375,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 372620,
      "end_ms": 374145,
      "text": "那个冲击力够记一辈子，",
      "token_start": 1383,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 375050,
      "end_ms": 377070,
      "text": "走得动的还可以进水帘洞。",
      "token_start": 1393,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 377090,
      "end_ms": 379415,
      "text": "瀑布后面有一条天然的溶洞，",
      "token_start": 1404,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 379840,
      "end_ms": 381165,
      "text": "从洞里往外看，",
      "token_start": 1416,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 381620,
      "end_ms": 383280,
      "text": "水帘就挂在眼前，",
      "token_start": 1422,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 383500,
      "end_ms": 385065,
      "text": "伸手就能碰到水，",
      "token_start": 1429,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 385490,
      "end_ms": 388825,
      "text": "很多大瀑布要么在深山里进去费劲，",
      "token_start": 1436,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 389250,
      "end_ms": 390170,
      "text": "要么到了跟前，",
      "token_start": 1451,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 390190,
      "end_ms": 392870,
      "text": "只能远远看着黄果树，",
      "token_start": 1457,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 392870,
      "end_ms": 395130,
      "text": "是真的把您送到瀑布面前，",
      "token_start": 1466,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 395130,
      "end_ms": 396645,
      "text": "让您摸到水的那种。",
      "token_start": 1477,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 397240,
      "end_ms": 398960,
      "text": "带着一家人站在水屋里面，",
      "token_start": 1485,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 398960,
      "end_ms": 400115,
      "text": "头发全湿了，",
      "token_start": 1496,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 400600,
      "end_ms": 401720,
      "text": "小孩在那儿笑，",
      "token_start": 1501,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 402140,
      "end_ms": 403435,
      "text": "老人在那儿夺水，",
      "token_start": 1507,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 404250,
      "end_ms": 409595,
      "text": "这个画面比拍一百张照片都值第七名。",
      "token_start": 1514,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 411550,
      "end_ms": 416405,
      "text": "西安、陕西西安历史上公认的千年古都，",
      "token_start": 1530,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 417220,
      "end_ms": 423900,
      "text": "大家耳熟能详的景朝代周秦汉唐都在这儿建过都西安，",
      "token_start": 1546,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 423920,
      "end_ms": 424800,
      "text": "适合带家人。",
      "token_start": 1569,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 424800,
      "end_ms": 425060,
      "text": "不是，",
      "token_start": 1574,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 425060,
      "end_ms": 426120,
      "text": "因为他有多好看，",
      "token_start": 1576,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 426520,
      "end_ms": 429820,
      "text": "是因为它能让一家人找到共同话题，",
      "token_start": 1583,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 430560,
      "end_ms": 433060,
      "text": "带孩子去看兵马俑课本。",
      "token_start": 1598,
      "token_end_exclusive": 1608
    },
    {
      "start_ms": 433060,
      "end_ms": 435260,
      "text": "上学过的东西突然立在眼前了，",
      "token_start": 1608,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 435800,
      "end_ms": 437780,
      "text": "一个个跟真人一样大，",
      "token_start": 1621,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 438380,
      "end_ms": 440060,
      "text": "脸上的表情都不一样。",
      "token_start": 1630,
      "token_end_exclusive": 1639
    },
    {
      "start_ms": 440720,
      "end_ms": 441860,
      "text": "小孩蹲在那看，",
      "token_start": 1639,
      "token_end_exclusive": 1645
    },
    {
      "start_ms": 441860,
      "end_ms": 442800,
      "text": "半天不起来，",
      "token_start": 1645,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 443560,
      "end_ms": 444900,
      "text": "带爸妈上城墙。",
      "token_start": 1650,
      "token_end_exclusive": 1656
    },
    {
      "start_ms": 445440,
      "end_ms": 446520,
      "text": "据文献记载，",
      "token_start": 1656,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 446580,
      "end_ms": 449230,
      "text": "西安的城墙始建于明朝，",
      "token_start": 1661,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 450010,
      "end_ms": 451870,
      "text": "周长将近十四公里，",
      "token_start": 1671,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 452570,
      "end_ms": 454030,
      "text": "保存基本完整。",
      "token_start": 1679,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 454130,
      "end_ms": 455570,
      "text": "上面能骑自行车，",
      "token_start": 1685,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 456170,
      "end_ms": 458330,
      "text": "老两口租辆车慢慢骑，",
      "token_start": 1692,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 458830,
      "end_ms": 460430,
      "text": "一边骑一边往下看。",
      "token_start": 1701,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 461230,
      "end_ms": 464550,
      "text": "城墙底下就是老城区的街巷，",
      "token_start": 1709,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 465330,
      "end_ms": 466710,
      "text": "屋顶连着屋顶，",
      "token_start": 1721,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 467370,
      "end_ms": 468270,
      "text": "到了饭点，",
      "token_start": 1727,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 468310,
      "end_ms": 470130,
      "text": "一家人钻进回民街，",
      "token_start": 1731,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 470730,
      "end_ms": 472030,
      "text": "一碗羊肉泡馍，",
      "token_start": 1739,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 472030,
      "end_ms": 472630,
      "text": "掰半天，",
      "token_start": 1745,
      "token_end_exclusive": 1748
    },
    {
      "start_ms": 473370,
      "end_ms": 474670,
      "text": "小孩吃肉夹馍，",
      "token_start": 1748,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 475110,
      "end_ms": 476980,
      "text": "老人喝一碗高配酸梅汤，",
      "token_start": 1754,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 477850,
      "end_ms": 482095,
      "text": "吃完了接着逛大雁塔碑林。",
      "token_start": 1764,
      "token_end_exclusive": 1775
    },
    {
      "start_ms": 482880,
      "end_ms": 485990,
      "text": "陕西历史博物馆走到哪儿，",
      "token_start": 1775,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 485990,
      "end_ms": 487835,
      "text": "都是课本上念过的名字。",
      "token_start": 1786,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 488200,
      "end_ms": 490615,
      "text": "西安不需要您懂历史，",
      "token_start": 1796,
      "token_end_exclusive": 1805
    },
    {
      "start_ms": 491310,
      "end_ms": 493260,
      "text": "他自己会跟您说话，",
      "token_start": 1805,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 493360,
      "end_ms": 495625,
      "text": "带着家人在城墙上骑一圈车，",
      "token_start": 1813,
      "token_end_exclusive": 1825
    },
    {
      "start_ms": 496430,
      "end_ms": 498625,
      "text": "在博物馆里看一下午青铜器。",
      "token_start": 1825,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 499200,
      "end_ms": 501585,
      "text": "晚上在回民街吃到走不动道，",
      "token_start": 1837,
      "token_end_exclusive": 1849
    },
    {
      "start_ms": 502390,
      "end_ms": 505710,
      "text": "回来以后一家人能聊的东西多了好几个月的量。",
      "token_start": 1849,
      "token_end_exclusive": 1869
    },
    {
      "start_ms": 505770,
      "end_ms": 508265,
      "text": "这比去哪个网红景点拍个照管用。",
      "token_start": 1869,
      "token_end_exclusive": 1883
    },
    {
      "start_ms": 508750,
      "end_ms": 509370,
      "text": "第六名，",
      "token_start": 1883,
      "token_end_exclusive": 1886
    },
    {
      "start_ms": 509510,
      "end_ms": 510255,
      "text": "张家界，",
      "token_start": 1886,
      "token_end_exclusive": 1889
    },
    {
      "start_ms": 511390,
      "end_ms": 512645,
      "text": "湖南张家界。",
      "token_start": 1889,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 513400,
      "end_ms": 514865,
      "text": "据地质资料记载，",
      "token_start": 1894,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 515520,
      "end_ms": 518640,
      "text": "三千多根石柱从地里冒出来，",
      "token_start": 1901,
      "token_end_exclusive": 1913
    },
    {
      "start_ms": 519300,
      "end_ms": 520985,
      "text": "高的有三百多米，",
      "token_start": 1913,
      "token_end_exclusive": 1920
    },
    {
      "start_ms": 521490,
      "end_ms": 523175,
      "text": "每一根都是单独立着，",
      "token_start": 1920,
      "token_end_exclusive": 1929
    },
    {
      "start_ms": 523820,
      "end_ms": 525255,
      "text": "上面长满了树，",
      "token_start": 1929,
      "token_end_exclusive": 1935
    },
    {
      "start_ms": 525710,
      "end_ms": 528030,
      "text": "像一片从地里长出来的森林。",
      "token_start": 1935,
      "token_end_exclusive": 1947
    },
    {
      "start_ms": 528230,
      "end_ms": 529775,
      "text": "张家界好看在哪？",
      "token_start": 1947,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 530130,
      "end_ms": 530590,
      "text": "好看？",
      "token_start": 1954,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 530590,
      "end_ms": 532175,
      "text": "在站在高处往下看，",
      "token_start": 1956,
      "token_end_exclusive": 1964
    },
    {
      "start_ms": 532530,
      "end_ms": 535270,
      "text": "可带家人去张家界最怕一件事儿，",
      "token_start": 1964,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 535270,
      "end_ms": 537690,
      "text": "爬山三千多根石柱，",
      "token_start": 1978,
      "token_end_exclusive": 1986
    },
    {
      "start_ms": 537750,
      "end_ms": 540985,
      "text": "看着好看可要爬上去看不容易。",
      "token_start": 1986,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 541410,
      "end_ms": 543735,
      "text": "以前的张家界确实不太适合老人，",
      "token_start": 1999,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 544420,
      "end_ms": 545635,
      "text": "可现在不一样，",
      "token_start": 2013,
      "token_end_exclusive": 2019
    },
    {
      "start_ms": 546570,
      "end_ms": 548895,
      "text": "景区里有一部摆龙天梯。",
      "token_start": 2019,
      "token_end_exclusive": 2029
    },
    {
      "start_ms": 549720,
      "end_ms": 551355,
      "text": "据公开资料介绍，",
      "token_start": 2029,
      "token_end_exclusive": 2036
    },
    {
      "start_ms": 552060,
      "end_ms": 556695,
      "text": "这部电梯贴着悬崖修的落差超过三百米，",
      "token_start": 2036,
      "token_end_exclusive": 2053
    },
    {
      "start_ms": 556990,
      "end_ms": 557850,
      "text": "一分多钟，",
      "token_start": 2053,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 558070,
      "end_ms": 560085,
      "text": "从山脚直接升到山顶，",
      "token_start": 2057,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 560940,
      "end_ms": 563400,
      "text": "老人小孩一步台阶不用爬，",
      "token_start": 2066,
      "token_end_exclusive": 2077
    },
    {
      "start_ms": 563520,
      "end_ms": 565500,
      "text": "电梯门一开三千根，",
      "token_start": 2077,
      "token_end_exclusive": 2085
    },
    {
      "start_ms": 565520,
      "end_ms": 567025,
      "text": "石柱就在眼前了，",
      "token_start": 2085,
      "token_end_exclusive": 2092
    },
    {
      "start_ms": 568150,
      "end_ms": 570545,
      "text": "站在山顶的观景台上往下看，",
      "token_start": 2092,
      "token_end_exclusive": 2104
    },
    {
      "start_ms": 571320,
      "end_ms": 572780,
      "text": "石柱群从脚底下，",
      "token_start": 2104,
      "token_end_exclusive": 2111
    },
    {
      "start_ms": 572780,
      "end_ms": 573975,
      "text": "一直排到天边，",
      "token_start": 2111,
      "token_end_exclusive": 2117
    },
    {
      "start_ms": 574750,
      "end_ms": 580920,
      "text": "每一根之间隔着深谷谷底是白色的云雾起雾的时候，",
      "token_start": 2117,
      "token_end_exclusive": 2139
    },
    {
      "start_ms": 580920,
      "end_ms": 583345,
      "text": "石柱的上半截露在云上面，",
      "token_start": 2139,
      "token_end_exclusive": 2150
    },
    {
      "start_ms": 584110,
      "end_ms": 585995,
      "text": "下半截埋在云里面，",
      "token_start": 2150,
      "token_end_exclusive": 2158
    },
    {
      "start_ms": 586550,
      "end_ms": 590254,
      "text": "像是从棉花堆里长出来的一根根柱子，",
      "token_start": 2158,
      "token_end_exclusive": 2174
    },
    {
      "start_ms": 590710,
      "end_ms": 593005,
      "text": "张家界还有一座玻璃桥。",
      "token_start": 2174,
      "token_end_exclusive": 2184
    },
    {
      "start_ms": 593620,
      "end_ms": 594425,
      "text": "据介绍。",
      "token_start": 2184,
      "token_end_exclusive": 2187
    },
    {
      "start_ms": 594810,
      "end_ms": 596910,
      "text": "桥面长超过四百米，",
      "token_start": 2187,
      "token_end_exclusive": 2195
    },
    {
      "start_ms": 597290,
      "end_ms": 598890,
      "text": "悬在峡谷上空，",
      "token_start": 2195,
      "token_end_exclusive": 2201
    },
    {
      "start_ms": 599290,
      "end_ms": 600850,
      "text": "桥面是透明的，",
      "token_start": 2201,
      "token_end_exclusive": 2207
    },
    {
      "start_ms": 600850,
      "end_ms": 601890,
      "text": "往脚底下看，",
      "token_start": 2207,
      "token_end_exclusive": 2212
    },
    {
      "start_ms": 601910,
      "end_ms": 605050,
      "text": "就是深谷胆子大的走到桥中间，",
      "token_start": 2212,
      "token_end_exclusive": 2225
    },
    {
      "start_ms": 605230,
      "end_ms": 607690,
      "text": "胆子小的在桥头看一眼就够了。",
      "token_start": 2225,
      "token_end_exclusive": 2238
    },
    {
      "start_ms": 608550,
      "end_ms": 609670,
      "text": "不管敢不敢走，",
      "token_start": 2238,
      "token_end_exclusive": 2244
    },
    {
      "start_ms": 609850,
      "end_ms": 611050,
      "text": "一家人站在桥头，",
      "token_start": 2244,
      "token_end_exclusive": 2251
    },
    {
      "start_ms": 611050,
      "end_ms": 612190,
      "text": "那个表情就够那，",
      "token_start": 2251,
      "token_end_exclusive": 2258
    },
    {
      "start_ms": 612190,
      "end_ms": 613990,
      "text": "一路三千多根。",
      "token_start": 2258,
      "token_end_exclusive": 2264
    },
    {
      "start_ms": 613990,
      "end_ms": 618870,
      "text": "石柱不用爬山就能看不部电梯解决了腿脚的问题，",
      "token_start": 2264,
      "token_end_exclusive": 2285
    },
    {
      "start_ms": 619310,
      "end_ms": 621570,
      "text": "带着一家人站在山顶上，",
      "token_start": 2285,
      "token_end_exclusive": 2295
    },
    {
      "start_ms": 621890,
      "end_ms": 626220,
      "text": "三百六十度全是石柱和云海一起看一次。",
      "token_start": 2295,
      "token_end_exclusive": 2312
    },
    {
      "start_ms": 626220,
      "end_ms": 629980,
      "text": "这辈子忘不了先在评论区打出四个字，",
      "token_start": 2312,
      "token_end_exclusive": 2328
    },
    {
      "start_ms": 630160,
      "end_ms": 633740,
      "text": "带上家人打完了咱们接着讲前五名，",
      "token_start": 2328,
      "token_end_exclusive": 2343
    },
    {
      "start_ms": 633880,
      "end_ms": 635540,
      "text": "一个比一个让人心里发热。",
      "token_start": 2343,
      "token_end_exclusive": 2354
    },
    {
      "start_ms": 637220,
      "end_ms": 641660,
      "text": "今天讲的这五个您品品青海湖铺一张毯子，",
      "token_start": 2354,
      "token_end_exclusive": 2372
    },
    {
      "start_ms": 641660,
      "end_ms": 642540,
      "text": "往湖边一坐，",
      "token_start": 2372,
      "token_end_exclusive": 2377
    },
    {
      "start_ms": 642560,
      "end_ms": 643560,
      "text": "谁都不用费劲。",
      "token_start": 2377,
      "token_end_exclusive": 2383
    },
    {
      "start_ms": 644400,
      "end_ms": 647800,
      "text": "凤凰古城一家人在江边吃着小鱼看着乌篷船，",
      "token_start": 2383,
      "token_end_exclusive": 2402
    },
    {
      "start_ms": 647800,
      "end_ms": 648640,
      "text": "觉得不是旅游，",
      "token_start": 2402,
      "token_end_exclusive": 2408
    },
    {
      "start_ms": 648640,
      "end_ms": 650880,
      "text": "是过日子黄果树瀑布，",
      "token_start": 2408,
      "token_end_exclusive": 2417
    },
    {
      "start_ms": 650880,
      "end_ms": 652180,
      "text": "不用爬一记台阶，",
      "token_start": 2417,
      "token_end_exclusive": 2424
    },
    {
      "start_ms": 652180,
      "end_ms": 654185,
      "text": "就把您送到水帘洞跟前，",
      "token_start": 2424,
      "token_end_exclusive": 2434
    },
    {
      "start_ms": 654930,
      "end_ms": 656250,
      "text": "西安让一家人回来。",
      "token_start": 2434,
      "token_end_exclusive": 2442
    },
    {
      "start_ms": 656250,
      "end_ms": 657975,
      "text": "能多聊好几个月的话题，",
      "token_start": 2442,
      "token_end_exclusive": 2452
    },
    {
      "start_ms": 658650,
      "end_ms": 660110,
      "text": "张家界一部电梯，",
      "token_start": 2452,
      "token_end_exclusive": 2459
    },
    {
      "start_ms": 660130,
      "end_ms": 663035,
      "text": "直接把三千根石柱送到您眼前。",
      "token_start": 2459,
      "token_end_exclusive": 2472
    },
    {
      "start_ms": 663650,
      "end_ms": 668625,
      "text": "可这五个加一块都比不过前五名里那个让人心里一紧的地方。",
      "token_start": 2472,
      "token_end_exclusive": 2498
    },
    {
      "start_ms": 669220,
      "end_ms": 671095,
      "text": "前五名里有一座岛，",
      "token_start": 2498,
      "token_end_exclusive": 2506
    },
    {
      "start_ms": 671370,
      "end_ms": 673270,
      "text": "带着家里人坐在沙滩上看，",
      "token_start": 2506,
      "token_end_exclusive": 2517
    },
    {
      "start_ms": 673270,
      "end_ms": 674070,
      "text": "日落的时候，",
      "token_start": 2517,
      "token_end_exclusive": 2522
    },
    {
      "start_ms": 674230,
      "end_ms": 676230,
      "text": "风是咸的浪声，",
      "token_start": 2522,
      "token_end_exclusive": 2528
    },
    {
      "start_ms": 676310,
      "end_ms": 678545,
      "text": "刚好能把手机里的消息盖住。",
      "token_start": 2528,
      "token_end_exclusive": 2540
    },
    {
      "start_ms": 679180,
      "end_ms": 681100,
      "text": "有一个地方带老人进去以后，",
      "token_start": 2540,
      "token_end_exclusive": 2552
    },
    {
      "start_ms": 681380,
      "end_ms": 683515,
      "text": "走着走着说话声自己就小了。",
      "token_start": 2552,
      "token_end_exclusive": 2564
    },
    {
      "start_ms": 683940,
      "end_ms": 684540,
      "text": "出来以后，",
      "token_start": 2564,
      "token_end_exclusive": 2568
    },
    {
      "start_ms": 684540,
      "end_ms": 686135,
      "text": "老人的眼眶是红的，",
      "token_start": 2568,
      "token_end_exclusive": 2576
    },
    {
      "start_ms": 686550,
      "end_ms": 687370,
      "text": "还有一个地方，",
      "token_start": 2576,
      "token_end_exclusive": 2582
    },
    {
      "start_ms": 687410,
      "end_ms": 689965,
      "text": "墙上的颜色正在一天一天的褪。",
      "token_start": 2582,
      "token_end_exclusive": 2595
    },
    {
      "start_ms": 690430,
      "end_ms": 691875,
      "text": "据研究人员监测，",
      "token_start": 2595,
      "token_end_exclusive": 2602
    },
    {
      "start_ms": 692750,
      "end_ms": 693710,
      "text": "再过几十年，",
      "token_start": 2602,
      "token_end_exclusive": 2607
    },
    {
      "start_ms": 693710,
      "end_ms": 695730,
      "text": "有些画面可能就彻底看不清了。",
      "token_start": 2607,
      "token_end_exclusive": 2620
    },
    {
      "start_ms": 695730,
      "end_ms": 697050,
      "text": "再不带家人去看一眼，",
      "token_start": 2620,
      "token_end_exclusive": 2629
    },
    {
      "start_ms": 697050,
      "end_ms": 698115,
      "text": "真的就没了。",
      "token_start": 2629,
      "token_end_exclusive": 2634
    },
    {
      "start_ms": 699520,
      "end_ms": 703670,
      "text": "下一集已经同步更新了点，",
      "token_start": 2634,
      "token_end_exclusive": 2645
    },
    {
      "start_ms": 703690,
      "end_ms": 706735,
      "text": "我头像进主页第一条，",
      "token_start": 2645,
      "token_end_exclusive": 2654
    },
    {
      "start_ms": 707250,
      "end_ms": 711275,
      "text": "就是咱们接着接前五名。",
      "token_start": 2654,
      "token_end_exclusive": 2664
    }
  ],
