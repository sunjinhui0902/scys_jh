{
  "video_id": "v_3ed9e1106acc15f8",
  "duration_s": 365.227007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_3ed9e1106acc15f8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_3ed9e1106acc15f8.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 490,
      "end_ms": 6010,
      "text": "你知道北京故宫里头老祖宗手艺登峰造极的宝贝都有哪些吗？",
      "token_start": 0,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6750,
      "end_ms": 10550,
      "text": "很多人第一反应想到翠玉白菜毛公鼎，",
      "token_start": 26,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 11110,
      "end_ms": 14090,
      "text": "可这两件文物并不收藏在北京故宫，",
      "token_start": 42,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 14450,
      "end_ms": 16770,
      "text": "而是藏于台北故宫博物院。",
      "token_start": 57,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 17490,
      "end_ms": 18630,
      "text": "有一件国宝，",
      "token_start": 68,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 19050,
      "end_ms": 21450,
      "text": "几乎每个中国人都听过它的名字，",
      "token_start": 73,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 21450,
      "end_ms": 24270,
      "text": "却很少有人亲眼见过实物。",
      "token_start": 87,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 24270,
      "end_ms": 26530,
      "text": "它历经五次劫难，",
      "token_start": 98,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 26530,
      "end_ms": 28150,
      "text": "四次流离宫外，",
      "token_start": 105,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 28150,
      "end_ms": 29410,
      "text": "几经辗转，",
      "token_start": 111,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 29410,
      "end_ms": 34720,
      "text": "最最后竟然是在一堆被视作赝品的古画之中被重新发现。",
      "token_start": 115,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 35580,
      "end_ms": 36040,
      "text": "今天，",
      "token_start": 139,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 36380,
      "end_ms": 41060,
      "text": "我们就一起来盘点故宫十件巧夺天工的传世国宝，",
      "token_start": 141,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 41620,
      "end_ms": 45360,
      "text": "每一件都承载一段险些失传的往事，",
      "token_start": 162,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 46139,
      "end_ms": 48660,
      "text": "排在第十名的就是象牙席。",
      "token_start": 177,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 49640,
      "end_ms": 51360,
      "text": "倘若不曾亲眼见过，",
      "token_start": 188,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 51660,
      "end_ms": 57040,
      "text": "很难想象夏日纳凉的凉席居然是用整根象牙编织而成，",
      "token_start": 196,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 57460,
      "end_ms": 62705,
      "text": "这是何等高超的古代记艺象牙质地坚硬又脆，",
      "token_start": 219,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 63070,
      "end_ms": 64410,
      "text": "普通人很难想象，",
      "token_start": 238,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 64550,
      "end_ms": 69510,
      "text": "他能被劈成细软面条编织成席清代宫廷匠人，",
      "token_start": 245,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 69610,
      "end_ms": 70965,
      "text": "掌握独门工艺，",
      "token_start": 264,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 71290,
      "end_ms": 71710,
      "text": "用药，",
      "token_start": 270,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 71710,
      "end_ms": 72410,
      "text": "水软化，",
      "token_start": 272,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 72410,
      "end_ms": 75045,
      "text": "象牙披成薄如纱线的细面，",
      "token_start": 275,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 75540,
      "end_ms": 77025,
      "text": "编织为人字纹样，",
      "token_start": 286,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 77710,
      "end_ms": 79290,
      "text": "睡上去温润清凉，",
      "token_start": 293,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 79570,
      "end_ms": 81070,
      "text": "还能如同绸缎一般，",
      "token_start": 300,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 81170,
      "end_ms": 82275,
      "text": "随意卷收，",
      "token_start": 308,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 83210,
      "end_ms": 86955,
      "text": "可这般绝顶手艺却被一纸圣旨叫停。",
      "token_start": 312,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 87510,
      "end_ms": 90710,
      "text": "雍正皇帝、体恤物力耗费巨大下，",
      "token_start": 327,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 90730,
      "end_ms": 92765,
      "text": "旨禁止在制作象牙席。",
      "token_start": 340,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 93390,
      "end_ms": 94465,
      "text": "这道诏令一出，",
      "token_start": 349,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 94740,
      "end_ms": 97560,
      "text": "民间再也不敢制作这项技艺，",
      "token_start": 355,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 97680,
      "end_ms": 99345,
      "text": "就此彻底失传。",
      "token_start": 367,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 100200,
      "end_ms": 101105,
      "text": "时至今日，",
      "token_start": 373,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 101450,
      "end_ms": 106880,
      "text": "全世界留存下来的象牙席仅有三张故宫这件两米多长，",
      "token_start": 377,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 107140,
      "end_ms": 108420,
      "text": "历经两百余年，",
      "token_start": 400,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 108420,
      "end_ms": 109760,
      "text": "岁月席上，",
      "token_start": 406,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 109760,
      "end_ms": 111135,
      "text": "面条完好无损，",
      "token_start": 410,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 112110,
      "end_ms": 113535,
      "text": "匠人早已远去，",
      "token_start": 416,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 114040,
      "end_ms": 117180,
      "text": "但这份巧夺天工的手艺得以留存。",
      "token_start": 422,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 117240,
      "end_ms": 121275,
      "text": "后世排在第九位的金嵌珍珠天球仪，",
      "token_start": 436,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 121700,
      "end_ms": 125845,
      "text": "可以说真正做到以器物描摹浩瀚星河。",
      "token_start": 451,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 126780,
      "end_ms": 128985,
      "text": "这件器物诞生于乾隆时期，",
      "token_start": 467,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 129490,
      "end_ms": 131370,
      "text": "通体以纯金打造球体，",
      "token_start": 478,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 131690,
      "end_ms": 134090,
      "text": "上面镶嵌数千颗珍珠标记，",
      "token_start": 487,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 134110,
      "end_ms": 135770,
      "text": "星辰位置完整，",
      "token_start": 498,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 135790,
      "end_ms": 136595,
      "text": "复刻星象，",
      "token_start": 504,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 137370,
      "end_ms": 139105,
      "text": "没有现代天文设备，",
      "token_start": 508,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 139510,
      "end_ms": 142275,
      "text": "古代匠人仅凭一代代观测积累，",
      "token_start": 516,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 142520,
      "end_ms": 145805,
      "text": "把整片星空浓缩在一只金球之上。",
      "token_start": 529,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 146250,
      "end_ms": 148850,
      "text": "九条金龙托起球体工艺，",
      "token_start": 543,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 148950,
      "end_ms": 151935,
      "text": "繁复精美两百多年，",
      "token_start": 553,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 152350,
      "end_ms": 154765,
      "text": "他一直安放在紫禁城之中。",
      "token_start": 561,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 155200,
      "end_ms": 156825,
      "text": "今天到故宫珍宝馆，",
      "token_start": 572,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 157140,
      "end_ms": 158495,
      "text": "站在这件文物面前，",
      "token_start": 580,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 158780,
      "end_ms": 161835,
      "text": "就如同将漫天银河捧于掌心。",
      "token_start": 588,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 162350,
      "end_ms": 164070,
      "text": "这份古人独有的浪漫，",
      "token_start": 600,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 164270,
      "end_ms": 165905,
      "text": "令人心生感叹。",
      "token_start": 609,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 166760,
      "end_ms": 169535,
      "text": "第八件就是大名鼎鼎的慈母，",
      "token_start": 615,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 169940,
      "end_ms": 171405,
      "text": "各种釉彩大屏。",
      "token_start": 627,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 172200,
      "end_ms": 173455,
      "text": "为什么叫慈母？",
      "token_start": 633,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 174230,
      "end_ms": 175010,
      "text": "乾隆时期，",
      "token_start": 639,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 175010,
      "end_ms": 180945,
      "text": "工匠把十几种截然不同的釉材集中烧制在一只大型瓷瓶之上。",
      "token_start": 643,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 181550,
      "end_ms": 184555,
      "text": "青花、粉彩、窑变鸽釉，",
      "token_start": 669,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 185120,
      "end_ms": 186360,
      "text": "每一种釉料烧制，",
      "token_start": 677,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 186360,
      "end_ms": 188055,
      "text": "温度都各不相同，",
      "token_start": 684,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 188510,
      "end_ms": 191095,
      "text": "要在同一件器物上全部烧成功，",
      "token_start": 691,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 191410,
      "end_ms": 193405,
      "text": "难度堪称登天之难。",
      "token_start": 704,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 194310,
      "end_ms": 195275,
      "text": "稍有温差，",
      "token_start": 712,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 195620,
      "end_ms": 197725,
      "text": "整件器物就直接报废，",
      "token_start": 716,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 198360,
      "end_ms": 199945,
      "text": "存世仅此一件，",
      "token_start": 725,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 200580,
      "end_ms": 201395,
      "text": "一只瓶子，",
      "token_start": 731,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 201730,
      "end_ms": 204675,
      "text": "几乎极其古代陶瓷的万千风华，",
      "token_start": 735,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 205140,
      "end_ms": 207545,
      "text": "称得上一部立体的陶瓷史书。",
      "token_start": 748,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 208310,
      "end_ms": 209135,
      "text": "第七名，",
      "token_start": 760,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 209660,
      "end_ms": 213105,
      "text": "金发塔藏着一代帝王的孝心。",
      "token_start": 763,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 214010,
      "end_ms": 217045,
      "text": "乾隆的生母重庆皇太后过世之后，",
      "token_start": 775,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 217390,
      "end_ms": 219650,
      "text": "乾隆为安放母亲遗留的发丝，",
      "token_start": 789,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 219970,
      "end_ms": 222145,
      "text": "下令打造这座鎏金宝塔。",
      "token_start": 801,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 222730,
      "end_ms": 226150,
      "text": "塔身耗费数千两黄金镶嵌无数，",
      "token_start": 811,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 226250,
      "end_ms": 229955,
      "text": "珠宝塔不大却重于百斤，",
      "token_start": 824,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 230470,
      "end_ms": 232015,
      "text": "世间珍宝无数。",
      "token_start": 834,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 232540,
      "end_ms": 236785,
      "text": "但这一座金塔承载的是帝王对母亲的思念，",
      "token_start": 840,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 237570,
      "end_ms": 240690,
      "text": "真正珍贵的从不是黄金珠宝，",
      "token_start": 858,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 241050,
      "end_ms": 243135,
      "text": "而是这份人间亲情。",
      "token_start": 870,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 244160,
      "end_ms": 247065,
      "text": "第六件乾隆田黄三联印，",
      "token_start": 878,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 247460,
      "end_ms": 248845,
      "text": "命运最为跌宕，",
      "token_start": 888,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 249740,
      "end_ms": 251460,
      "text": "自古便有一两田黄。",
      "token_start": 894,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 251520,
      "end_ms": 252755,
      "text": "十、两斤的说法，",
      "token_start": 902,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 253310,
      "end_ms": 256410,
      "text": "整块名贵田黄石不拆分做印章，",
      "token_start": 908,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 256690,
      "end_ms": 257950,
      "text": "而是一体漏雕，",
      "token_start": 921,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 258350,
      "end_ms": 259730,
      "text": "做出三方印章，",
      "token_start": 927,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 259890,
      "end_ms": 261535,
      "text": "还保留相连的石链，",
      "token_start": 933,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 261880,
      "end_ms": 262840,
      "text": "环环相扣，",
      "token_start": 941,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 262980,
      "end_ms": 264325,
      "text": "没有一丝拼接，",
      "token_start": 945,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 264930,
      "end_ms": 265735,
      "text": "稍有不慎，",
      "token_start": 951,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 265980,
      "end_ms": 268675,
      "text": "整块西式石料便彻底损毁。",
      "token_start": 955,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 269500,
      "end_ms": 270380,
      "text": "一九二四年，",
      "token_start": 966,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 270400,
      "end_ms": 271840,
      "text": "溥仪被赶出紫禁城，",
      "token_start": 971,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 272260,
      "end_ms": 274005,
      "text": "无数珍宝来不及带走，",
      "token_start": 979,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 274250,
      "end_ms": 275675,
      "text": "唯独这枚三联印，",
      "token_start": 988,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 275950,
      "end_ms": 278835,
      "text": "被他缝进棉衣夹层贴身保管，",
      "token_start": 995,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 279670,
      "end_ms": 281485,
      "text": "辗转天津东北，",
      "token_start": 1007,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 281830,
      "end_ms": 284165,
      "text": "哪怕深陷抚顺战犯管理所。",
      "token_start": 1013,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 284570,
      "end_ms": 286825,
      "text": "这枚印章一直贴身携带。",
      "token_start": 1024,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 287090,
      "end_ms": 288425,
      "text": "整整二十六年，",
      "token_start": 1034,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 288960,
      "end_ms": 290200,
      "text": "直到一九五零年，",
      "token_start": 1040,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 290380,
      "end_ms": 296285,
      "text": "溥仪才将这件国宝上交国家末代皇帝弄丢了万里江山。",
      "token_start": 1047,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 296710,
      "end_ms": 299950,
      "text": "却拼尽全力保住这件绝世国宝。",
      "token_start": 1070,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 300470,
      "end_ms": 301750,
      "text": "以上五件国宝，",
      "token_start": 1083,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 301930,
      "end_ms": 303670,
      "text": "每一件都写满传奇，",
      "token_start": 1089,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 304710,
      "end_ms": 306770,
      "text": "象牙席一道圣旨，",
      "token_start": 1097,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 306810,
      "end_ms": 308030,
      "text": "断绝一门绝技。",
      "token_start": 1104,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 308410,
      "end_ms": 311690,
      "text": "天球仪把漫天星辰收进金球，",
      "token_start": 1110,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 312230,
      "end_ms": 314850,
      "text": "慈母集万千瓷艺于一身，",
      "token_start": 1122,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 315350,
      "end_ms": 317850,
      "text": "金发塔藏着帝王的孝心。",
      "token_start": 1132,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 318410,
      "end_ms": 319410,
      "text": "田皇三联映，",
      "token_start": 1142,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 319630,
      "end_ms": 320470,
      "text": "历经战火，",
      "token_start": 1147,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 320630,
      "end_ms": 322450,
      "text": "被贴身守护二十六年。",
      "token_start": 1151,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 323270,
      "end_ms": 325330,
      "text": "而故宫国宝榜单前五，",
      "token_start": 1160,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 325710,
      "end_ms": 327220,
      "text": "同样各格个震撼，",
      "token_start": 1169,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 327740,
      "end_ms": 330200,
      "text": "有的是耗费重金从海外购回。",
      "token_start": 1176,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 330580,
      "end_ms": 331400,
      "text": "归来之时，",
      "token_start": 1188,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 331580,
      "end_ms": 333080,
      "text": "器物满身残破，",
      "token_start": 1192,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 333620,
      "end_ms": 334920,
      "text": "有的存世稀少，",
      "token_start": 1198,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 335180,
      "end_ms": 338280,
      "text": "国内大半馆藏都藏在北京故宫，",
      "token_start": 1204,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 338960,
      "end_ms": 340620,
      "text": "还有一件重达数吨，",
      "token_start": 1217,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 340920,
      "end_ms": 342340,
      "text": "从新疆一路跋涉，",
      "token_start": 1225,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 342400,
      "end_ms": 344260,
      "text": "三年才运抵京城。",
      "token_start": 1232,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 345100,
      "end_ms": 346120,
      "text": "至于那一件，",
      "token_start": 1239,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 346620,
      "end_ms": 349340,
      "text": "历经五次琉璃四次流出宫外，",
      "token_start": 1244,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 349700,
      "end_ms": 354980,
      "text": "最终于一堆尾作古画中重见天日的国宝究竟是什么？",
      "token_start": 1256,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 355840,
      "end_ms": 358315,
      "text": "最迎在评论区聊聊你的猜想。",
      "token_start": 1278,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 359110,
      "end_ms": 364945,
      "text": "下一期我们接着盘点故宫五大国宝揭晓这件传奇文物的故事。",
      "token_start": 1290,
      "token_end_exclusive": 1316
    }
  ],
