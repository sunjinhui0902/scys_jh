{
  "video_id": "v_8ea3bdec43adefd7",
  "duration_s": 579.339002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_8ea3bdec43adefd7.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_8ea3bdec43adefd7.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 1790,
      "text": "上一集咱们讲了故宫五个，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 1790,
      "end_ms": 3170,
      "text": "你绝对不知道的秘密。",
      "token_start": 11,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 3870,
      "end_ms": 8510,
      "text": "从第十个讲到了第六个有人在评论区说，",
      "token_start": 20,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 9250,
      "end_ms": 12150,
      "text": "一块地砖烧五年就已经够离谱了。",
      "token_start": 37,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 12590,
      "end_ms": 13470,
      "text": "可我跟您说，",
      "token_start": 51,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 13670,
      "end_ms": 17550,
      "text": "那个在前五里头只能排第九老五个，",
      "token_start": 56,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 17770,
      "end_ms": 18930,
      "text": "一个比一个邪门。",
      "token_start": 71,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 19650,
      "end_ms": 21090,
      "text": "第一个那个秘密。",
      "token_start": 78,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 22050,
      "end_ms": 25290,
      "text": "面对二零一二年北京最大的那场暴雨，",
      "token_start": 85,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 25590,
      "end_ms": 28630,
      "text": "全城都淹故宫一滴水没存。",
      "token_start": 101,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 29330,
      "end_ms": 30000,
      "text": "老规矩，",
      "token_start": 112,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 30220,
      "end_ms": 30900,
      "text": "开讲前，",
      "token_start": 115,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 31000,
      "end_ms": 38480,
      "text": "劳烦各位老友顺手点亮红心评论区打个来了让我看看今天又有多少知音来捧场。",
      "token_start": 118,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 39600,
      "end_ms": 40640,
      "text": "第五个秘密，",
      "token_start": 152,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 41540,
      "end_ms": 44120,
      "text": "故宫的门钉数量是有讲究的。",
      "token_start": 157,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 44900,
      "end_ms": 46319,
      "text": "您去故宫的时候，",
      "token_start": 169,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 46440,
      "end_ms": 47460,
      "text": "可能注意过，",
      "token_start": 176,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 47920,
      "end_ms": 51180,
      "text": "每扇大门上面都有一排排的圆铜钉，",
      "token_start": 181,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 52020,
      "end_ms": 55060,
      "text": "这些钉子不是随便钉的数量，",
      "token_start": 196,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 55120,
      "end_ms": 56040,
      "text": "是定死的。",
      "token_start": 208,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 56040,
      "end_ms": 61225,
      "text": "纵酒恒酒一扇门八十一颗为什么是酒？",
      "token_start": 212,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 62130,
      "end_ms": 64635,
      "text": "因为酒是最大的阳树，",
      "token_start": 228,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 65040,
      "end_ms": 67165,
      "text": "在古代代表最高等级。",
      "token_start": 237,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 67570,
      "end_ms": 70230,
      "text": "皇帝用酒清王只能用七，",
      "token_start": 246,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 70450,
      "end_ms": 72350,
      "text": "再往下只能用五肯，",
      "token_start": 256,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 72350,
      "end_ms": 73125,
      "text": "您知道吗？",
      "token_start": 264,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 73560,
      "end_ms": 75900,
      "text": "整个故宫有一扇门的门钉，",
      "token_start": 268,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 75980,
      "end_ms": 76720,
      "text": "不是九排，",
      "token_start": 279,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 76740,
      "end_ms": 77620,
      "text": "而是八排，",
      "token_start": 283,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 78040,
      "end_ms": 80415,
      "text": "纵九横八少了一排。",
      "token_start": 287,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 81200,
      "end_ms": 82765,
      "text": "这扇门就是东华门，",
      "token_start": 295,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 83330,
      "end_ms": 84455,
      "text": "为什么少一排？",
      "token_start": 303,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 85220,
      "end_ms": 87380,
      "text": "东华门是当年皇帝驾崩之后，",
      "token_start": 309,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 87380,
      "end_ms": 88185,
      "text": "出殡的门，",
      "token_start": 321,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 89090,
      "end_ms": 90645,
      "text": "棺材从这儿抬出去，",
      "token_start": 325,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 91270,
      "end_ms": 92805,
      "text": "因为走的是阴式，",
      "token_start": 333,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 93470,
      "end_ms": 95230,
      "text": "所以门丁用了偶数。",
      "token_start": 340,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 95290,
      "end_ms": 97685,
      "text": "八、不用杨树酒，",
      "token_start": 348,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 98350,
      "end_ms": 103075,
      "text": "一个门丁的数量变化背后是一整套生死规矩。",
      "token_start": 354,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 103820,
      "end_ms": 105345,
      "text": "您下次去故宫，",
      "token_start": 373,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 105670,
      "end_ms": 108570,
      "text": "可以专门数数东华门的门钉，",
      "token_start": 379,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 108710,
      "end_ms": 109955,
      "text": "确实是八排。",
      "token_start": 391,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 110270,
      "end_ms": 111215,
      "text": "第四个秘密。",
      "token_start": 396,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 111520,
      "end_ms": 113095,
      "text": "金水河不是直的，",
      "token_start": 401,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 113330,
      "end_ms": 114075,
      "text": "是弯的，",
      "token_start": 408,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 114690,
      "end_ms": 115875,
      "text": "弯的有讲究。",
      "token_start": 411,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 116320,
      "end_ms": 120175,
      "text": "故宫太和门前面有一条河叫内金水河，",
      "token_start": 416,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 120660,
      "end_ms": 122515,
      "text": "从西北角引进来，",
      "token_start": 432,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 122970,
      "end_ms": 125225,
      "text": "在太和门前拐了一个大弯，",
      "token_start": 439,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 125690,
      "end_ms": 127175,
      "text": "形状像一张弓。",
      "token_start": 450,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 127850,
      "end_ms": 130825,
      "text": "很多人以为这个弯是为了风水好看，",
      "token_start": 456,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 131260,
      "end_ms": 133820,
      "text": "其实不全是这条河，",
      "token_start": 471,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 133840,
      "end_ms": 136275,
      "text": "弯成弓形有一个实际功能，",
      "token_start": 479,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 136710,
      "end_ms": 139110,
      "text": "防刺客古代。",
      "token_start": 490,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 139110,
      "end_ms": 142465,
      "text": "如果有人要从正面冲进太和门，",
      "token_start": 495,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 142980,
      "end_ms": 144585,
      "text": "必须先过桥。",
      "token_start": 508,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 145540,
      "end_ms": 146600,
      "text": "河是弯的，",
      "token_start": 513,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 146640,
      "end_ms": 147695,
      "text": "桥也是弯的，",
      "token_start": 517,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 148100,
      "end_ms": 149255,
      "text": "起码冲不起来，",
      "token_start": 522,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 149570,
      "end_ms": 150445,
      "text": "必须减速。",
      "token_start": 528,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 151200,
      "end_ms": 156155,
      "text": "简述了两边埋伏的侍卫就有时间反应。",
      "token_start": 532,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 156960,
      "end_ms": 157440,
      "text": "同时，",
      "token_start": 548,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 157440,
      "end_ms": 159895,
      "text": "这条河还承担消防功能，",
      "token_start": 550,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 161350,
      "end_ms": 162625,
      "text": "故宫最怕火，",
      "token_start": 560,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 163130,
      "end_ms": 164035,
      "text": "一旦着了火，",
      "token_start": 565,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 164430,
      "end_ms": 167050,
      "text": "太监们直接从金水河里取水灭火，",
      "token_start": 570,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 167130,
      "end_ms": 168165,
      "text": "不用跑远路，",
      "token_start": 584,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 168840,
      "end_ms": 169580,
      "text": "一条河，",
      "token_start": 589,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 169980,
      "end_ms": 171000,
      "text": "又防刺客，",
      "token_start": 592,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 171000,
      "end_ms": 171540,
      "text": "又防火，",
      "token_start": 596,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 171540,
      "end_ms": 174695,
      "text": "还兼顾风水弯的每一寸都有道理。",
      "token_start": 599,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 175310,
      "end_ms": 176315,
      "text": "第三个秘密。",
      "token_start": 613,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 177190,
      "end_ms": 180065,
      "text": "太和殿里有一块金砖是活动的，",
      "token_start": 618,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 181030,
      "end_ms": 184030,
      "text": "太和殿是皇帝举行大典的地方，",
      "token_start": 631,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 184110,
      "end_ms": 186650,
      "text": "龙椅就摆在正中间龙椅。",
      "token_start": 644,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 186650,
      "end_ms": 188570,
      "text": "下面的地砖跟其他地方一样，",
      "token_start": 654,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 188570,
      "end_ms": 189445,
      "text": "都是金砖，",
      "token_start": 666,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 190260,
      "end_ms": 191120,
      "text": "可有传说，",
      "token_start": 670,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 191140,
      "end_ms": 192785,
      "text": "其中有一块是活动的。",
      "token_start": 674,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 193570,
      "end_ms": 196805,
      "text": "据说这块砖下面是一个暗道的入口，",
      "token_start": 683,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 197260,
      "end_ms": 199760,
      "text": "是皇帝在紧急情况下逃生。",
      "token_start": 698,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 199820,
      "end_ms": 203145,
      "text": "用这个说法有没有实锤呢？",
      "token_start": 709,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 203620,
      "end_ms": 205885,
      "text": "故宫博物院没有公开确认过，",
      "token_start": 720,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 206330,
      "end_ms": 207485,
      "text": "但也没有否认。",
      "token_start": 732,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 208250,
      "end_ms": 210605,
      "text": "二零零四年故宫大修的时候，",
      "token_start": 738,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 211050,
      "end_ms": 215985,
      "text": "工人在太和殿的地砖下面确实发现了多层砖体结构。",
      "token_start": 750,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 216350,
      "end_ms": 217410,
      "text": "最上面一层，",
      "token_start": 772,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 217410,
      "end_ms": 218990,
      "text": "金砖下面还有一层，",
      "token_start": 777,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 219010,
      "end_ms": 220170,
      "text": "再下面还有一层，",
      "token_start": 785,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 220410,
      "end_ms": 221975,
      "text": "一共叠了好几层。",
      "token_start": 792,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 222620,
      "end_ms": 224765,
      "text": "最早的那层砖是明代的，",
      "token_start": 799,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 225070,
      "end_ms": 226495,
      "text": "最上面的是清代。",
      "token_start": 809,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 227330,
      "end_ms": 228230,
      "text": "至于这些砖，",
      "token_start": 816,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 228250,
      "end_ms": 230405,
      "text": "下面到底有没有暗道，",
      "token_start": 821,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 231550,
      "end_ms": 235015,
      "text": "大修报告里没提六百年的老房子，",
      "token_start": 830,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 235410,
      "end_ms": 237145,
      "text": "地底下叠了好几层砖，",
      "token_start": 844,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 237660,
      "end_ms": 240960,
      "text": "最底下那层压着什么说不清楚，",
      "token_start": 853,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 241640,
      "end_ms": 243760,
      "text": "可皇帝住的地方留个后手，",
      "token_start": 866,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 244320,
      "end_ms": 245980,
      "text": "按常理推也不奇怪。",
      "token_start": 877,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 246520,
      "end_ms": 247480,
      "text": "第二个秘密，",
      "token_start": 885,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 247740,
      "end_ms": 249140,
      "text": "故宫的墙会传声，",
      "token_start": 890,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 249580,
      "end_ms": 252020,
      "text": "故宫里有些宫墙的设计非常特殊。",
      "token_start": 897,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 252200,
      "end_ms": 252920,
      "text": "据记载，",
      "token_start": 911,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 253180,
      "end_ms": 254360,
      "text": "皇帝的寝宫，",
      "token_start": 914,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 254400,
      "end_ms": 257940,
      "text": "周围的墙体比其他地方的墙要厚，",
      "token_start": 919,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 258660,
      "end_ms": 261780,
      "text": "有些墙体内部是中空的，",
      "token_start": 933,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 262420,
      "end_ms": 264820,
      "text": "这种设计不是为了省材料，",
      "token_start": 943,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 265120,
      "end_ms": 266860,
      "text": "而是一套声学机关。",
      "token_start": 954,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 267480,
      "end_ms": 270490,
      "text": "皇帝在里面说话的声音会被墙体体吸收，",
      "token_start": 962,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 270710,
      "end_ms": 271610,
      "text": "外面听不到。",
      "token_start": 979,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 272330,
      "end_ms": 274690,
      "text": "可如果有人在外面大声呼喊，",
      "token_start": 984,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 274690,
      "end_ms": 276270,
      "text": "或者发出异常响动，",
      "token_start": 996,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 276690,
      "end_ms": 278370,
      "text": "声音反而能传进去。",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 278870,
      "end_ms": 280110,
      "text": "为什么这么设计？",
      "token_start": 1012,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 280890,
      "end_ms": 281730,
      "text": "为了安全，",
      "token_start": 1019,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 282210,
      "end_ms": 283630,
      "text": "皇帝睡觉的时候，",
      "token_start": 1023,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 284010,
      "end_ms": 288050,
      "text": "门外的侍卫有什么异常情况能第一时间传进来。",
      "token_start": 1030,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 288150,
      "end_ms": 288570,
      "text": "同时，",
      "token_start": 1050,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 288570,
      "end_ms": 292275,
      "text": "皇帝在寝宫里跟大臣密谈的内容又不会外泄。",
      "token_start": 1052,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 293100,
      "end_ms": 297840,
      "text": "据说养心殿的墙体做过最精密的声学处理，",
      "token_start": 1071,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 298500,
      "end_ms": 299580,
      "text": "从雍正开始，",
      "token_start": 1089,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 299580,
      "end_ms": 301960,
      "text": "那就是皇帝日常办公的地方，",
      "token_start": 1094,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 302320,
      "end_ms": 305200,
      "text": "每天要跟大臣聊多少机密室墙，",
      "token_start": 1106,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 305320,
      "end_ms": 306160,
      "text": "要是不隔音，",
      "token_start": 1119,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 306240,
      "end_ms": 308080,
      "text": "可就全漏了一面。",
      "token_start": 1124,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 308100,
      "end_ms": 309680,
      "text": "看起来普普通通的墙，",
      "token_start": 1131,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 310160,
      "end_ms": 312980,
      "text": "里面藏着六百年前的声学设计。",
      "token_start": 1140,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 313900,
      "end_ms": 314360,
      "text": "好了，",
      "token_start": 1153,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 314780,
      "end_ms": 316140,
      "text": "前面九个讲完了，",
      "token_start": 1155,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 316300,
      "end_ms": 318060,
      "text": "现在该接第一个秘密。",
      "token_start": 1162,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 318600,
      "end_ms": 319480,
      "text": "第一个秘密。",
      "token_start": 1171,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 319480,
      "end_ms": 322140,
      "text": "故宫的排水系统这个排第一，",
      "token_start": 1176,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 322500,
      "end_ms": 323710,
      "text": "没有有任何争议。",
      "token_start": 1188,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 324530,
      "end_ms": 328390,
      "text": "故宫六百年经历了无数次暴雨洪水，",
      "token_start": 1195,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 328590,
      "end_ms": 332150,
      "text": "台风从来没有发生过一次内涝。",
      "token_start": 1210,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 332550,
      "end_ms": 334710,
      "text": "二零一二年七月二十一日，",
      "token_start": 1223,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 334710,
      "end_ms": 337710,
      "text": "北京遭遇了六十年一遇的特大暴雨。",
      "token_start": 1234,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 338490,
      "end_ms": 340590,
      "text": "全城一百多处积水，",
      "token_start": 1249,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 341270,
      "end_ms": 343710,
      "text": "地铁灌水汽车暴水，",
      "token_start": 1257,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 344410,
      "end_ms": 347650,
      "text": "可故宫里面干干净净雨停之后，",
      "token_start": 1265,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 347710,
      "end_ms": 350890,
      "text": "地面上的水半个小时之内就排完了，",
      "token_start": 1278,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 351130,
      "end_ms": 352235,
      "text": "怎么做到的？",
      "token_start": 1293,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 352520,
      "end_ms": 359755,
      "text": "三套系统第一套地面坡度故宫的整体地势是北高南低，",
      "token_start": 1298,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 360530,
      "end_ms": 362230,
      "text": "从神武门到午门，",
      "token_start": 1321,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 362230,
      "end_ms": 364265,
      "text": "有一个不到两米的落差，",
      "token_start": 1328,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 365020,
      "end_ms": 366995,
      "text": "您站在里面感觉是平的。",
      "token_start": 1338,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 367790,
      "end_ms": 370475,
      "text": "其实整个故宫在微微倾斜，",
      "token_start": 1348,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 370930,
      "end_ms": 372685,
      "text": "雨水自然往南流，",
      "token_start": 1359,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 373100,
      "end_ms": 375585,
      "text": "每个院落的地面也不是纯平的，",
      "token_start": 1366,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 375950,
      "end_ms": 376910,
      "text": "中间略高，",
      "token_start": 1379,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 376990,
      "end_ms": 377910,
      "text": "四周略低，",
      "token_start": 1383,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 378330,
      "end_ms": 379535,
      "text": "水往四边跑。",
      "token_start": 1387,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 380310,
      "end_ms": 385950,
      "text": "第二套明沟暗渠故宫里面有一套完整的沟渠系统，",
      "token_start": 1392,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 386290,
      "end_ms": 388775,
      "text": "总长度超过十五公里，",
      "token_start": 1413,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 389220,
      "end_ms": 391180,
      "text": "明沟走地面暗渠，",
      "token_start": 1422,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 391220,
      "end_ms": 394020,
      "text": "走地下雨水从地面流进明沟，",
      "token_start": 1429,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 394480,
      "end_ms": 396940,
      "text": "明沟接入暗渠暗渠，",
      "token_start": 1441,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 397020,
      "end_ms": 399635,
      "text": "最后全部汇入内金水河。",
      "token_start": 1449,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 400480,
      "end_ms": 402195,
      "text": "金水河把水带出故宫，",
      "token_start": 1459,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 402990,
      "end_ms": 405685,
      "text": "第三套吃手排水。",
      "token_start": 1468,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 406580,
      "end_ms": 408920,
      "text": "您去故宫可能见过台基，",
      "token_start": 1475,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 408920,
      "end_ms": 412065,
      "text": "上面一排排龙头模样的石雕，",
      "token_start": 1485,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 412560,
      "end_ms": 413760,
      "text": "那不是装饰品，",
      "token_start": 1497,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 414300,
      "end_ms": 415380,
      "text": "是排水口。",
      "token_start": 1503,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 416280,
      "end_ms": 423580,
      "text": "太和殿、中和殿、保和殿三大殿的台基上一共有一千一百四十二个吃首，",
      "token_start": 1507,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 424360,
      "end_ms": 426580,
      "text": "每个吃首的嘴巴都是中空的，",
      "token_start": 1536,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 426880,
      "end_ms": 430760,
      "text": "连着台基里面的排水管道一下大雨，",
      "token_start": 1548,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 430860,
      "end_ms": 433820,
      "text": "一千一百四十二条龙同时往外吐水，",
      "token_start": 1563,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 434200,
      "end_ms": 437040,
      "text": "场面壮观的跟千龙吐水一样，",
      "token_start": 1578,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 437700,
      "end_ms": 442410,
      "text": "这也是故宫最出名的鱼井三套系统套在一起，",
      "token_start": 1590,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 442830,
      "end_ms": 446470,
      "text": "从地面坡度到沟渠网络到台基排水，",
      "token_start": 1609,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 446950,
      "end_ms": 447970,
      "text": "层层叠叠，",
      "token_start": 1624,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 448150,
      "end_ms": 448990,
      "text": "滴水不漏。",
      "token_start": 1628,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 449830,
      "end_ms": 451810,
      "text": "六百年前的工匠没有计算机，",
      "token_start": 1632,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 451810,
      "end_ms": 452870,
      "text": "没有测量仪器，",
      "token_start": 1644,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 453150,
      "end_ms": 455990,
      "text": "就靠经验和手艺把这套系统设计出来。",
      "token_start": 1650,
      "token_end_exclusive": 1666
    },
    {
      "start_ms": 456410,
      "end_ms": 458310,
      "text": "到今天一个零件都没换过，",
      "token_start": 1666,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 458310,
      "end_ms": 458850,
      "text": "还在用。",
      "token_start": 1677,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 459270,
      "end_ms": 461550,
      "text": "二零一二年那场暴雨之后，",
      "token_start": 1680,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 461630,
      "end_ms": 465430,
      "text": "有记者去采访故宫的工作人员问他们怎么做到的？",
      "token_start": 1691,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 466270,
      "end_ms": 467830,
      "text": "工作人员说了一句话，",
      "token_start": 1712,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 468690,
      "end_ms": 469930,
      "text": "我们没做什么，",
      "token_start": 1721,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 470970,
      "end_ms": 473140,
      "text": "六百年前的人都做好了，",
      "token_start": 1727,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 473560,
      "end_ms": 475720,
      "text": "我们就是按时通一通沟。",
      "token_start": 1737,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 476400,
      "end_ms": 477800,
      "text": "这句话听着简单，",
      "token_start": 1747,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 478680,
      "end_ms": 483060,
      "text": "可您琢磨琢磨六百年前修的排水系统，",
      "token_start": 1754,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 483780,
      "end_ms": 486480,
      "text": "打败了六百年后修的城市排水。",
      "token_start": 1770,
      "token_end_exclusive": 1783
    },
    {
      "start_ms": 487300,
      "end_ms": 488980,
      "text": "不是今天的技术不行，",
      "token_start": 1783,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 489820,
      "end_ms": 492160,
      "text": "是那时候的人实在太讲究，",
      "token_start": 1792,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 492780,
      "end_ms": 494600,
      "text": "先在评论区打出四个字。",
      "token_start": 1803,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 495740,
      "end_ms": 499040,
      "text": "故宫秘密打完回来，",
      "token_start": 1813,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 499100,
      "end_ms": 501320,
      "text": "听最后一段十个秘密讲完了，",
      "token_start": 1821,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 501320,
      "end_ms": 502970,
      "text": "您回头再想想，",
      "token_start": 1833,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 503530,
      "end_ms": 505230,
      "text": "堂堂皇帝上厕所，",
      "token_start": 1839,
      "token_end_exclusive": 1846
    },
    {
      "start_ms": 505250,
      "end_ms": 508530,
      "text": "用便盆一块砖烧了五年，",
      "token_start": 1846,
      "token_end_exclusive": 1856
    },
    {
      "start_ms": 508530,
      "end_ms": 509550,
      "text": "比金子还贵。",
      "token_start": 1856,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 510450,
      "end_ms": 513910,
      "text": "九千九百九十九间半是编的猫，",
      "token_start": 1861,
      "token_end_exclusive": 1874
    },
    {
      "start_ms": 514190,
      "end_ms": 517210,
      "text": "在故宫值了六百年的斑四座，",
      "token_start": 1874,
      "token_end_exclusive": 1886
    },
    {
      "start_ms": 517230,
      "end_ms": 518470,
      "text": "角楼美到极致。",
      "token_start": 1886,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 518470,
      "end_ms": 521390,
      "text": "可没人知道谁设计的门钉少一排，",
      "token_start": 1892,
      "token_end_exclusive": 1906
    },
    {
      "start_ms": 521590,
      "end_ms": 523310,
      "text": "是因为那扇门走死人，",
      "token_start": 1906,
      "token_end_exclusive": 1915
    },
    {
      "start_ms": 523670,
      "end_ms": 525170,
      "text": "一条河弯成弓形，",
      "token_start": 1915,
      "token_end_exclusive": 1922
    },
    {
      "start_ms": 525170,
      "end_ms": 528750,
      "text": "是为了防刺客龙椅底下的砖叠了好几层，",
      "token_start": 1922,
      "token_end_exclusive": 1939
    },
    {
      "start_ms": 528770,
      "end_ms": 529890,
      "text": "不知道压着什么。",
      "token_start": 1939,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 530090,
      "end_ms": 534520,
      "text": "墙壁里面藏着隔音的机关排水系统，",
      "token_start": 1946,
      "token_end_exclusive": 1961
    },
    {
      "start_ms": 534520,
      "end_ms": 536380,
      "text": "六百年打败了现代城市。",
      "token_start": 1961,
      "token_end_exclusive": 1971
    },
    {
      "start_ms": 536520,
      "end_ms": 538060,
      "text": "这十个秘密加一块，",
      "token_start": 1971,
      "token_end_exclusive": 1979
    },
    {
      "start_ms": 538820,
      "end_ms": 540280,
      "text": "您说最厉害的是什么？",
      "token_start": 1979,
      "token_end_exclusive": 1988
    },
    {
      "start_ms": 540880,
      "end_ms": 543560,
      "text": "我觉得最厉害的不是哪一个设计有多巧妙，",
      "token_start": 1988,
      "token_end_exclusive": 2006
    },
    {
      "start_ms": 544160,
      "end_ms": 547320,
      "text": "而是六百年前那帮工匠做事的那股劲儿，",
      "token_start": 2006,
      "token_end_exclusive": 2023
    },
    {
      "start_ms": 547320,
      "end_ms": 549440,
      "text": "每一块砖、每一条沟，",
      "token_start": 2023,
      "token_end_exclusive": 2031
    },
    {
      "start_ms": 550020,
      "end_ms": 551960,
      "text": "每一根钉子都不糊弄。",
      "token_start": 2031,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 552320,
      "end_ms": 555060,
      "text": "这股劲到今今天还在替他们撑着。",
      "token_start": 2040,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 555060,
      "end_ms": 557820,
      "text": "这座城您去过故宫几次，",
      "token_start": 2054,
      "token_end_exclusive": 2064
    },
    {
      "start_ms": 558120,
      "end_ms": 559080,
      "text": "下次去的时候，",
      "token_start": 2064,
      "token_end_exclusive": 2070
    },
    {
      "start_ms": 559080,
      "end_ms": 560940,
      "text": "记得低头看看脚底下的砖，",
      "token_start": 2070,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 561600,
      "end_ms": 565970,
      "text": "抬头蜀门上的钉子走到太和门前，",
      "token_start": 2081,
      "token_end_exclusive": 2095
    },
    {
      "start_ms": 566110,
      "end_ms": 566810,
      "text": "停一停，",
      "token_start": 2095,
      "token_end_exclusive": 2098
    },
    {
      "start_ms": 566990,
      "end_ms": 568890,
      "text": "听金水河的水声。",
      "token_start": 2098,
      "token_end_exclusive": 2105
    },
    {
      "start_ms": 569050,
      "end_ms": 571590,
      "text": "故宫最好的东西不在掌柜里，",
      "token_start": 2105,
      "token_end_exclusive": 2117
    },
    {
      "start_ms": 571730,
      "end_ms": 575870,
      "text": "在脚底下和头顶上觉得有意思的话，",
      "token_start": 2117,
      "token_end_exclusive": 2132
    },
    {
      "start_ms": 575870,
      "end_ms": 576830,
      "text": "帮忙点个赞，",
      "token_start": 2132,
      "token_end_exclusive": 2137
    },
    {
      "start_ms": 576870,
      "end_ms": 577430,
      "text": "转个发，",
      "token_start": 2137,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 577590,
      "end_ms": 579225,
      "text": "咱们下一期接着聊。",
      "token_start": 2140,
      "token_end_exclusive": 2148
    }
