{
  "video_id": "v_e55cdcc6396cb15e",
  "duration_s": 611.892993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_e55cdcc6396cb15e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_e55cdcc6396cb15e.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 3630,
      "text": "你知道我国最适合过冬的十座小城是哪儿吗？",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 3970,
      "end_ms": 4550,
      "text": "有人说，",
      "token_start": 19,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4550,
      "end_ms": 5010,
      "text": "三亚，",
      "token_start": 22,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5210,
      "end_ms": 8470,
      "text": "有人说海口不是三亚过冬，",
      "token_start": 24,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8470,
      "end_ms": 9270,
      "text": "一个月光，",
      "token_start": 35,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9310,
      "end_ms": 10450,
      "text": "房租就五六千，",
      "token_start": 39,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10830,
      "end_ms": 13210,
      "text": "吃碗米粉都比老家贵一倍。",
      "token_start": 45,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 13650,
      "end_ms": 15130,
      "text": "海滩上人挤人，",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 15170,
      "end_ms": 19870,
      "text": "连个安静晒太阳的地方都找不着海口好一点。",
      "token_start": 62,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 20510,
      "end_ms": 22070,
      "text": "可每年一到冬天，",
      "token_start": 81,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 22150,
      "end_ms": 27030,
      "text": "全国的老人往那扎堆儿菜市场跟赶庙会似的，",
      "token_start": 88,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 27510,
      "end_ms": 29785,
      "text": "真正排榜首的那个小城。",
      "token_start": 107,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 30120,
      "end_ms": 31780,
      "text": "冬天均温十几度，",
      "token_start": 117,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 32060,
      "end_ms": 33700,
      "text": "满城的银杏黄了，",
      "token_start": 124,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 33700,
      "end_ms": 35020,
      "text": "像铺了一地金子，",
      "token_start": 131,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 35100,
      "end_ms": 37340,
      "text": "泡一次野温泉十来块钱。",
      "token_start": 138,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 37840,
      "end_ms": 41480,
      "text": "菜市场的蔬菜水果新鲜到您不想回家。",
      "token_start": 148,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 41900,
      "end_ms": 44940,
      "text": "关键是一个月的房租一千出头，",
      "token_start": 164,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 45240,
      "end_ms": 46319,
      "text": "到底是哪儿？",
      "token_start": 177,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 46900,
      "end_ms": 49740,
      "text": "从第十名开始倒着讲讲，",
      "token_start": 182,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 49740,
      "end_ms": 51840,
      "text": "到最后您自己盘算盘算，",
      "token_start": 192,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 52140,
      "end_ms": 53520,
      "text": "还是咱们的老规矩。",
      "token_start": 202,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 53880,
      "end_ms": 54520,
      "text": "开奖前，",
      "token_start": 210,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 54580,
      "end_ms": 57040,
      "text": "劳烦各位老友顺手点亮红心。",
      "token_start": 213,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 57300,
      "end_ms": 58840,
      "text": "评论区打个来了，",
      "token_start": 225,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 59180,
      "end_ms": 62595,
      "text": "讲我看看今天又有多少知音来捧场。",
      "token_start": 232,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 63020,
      "end_ms": 63800,
      "text": "第十名。",
      "token_start": 247,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 64040,
      "end_ms": 67260,
      "text": "广西北海北海很多人听过，",
      "token_start": 250,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 67320,
      "end_ms": 69885,
      "text": "可真正去住过一个冬天的人不多。",
      "token_start": 261,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 70320,
      "end_ms": 73485,
      "text": "大部分人对北海的印象就是银滩，",
      "token_start": 275,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 74130,
      "end_ms": 75525,
      "text": "觉得是个旅游城市，",
      "token_start": 289,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 75760,
      "end_ms": 76245,
      "text": "住不了。",
      "token_start": 297,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 76810,
      "end_ms": 77290,
      "text": "其实，",
      "token_start": 300,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 77310,
      "end_ms": 80405,
      "text": "北海的老城区跟旅游区是两个世界，",
      "token_start": 302,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 80870,
      "end_ms": 84470,
      "text": "老城区里有一条百年老街棋楼，",
      "token_start": 317,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 84470,
      "end_ms": 85515,
      "text": "一排排的立着，",
      "token_start": 330,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 85790,
      "end_ms": 87410,
      "text": "底下是卖早餐的，",
      "token_start": 336,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 87450,
      "end_ms": 88435,
      "text": "卖糖水的，",
      "token_start": 343,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 88660,
      "end_ms": 89220,
      "text": "卖海鲜，",
      "token_start": 347,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 89220,
      "end_ms": 89865,
      "text": "干货的，",
      "token_start": 350,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 90300,
      "end_ms": 91680,
      "text": "生活气息浓得很。",
      "token_start": 353,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 91880,
      "end_ms": 92280,
      "text": "冬天，",
      "token_start": 360,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 92360,
      "end_ms": 95115,
      "text": "北海的气温在十度到二十度之间，",
      "token_start": 362,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 95570,
      "end_ms": 96490,
      "text": "不用开暖气，",
      "token_start": 376,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 96630,
      "end_ms": 97970,
      "text": "也不用穿羽绒服，",
      "token_start": 381,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 98250,
      "end_ms": 99990,
      "text": "一件薄外套就够了。",
      "token_start": 388,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 100010,
      "end_ms": 103415,
      "text": "北海过冬最舒服的事儿是吃海鲜。",
      "token_start": 396,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 103920,
      "end_ms": 107145,
      "text": "冬天是北部湾海鲜最肥的时候，",
      "token_start": 410,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 107560,
      "end_ms": 109720,
      "text": "早上去市场买一斤花蟹，",
      "token_start": 423,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 109760,
      "end_ms": 110655,
      "text": "十来块钱，",
      "token_start": 433,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 111110,
      "end_ms": 112795,
      "text": "大虾二十来块一斤，",
      "token_start": 437,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 113250,
      "end_ms": 114505,
      "text": "回来自己蒸着吃，",
      "token_start": 445,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 114820,
      "end_ms": 116745,
      "text": "比在老家下馆子便宜，",
      "token_start": 452,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 117340,
      "end_ms": 117980,
      "text": "吃完了，",
      "token_start": 461,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 117980,
      "end_ms": 119200,
      "text": "沿着海边走走。",
      "token_start": 464,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 119440,
      "end_ms": 125060,
      "text": "冬天的银滩人少了大半儿海风不冷太阳暖暖的走一个，",
      "token_start": 470,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 125060,
      "end_ms": 126605,
      "text": "来回出一身微汗。",
      "token_start": 493,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 127120,
      "end_ms": 128105,
      "text": "租房的话，",
      "token_start": 500,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 128540,
      "end_ms": 131060,
      "text": "老城区一个月一千来块钱，",
      "token_start": 504,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 131260,
      "end_ms": 133685,
      "text": "能租到带厨房的一居室，",
      "token_start": 515,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 134600,
      "end_ms": 137240,
      "text": "一千块房租十来块的花蟹，",
      "token_start": 525,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 137360,
      "end_ms": 138865,
      "text": "冬天穿薄外套，",
      "token_start": 536,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 139300,
      "end_ms": 140520,
      "text": "北海排第十。",
      "token_start": 542,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 140640,
      "end_ms": 141520,
      "text": "不是它不好，",
      "token_start": 547,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 141840,
      "end_ms": 143700,
      "text": "是后面的更便宜，",
      "token_start": 552,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 143800,
      "end_ms": 144535,
      "text": "更安静。",
      "token_start": 559,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 145510,
      "end_ms": 146130,
      "text": "第九名，",
      "token_start": 562,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 146350,
      "end_ms": 147525,
      "text": "广西崇左，",
      "token_start": 565,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 148150,
      "end_ms": 151520,
      "text": "崇左在广西的西南角挨着越南，",
      "token_start": 569,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 151580,
      "end_ms": 153555,
      "text": "大部分人没听过这个名字。",
      "token_start": 582,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 153970,
      "end_ms": 155550,
      "text": "可要是说德天瀑布，",
      "token_start": 593,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 155570,
      "end_ms": 156910,
      "text": "您可能有点印象。",
      "token_start": 601,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 156990,
      "end_ms": 159255,
      "text": "德天瀑布就在崇左境内，",
      "token_start": 608,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 159780,
      "end_ms": 164935,
      "text": "崇左冬天的气温跟北海差不多十度到二十度之间，",
      "token_start": 618,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 165390,
      "end_ms": 168215,
      "text": "可崇左比北海安静十倍。",
      "token_start": 639,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 168690,
      "end_ms": 171445,
      "text": "这个城市不大街上没什么游客，",
      "token_start": 649,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 171970,
      "end_ms": 174325,
      "text": "生活节奏慢到什么程度呢？",
      "token_start": 662,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 174930,
      "end_ms": 176270,
      "text": "下午两三点钟，",
      "token_start": 673,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 176350,
      "end_ms": 178535,
      "text": "您去老城区的茶馆坐着，",
      "token_start": 679,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 179050,
      "end_ms": 182975,
      "text": "周围全是本地老人在喝茶聊天下象棋，",
      "token_start": 689,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 183460,
      "end_ms": 185565,
      "text": "茶是几块钱一壶的那种，",
      "token_start": 705,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 186140,
      "end_ms": 187735,
      "text": "坐一下午没人赶你。",
      "token_start": 715,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 188850,
      "end_ms": 191215,
      "text": "崇左的物价低到什么程度呢？",
      "token_start": 723,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 191560,
      "end_ms": 194245,
      "text": "菜市场的青菜一块多钱一斤，",
      "token_start": 735,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 194650,
      "end_ms": 195735,
      "text": "猪肉十来块，",
      "token_start": 747,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 196550,
      "end_ms": 203395,
      "text": "越南进来的热带水果、火龙果、百香果、芒果比别的地方便宜将近一半儿，",
      "token_start": 752,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 203710,
      "end_ms": 204970,
      "text": "租房更便宜，",
      "token_start": 781,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 205050,
      "end_ms": 209045,
      "text": "老城区一个月七八百就能租到不错的宜居室。",
      "token_start": 786,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 209620,
      "end_ms": 213630,
      "text": "崇左边儿上还有个名仕田园喀斯特的山，",
      "token_start": 805,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 213830,
      "end_ms": 216145,
      "text": "一座一座立在稻田边儿上。",
      "token_start": 822,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 216590,
      "end_ms": 217090,
      "text": "冬天，",
      "token_start": 833,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 217230,
      "end_ms": 219230,
      "text": "水稻收完了田里，",
      "token_start": 835,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 219230,
      "end_ms": 222170,
      "text": "空着远处的山在薄雾里面，",
      "token_start": 842,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 222390,
      "end_ms": 223675,
      "text": "安安静静的。",
      "token_start": 853,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 224140,
      "end_ms": 225380,
      "text": "您租个电动车，",
      "token_start": 858,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 225560,
      "end_ms": 227520,
      "text": "沿着田间小路骑一圈，",
      "token_start": 864,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 228090,
      "end_ms": 228910,
      "text": "前面是山，",
      "token_start": 873,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 228970,
      "end_ms": 232605,
      "text": "后面是山路上没人七八百的房租，",
      "token_start": 877,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 233080,
      "end_ms": 238670,
      "text": "几块钱的茶骑着电动车在山水里面转崇左过冬，",
      "token_start": 891,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 238990,
      "end_ms": 240370,
      "text": "花的是最少的钱，",
      "token_start": 911,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 240530,
      "end_ms": 243035,
      "text": "住的是最安静的地方。",
      "token_start": 918,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 243690,
      "end_ms": 244430,
      "text": "第八名，",
      "token_start": 927,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 244610,
      "end_ms": 252305,
      "text": "云南建水建水在云南红河州是一座有一千二百多年历史的古城，",
      "token_start": 930,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 253000,
      "end_ms": 254975,
      "text": "可跟大理、丽江比起来，",
      "token_start": 957,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 255390,
      "end_ms": 258375,
      "text": "建水的名气小到几乎没人提。",
      "token_start": 966,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 258900,
      "end_ms": 262875,
      "text": "建水冬天的气温在七度到二十度之间，",
      "token_start": 978,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 263340,
      "end_ms": 264840,
      "text": "白天晒着太阳能，",
      "token_start": 994,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 264860,
      "end_ms": 265625,
      "text": "穿单衣，",
      "token_start": 1001,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 265960,
      "end_ms": 267585,
      "text": "早晚加件外套，",
      "token_start": 1004,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 268050,
      "end_ms": 269865,
      "text": "这个温度不算最暖，",
      "token_start": 1010,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 270250,
      "end_ms": 272685,
      "text": "可见水剩在另一样东西吃。",
      "token_start": 1018,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 273280,
      "end_ms": 276500,
      "text": "建水最出名的是烤豆腐古城，",
      "token_start": 1029,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 276520,
      "end_ms": 278665,
      "text": "西门外有一条烧烤街，",
      "token_start": 1041,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 279130,
      "end_ms": 281895,
      "text": "街两边全是烤豆腐的摊子，",
      "token_start": 1050,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 282220,
      "end_ms": 286040,
      "text": "用炭火烤的小方块豆腐外面焦脆，",
      "token_start": 1061,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 286120,
      "end_ms": 290245,
      "text": "里面嫩蘸着当地的蘸水吃五毛钱一块儿。",
      "token_start": 1075,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 290570,
      "end_ms": 292870,
      "text": "您坐在摊子边儿上的小板凳上，",
      "token_start": 1092,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 293030,
      "end_ms": 294130,
      "text": "老板一边烤，",
      "token_start": 1105,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 294270,
      "end_ms": 297510,
      "text": "一边用小石子在您面前计数吃一块，",
      "token_start": 1110,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 297610,
      "end_ms": 298765,
      "text": "放一颗石子，",
      "token_start": 1125,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 299160,
      "end_ms": 301075,
      "text": "吃完了数十子算钱，",
      "token_start": 1130,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 301650,
      "end_ms": 303405,
      "text": "十块钱能吃到撑。",
      "token_start": 1138,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 303950,
      "end_ms": 306370,
      "text": "建水还有一条米鬼小火车，",
      "token_start": 1145,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 306850,
      "end_ms": 309850,
      "text": "轨距只有普通铁路的一半儿，",
      "token_start": 1156,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 309910,
      "end_ms": 314470,
      "text": "是法国人一百多年前修的滇越铁路的一段小火车。",
      "token_start": 1168,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 314670,
      "end_ms": 317350,
      "text": "从建水古城开到团山村，",
      "token_start": 1189,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 317770,
      "end_ms": 320090,
      "text": "沿途穿过田野和村庄，",
      "token_start": 1199,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 320570,
      "end_ms": 321470,
      "text": "速度很慢，",
      "token_start": 1208,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 322030,
      "end_ms": 324290,
      "text": "窗外的风慢慢吹进来。",
      "token_start": 1212,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 324630,
      "end_ms": 326070,
      "text": "坐一趟几十块钱，",
      "token_start": 1221,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 326370,
      "end_ms": 327570,
      "text": "不赶时间的话，",
      "token_start": 1228,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 327750,
      "end_ms": 331570,
      "text": "来回能做一个下午一千二百年的古城，",
      "token_start": 1234,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 331830,
      "end_ms": 333570,
      "text": "五毛钱一块的烤豆腐，",
      "token_start": 1250,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 334220,
      "end_ms": 335900,
      "text": "一百多年的小火车，",
      "token_start": 1259,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 336560,
      "end_ms": 339260,
      "text": "建水过冬过的不是暖和，",
      "token_start": 1267,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 339660,
      "end_ms": 342360,
      "text": "是一种旧旧的慢慢的日子。",
      "token_start": 1277,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 342840,
      "end_ms": 343800,
      "text": "第七名，",
      "token_start": 1288,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 344400,
      "end_ms": 350100,
      "text": "四川攀枝花四川攀枝花这个名字一说出来，",
      "token_start": 1291,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 350120,
      "end_ms": 354280,
      "text": "很多人第一反应是四川冬天不冷吗？",
      "token_start": 1309,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 354400,
      "end_ms": 354880,
      "text": "不冷。",
      "token_start": 1324,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 355660,
      "end_ms": 358640,
      "text": "攀枝花是中国非常特殊的一座城市，",
      "token_start": 1326,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 358640,
      "end_ms": 364135,
      "text": "它在四川最南端金沙江边上属于干热河谷期气候，",
      "token_start": 1341,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 364780,
      "end_ms": 368185,
      "text": "冬天的日均气温在十度到二十度之间，",
      "token_start": 1362,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 368610,
      "end_ms": 371105,
      "text": "日照时间跟三亚不相上下，",
      "token_start": 1378,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 371570,
      "end_ms": 374655,
      "text": "全年日照将近两千七百个小时。",
      "token_start": 1389,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 375220,
      "end_ms": 377440,
      "text": "您在成都冬天缩在屋里，",
      "token_start": 1402,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 377440,
      "end_ms": 378680,
      "text": "不想出门的时候，",
      "token_start": 1412,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 378900,
      "end_ms": 382415,
      "text": "同一个省的攀枝花正穿着短袖晒太阳，",
      "token_start": 1419,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 382910,
      "end_ms": 385890,
      "text": "攀枝花过冬最出名的是水果，",
      "token_start": 1435,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 386130,
      "end_ms": 390410,
      "text": "冬天正是攀枝花芒果的尾季和枇杷的旺季，",
      "token_start": 1447,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 390790,
      "end_ms": 392715,
      "text": "草莓也大量上市。",
      "token_start": 1465,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 393150,
      "end_ms": 393930,
      "text": "菜市场里，",
      "token_start": 1472,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 393950,
      "end_ms": 397490,
      "text": "冬天的水果品种比很多城市夏天还多，",
      "token_start": 1476,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 397850,
      "end_ms": 398930,
      "text": "而且便宜。",
      "token_start": 1492,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 398930,
      "end_ms": 400435,
      "text": "芒果几块钱一斤，",
      "token_start": 1496,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 400950,
      "end_ms": 402135,
      "text": "琵琶十来块，",
      "token_start": 1503,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 402700,
      "end_ms": 404235,
      "text": "草莓不到二十，",
      "token_start": 1508,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 404910,
      "end_ms": 407110,
      "text": "攀枝花还有一个别的过冬，",
      "token_start": 1514,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 407130,
      "end_ms": 408650,
      "text": "城市没有的东西，",
      "token_start": 1525,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 408670,
      "end_ms": 412145,
      "text": "阳光冬天走在攀枝花的街上，",
      "token_start": 1532,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 412500,
      "end_ms": 414815,
      "text": "阳光是直直照下来的，",
      "token_start": 1544,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 415350,
      "end_ms": 416190,
      "text": "晒在身上，",
      "token_start": 1553,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 416270,
      "end_ms": 417225,
      "text": "暖到骨头里，",
      "token_start": 1557,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 417550,
      "end_ms": 418985,
      "text": "干燥不潮湿。",
      "token_start": 1562,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 419710,
      "end_ms": 420530,
      "text": "当地人说，",
      "token_start": 1567,
      "token_end_exclusive": 1571
    },
    {
      "start_ms": 420550,
      "end_ms": 422950,
      "text": "攀枝花的冬天不穿棉袄，",
      "token_start": 1571,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 423110,
      "end_ms": 425055,
      "text": "穿衬衫不是吹牛，",
      "token_start": 1581,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 425460,
      "end_ms": 426235,
      "text": "是实话，",
      "token_start": 1588,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 426640,
      "end_ms": 427755,
      "text": "房租也不贵。",
      "token_start": 1591,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 428100,
      "end_ms": 430220,
      "text": "城区一个月一千出头，",
      "token_start": 1596,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 430560,
      "end_ms": 431760,
      "text": "一千块的房租，",
      "token_start": 1605,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 432060,
      "end_ms": 433380,
      "text": "穿衬衫的冬天，",
      "token_start": 1611,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 433660,
      "end_ms": 435220,
      "text": "几块钱一斤的芒果，",
      "token_start": 1617,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 435520,
      "end_ms": 438380,
      "text": "同一个四川成都和攀枝花，",
      "token_start": 1625,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 438700,
      "end_ms": 440205,
      "text": "简直是两个季节。",
      "token_start": 1636,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 441060,
      "end_ms": 441740,
      "text": "第六名，",
      "token_start": 1643,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 442040,
      "end_ms": 446320,
      "text": "云南盲氏、云南德宏州的州府盲市。",
      "token_start": 1646,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 446720,
      "end_ms": 448460,
      "text": "这个名字很多人没听过，",
      "token_start": 1660,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 448580,
      "end_ms": 450240,
      "text": "可要是说中缅边境，",
      "token_start": 1670,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 450260,
      "end_ms": 452045,
      "text": "您可能就有点方向感了。",
      "token_start": 1678,
      "token_end_exclusive": 1688
    },
    {
      "start_ms": 452430,
      "end_ms": 454715,
      "text": "芒市在云南的最西边，",
      "token_start": 1688,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 455140,
      "end_ms": 456380,
      "text": "离国境线不远。",
      "token_start": 1697,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 456600,
      "end_ms": 460580,
      "text": "芒市冬天的气温在十度到二十五度之间，",
      "token_start": 1703,
      "token_end_exclusive": 1720
    },
    {
      "start_ms": 460780,
      "end_ms": 463830,
      "text": "跟春天似的可忙市过冬。",
      "token_start": 1720,
      "token_end_exclusive": 1730
    },
    {
      "start_ms": 463970,
      "end_ms": 465930,
      "text": "最让人上瘾的不是温度，",
      "token_start": 1730,
      "token_end_exclusive": 1740
    },
    {
      "start_ms": 466170,
      "end_ms": 469070,
      "text": "是市场芒市的菜市场，",
      "token_start": 1740,
      "token_end_exclusive": 1749
    },
    {
      "start_ms": 469190,
      "end_ms": 471035,
      "text": "热闹的超出您想象。",
      "token_start": 1749,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 471470,
      "end_ms": 473900,
      "text": "因为靠近边境市场里面，",
      "token_start": 1757,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 473900,
      "end_ms": 475940,
      "text": "除了本地的蔬菜水果，",
      "token_start": 1767,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 476160,
      "end_ms": 482230,
      "text": "还有大量从境外过来的热带水果和香料、牛油果、山竹世家。",
      "token_start": 1776,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 482270,
      "end_ms": 487990,
      "text": "菠萝蜜品种多到您在别的城市很少能见着价格呢。",
      "token_start": 1800,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 488010,
      "end_ms": 489230,
      "text": "菠萝蜜十来块钱，",
      "token_start": 1821,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 489230,
      "end_ms": 490510,
      "text": "一大个牛油果，",
      "token_start": 1828,
      "token_end_exclusive": 1834
    },
    {
      "start_ms": 490550,
      "end_ms": 491290,
      "text": "三四块钱，",
      "token_start": 1834,
      "token_end_exclusive": 1838
    },
    {
      "start_ms": 491290,
      "end_ms": 493895,
      "text": "一个山竹五六块钱一斤。",
      "token_start": 1838,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 494290,
      "end_ms": 495735,
      "text": "您要是喜欢做饭，",
      "token_start": 1848,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 496030,
      "end_ms": 497310,
      "text": "芒市的菜市场，",
      "token_start": 1855,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 497370,
      "end_ms": 500785,
      "text": "能让您每天变着花样做一个月不重样。",
      "token_start": 1861,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 501200,
      "end_ms": 505655,
      "text": "王氏还有傣族的泼水广场、金塔、佛寺，",
      "token_start": 1877,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 506030,
      "end_ms": 510325,
      "text": "冬天街上到处是开的正旺的三角梅和凤凰花，",
      "token_start": 1892,
      "token_end_exclusive": 1911
    },
    {
      "start_ms": 510890,
      "end_ms": 518370,
      "text": "走在街上能听到傣语、缅语、普通话三种话交杂着烟火气浓的化不开。",
      "token_start": 1911,
      "token_end_exclusive": 1939
    },
    {
      "start_ms": 518790,
      "end_ms": 521175,
      "text": "租房一个月七八百到一千，",
      "token_start": 1939,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 521700,
      "end_ms": 523760,
      "text": "吃饭一天二三十块钱，",
      "token_start": 1950,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 523840,
      "end_ms": 524700,
      "text": "能吃的很好。",
      "token_start": 1959,
      "token_end_exclusive": 1964
    },
    {
      "start_ms": 524940,
      "end_ms": 525180,
      "text": "忙。",
      "token_start": 1964,
      "token_end_exclusive": 1965
    },
    {
      "start_ms": 525180,
      "end_ms": 527680,
      "text": "市过冬过的是一种边境小城，",
      "token_start": 1965,
      "token_end_exclusive": 1977
    },
    {
      "start_ms": 527800,
      "end_ms": 528620,
      "text": "特有的热闹，",
      "token_start": 1977,
      "token_end_exclusive": 1982
    },
    {
      "start_ms": 528640,
      "end_ms": 529875,
      "text": "不是游客的热闹，",
      "token_start": 1982,
      "token_end_exclusive": 1989
    },
    {
      "start_ms": 530160,
      "end_ms": 532460,
      "text": "是本地人过日子的那种热闹。",
      "token_start": 1989,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 532880,
      "end_ms": 535900,
      "text": "先在评论区打出四个字过冬，",
      "token_start": 2001,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 535940,
      "end_ms": 537410,
      "text": "秘境打完了，",
      "token_start": 2013,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 537410,
      "end_ms": 538845,
      "text": "咱们接着讲前五名，",
      "token_start": 2018,
      "token_end_exclusive": 2026
    },
    {
      "start_ms": 539240,
      "end_ms": 541340,
      "text": "一个比一个让人想直接订票。",
      "token_start": 2026,
      "token_end_exclusive": 2038
    },
    {
      "start_ms": 541840,
      "end_ms": 543480,
      "text": "今天讲的这五个城市，",
      "token_start": 2038,
      "token_end_exclusive": 2047
    },
    {
      "start_ms": 543500,
      "end_ms": 545860,
      "text": "您品品北海一千块房租，",
      "token_start": 2047,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 545940,
      "end_ms": 547355,
      "text": "加十来块的花蟹，",
      "token_start": 2057,
      "token_end_exclusive": 2064
    },
    {
      "start_ms": 547840,
      "end_ms": 549400,
      "text": "重做七八百的房租，",
      "token_start": 2064,
      "token_end_exclusive": 2072
    },
    {
      "start_ms": 549520,
      "end_ms": 551485,
      "text": "在山水里骑电动车，",
      "token_start": 2072,
      "token_end_exclusive": 2080
    },
    {
      "start_ms": 552210,
      "end_ms": 556610,
      "text": "建水五毛钱一块的烤豆腐配一千二百年的古城。",
      "token_start": 2080,
      "token_end_exclusive": 2100
    },
    {
      "start_ms": 556750,
      "end_ms": 561150,
      "text": "攀枝花穿着衬衫在四川过冬忙市七八百块钱，",
      "token_start": 2100,
      "token_end_exclusive": 2119
    },
    {
      "start_ms": 561250,
      "end_ms": 562090,
      "text": "住在边境，",
      "token_start": 2119,
      "token_end_exclusive": 2123
    },
    {
      "start_ms": 562110,
      "end_ms": 564485,
      "text": "吃一个月不重样的热带水果。",
      "token_start": 2123,
      "token_end_exclusive": 2135
    },
    {
      "start_ms": 564810,
      "end_ms": 567010,
      "text": "可这五个加一块儿都比不过，",
      "token_start": 2135,
      "token_end_exclusive": 2147
    },
    {
      "start_ms": 567010,
      "end_ms": 570370,
      "text": "前五名里那个一千块钱能泡一个冬天。",
      "token_start": 2147,
      "token_end_exclusive": 2163
    },
    {
      "start_ms": 570430,
      "end_ms": 571625,
      "text": "野温泉的地方，",
      "token_start": 2163,
      "token_end_exclusive": 2169
    },
    {
      "start_ms": 572080,
      "end_ms": 574775,
      "text": "前五名里有一个海南的小城，",
      "token_start": 2169,
      "token_end_exclusive": 2181
    },
    {
      "start_ms": 575310,
      "end_ms": 577725,
      "text": "房租是三亚的三分之一。",
      "token_start": 2181,
      "token_end_exclusive": 2191
    },
    {
      "start_ms": 578330,
      "end_ms": 579130,
      "text": "海滩上，",
      "token_start": 2191,
      "token_end_exclusive": 2194
    },
    {
      "start_ms": 579330,
      "end_ms": 583305,
      "text": "一个游客都没有有一个福建的城市，",
      "token_start": 2194,
      "token_end_exclusive": 2209
    },
    {
      "start_ms": 583930,
      "end_ms": 587190,
      "text": "闽南的烟火气比厦门浓十倍，",
      "token_start": 2209,
      "token_end_exclusive": 2221
    },
    {
      "start_ms": 587370,
      "end_ms": 589475,
      "text": "物价只有厦门的一半儿。",
      "token_start": 2221,
      "token_end_exclusive": 2231
    },
    {
      "start_ms": 589940,
      "end_ms": 592160,
      "text": "有一个地方冬天的空气好，",
      "token_start": 2231,
      "token_end_exclusive": 2242
    },
    {
      "start_ms": 592160,
      "end_ms": 593420,
      "text": "到您每天醒来。",
      "token_start": 2242,
      "token_end_exclusive": 2248
    },
    {
      "start_ms": 593420,
      "end_ms": 595325,
      "text": "第一件事儿是深呼吸，",
      "token_start": 2248,
      "token_end_exclusive": 2257
    },
    {
      "start_ms": 595830,
      "end_ms": 597445,
      "text": "还有一个边境小城，",
      "token_start": 2257,
      "token_end_exclusive": 2265
    },
    {
      "start_ms": 598070,
      "end_ms": 600250,
      "text": "山水比桂林安静十倍。",
      "token_start": 2265,
      "token_end_exclusive": 2274
    },
    {
      "start_ms": 600510,
      "end_ms": 602605,
      "text": "米粉比桂林还好吃，",
      "token_start": 2274,
      "token_end_exclusive": 2282
    },
    {
      "start_ms": 603260,
      "end_ms": 606250,
      "text": "下一集已经同步更新了点，",
      "token_start": 2282,
      "token_end_exclusive": 2293
    },
    {
      "start_ms": 606270,
      "end_ms": 608430,
      "text": "我头像进主页第一条，",
      "token_start": 2293,
      "token_end_exclusive": 2302
    },
    {
      "start_ms": 608570,
      "end_ms": 611795,
      "text": "就是咱们接着接前五名。",
      "token_start": 2302,
      "token_end_exclusive": 2312
    }
  ],
