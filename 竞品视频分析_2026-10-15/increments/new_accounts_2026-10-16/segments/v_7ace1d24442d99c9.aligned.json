{
  "video_id": "v_7ace1d24442d99c9",
  "duration_s": 574.95,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_7ace1d24442d99c9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_7ace1d24442d99c9.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 350,
      "end_ms": 3190,
      "text": "十分钟讲解阿里斯特基督教神学导论。",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3430,
      "end_ms": 7030,
      "text": "今天我们来看看牛津大学那位最不务正业的跨界奇人。",
      "token_start": 16,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 7290,
      "end_ms": 11390,
      "text": "阿里斯特麦格拉斯的基督教神学导论这部书有多牛？",
      "token_start": 39,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 11870,
      "end_ms": 12470,
      "text": "这么说吧，",
      "token_start": 61,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 12870,
      "end_ms": 14030,
      "text": "豆瓣评分九点一，",
      "token_start": 65,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 14250,
      "end_ms": 17670,
      "text": "被誉为神学领域普遍适用的教材佳作，",
      "token_start": 72,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 18150,
      "end_ms": 20790,
      "text": "一本教科书级别的著作能拿到这个分数。",
      "token_start": 88,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 20870,
      "end_ms": 21690,
      "text": "你见过几本？",
      "token_start": 105,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 21850,
      "end_ms": 22530,
      "text": "话不多说，",
      "token_start": 110,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 22550,
      "end_ms": 26110,
      "text": "我们现在就开始我们的主人公阿里斯特麦格拉斯，",
      "token_start": 114,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 26290,
      "end_ms": 29170,
      "text": "一九五三年出生在北爱尔兰贝尔法斯特，",
      "token_start": 135,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 29230,
      "end_ms": 33860,
      "text": "后来获得牛津大学神学、文学和分子生物物理学三个博士学位。",
      "token_start": 152,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 33920,
      "end_ms": 36020,
      "text": "他早年是个彻头彻尾的无神论者，",
      "token_start": 178,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 36240,
      "end_ms": 38700,
      "text": "还在大学里倾心于某种社会批判理论，",
      "token_start": 192,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 39000,
      "end_ms": 40980,
      "text": "觉得凡是科学回答不了的问题，",
      "token_start": 208,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 41000,
      "end_ms": 42360,
      "text": "都不值得认真对待。",
      "token_start": 221,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 42420,
      "end_ms": 44220,
      "text": "可就在牛津读化学的那些年，",
      "token_start": 229,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 44360,
      "end_ms": 45820,
      "text": "他的人生拐了一个大弯，",
      "token_start": 241,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 46000,
      "end_ms": 48460,
      "text": "他开始重新思考一个最根本的问题。",
      "token_start": 251,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 48720,
      "end_ms": 51640,
      "text": "这世界上除了可以被测量、被计算的东西之外，",
      "token_start": 266,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 51760,
      "end_ms": 53660,
      "text": "到底还有没有另一种真实？",
      "token_start": 285,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 54220,
      "end_ms": 55760,
      "text": "这个问题一旦钻进脑子，",
      "token_start": 296,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 55900,
      "end_ms": 57080,
      "text": "就再也拔不出来了。",
      "token_start": 306,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 57600,
      "end_ms": 58040,
      "text": "于是，",
      "token_start": 314,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 58120,
      "end_ms": 60775,
      "text": "他一边在实验室里研究分子生物物理，",
      "token_start": 316,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 61090,
      "end_ms": 64005,
      "text": "一边开始啃那些积满灰尘的思想史典籍。",
      "token_start": 332,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 64380,
      "end_ms": 67200,
      "text": "最终在二十二岁拿到分子生物学博士学位。",
      "token_start": 349,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 67200,
      "end_ms": 69700,
      "text": "之后又转向了思想的深水区，",
      "token_start": 367,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 69920,
      "end_ms": 71635,
      "text": "拿下了神学博士学位。",
      "token_start": 379,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 71970,
      "end_ms": 74030,
      "text": "他后来在牛津大学教了几十年书，",
      "token_start": 388,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 74230,
      "end_ms": 77765,
      "text": "把毕生所学浓缩成了一部基督教神学导论。",
      "token_start": 402,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 78290,
      "end_ms": 80975,
      "text": "这部书的写法跟一般的入门读物完全不同。",
      "token_start": 420,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 81330,
      "end_ms": 83245,
      "text": "他不急着告诉你结论是什么，",
      "token_start": 438,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 83570,
      "end_ms": 85535,
      "text": "而是像一个经验老道的侦探，",
      "token_start": 450,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 85860,
      "end_ms": 89020,
      "text": "把几千年思想史上那些最聪明的大脑怎么炒，",
      "token_start": 462,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 89300,
      "end_ms": 89885,
      "text": "怎么变，",
      "token_start": 481,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 90180,
      "end_ms": 92480,
      "text": "怎么推翻对方又重新建立的过程，",
      "token_start": 484,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 92760,
      "end_ms": 94240,
      "text": "一层一层给你剥开。",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 94320,
      "end_ms": 95255,
      "text": "那么问题来了，",
      "token_start": 506,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 95490,
      "end_ms": 97925,
      "text": "这部书到底是怎么把思想史看透的呢？",
      "token_start": 512,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 98330,
      "end_ms": 100015,
      "text": "这就要从书的结构说起。",
      "token_start": 528,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 100310,
      "end_ms": 101650,
      "text": "全书分三大部分，",
      "token_start": 538,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 101850,
      "end_ms": 103195,
      "text": "第一部分追踪历史，",
      "token_start": 545,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 103480,
      "end_ms": 105920,
      "text": "从最早的教父时期一路讲到现代。",
      "token_start": 553,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 106060,
      "end_ms": 107880,
      "text": "第二部分探讨来源和方法，",
      "token_start": 567,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 108080,
      "end_ms": 109620,
      "text": "也就是理性经验。",
      "token_start": 578,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 109740,
      "end_ms": 111260,
      "text": "传统这些工具怎么用？",
      "token_start": 585,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 111320,
      "end_ms": 114100,
      "text": "第三部分才进入核心主题的逐一切磋。",
      "token_start": 594,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 114220,
      "end_ms": 115040,
      "text": "你注意到没有？",
      "token_start": 610,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 115260,
      "end_ms": 116620,
      "text": "它不像一般的教科书那样，",
      "token_start": 616,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 116620,
      "end_ms": 117615,
      "text": "先给你灌概念，",
      "token_start": 627,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 117880,
      "end_ms": 119300,
      "text": "而是先带你走一遍历史。",
      "token_start": 633,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 119420,
      "end_ms": 119995,
      "text": "为什么？",
      "token_start": 643,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 120410,
      "end_ms": 121705,
      "text": "因为他太清楚了，",
      "token_start": 646,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 121990,
      "end_ms": 123965,
      "text": "思想不是从天上掉下来的，",
      "token_start": 653,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 124250,
      "end_ms": 128845,
      "text": "每一个看起来理所当然的结论背后都有一场你死我活的辩论道。",
      "token_start": 664,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 129130,
      "end_ms": 131435,
      "text": "我们现在来讲这部书最核心的一个问题，",
      "token_start": 691,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 131770,
      "end_ms": 133465,
      "text": "理性与信仰的关系。",
      "token_start": 708,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 133780,
      "end_ms": 135080,
      "text": "我换个说法你就明白了。",
      "token_start": 716,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 135080,
      "end_ms": 138620,
      "text": "麦格拉斯就像是一个在两座山头之间架桥的工程师，",
      "token_start": 726,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 138700,
      "end_ms": 139635,
      "text": "这头是理性，",
      "token_start": 748,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 139970,
      "end_ms": 141115,
      "text": "那一头是信仰。",
      "token_start": 753,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 141320,
      "end_ms": 143035,
      "text": "很多人以为这两座山是对立的，",
      "token_start": 759,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 143310,
      "end_ms": 146075,
      "text": "要么你站理信那边把信仰当成迷信扔掉。",
      "token_start": 772,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 146410,
      "end_ms": 149685,
      "text": "要么你在信仰这边把理性当成了傲慢的僭越。",
      "token_start": 789,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 150070,
      "end_ms": 151255,
      "text": "可麦德拉斯告诉你，",
      "token_start": 808,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 151490,
      "end_ms": 152485,
      "text": "事情没这么简单，",
      "token_start": 816,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 153190,
      "end_ms": 156050,
      "text": "他在书里专门写了一章叫哲学与神学。",
      "token_start": 823,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 156350,
      "end_ms": 157490,
      "text": "对话与争辩。",
      "token_start": 839,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 157630,
      "end_ms": 158875,
      "text": "这一章讲的是什么？",
      "token_start": 844,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 159300,
      "end_ms": 163780,
      "text": "讲的是两千多年来哲学和思想之间那些精彩的过招。",
      "token_start": 852,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 163920,
      "end_ms": 166785,
      "text": "从古希腊的苏格拉底到中世纪的经院哲学，",
      "token_start": 874,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 167180,
      "end_ms": 170180,
      "text": "从启蒙运动的理性主义到现代的存在主义，",
      "token_start": 892,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 170240,
      "end_ms": 172680,
      "text": "每一个时代的思想家都在问同一个问题，",
      "token_start": 910,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 172940,
      "end_ms": 175179,
      "text": "我到底能不能靠自己的脑子？",
      "token_start": 927,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 175200,
      "end_ms": 176705,
      "text": "想明白终极的问题。",
      "token_start": 939,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 176930,
      "end_ms": 179155,
      "text": "如果能那还需要别的什么吗？",
      "token_start": 947,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 179450,
      "end_ms": 180210,
      "text": "如果不能，",
      "token_start": 959,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 180490,
      "end_ms": 183110,
      "text": "那我凭什么相信那些超越我理解的东西？",
      "token_start": 963,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 183270,
      "end_ms": 184975,
      "text": "麦格拉斯的态度很有意思，",
      "token_start": 980,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 185250,
      "end_ms": 187375,
      "text": "他本身受过严格的自然科学训练，",
      "token_start": 991,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 187680,
      "end_ms": 189075,
      "text": "深知科学的威力。",
      "token_start": 1005,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 189530,
      "end_ms": 191365,
      "text": "但他也清醒的意识到一个界限，",
      "token_start": 1012,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 191660,
      "end_ms": 194555,
      "text": "科学处理的是可以被经验检验的问题。",
      "token_start": 1025,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 195010,
      "end_ms": 195950,
      "text": "而有些问题，",
      "token_start": 1041,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 196090,
      "end_ms": 197730,
      "text": "比如人为什么活着，",
      "token_start": 1046,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 197930,
      "end_ms": 199150,
      "text": "苦难有没有意义？",
      "token_start": 1054,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 199310,
      "end_ms": 200625,
      "text": "死亡之后是什么？",
      "token_start": 1061,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 200890,
      "end_ms": 203335,
      "text": "根本就不在科学的方法论射程之内。",
      "token_start": 1068,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 203670,
      "end_ms": 204890,
      "text": "你说这些问题不重要，",
      "token_start": 1083,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 205130,
      "end_ms": 208145,
      "text": "那你就等于说人生中最重要的那些时刻都不重要。",
      "token_start": 1092,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 208900,
      "end_ms": 212800,
      "text": "这就是全书的第一把密钥叫理性与信仰的张力。",
      "token_start": 1113,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 212920,
      "end_ms": 213860,
      "text": "麦格拉斯发现，",
      "token_start": 1133,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 214160,
      "end_ms": 216145,
      "text": "思想史上最伟大的那些头脑，",
      "token_start": 1139,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 216400,
      "end_ms": 219085,
      "text": "从来不是在理性和信仰之间二选一，",
      "token_start": 1151,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 219430,
      "end_ms": 222430,
      "text": "而是在两者的张力中找到了更深的洞见。",
      "token_start": 1166,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 222430,
      "end_ms": 224005,
      "text": "李性像一把锋利的刀，",
      "token_start": 1183,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 224270,
      "end_ms": 225450,
      "text": "他帮你切开迷雾，",
      "token_start": 1192,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 225610,
      "end_ms": 227025,
      "text": "看清逻辑的纹理，",
      "token_start": 1199,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 227580,
      "end_ms": 229120,
      "text": "信仰像一片辽阔的天。",
      "token_start": 1206,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 229460,
      "end_ms": 230780,
      "text": "他给你一个立足之处，",
      "token_start": 1215,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 231000,
      "end_ms": 232920,
      "text": "让你不至于在切完一切之后，",
      "token_start": 1224,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 232980,
      "end_ms": 234460,
      "text": "发现自己站在虚空之上。",
      "token_start": 1236,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 234700,
      "end_ms": 235805,
      "text": "两者不是敌人，",
      "token_start": 1246,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 236120,
      "end_ms": 238105,
      "text": "而是一对互相成全的老搭档。",
      "token_start": 1252,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 238470,
      "end_ms": 239750,
      "text": "你以为你只能选一个，",
      "token_start": 1264,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 239910,
      "end_ms": 242195,
      "text": "其实你每一步都在同时使用它们，",
      "token_start": 1273,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 242990,
      "end_ms": 245205,
      "text": "可光是理性和信仰的张力还不够。",
      "token_start": 1287,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 245800,
      "end_ms": 246525,
      "text": "有人会问了，",
      "token_start": 1301,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 246760,
      "end_ms": 247460,
      "text": "你说了半天，",
      "token_start": 1306,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 247460,
      "end_ms": 250955,
      "text": "思想史这些古代人的争论跟我们今天有什么关系？",
      "token_start": 1311,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 251520,
      "end_ms": 254340,
      "text": "这个问题问的好麦格拉斯在书里反复强调，",
      "token_start": 1332,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 254340,
      "end_ms": 254925,
      "text": "一个观点，",
      "token_start": 1350,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 255350,
      "end_ms": 260365,
      "text": "现时代的一切思想都建基于历史之上抽离开思想的历史。",
      "token_start": 1354,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 260630,
      "end_ms": 263605,
      "text": "你根本无法理解今天的人为什么这样想问题？",
      "token_start": 1378,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 263880,
      "end_ms": 267050,
      "text": "这就是第二把密钥叫历史与真理的追问。",
      "token_start": 1397,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 267110,
      "end_ms": 270515,
      "text": "麦格拉斯在书的第一部分专门梳理了四个大时代。",
      "token_start": 1414,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 270940,
      "end_ms": 274680,
      "text": "教父时期中世纪与文艺复兴改革时期，",
      "token_start": 1435,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 274880,
      "end_ms": 275700,
      "text": "现代时期，",
      "token_start": 1451,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 275760,
      "end_ms": 278805,
      "text": "每一个时代都有它的核心焦虑和核心答案。",
      "token_start": 1455,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 279090,
      "end_ms": 280325,
      "text": "教父时期的人在问，",
      "token_start": 1473,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 280630,
      "end_ms": 283970,
      "text": "这个新兴的思想体系跟古希腊哲学到底什么关系？",
      "token_start": 1481,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 284030,
      "end_ms": 285175,
      "text": "中世纪的人在问，",
      "token_start": 1502,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 285400,
      "end_ms": 287425,
      "text": "理性和启示能不能共存？",
      "token_start": 1509,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 287750,
      "end_ms": 288910,
      "text": "改革时期的人在问，",
      "token_start": 1519,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 289210,
      "end_ms": 291145,
      "text": "传统和原点谁说了算？",
      "token_start": 1527,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 291550,
      "end_ms": 294760,
      "text": "现代时期的人在问当一切都可以被怀疑的时候，",
      "token_start": 1536,
      "token_end_exclusive": 1556
    },
    {
      "start_ms": 294840,
      "end_ms": 295755,
      "text": "还剩什么？",
      "token_start": 1556,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 296270,
      "end_ms": 297085,
      "text": "你发现没有？",
      "token_start": 1560,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 297420,
      "end_ms": 298895,
      "text": "这些问题换了一副面孔。",
      "token_start": 1565,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 299290,
      "end_ms": 300930,
      "text": "但内核从来没有变过。",
      "token_start": 1575,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 301010,
      "end_ms": 303450,
      "text": "我们今天在社交媒体上争论的那些话题，",
      "token_start": 1584,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 303870,
      "end_ms": 306090,
      "text": "传统该不该保留权威，",
      "token_start": 1601,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 306110,
      "end_ms": 308710,
      "text": "能不能质疑个人经验算不算数？",
      "token_start": 1610,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 308890,
      "end_ms": 313630,
      "text": "本质上都是几百年前那些思想家用毕生精力在辩论的问题的翻版。",
      "token_start": 1623,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 313810,
      "end_ms": 314470,
      "text": "麦格拉斯，",
      "token_start": 1651,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 314470,
      "end_ms": 316730,
      "text": "把这些辩论的历史脉络给你理清楚，",
      "token_start": 1655,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 317030,
      "end_ms": 320030,
      "text": "你再看今天的事儿就不会觉得那么晕头转向了。",
      "token_start": 1670,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 320150,
      "end_ms": 322650,
      "text": "那这部书到底还有没有更具体的硬货？",
      "token_start": 1690,
      "token_end_exclusive": 1706
    },
    {
      "start_ms": 322950,
      "end_ms": 326010,
      "text": "当然有你翻到第二部分来源与方法。",
      "token_start": 1706,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 326510,
      "end_ms": 328430,
      "text": "麦格拉斯干了一件特别漂亮的事儿，",
      "token_start": 1721,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 328430,
      "end_ms": 332140,
      "text": "他把思想史上用来判断真伪的那几把尺子，",
      "token_start": 1736,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 332440,
      "end_ms": 334120,
      "text": "一把一把摆在你面前，",
      "token_start": 1754,
      "token_end_exclusive": 1763
    },
    {
      "start_ms": 334320,
      "end_ms": 335260,
      "text": "让你自己去量。",
      "token_start": 1763,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 335400,
      "end_ms": 336700,
      "text": "第一把尺子是文本，",
      "token_start": 1769,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 336980,
      "end_ms": 339380,
      "text": "就是那些被反复引用的原始文献，",
      "token_start": 1777,
      "token_end_exclusive": 1791
    },
    {
      "start_ms": 339720,
      "end_ms": 341240,
      "text": "他们是思想的源代码。",
      "token_start": 1791,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 341480,
      "end_ms": 342860,
      "text": "第二把尺子是理性，",
      "token_start": 1800,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 343160,
      "end_ms": 345060,
      "text": "就是逻辑和推论的能力。",
      "token_start": 1808,
      "token_end_exclusive": 1818
    },
    {
      "start_ms": 345360,
      "end_ms": 346860,
      "text": "他负责检验一套说法，",
      "token_start": 1818,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 346860,
      "end_ms": 348060,
      "text": "在内部是否自洽。",
      "token_start": 1827,
      "token_end_exclusive": 1834
    },
    {
      "start_ms": 348200,
      "end_ms": 348540,
      "text": "第三，",
      "token_start": 1834,
      "token_end_exclusive": 1836
    },
    {
      "start_ms": 348540,
      "end_ms": 349680,
      "text": "把尺子是传统，",
      "token_start": 1836,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 350020,
      "end_ms": 352480,
      "text": "就是历代积累下来的共识和争论。",
      "token_start": 1842,
      "token_end_exclusive": 1856
    },
    {
      "start_ms": 352840,
      "end_ms": 355300,
      "text": "他告诉你哪些路前人已经走过了，",
      "token_start": 1856,
      "token_end_exclusive": 1870
    },
    {
      "start_ms": 355340,
      "end_ms": 355900,
      "text": "哪些坑，",
      "token_start": 1870,
      "token_end_exclusive": 1873
    },
    {
      "start_ms": 355980,
      "end_ms": 357100,
      "text": "前人也踩过了。",
      "token_start": 1873,
      "token_end_exclusive": 1879
    },
    {
      "start_ms": 357180,
      "end_ms": 357520,
      "text": "第四，",
      "token_start": 1879,
      "token_end_exclusive": 1881
    },
    {
      "start_ms": 357520,
      "end_ms": 358440,
      "text": "把尺子是经验，",
      "token_start": 1881,
      "token_end_exclusive": 1887
    },
    {
      "start_ms": 358440,
      "end_ms": 360590,
      "text": "就是你作为一个活生生的人，",
      "token_start": 1887,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 360890,
      "end_ms": 362890,
      "text": "在实际生活里感受到的东西。",
      "token_start": 1899,
      "token_end_exclusive": 1911
    },
    {
      "start_ms": 362970,
      "end_ms": 364150,
      "text": "麦格拉斯没有告诉你，",
      "token_start": 1911,
      "token_end_exclusive": 1920
    },
    {
      "start_ms": 364150,
      "end_ms": 365325,
      "text": "哪把尺子最好用。",
      "token_start": 1920,
      "token_end_exclusive": 1927
    },
    {
      "start_ms": 365730,
      "end_ms": 367285,
      "text": "他把四把尺子都递给你，",
      "token_start": 1927,
      "token_end_exclusive": 1937
    },
    {
      "start_ms": 367490,
      "end_ms": 369025,
      "text": "然后说你自己掂量，",
      "token_start": 1937,
      "token_end_exclusive": 1945
    },
    {
      "start_ms": 369590,
      "end_ms": 371155,
      "text": "这是一种特别高级的写法，",
      "token_start": 1945,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 371600,
      "end_ms": 374300,
      "text": "他不告诉你怎么想他让你自己学会。",
      "token_start": 1956,
      "token_end_exclusive": 1971
    },
    {
      "start_ms": 374300,
      "end_ms": 375505,
      "text": "想你可能会问了，",
      "token_start": 1971,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 375940,
      "end_ms": 379815,
      "text": "麦格拉斯这些跨学科的背景到底给了他什么不一样的东西？",
      "token_start": 1978,
      "token_end_exclusive": 2003
    },
    {
      "start_ms": 380220,
      "end_ms": 380895,
      "text": "我告诉你，",
      "token_start": 2003,
      "token_end_exclusive": 2007
    },
    {
      "start_ms": 381180,
      "end_ms": 382035,
      "text": "太不一样了。",
      "token_start": 2007,
      "token_end_exclusive": 2012
    },
    {
      "start_ms": 382440,
      "end_ms": 383700,
      "text": "一个只懂思想的人，",
      "token_start": 2012,
      "token_end_exclusive": 2020
    },
    {
      "start_ms": 383700,
      "end_ms": 385845,
      "text": "写思想史容易飘在半空中。",
      "token_start": 2020,
      "token_end_exclusive": 2031
    },
    {
      "start_ms": 386280,
      "end_ms": 387480,
      "text": "一个只懂科学的人，",
      "token_start": 2031,
      "token_end_exclusive": 2039
    },
    {
      "start_ms": 387480,
      "end_ms": 388235,
      "text": "写思想史，",
      "token_start": 2039,
      "token_end_exclusive": 2043
    },
    {
      "start_ms": 388520,
      "end_ms": 390395,
      "text": "容易把一切都简化成公式。",
      "token_start": 2043,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 390690,
      "end_ms": 393335,
      "text": "而麦格拉斯两只脚踩在两个世界里，",
      "token_start": 2054,
      "token_end_exclusive": 2069
    },
    {
      "start_ms": 393680,
      "end_ms": 395880,
      "text": "他的写法有一种罕见的清醒，",
      "token_start": 2069,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 396040,
      "end_ms": 398140,
      "text": "他既不会被漂亮的理论忽悠住，",
      "token_start": 2081,
      "token_end_exclusive": 2094
    },
    {
      "start_ms": 398380,
      "end_ms": 401000,
      "text": "也不会因为一个论证不符合科学规范，",
      "token_start": 2094,
      "token_end_exclusive": 2110
    },
    {
      "start_ms": 401000,
      "end_ms": 402200,
      "text": "就把他一棒子打死。",
      "token_start": 2110,
      "token_end_exclusive": 2118
    },
    {
      "start_ms": 402320,
      "end_ms": 404180,
      "text": "他在科学与思想的交界地带，",
      "token_start": 2118,
      "token_end_exclusive": 2130
    },
    {
      "start_ms": 404180,
      "end_ms": 405025,
      "text": "走来走去，",
      "token_start": 2130,
      "token_end_exclusive": 2134
    },
    {
      "start_ms": 405290,
      "end_ms": 406575,
      "text": "哪边的风景都看过，",
      "token_start": 2134,
      "token_end_exclusive": 2142
    },
    {
      "start_ms": 406840,
      "end_ms": 408395,
      "text": "所以哪边的话他都能听懂。",
      "token_start": 2142,
      "token_end_exclusive": 2153
    },
    {
      "start_ms": 408950,
      "end_ms": 409690,
      "text": "这就是第三，",
      "token_start": 2153,
      "token_end_exclusive": 2158
    },
    {
      "start_ms": 409690,
      "end_ms": 412130,
      "text": "把密钥叫跨界者的清醒。",
      "token_start": 2158,
      "token_end_exclusive": 2168
    },
    {
      "start_ms": 412330,
      "end_ms": 413150,
      "text": "他自己说过，",
      "token_start": 2168,
      "token_end_exclusive": 2173
    },
    {
      "start_ms": 413290,
      "end_ms": 413970,
      "text": "科学史上，",
      "token_start": 2173,
      "token_end_exclusive": 2177
    },
    {
      "start_ms": 413970,
      "end_ms": 416915,
      "text": "每一代科学家都在推翻上一代人的结论。",
      "token_start": 2177,
      "token_end_exclusive": 2194
    },
    {
      "start_ms": 417250,
      "end_ms": 420595,
      "text": "即使那些结论在当时被坚信为绝对正确，",
      "token_start": 2194,
      "token_end_exclusive": 2211
    },
    {
      "start_ms": 420880,
      "end_ms": 422475,
      "text": "这句话背后的意思太深了，",
      "token_start": 2211,
      "token_end_exclusive": 2222
    },
    {
      "start_ms": 422980,
      "end_ms": 425935,
      "text": "连科学本身都不是铁板一块的真理，",
      "token_start": 2222,
      "token_end_exclusive": 2237
    },
    {
      "start_ms": 426200,
      "end_ms": 428600,
      "text": "你凭什么觉得你手里那个绝对正确的答案，",
      "token_start": 2237,
      "token_end_exclusive": 2255
    },
    {
      "start_ms": 428600,
      "end_ms": 429655,
      "text": "就一定是终点，",
      "token_start": 2255,
      "token_end_exclusive": 2261
    },
    {
      "start_ms": 429910,
      "end_ms": 431390,
      "text": "让我们回到全书的起点？",
      "token_start": 2261,
      "token_end_exclusive": 2271
    },
    {
      "start_ms": 431390,
      "end_ms": 432345,
      "text": "再想一个问题，",
      "token_start": 2271,
      "token_end_exclusive": 2277
    },
    {
      "start_ms": 432640,
      "end_ms": 434265,
      "text": "麦格拉斯为什么要写这本书？",
      "token_start": 2277,
      "token_end_exclusive": 2289
    },
    {
      "start_ms": 434870,
      "end_ms": 437330,
      "text": "他本可以只写一本高深的学术著作，",
      "token_start": 2289,
      "token_end_exclusive": 2304
    },
    {
      "start_ms": 437450,
      "end_ms": 438565,
      "text": "只给圈内人看。",
      "token_start": 2304,
      "token_end_exclusive": 2310
    },
    {
      "start_ms": 439110,
      "end_ms": 441215,
      "text": "可他偏偏选择了导论的形式，",
      "token_start": 2310,
      "token_end_exclusive": 2322
    },
    {
      "start_ms": 441480,
      "end_ms": 444875,
      "text": "一部让没有任何基础的人也能进入的入门书。",
      "token_start": 2322,
      "token_end_exclusive": 2341
    },
    {
      "start_ms": 445330,
      "end_ms": 445875,
      "text": "为什么？",
      "token_start": 2341,
      "token_end_exclusive": 2344
    },
    {
      "start_ms": 446160,
      "end_ms": 446915,
      "text": "因为他相信，",
      "token_start": 2344,
      "token_end_exclusive": 2349
    },
    {
      "start_ms": 447190,
      "end_ms": 449145,
      "text": "那些看似遥远的思想辩论，",
      "token_start": 2349,
      "token_end_exclusive": 2360
    },
    {
      "start_ms": 449410,
      "end_ms": 451845,
      "text": "其实关乎每一个人实实在在的生活。",
      "token_start": 2360,
      "token_end_exclusive": 2375
    },
    {
      "start_ms": 452090,
      "end_ms": 453390,
      "text": "你不去想这些问题，",
      "token_start": 2375,
      "token_end_exclusive": 2383
    },
    {
      "start_ms": 453550,
      "end_ms": 454845,
      "text": "不代表他们不存在。",
      "token_start": 2383,
      "token_end_exclusive": 2391
    },
    {
      "start_ms": 455220,
      "end_ms": 456040,
      "text": "你想不清楚，",
      "token_start": 2391,
      "token_end_exclusive": 2396
    },
    {
      "start_ms": 456300,
      "end_ms": 460685,
      "text": "不代表他们不会在你人生最脆弱的时刻突然冒出来让你手足无措。",
      "token_start": 2396,
      "token_end_exclusive": 2424
    },
    {
      "start_ms": 461190,
      "end_ms": 462875,
      "text": "那这部书到底给了我们什么？",
      "token_start": 2424,
      "token_end_exclusive": 2436
    },
    {
      "start_ms": 463450,
      "end_ms": 465795,
      "text": "他给的不是一套让你拿去炫耀的知识，",
      "token_start": 2436,
      "token_end_exclusive": 2452
    },
    {
      "start_ms": 466200,
      "end_ms": 467455,
      "text": "而是一种思维方式，",
      "token_start": 2452,
      "token_end_exclusive": 2460
    },
    {
      "start_ms": 467880,
      "end_ms": 470925,
      "text": "一种在众说纷纭中保持清醒的能力。",
      "token_start": 2460,
      "token_end_exclusive": 2475
    },
    {
      "start_ms": 471630,
      "end_ms": 473505,
      "text": "当你面对一个复杂问题的时候，",
      "token_start": 2475,
      "token_end_exclusive": 2488
    },
    {
      "start_ms": 473760,
      "end_ms": 476625,
      "text": "你能不能像麦格拉斯那样先退后一步，",
      "token_start": 2488,
      "token_end_exclusive": 2504
    },
    {
      "start_ms": 476940,
      "end_ms": 479045,
      "text": "看看这个问题在历史上是怎么来的，",
      "token_start": 2504,
      "token_end_exclusive": 2519
    },
    {
      "start_ms": 479370,
      "end_ms": 480465,
      "text": "别人是怎么答的。",
      "token_start": 2519,
      "token_end_exclusive": 2526
    },
    {
      "start_ms": 480810,
      "end_ms": 483330,
      "text": "每种打法各有什么长处和短处，",
      "token_start": 2526,
      "token_end_exclusive": 2539
    },
    {
      "start_ms": 483530,
      "end_ms": 484510,
      "text": "你能做到这一点，",
      "token_start": 2539,
      "token_end_exclusive": 2546
    },
    {
      "start_ms": 484610,
      "end_ms": 486830,
      "text": "你就不会被那些听起来很有道理，",
      "token_start": 2546,
      "token_end_exclusive": 2560
    },
    {
      "start_ms": 486830,
      "end_ms": 489415,
      "text": "但其实经不起推敲的说法牵着鼻子走，",
      "token_start": 2560,
      "token_end_exclusive": 2576
    },
    {
      "start_ms": 489840,
      "end_ms": 491640,
      "text": "你就是一个真正会思考的人。",
      "token_start": 2576,
      "token_end_exclusive": 2588
    },
    {
      "start_ms": 491720,
      "end_ms": 492580,
      "text": "故事讲到这里，",
      "token_start": 2588,
      "token_end_exclusive": 2594
    },
    {
      "start_ms": 492740,
      "end_ms": 493940,
      "text": "我想让你记住一件事。",
      "token_start": 2594,
      "token_end_exclusive": 2603
    },
    {
      "start_ms": 494100,
      "end_ms": 495780,
      "text": "麦格拉斯在书里说过一段话，",
      "token_start": 2603,
      "token_end_exclusive": 2615
    },
    {
      "start_ms": 496100,
      "end_ms": 496975,
      "text": "大意是说，",
      "token_start": 2615,
      "token_end_exclusive": 2619
    },
    {
      "start_ms": 497420,
      "end_ms": 500275,
      "text": "知识性的梳理只是思想在历史中的效应，",
      "token_start": 2619,
      "token_end_exclusive": 2636
    },
    {
      "start_ms": 500690,
      "end_ms": 504390,
      "text": "真正的思考永远比知识体系更丰富、更鲜活。",
      "token_start": 2636,
      "token_end_exclusive": 2654
    },
    {
      "start_ms": 504750,
      "end_ms": 508670,
      "text": "这句话什么意思意思是说你不要以为读完一本导论，",
      "token_start": 2654,
      "token_end_exclusive": 2676
    },
    {
      "start_ms": 508670,
      "end_ms": 509610,
      "text": "就什么都懂了，",
      "token_start": 2676,
      "token_end_exclusive": 2682
    },
    {
      "start_ms": 509950,
      "end_ms": 511565,
      "text": "导论只是给你一把钥匙，",
      "token_start": 2682,
      "token_end_exclusive": 2692
    },
    {
      "start_ms": 512050,
      "end_ms": 514005,
      "text": "真正的门要你自己去推。",
      "token_start": 2692,
      "token_end_exclusive": 2702
    },
    {
      "start_ms": 514350,
      "end_ms": 515130,
      "text": "但反过来说，",
      "token_start": 2702,
      "token_end_exclusive": 2707
    },
    {
      "start_ms": 515430,
      "end_ms": 516390,
      "text": "没有这把钥匙，",
      "token_start": 2707,
      "token_end_exclusive": 2713
    },
    {
      "start_ms": 516570,
      "end_ms": 518410,
      "text": "你可能连门在哪里都找不到。",
      "token_start": 2713,
      "token_end_exclusive": 2725
    },
    {
      "start_ms": 518550,
      "end_ms": 520010,
      "text": "读完基督教神学导论。",
      "token_start": 2725,
      "token_end_exclusive": 2734
    },
    {
      "start_ms": 520270,
      "end_ms": 523855,
      "text": "希望我们在每一次面对那些说不清道不明的困惑时，",
      "token_start": 2734,
      "token_end_exclusive": 2756
    },
    {
      "start_ms": 524340,
      "end_ms": 527605,
      "text": "心里都能想起麦格拉斯在牛津讲台上的那句话。",
      "token_start": 2756,
      "token_end_exclusive": 2776
    },
    {
      "start_ms": 528120,
      "end_ms": 529300,
      "text": "先别急着下结论，",
      "token_start": 2776,
      "token_end_exclusive": 2783
    },
    {
      "start_ms": 529620,
      "end_ms": 531415,
      "text": "让我把这段历史讲给你听。",
      "token_start": 2783,
      "token_end_exclusive": 2794
    },
    {
      "start_ms": 531980,
      "end_ms": 533935,
      "text": "世界从来不是非黑即白的，",
      "token_start": 2794,
      "token_end_exclusive": 2805
    },
    {
      "start_ms": 534310,
      "end_ms": 536475,
      "text": "不是在浮躁的争论里固执的战队，",
      "token_start": 2805,
      "token_end_exclusive": 2819
    },
    {
      "start_ms": 536820,
      "end_ms": 539975,
      "text": "而是安安静静的做一个清醒的追问者。",
      "token_start": 2819,
      "token_end_exclusive": 2835
    },
    {
      "start_ms": 540250,
      "end_ms": 543625,
      "text": "毕竟能在这么多声音同时响起的时代里，",
      "token_start": 2835,
      "token_end_exclusive": 2852
    },
    {
      "start_ms": 543930,
      "end_ms": 545870,
      "text": "找到一种属于自己的思考方式。",
      "token_start": 2852,
      "token_end_exclusive": 2865
    },
    {
      "start_ms": 546050,
      "end_ms": 548735,
      "text": "这本身就是一种极高明的智慧。",
      "token_start": 2865,
      "token_end_exclusive": 2878
    },
    {
      "start_ms": 549030,
      "end_ms": 551975,
      "text": "如果你也想拥有这样一台思想界的x光机，",
      "token_start": 2878,
      "token_end_exclusive": 2896
    },
    {
      "start_ms": 552380,
      "end_ms": 555415,
      "text": "今天就把这本基督教神学导论带回家。",
      "token_start": 2896,
      "token_end_exclusive": 2912
    },
    {
      "start_ms": 556360,
      "end_ms": 559165,
      "text": "它不是那种翻一遍就放在书架上吃灰的书，",
      "token_start": 2912,
      "token_end_exclusive": 2930
    },
    {
      "start_ms": 559620,
      "end_ms": 562975,
      "text": "它是那种你每隔一段时间就想拿出来翻一翻的书，",
      "token_start": 2930,
      "token_end_exclusive": 2951
    },
    {
      "start_ms": 563780,
      "end_ms": 566730,
      "text": "因为你每成长一步读出来的东西都不一样。",
      "token_start": 2951,
      "token_end_exclusive": 2969
    },
    {
      "start_ms": 566930,
      "end_ms": 568350,
      "text": "经典之所以是经典，",
      "token_start": 2969,
      "token_end_exclusive": 2977
    },
    {
      "start_ms": 568610,
      "end_ms": 571395,
      "text": "就是因为它永远比你以为的更深一层。",
      "token_start": 2977,
      "token_end_exclusive": 2993
    },
    {
      "start_ms": 571890,
      "end_ms": 572705,
      "text": "我是小海龟，",
      "token_start": 2993,
      "token_end_exclusive": 2998
    },
    {
      "start_ms": 573080,
      "end_ms": 574825,
      "text": "欢迎持续关注我们下本书见。",
      "token_start": 2998,
      "token_end_exclusive": 3010
    }
  ],
