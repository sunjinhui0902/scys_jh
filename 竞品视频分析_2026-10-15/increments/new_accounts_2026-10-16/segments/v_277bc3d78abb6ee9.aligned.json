{
  "video_id": "v_277bc3d78abb6ee9",
  "duration_s": 644.726009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_277bc3d78abb6ee9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_277bc3d78abb6ee9.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 3690,
      "text": "你知道中国出土过最诡异的一件文物是什么吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4050,
      "end_ms": 4610,
      "text": "有人说，",
      "token_start": 20,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 4610,
      "end_ms": 7590,
      "text": "三星堆的青铜面具眼睛凸出来，",
      "token_start": 23,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 7590,
      "end_ms": 10210,
      "text": "十几厘米不像地球上的东西。",
      "token_start": 36,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 10610,
      "end_ms": 11270,
      "text": "有人说，",
      "token_start": 48,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11270,
      "end_ms": 16010,
      "text": "秦始皇的兵马俑第千个泥人占了两千多年，",
      "token_start": 51,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 16110,
      "end_ms": 17150,
      "text": "个个不重样。",
      "token_start": 69,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 17330,
      "end_ms": 17870,
      "text": "错了，",
      "token_start": 74,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 18610,
      "end_ms": 20510,
      "text": "三星堆排不了第一，",
      "token_start": 76,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 21190,
      "end_ms": 23310,
      "text": "兵马俑连前五都进不去，",
      "token_start": 84,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 24210,
      "end_ms": 25950,
      "text": "真正排第一的那件。",
      "token_start": 94,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 26370,
      "end_ms": 29490,
      "text": "第一次看见他的人都以为是个现代的东西，",
      "token_start": 102,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 29490,
      "end_ms": 31180,
      "text": "或者混进了古墓，",
      "token_start": 120,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 31800,
      "end_ms": 34880,
      "text": "它长得跟你家茶几上的玻璃杯一模一样，",
      "token_start": 127,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 34880,
      "end_ms": 36620,
      "text": "可它是两千多年前的，",
      "token_start": 144,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 37360,
      "end_ms": 39740,
      "text": "到今天没人能解释清楚，",
      "token_start": 153,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 40640,
      "end_ms": 43820,
      "text": "两千多年前的人是怎么把它做出来的。",
      "token_start": 163,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 44660,
      "end_ms": 49140,
      "text": "今天咱们就来盘点中国实践最诡异的出土文。",
      "token_start": 179,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 49640,
      "end_ms": 50340,
      "text": "老规矩，",
      "token_start": 198,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 50740,
      "end_ms": 51600,
      "text": "开讲之前，",
      "token_start": 201,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 51640,
      "end_ms": 52900,
      "text": "劳烦您点个红心，",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 53220,
      "end_ms": 56680,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 212,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 57600,
      "end_ms": 58600,
      "text": "朱文陶钵，",
      "token_start": 224,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 58940,
      "end_ms": 60795,
      "text": "浙江余姚河的琢么度一致？",
      "token_start": 228,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 61950,
      "end_ms": 63505,
      "text": "七千年前的东西，",
      "token_start": 239,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 64300,
      "end_ms": 65785,
      "text": "一个陶土烧的锅，",
      "token_start": 246,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 66190,
      "end_ms": 69225,
      "text": "碗口大小本来没什么稀奇，",
      "token_start": 253,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 70110,
      "end_ms": 71130,
      "text": "可您翻过来看，",
      "token_start": 264,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 71130,
      "end_ms": 72955,
      "text": "侧面上头刻着一头猪，",
      "token_start": 270,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 73330,
      "end_ms": 74625,
      "text": "圆滚滚的肚子，",
      "token_start": 279,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 75370,
      "end_ms": 77210,
      "text": "短短的腿小眼睛，",
      "token_start": 285,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 77250,
      "end_ms": 78640,
      "text": "眯着嘴巴，",
      "token_start": 292,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 78640,
      "end_ms": 79605,
      "text": "微微翘起来。",
      "token_start": 296,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 80380,
      "end_ms": 81675,
      "text": "那表情怎么说呢？",
      "token_start": 301,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 81880,
      "end_ms": 84495,
      "text": "跟你手机里的表情包一模一样。",
      "token_start": 308,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 84910,
      "end_ms": 87335,
      "text": "七千年前的人没见过表情包，",
      "token_start": 321,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 87660,
      "end_ms": 92285,
      "text": "可他刻出来的猪萌的跟今天的卡通形象没有任何区别。",
      "token_start": 333,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 92850,
      "end_ms": 94045,
      "text": "更诡异的是，",
      "token_start": 356,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 94600,
      "end_ms": 97525,
      "text": "这头猪的身上刻满了圆圈和弧线。",
      "token_start": 361,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 98070,
      "end_ms": 100145,
      "text": "有人说是猪身上的花纹，",
      "token_start": 375,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 100500,
      "end_ms": 103975,
      "text": "有人说是某种符号到现在没有定论。",
      "token_start": 385,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 104770,
      "end_ms": 106850,
      "text": "七千年前的一个原始人，",
      "token_start": 400,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 106890,
      "end_ms": 110415,
      "text": "吃完饭闲着没事儿在晚上刻了一头猪，",
      "token_start": 410,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 111330,
      "end_ms": 113655,
      "text": "这头猪穿越了七千年，",
      "token_start": 426,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 114450,
      "end_ms": 117195,
      "text": "跟今天的审美完美吻合。",
      "token_start": 435,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 118120,
      "end_ms": 119975,
      "text": "您说这巧合还是巧合？",
      "token_start": 445,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 121450,
      "end_ms": 122275,
      "text": "第九名，",
      "token_start": 454,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 122810,
      "end_ms": 123605,
      "text": "玉猪龙，",
      "token_start": 457,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 124000,
      "end_ms": 126025,
      "text": "内蒙古红山文化遗址。",
      "token_start": 460,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 126430,
      "end_ms": 133925,
      "text": "五千多年前的东西玉做的c型卷成一个圈儿，",
      "token_start": 469,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 134690,
      "end_ms": 135755,
      "text": "头大身子小，",
      "token_start": 488,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 136130,
      "end_ms": 136910,
      "text": "脑袋像猪，",
      "token_start": 493,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 137130,
      "end_ms": 139965,
      "text": "可整体形状又像一条圈起来的路。",
      "token_start": 497,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 140500,
      "end_ms": 142715,
      "text": "也有人说他像一个蜷缩的胎儿，",
      "token_start": 511,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 143590,
      "end_ms": 147940,
      "text": "到底是猪、是龙还是胎儿吵了几十年？",
      "token_start": 524,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 148000,
      "end_ms": 148755,
      "text": "没有结论，",
      "token_start": 539,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 149240,
      "end_ms": 151115,
      "text": "中国人说自己是龙的传人，",
      "token_start": 543,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 151450,
      "end_ms": 153535,
      "text": "可龙这个形象最早长什么样？",
      "token_start": 554,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 154270,
      "end_ms": 156825,
      "text": "就是这个东西不威风，",
      "token_start": 566,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 157050,
      "end_ms": 157705,
      "text": "不霸气，",
      "token_start": 575,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 158640,
      "end_ms": 160025,
      "text": "圆滚滚胖乎乎，",
      "token_start": 578,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 160970,
      "end_ms": 161865,
      "text": "脑袋像猪，",
      "token_start": 584,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 162310,
      "end_ms": 163315,
      "text": "身子像虫。",
      "token_start": 588,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 163770,
      "end_ms": 166035,
      "text": "五千年前的老祖宗心里的龙，",
      "token_start": 592,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 166470,
      "end_ms": 168635,
      "text": "跟咱们今天想的完全不一样。",
      "token_start": 604,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 169470,
      "end_ms": 170595,
      "text": "更诡异的是，",
      "token_start": 616,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 171380,
      "end_ms": 174175,
      "text": "红山文化在内蒙古和辽宁一带，",
      "token_start": 621,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 174970,
      "end_ms": 177145,
      "text": "五千年前的地方是荒原，",
      "token_start": 634,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 177710,
      "end_ms": 180465,
      "text": "可他们雕玉的手艺精细到什么程度？",
      "token_start": 644,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 181430,
      "end_ms": 184170,
      "text": "玉珠龙的表面打磨的光滑如镜，",
      "token_start": 659,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 184190,
      "end_ms": 186675,
      "text": "边缘的弧线流畅均匀。",
      "token_start": 672,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 187000,
      "end_ms": 188695,
      "text": "五千年前没有金属工具，",
      "token_start": 681,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 189140,
      "end_ms": 194690,
      "text": "他们拿什么雕的石头磨石头一点一点磨出来的一块玉，",
      "token_start": 691,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 194910,
      "end_ms": 195875,
      "text": "要磨成这样，",
      "token_start": 714,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 196350,
      "end_ms": 197085,
      "text": "得多少天，",
      "token_start": 719,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 197500,
      "end_ms": 198625,
      "text": "没人算得出来。",
      "token_start": 723,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 199010,
      "end_ms": 199870,
      "text": "五千年前，",
      "token_start": 729,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 199890,
      "end_ms": 200935,
      "text": "一个没有文字，",
      "token_start": 733,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 201280,
      "end_ms": 202775,
      "text": "没有金属的部落，",
      "token_start": 739,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 203090,
      "end_ms": 204725,
      "text": "磨出了中国最早的龙，",
      "token_start": 746,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 205210,
      "end_ms": 206495,
      "text": "您说诡异不诡异？",
      "token_start": 755,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 207770,
      "end_ms": 208465,
      "text": "第八名，",
      "token_start": 762,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 210330,
      "end_ms": 210890,
      "text": "跪坐，",
      "token_start": 765,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 211110,
      "end_ms": 211625,
      "text": "玉人，",
      "token_start": 767,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 212280,
      "end_ms": 213995,
      "text": "河南安阳父好墓，",
      "token_start": 769,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 214580,
      "end_ms": 216820,
      "text": "商朝的东西三千多年。",
      "token_start": 776,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 216820,
      "end_ms": 219900,
      "text": "前富豪是商王武丁的王后，",
      "token_start": 785,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 220000,
      "end_ms": 221655,
      "text": "能打仗能祭祀，",
      "token_start": 796,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 222180,
      "end_ms": 224835,
      "text": "墓里出了将近两千件东西，",
      "token_start": 802,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 225590,
      "end_ms": 229195,
      "text": "其中有一件小玉人跪坐着，",
      "token_start": 813,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 229990,
      "end_ms": 231845,
      "text": "双手放在膝盖上，",
      "token_start": 824,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 232750,
      "end_ms": 233810,
      "text": "五官清晰，",
      "token_start": 831,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 234070,
      "end_ms": 235175,
      "text": "眉毛弯弯，",
      "token_start": 835,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 235530,
      "end_ms": 236585,
      "text": "眼睛细长，",
      "token_start": 839,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 237090,
      "end_ms": 238115,
      "text": "嘴唇微敏，",
      "token_start": 843,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 238590,
      "end_ms": 240955,
      "text": "脸上的表情安静又认真。",
      "token_start": 847,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 241810,
      "end_ms": 243425,
      "text": "这些都不算诡异。",
      "token_start": 857,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 244210,
      "end_ms": 245170,
      "text": "诡异的是，",
      "token_start": 864,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 245170,
      "end_ms": 248740,
      "text": "他的发型头发从中间分开，",
      "token_start": 868,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 249060,
      "end_ms": 250625,
      "text": "两边各梳一个卷，",
      "token_start": 879,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 250930,
      "end_ms": 252090,
      "text": "往后拢到脑后，",
      "token_start": 886,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 252110,
      "end_ms": 255745,
      "text": "收起来齐耳短发微微蓬松。",
      "token_start": 892,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 256320,
      "end_ms": 259235,
      "text": "您把这个发型搁到今天的理发店里，",
      "token_start": 903,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 259460,
      "end_ms": 260460,
      "text": "就叫包包头，",
      "token_start": 918,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 260600,
      "end_ms": 262460,
      "text": "满大街都是三千多年。",
      "token_start": 923,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 262460,
      "end_ms": 267930,
      "text": "前一个商朝女人的发型跟今天时尚杂志上的发型撞了，",
      "token_start": 932,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 268170,
      "end_ms": 271155,
      "text": "您说他是穿越了还是咱们在抄他？",
      "token_start": 955,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 272420,
      "end_ms": 273635,
      "text": "更有意思的是，",
      "token_start": 969,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 274160,
      "end_ms": 277795,
      "text": "这个玉人身上穿的衣服也刻的清清楚楚。",
      "token_start": 975,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 278480,
      "end_ms": 281160,
      "text": "交岭束腰长袖，",
      "token_start": 992,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 281580,
      "end_ms": 283120,
      "text": "衣服上还有纹饰。",
      "token_start": 998,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 283800,
      "end_ms": 289280,
      "text": "三千多年前商朝人的穿着打扮比我们想象中讲究的多。",
      "token_start": 1005,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 289910,
      "end_ms": 291835,
      "text": "一个三千年前的玉人，",
      "token_start": 1028,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 292120,
      "end_ms": 295735,
      "text": "顶着一个二零二六年最流行的发型，",
      "token_start": 1037,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 296540,
      "end_ms": 297640,
      "text": "您说这算什么？",
      "token_start": 1052,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 297640,
      "end_ms": 298455,
      "text": "第七名，",
      "token_start": 1058,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 300430,
      "end_ms": 301310,
      "text": "梯形薄画，",
      "token_start": 1061,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 301590,
      "end_ms": 303515,
      "text": "湖南长沙马王堆汉墓。",
      "token_start": 1065,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 304430,
      "end_ms": 306890,
      "text": "这幅画是辛追夫人的随葬品，",
      "token_start": 1074,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 307750,
      "end_ms": 310010,
      "text": "盖在他棺材最外面那一层上，",
      "token_start": 1086,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 311150,
      "end_ms": 314670,
      "text": "t字形上窄下宽长两米多。",
      "token_start": 1098,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 315010,
      "end_ms": 315990,
      "text": "画的是什么？",
      "token_start": 1109,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 317570,
      "end_ms": 323350,
      "text": "三个世界最上面一层是天上太阳，",
      "token_start": 1114,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 323370,
      "end_ms": 325030,
      "text": "里头蹲着一只蟾蜍。",
      "token_start": 1128,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 325950,
      "end_ms": 328310,
      "text": "月亮里头趴着一只金蜍，",
      "token_start": 1136,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 329490,
      "end_ms": 331370,
      "text": "最条龙盘在天门口，",
      "token_start": 1146,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 332970,
      "end_ms": 333530,
      "text": "中间，",
      "token_start": 1154,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 333550,
      "end_ms": 336240,
      "text": "一层是人间辛追夫人，",
      "token_start": 1156,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 336240,
      "end_ms": 338760,
      "text": "拄着拐杖站在当中前面，",
      "token_start": 1165,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 338780,
      "end_ms": 339720,
      "text": "有人跪迎，",
      "token_start": 1175,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 339980,
      "end_ms": 341400,
      "text": "后面有人伺候。",
      "token_start": 1179,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 341900,
      "end_ms": 345200,
      "text": "最下面一层是地下一个赤身大力士，",
      "token_start": 1185,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 345200,
      "end_ms": 346360,
      "text": "踩着两条大鱼，",
      "token_start": 1200,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 346760,
      "end_ms": 350540,
      "text": "拖着整个人间天上人间，",
      "token_start": 1206,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 350700,
      "end_ms": 353960,
      "text": "地下三个世界画在一块薄上，",
      "token_start": 1216,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 354900,
      "end_ms": 355820,
      "text": "过渡自然，",
      "token_start": 1228,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 356240,
      "end_ms": 362280,
      "text": "每一层的颜色、构图、人物比例都不一样，",
      "token_start": 1232,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 363000,
      "end_ms": 365315,
      "text": "可合在一起看又浑然一体。",
      "token_start": 1248,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 366160,
      "end_ms": 368535,
      "text": "两千一百多年前的一个画工，",
      "token_start": 1259,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 369270,
      "end_ms": 372565,
      "text": "把整个宇宙的结构画在了一块布上，",
      "token_start": 1271,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 373570,
      "end_ms": 375265,
      "text": "从天上画到地下，",
      "token_start": 1286,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 375670,
      "end_ms": 377795,
      "text": "逻辑清楚的像一张设计图。",
      "token_start": 1293,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 378720,
      "end_ms": 380285,
      "text": "这幅画诡异在哪？",
      "token_start": 1304,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 381080,
      "end_ms": 382445,
      "text": "不是画面本身，",
      "token_start": 1311,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 383240,
      "end_ms": 385100,
      "text": "是他背后那套世界观。",
      "token_start": 1317,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 385300,
      "end_ms": 387515,
      "text": "两千一百年前的汉朝人，",
      "token_start": 1326,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 388020,
      "end_ms": 391655,
      "text": "脑袋里已经有了一个完整的三界结构。",
      "token_start": 1336,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 392510,
      "end_ms": 393430,
      "text": "天上有神，",
      "token_start": 1352,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 393690,
      "end_ms": 395125,
      "text": "人间有贵族，",
      "token_start": 1356,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 395640,
      "end_ms": 396760,
      "text": "地下有巨人，",
      "token_start": 1361,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 396760,
      "end_ms": 399030,
      "text": "称着这套设计，",
      "token_start": 1366,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 399030,
      "end_ms": 401995,
      "text": "比后来佛教传入中国还早了好几百年。",
      "token_start": 1372,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 402530,
      "end_ms": 404985,
      "text": "他是纯粹的中国本土想象，",
      "token_start": 1388,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 405820,
      "end_ms": 410780,
      "text": "可他完整到让人害怕一块薄画画了。",
      "token_start": 1399,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 410780,
      "end_ms": 416485,
      "text": "三个世界两千一百年前的人脑子里装着一整套宇宙，",
      "token_start": 1414,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 417010,
      "end_ms": 419775,
      "text": "您说这想象力到底从哪儿来的？",
      "token_start": 1436,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 421150,
      "end_ms": 421745,
      "text": "第六名，",
      "token_start": 1449,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 423160,
      "end_ms": 433840,
      "text": "云纹铜镜河南淅川下四楚木一九七八年出土两千五百多年前的东西长一点三米，",
      "token_start": 1452,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 434100,
      "end_ms": 434340,
      "text": "宽，",
      "token_start": 1486,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 434580,
      "end_ms": 436045,
      "text": "将近七十厘米，",
      "token_start": 1487,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 436400,
      "end_ms": 438985,
      "text": "是一张放久不用的铜桌子。",
      "token_start": 1493,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 440220,
      "end_ms": 442015,
      "text": "这东西第一眼看上去，",
      "token_start": 1504,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 442490,
      "end_ms": 444345,
      "text": "您可能觉得不就是张桌子吗？",
      "token_start": 1513,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 444630,
      "end_ms": 447330,
      "text": "可您凑近了看整张桌子，",
      "token_start": 1525,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 447330,
      "end_ms": 451100,
      "text": "从里到外全是镂空的云朵一样的纹路，",
      "token_start": 1535,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 451160,
      "end_ms": 451780,
      "text": "一层套，",
      "token_start": 1551,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 451780,
      "end_ms": 454765,
      "text": "一层弯弯绕绕密密麻麻，",
      "token_start": 1554,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 455340,
      "end_ms": 457405,
      "text": "每一根铜丝都是独立的，",
      "token_start": 1564,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 457840,
      "end_ms": 459315,
      "text": "可又根根相连。",
      "token_start": 1574,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 460320,
      "end_ms": 462285,
      "text": "十二条龙攀在四周，",
      "token_start": 1580,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 462970,
      "end_ms": 465980,
      "text": "每条龙的身体也是镂空的，",
      "token_start": 1588,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 466060,
      "end_ms": 467160,
      "text": "整件东西，",
      "token_start": 1599,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 467220,
      "end_ms": 469275,
      "text": "没有一处焊接的痕迹，",
      "token_start": 1603,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 469860,
      "end_ms": 470785,
      "text": "这怎么做的？",
      "token_start": 1612,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 471760,
      "end_ms": 472565,
      "text": "施蜡法，",
      "token_start": 1617,
      "token_end_exclusive": 1620
    },
    {
      "start_ms": 473350,
      "end_ms": 475040,
      "text": "先用蜡雕出模型，",
      "token_start": 1620,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 475320,
      "end_ms": 476435,
      "text": "外面裹上泥，",
      "token_start": 1627,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 476840,
      "end_ms": 478210,
      "text": "烧硬了蜡融掉，",
      "token_start": 1632,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 478570,
      "end_ms": 480365,
      "text": "留下空腔再灌桶水。",
      "token_start": 1638,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 480910,
      "end_ms": 481795,
      "text": "可问题是，",
      "token_start": 1646,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 482180,
      "end_ms": 486825,
      "text": "这么复杂的镂空结构蜡模本身怎么雕的？",
      "token_start": 1650,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 487380,
      "end_ms": 489875,
      "text": "一层套一层层层镂空，",
      "token_start": 1667,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 490280,
      "end_ms": 491300,
      "text": "稍微一手抖，",
      "token_start": 1676,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 491400,
      "end_ms": 492335,
      "text": "整个就断了。",
      "token_start": 1681,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 493390,
      "end_ms": 496445,
      "text": "两千五百年前的工匠没有三d打印，",
      "token_start": 1686,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 497080,
      "end_ms": 499740,
      "text": "可他做出来的东西放在三d打印机旁边，",
      "token_start": 1701,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 499740,
      "end_ms": 503115,
      "text": "比ZED打印机都得想一想。",
      "token_start": 1718,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 504150,
      "end_ms": 506370,
      "text": "这件铜镜出土的时候呢，",
      "token_start": 1728,
      "token_end_exclusive": 1738
    },
    {
      "start_ms": 506370,
      "end_ms": 507365,
      "text": "锈蚀严重，",
      "token_start": 1738,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 508230,
      "end_ms": 512630,
      "text": "后来修复师花了好几年才复原云纹。",
      "token_start": 1742,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 512650,
      "end_ms": 514095,
      "text": "铜镜诡异在哪？",
      "token_start": 1757,
      "token_end_exclusive": 1763
    },
    {
      "start_ms": 515030,
      "end_ms": 515950,
      "text": "不是他好看，",
      "token_start": 1763,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 516690,
      "end_ms": 519695,
      "text": "是他不该出现在两千五百年前。",
      "token_start": 1768,
      "token_end_exclusive": 1781
    },
    {
      "start_ms": 520730,
      "end_ms": 523230,
      "text": "这种精度的施蜡法铸造，",
      "token_start": 1781,
      "token_end_exclusive": 1791
    },
    {
      "start_ms": 523710,
      "end_ms": 526065,
      "text": "按照正常的技术演进规律，",
      "token_start": 1791,
      "token_end_exclusive": 1802
    },
    {
      "start_ms": 526820,
      "end_ms": 528895,
      "text": "不应该在春秋时期就出现。",
      "token_start": 1802,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 529640,
      "end_ms": 530955,
      "text": "可他就是出现了，",
      "token_start": 1813,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 531750,
      "end_ms": 533250,
      "text": "而且出现即巅峰，",
      "token_start": 1820,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 533990,
      "end_ms": 538310,
      "text": "后面再也没有一件施蜡法铸剑能达到它的复杂度。",
      "token_start": 1827,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 538730,
      "end_ms": 542425,
      "text": "一张两千五百年前的铜桌子，",
      "token_start": 1848,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 543120,
      "end_ms": 547680,
      "text": "镂空到像蕾丝精细到像机器干的活。",
      "token_start": 1860,
      "token_end_exclusive": 1875
    },
    {
      "start_ms": 547720,
      "end_ms": 550185,
      "text": "您说这是老祖宗做的还是谁做的？",
      "token_start": 1875,
      "token_end_exclusive": 1889
    },
    {
      "start_ms": 550610,
      "end_ms": 552430,
      "text": "先在评论区打出四个字，",
      "token_start": 1889,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 552470,
      "end_ms": 553485,
      "text": "细思极恐。",
      "token_start": 1899,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 553860,
      "end_ms": 554300,
      "text": "打完了，",
      "token_start": 1903,
      "token_end_exclusive": 1906
    },
    {
      "start_ms": 554300,
      "end_ms": 555065,
      "text": "咱们接着讲，",
      "token_start": 1906,
      "token_end_exclusive": 1911
    },
    {
      "start_ms": 555420,
      "end_ms": 559665,
      "text": "因为接下来的前五名才是真正让人头皮发麻。",
      "token_start": 1911,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 560390,
      "end_ms": 564905,
      "text": "从第十到第六七千年前的猪长得像表情包，",
      "token_start": 1930,
      "token_end_exclusive": 1948
    },
    {
      "start_ms": 565350,
      "end_ms": 567310,
      "text": "五千年前的龙长得像猪，",
      "token_start": 1948,
      "token_end_exclusive": 1958
    },
    {
      "start_ms": 567670,
      "end_ms": 574255,
      "text": "三千年前的发型跟今天撞了两千一百年前一块薄画装了三个世界。",
      "token_start": 1958,
      "token_end_exclusive": 1986
    },
    {
      "start_ms": 574830,
      "end_ms": 576030,
      "text": "两千五百年前，",
      "token_start": 1986,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 576030,
      "end_ms": 580095,
      "text": "一张铜桌子镂空道像三d打印够诡异了吧，",
      "token_start": 1992,
      "token_end_exclusive": 2010
    },
    {
      "start_ms": 581450,
      "end_ms": 585015,
      "text": "可跟前五名比这些都只是开胃菜。",
      "token_start": 2010,
      "token_end_exclusive": 2024
    },
    {
      "start_ms": 585940,
      "end_ms": 593770,
      "text": "接下来有一件文物一百九十二公斤的铜铸了八对龙缠在一起浇筑方式，",
      "token_start": 2024,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 593770,
      "end_ms": 594955,
      "text": "到现在都在炒，",
      "token_start": 2054,
      "token_end_exclusive": 2060
    },
    {
      "start_ms": 595610,
      "end_ms": 598565,
      "text": "有一辆车三千多个零件，",
      "token_start": 2060,
      "token_end_exclusive": 2070
    },
    {
      "start_ms": 599390,
      "end_ms": 604345,
      "text": "两千多年前的人造了一辆能拆能装的青铜模型车，",
      "token_start": 2070,
      "token_end_exclusive": 2091
    },
    {
      "start_ms": 604610,
      "end_ms": 606915,
      "text": "有一只杯子必薄道，",
      "token_start": 2091,
      "token_end_exclusive": 2099
    },
    {
      "start_ms": 607210,
      "end_ms": 608365,
      "text": "只有零点二毫米。",
      "token_start": 2099,
      "token_end_exclusive": 2106
    },
    {
      "start_ms": 609420,
      "end_ms": 612395,
      "text": "四千年前没有拉皮机的人怎么做出来？",
      "token_start": 2106,
      "token_end_exclusive": 2122
    },
    {
      "start_ms": 613000,
      "end_ms": 617220,
      "text": "有一把尺子跟现代游标卡尺几乎一模一样，",
      "token_start": 2122,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 617220,
      "end_ms": 618885,
      "text": "可排在第一的那件。",
      "token_start": 2140,
      "token_end_exclusive": 2148
    },
    {
      "start_ms": 619780,
      "end_ms": 620280,
      "text": "看一眼，",
      "token_start": 2148,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 620280,
      "end_ms": 620900,
      "text": "您就会说，",
      "token_start": 2151,
      "token_end_exclusive": 2155
    },
    {
      "start_ms": 620900,
      "end_ms": 622445,
      "text": "这不可能是古代的东西，",
      "token_start": 2155,
      "token_end_exclusive": 2165
    },
    {
      "start_ms": 623200,
      "end_ms": 625405,
      "text": "它跟你家喝水的玻璃杯一模一样，",
      "token_start": 2165,
      "token_end_exclusive": 2179
    },
    {
      "start_ms": 625700,
      "end_ms": 627445,
      "text": "可他是两千多年前的，",
      "token_start": 2179,
      "token_end_exclusive": 2188
    },
    {
      "start_ms": 627840,
      "end_ms": 629805,
      "text": "下一集已经同步更新，",
      "token_start": 2188,
      "token_end_exclusive": 2197
    },
    {
      "start_ms": 630660,
      "end_ms": 632725,
      "text": "现在直接点开我的头像，",
      "token_start": 2197,
      "token_end_exclusive": 2207
    },
    {
      "start_ms": 633550,
      "end_ms": 634515,
      "text": "进入主页，",
      "token_start": 2207,
      "token_end_exclusive": 2211
    },
    {
      "start_ms": 635520,
      "end_ms": 639375,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 2211,
      "token_end_exclusive": 2225
    },
    {
      "start_ms": 640190,
      "end_ms": 644690,
      "text": "看看中国地底下到底还埋着什么让人说不清的东西。",
      "token_start": 2225,
      "token_end_exclusive": 2247
    }
