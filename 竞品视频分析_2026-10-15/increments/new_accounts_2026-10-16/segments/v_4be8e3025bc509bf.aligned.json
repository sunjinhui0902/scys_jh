{
  "video_id": "v_4be8e3025bc509bf",
  "duration_s": 483.973991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_4be8e3025bc509bf.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_4be8e3025bc509bf.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 3270,
      "text": "你知道故宫最不可思议的秘密是什么吗？",
      "token_start": 0,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4090,
      "end_ms": 7450,
      "text": "有人说是九千九百九十九间半房子，",
      "token_start": 17,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 7870,
      "end_ms": 10270,
      "text": "有人说是里面数不清的宝贝。",
      "token_start": 32,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11190,
      "end_ms": 11430,
      "text": "错，",
      "token_start": 44,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12030,
      "end_ms": 16790,
      "text": "这些连前五都排不进真正排第一的那个秘密。",
      "token_start": 45,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 17130,
      "end_ms": 18110,
      "text": "二零一二年，",
      "token_start": 64,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 18150,
      "end_ms": 21170,
      "text": "北京发了六十年一遇的大暴雨，",
      "token_start": 69,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 21850,
      "end_ms": 23370,
      "text": "全程泡在水里，",
      "token_start": 82,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 23970,
      "end_ms": 24690,
      "text": "车淹了，",
      "token_start": 88,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 25410,
      "end_ms": 26490,
      "text": "地铁灌了。",
      "token_start": 91,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 27230,
      "end_ms": 32860,
      "text": "可六百年的故宫里面干干净净的一滴水没存到底，",
      "token_start": 95,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 32880,
      "end_ms": 34960,
      "text": "靠的什么没人猜得到。",
      "token_start": 116,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 36120,
      "end_ms": 38660,
      "text": "咱们从第十个秘密开始倒着讲讲到。",
      "token_start": 125,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 38660,
      "end_ms": 39200,
      "text": "第一个，",
      "token_start": 140,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 39240,
      "end_ms": 40280,
      "text": "您自己品品，",
      "token_start": 143,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 41180,
      "end_ms": 42560,
      "text": "还是咱们的老规矩。",
      "token_start": 148,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 43360,
      "end_ms": 44120,
      "text": "开讲前，",
      "token_start": 156,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 44220,
      "end_ms": 46800,
      "text": "劳烦各位老友顺手点亮红心。",
      "token_start": 159,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 47160,
      "end_ms": 53140,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场，",
      "token_start": 171,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 53560,
      "end_ms": 57340,
      "text": "第十个秘密开宫里没有厕所，",
      "token_start": 193,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 57640,
      "end_ms": 58420,
      "text": "您没听错，",
      "token_start": 205,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 59300,
      "end_ms": 61935,
      "text": "整个故共七十多万平方米，",
      "token_start": 209,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 62780,
      "end_ms": 66855,
      "text": "九千多间房子一个厕所都没有，",
      "token_start": 220,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 67950,
      "end_ms": 76545,
      "text": "皇帝妃子太监宫女几千号人住在里面上哪方便呢？",
      "token_start": 233,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 76780,
      "end_ms": 79240,
      "text": "用便盆宫里管这个叫官房，",
      "token_start": 254,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 79440,
      "end_ms": 84325,
      "text": "就是一个木头盒子里面铺上炭灰和香料，",
      "token_start": 265,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 85080,
      "end_ms": 87705,
      "text": "用完太监马上端走处理掉。",
      "token_start": 282,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 88030,
      "end_ms": 89215,
      "text": "为什么不修厕所？",
      "token_start": 293,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 90150,
      "end_ms": 90925,
      "text": "两个原因，",
      "token_start": 300,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 91640,
      "end_ms": 93085,
      "text": "第一怕味道，",
      "token_start": 304,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 94780,
      "end_ms": 96535,
      "text": "故宫的宫殿挨得很近。",
      "token_start": 309,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 97000,
      "end_ms": 100580,
      "text": "北京的夏天三十七八度要是修了厕所，",
      "token_start": 318,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 100580,
      "end_ms": 102785,
      "text": "那味道能挑半个紫禁城。",
      "token_start": 334,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 103160,
      "end_ms": 103500,
      "text": "第二，",
      "token_start": 344,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 103960,
      "end_ms": 104740,
      "text": "怕渗漏，",
      "token_start": 346,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 104820,
      "end_ms": 105775,
      "text": "污染地下水。",
      "token_start": 349,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 106820,
      "end_ms": 111010,
      "text": "故宫的地下水系是整套设计好的厕所的污水，",
      "token_start": 354,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 111010,
      "end_ms": 112205,
      "text": "一旦渗进去，",
      "token_start": 373,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 112980,
      "end_ms": 114295,
      "text": "整个系统就废了。",
      "token_start": 378,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 114750,
      "end_ms": 116910,
      "text": "所以宁可用最笨的办法认断，",
      "token_start": 385,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 116990,
      "end_ms": 118355,
      "text": "也不修一个厕所。",
      "token_start": 397,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 118970,
      "end_ms": 119675,
      "text": "您想想，",
      "token_start": 404,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 120070,
      "end_ms": 123030,
      "text": "堂堂大清皇帝上厕所也得用便盆，",
      "token_start": 407,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 123850,
      "end_ms": 126490,
      "text": "太监在门口候着完事儿了，",
      "token_start": 421,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 126490,
      "end_ms": 130170,
      "text": "端走这排场跟您想的不太一样吧。",
      "token_start": 432,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 130630,
      "end_ms": 131590,
      "text": "第九个秘密，",
      "token_start": 446,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 132590,
      "end_ms": 134770,
      "text": "故宫的地砖比黄金还贵。",
      "token_start": 451,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 135550,
      "end_ms": 138530,
      "text": "故宫太和殿里铺的那种方砖叫金砖，",
      "token_start": 461,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 139330,
      "end_ms": 140690,
      "text": "可它不是金子砖，",
      "token_start": 476,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 141590,
      "end_ms": 142910,
      "text": "为什么叫金砖呢？",
      "token_start": 483,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 143650,
      "end_ms": 145490,
      "text": "因为造价比金子还高，",
      "token_start": 490,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 146070,
      "end_ms": 153220,
      "text": "这种砖子苏州用的是阳城湖底底下下的泥光选泥就要挑三年，",
      "token_start": 499,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 153300,
      "end_ms": 156700,
      "text": "挖出来的泥得在露天放一整年让它风化，",
      "token_start": 525,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 156820,
      "end_ms": 158600,
      "text": "然后泡水里再放一年，",
      "token_start": 542,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 158780,
      "end_ms": 159500,
      "text": "再晾米，",
      "token_start": 551,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 159800,
      "end_ms": 163340,
      "text": "三年之后才能泥选好了开始烧，",
      "token_start": 554,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 164140,
      "end_ms": 166380,
      "text": "再用糠草火熏一个月，",
      "token_start": 567,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 167000,
      "end_ms": 168900,
      "text": "再用片柴烧一个月，",
      "token_start": 576,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 169640,
      "end_ms": 171440,
      "text": "接着用颗柴烧一个月，",
      "token_start": 584,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 171800,
      "end_ms": 174220,
      "text": "最后用松脂烧四十天，",
      "token_start": 593,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 175240,
      "end_ms": 177520,
      "text": "前后烧制药七百二十天，",
      "token_start": 602,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 178060,
      "end_ms": 179200,
      "text": "将近两年。",
      "token_start": 612,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 179320,
      "end_ms": 181050,
      "text": "烧出来的砖敲上去，",
      "token_start": 616,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 181050,
      "end_ms": 182930,
      "text": "声音跟敲磬一样清脆，",
      "token_start": 624,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 183530,
      "end_ms": 186530,
      "text": "掰开了里面的纹理跟石头一样细密。",
      "token_start": 633,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 187050,
      "end_ms": 189750,
      "text": "一块金砖从选泥到出窑，",
      "token_start": 648,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 189870,
      "end_ms": 193530,
      "text": "要花将近五年每一块的造价，",
      "token_start": 658,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 193670,
      "end_ms": 198790,
      "text": "在当时折合白银好几两抵得上一个普通人家半年的口粮钱。",
      "token_start": 670,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 199330,
      "end_ms": 201490,
      "text": "太和殿里铺了四千七百多块，",
      "token_start": 695,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 202090,
      "end_ms": 204050,
      "text": "光地砖就花了这么多银子，",
      "token_start": 707,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 204450,
      "end_ms": 207410,
      "text": "您走在上面可能觉得就是块灰色的方砖，",
      "token_start": 718,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 207910,
      "end_ms": 211720,
      "text": "可能是五年烧出来第八个秘密，",
      "token_start": 735,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 212640,
      "end_ms": 216640,
      "text": "故宫的房间数不是九千九百九十九间半，",
      "token_start": 748,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 217600,
      "end_ms": 220340,
      "text": "故宫有九千九百九十九间半，",
      "token_start": 765,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 220420,
      "end_ms": 221060,
      "text": "这个说法，",
      "token_start": 777,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 221060,
      "end_ms": 222320,
      "text": "流传了几百年了，",
      "token_start": 781,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 222680,
      "end_ms": 225480,
      "text": "说是天上的玉皇大帝有一万间房，",
      "token_start": 788,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 226340,
      "end_ms": 228740,
      "text": "故间的皇帝不敢跟老天比，",
      "token_start": 802,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 228740,
      "end_ms": 229860,
      "text": "就少了半间，",
      "token_start": 813,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 230080,
      "end_ms": 231060,
      "text": "以示尊敬。",
      "token_start": 818,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 232060,
      "end_ms": 234520,
      "text": "故事讲的好故是假的。",
      "token_start": 822,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 235440,
      "end_ms": 236440,
      "text": "二零一零年，",
      "token_start": 831,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 236460,
      "end_ms": 238660,
      "text": "故宫博物院做过一次全面测量，",
      "token_start": 836,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 239080,
      "end_ms": 241275,
      "text": "结果是八千七百零七件，",
      "token_start": 849,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 241860,
      "end_ms": 243480,
      "text": "既不是九千九百九十九，",
      "token_start": 859,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 243480,
      "end_ms": 244245,
      "text": "也不是一万，",
      "token_start": 869,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 244740,
      "end_ms": 246285,
      "text": "就是八千七百零七。",
      "token_start": 874,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 247290,
      "end_ms": 249225,
      "text": "那个半间的说法怎么来的呢？",
      "token_start": 882,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 250100,
      "end_ms": 251420,
      "text": "有人说是文渊阁，",
      "token_start": 894,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 251420,
      "end_ms": 251940,
      "text": "楼梯间，",
      "token_start": 901,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 251940,
      "end_ms": 255035,
      "text": "只有别的房间一半大算半间。",
      "token_start": 904,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 255350,
      "end_ms": 256805,
      "text": "可按古建筑的算法，",
      "token_start": 916,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 257250,
      "end_ms": 259675,
      "text": "肩是两根柱子之间的空间，",
      "token_start": 924,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 260110,
      "end_ms": 261715,
      "text": "不管大小都算一间，",
      "token_start": 935,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 262070,
      "end_ms": 263510,
      "text": "没有半间这个说法，",
      "token_start": 943,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 263630,
      "end_ms": 265690,
      "text": "一个流传了几百年的数字，",
      "token_start": 951,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 266150,
      "end_ms": 267275,
      "text": "其实是错的。",
      "token_start": 962,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 267680,
      "end_ms": 271305,
      "text": "可到今天还有导游在讲九千九百九十九间半，",
      "token_start": 967,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 271900,
      "end_ms": 273020,
      "text": "您下次去了，",
      "token_start": 986,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 273020,
      "end_ms": 276555,
      "text": "可以纠正他第七个秘密，",
      "token_start": 991,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 277040,
      "end_ms": 278660,
      "text": "故宫里养了几百只猫。",
      "token_start": 1001,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 278880,
      "end_ms": 280440,
      "text": "您要是去故宫逛过，",
      "token_start": 1010,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 280620,
      "end_ms": 283060,
      "text": "可能见过院子里趴着晒太阳的猫。",
      "token_start": 1018,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 283720,
      "end_ms": 285500,
      "text": "这些猫不是流浪猫，",
      "token_start": 1032,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 285700,
      "end_ms": 289070,
      "text": "是故宫的编制内员工有名字，",
      "token_start": 1040,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 289270,
      "end_ms": 290010,
      "text": "有人位，",
      "token_start": 1052,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 290270,
      "end_ms": 291345,
      "text": "有固定的窝。",
      "token_start": 1055,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 292140,
      "end_ms": 294505,
      "text": "故宫现在常年有两百多只猫，",
      "token_start": 1060,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 295160,
      "end_ms": 296385,
      "text": "工作人员管他们叫。",
      "token_start": 1072,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 296710,
      "end_ms": 300070,
      "text": "故宫猫这些猫从什么时候开始养的呢？",
      "token_start": 1080,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 300810,
      "end_ms": 304150,
      "text": "明朝故宫的建筑大量使用木头，",
      "token_start": 1096,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 304910,
      "end_ms": 308410,
      "text": "最怕的就是老鼠啃木梁被啃了，",
      "token_start": 1109,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 308410,
      "end_ms": 309590,
      "text": "建筑会出问题，",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 309930,
      "end_ms": 310990,
      "text": "字画被啃了，",
      "token_start": 1128,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 310990,
      "end_ms": 311930,
      "text": "文物就毁了。",
      "token_start": 1133,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 312470,
      "end_ms": 313710,
      "text": "所以从明朝开始，",
      "token_start": 1138,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 313710,
      "end_ms": 314530,
      "text": "宫里就养猫，",
      "token_start": 1145,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 314530,
      "end_ms": 316890,
      "text": "抓老鼠一养就是六百年。",
      "token_start": 1150,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 317370,
      "end_ms": 319390,
      "text": "现在这些猫虽然不用抓老鼠，",
      "token_start": 1160,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 319710,
      "end_ms": 321610,
      "text": "但故宫方面一直养着，",
      "token_start": 1172,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 321790,
      "end_ms": 324490,
      "text": "每只猫都做了绝育和防疫，",
      "token_start": 1181,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 325010,
      "end_ms": 326315,
      "text": "有专门的猫舍。",
      "token_start": 1192,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 326940,
      "end_ms": 329500,
      "text": "六百年前的猫跟今天的猫当然不是一波。",
      "token_start": 1198,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 329640,
      "end_ms": 331960,
      "text": "可故宫养猫这件事传了六百年，",
      "token_start": 1215,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 331960,
      "end_ms": 333980,
      "text": "没断过故宫里的木头，",
      "token_start": 1228,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 334120,
      "end_ms": 335660,
      "text": "靠猫守了六百年，",
      "token_start": 1237,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 335960,
      "end_ms": 337760,
      "text": "这也算一种文物保护吧。",
      "token_start": 1244,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 338780,
      "end_ms": 339720,
      "text": "第六个秘密，",
      "token_start": 1254,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 340720,
      "end_ms": 342420,
      "text": "故宫的角楼没有图纸，",
      "token_start": 1259,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 342739,
      "end_ms": 345360,
      "text": "故宫四个角上各有一座一角，",
      "token_start": 1268,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 345840,
      "end_ms": 349420,
      "text": "三重岩七十二条戟二十八个一角。",
      "token_start": 1280,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 350220,
      "end_ms": 351460,
      "text": "从哪个方向看，",
      "token_start": 1294,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 351680,
      "end_ms": 354340,
      "text": "都是对称的、精美的，",
      "token_start": 1300,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 354340,
      "end_ms": 355080,
      "text": "不像征的。",
      "token_start": 1308,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 355080,
      "end_ms": 359175,
      "text": "可这座楼的设计图纸到底是谁画的？",
      "token_start": 1312,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 359680,
      "end_ms": 360805,
      "text": "至今是个谜。",
      "token_start": 1327,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 361820,
      "end_ms": 363235,
      "text": "民间传说是这样，",
      "token_start": 1332,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 364150,
      "end_ms": 365650,
      "text": "当年修故宫的时候，",
      "token_start": 1339,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 365650,
      "end_ms": 368350,
      "text": "工匠们怎么都设计不出角楼的样子，",
      "token_start": 1347,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 368350,
      "end_ms": 369245,
      "text": "急得要命。",
      "token_start": 1362,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 370530,
      "end_ms": 371090,
      "text": "有一天，",
      "token_start": 1366,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 371110,
      "end_ms": 375435,
      "text": "一个老木匠在街上看到一个卖蝈蝈笼的老头，",
      "token_start": 1369,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 376220,
      "end_ms": 379155,
      "text": "那蝈蝈龙的结构上下穿插，",
      "token_start": 1388,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 379630,
      "end_ms": 380695,
      "text": "层层叠叠，",
      "token_start": 1399,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 381540,
      "end_ms": 382955,
      "text": "他拿回去一琢磨，",
      "token_start": 1403,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 383460,
      "end_ms": 386215,
      "text": "照着郭国荣的原理设计出了角楼。",
      "token_start": 1410,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 386740,
      "end_ms": 387840,
      "text": "这个故事好听，",
      "token_start": 1424,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 388240,
      "end_ms": 389715,
      "text": "可没有史料证实，",
      "token_start": 1430,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 390330,
      "end_ms": 394945,
      "text": "实际情况是故宫的营建档案在明代就丢了大半。",
      "token_start": 1437,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 395770,
      "end_ms": 399015,
      "text": "清代的档案里也没有角楼设计图的记录。",
      "token_start": 1457,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 399500,
      "end_ms": 402435,
      "text": "这么一座结构极其复杂的建筑，",
      "token_start": 1474,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 402850,
      "end_ms": 404575,
      "text": "到底是谁设计的，",
      "token_start": 1487,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 404840,
      "end_ms": 406060,
      "text": "依据什么原理？",
      "token_start": 1494,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 406080,
      "end_ms": 407665,
      "text": "设计的真的说不清楚，",
      "token_start": 1500,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 408310,
      "end_ms": 410550,
      "text": "只知道四座角楼。",
      "token_start": 1509,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 410690,
      "end_ms": 413625,
      "text": "从明朝永乐年间建成到今天，",
      "token_start": 1516,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 414210,
      "end_ms": 415070,
      "text": "六百年了，",
      "token_start": 1528,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 415070,
      "end_ms": 417285,
      "text": "一根木头都没换过主结构，",
      "token_start": 1532,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 417910,
      "end_ms": 421305,
      "text": "一座没有图纸的楼立了六百年。",
      "token_start": 1543,
      "token_end_exclusive": 1556
    },
    {
      "start_ms": 422540,
      "end_ms": 424545,
      "text": "今天讲的这五个您品品，",
      "token_start": 1556,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 425450,
      "end_ms": 428535,
      "text": "堂堂皇帝上厕所也得用便盆。",
      "token_start": 1566,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 429550,
      "end_ms": 431430,
      "text": "一块地砖烧五年，",
      "token_start": 1578,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 431450,
      "end_ms": 432725,
      "text": "比黄金还贵，",
      "token_start": 1585,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 433630,
      "end_ms": 436265,
      "text": "流传了几百年的房间数是错的。",
      "token_start": 1590,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 436610,
      "end_ms": 439465,
      "text": "猫在故宫上了六百年的班，",
      "token_start": 1603,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 440140,
      "end_ms": 441180,
      "text": "四座角楼，",
      "token_start": 1614,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 441220,
      "end_ms": 442040,
      "text": "精美绝伦，",
      "token_start": 1618,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 442040,
      "end_ms": 443845,
      "text": "可没人知道是谁设计的。",
      "token_start": 1622,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 444540,
      "end_ms": 450065,
      "text": "可这五个加一块都比不过前五个秘密的最离谱的那一个。",
      "token_start": 1632,
      "token_end_exclusive": 1656
    },
    {
      "start_ms": 450880,
      "end_ms": 454385,
      "text": "前五个里有一条河拐了个弯儿，",
      "token_start": 1656,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 455180,
      "end_ms": 456305,
      "text": "不是为了好看，",
      "token_start": 1669,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 457010,
      "end_ms": 458295,
      "text": "是为了防刺客。",
      "token_start": 1675,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 459170,
      "end_ms": 460050,
      "text": "有一面墙，",
      "token_start": 1681,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 460130,
      "end_ms": 462015,
      "text": "里面藏了一个机关，",
      "token_start": 1685,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 462470,
      "end_ms": 463590,
      "text": "皇帝一拍桌子，",
      "token_start": 1693,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 463590,
      "end_ms": 465545,
      "text": "外面的侍卫马上就能听见，",
      "token_start": 1699,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 466460,
      "end_ms": 469080,
      "text": "还有一套排水系统六百年了，",
      "token_start": 1710,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 469080,
      "end_ms": 469760,
      "text": "暴雨来了，",
      "token_start": 1722,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 469760,
      "end_ms": 470655,
      "text": "跟他没关系，",
      "token_start": 1726,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 471420,
      "end_ms": 473305,
      "text": "水从哪儿进就从哪出，",
      "token_start": 1731,
      "token_end_exclusive": 1740
    },
    {
      "start_ms": 473820,
      "end_ms": 474645,
      "text": "干干净净，",
      "token_start": 1740,
      "token_end_exclusive": 1744
    },
    {
      "start_ms": 475210,
      "end_ms": 478030,
      "text": "下一集已经同步更新了点。",
      "token_start": 1744,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 478030,
      "end_ms": 479650,
      "text": "我头像进主页第一条，",
      "token_start": 1755,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 479670,
      "end_ms": 483865,
      "text": "就是咱们接着接前五个秘密。",
      "token_start": 1764,
      "token_end_exclusive": 1776
    }
  ],
