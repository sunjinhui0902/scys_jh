{
  "video_id": "v_7e282e82c16ff21e",
  "duration_s": 553.772993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_7e282e82c16ff21e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_7e282e82c16ff21e.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 1070,
      "text": "你敢相信吗？",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1350,
      "end_ms": 2910,
      "text": "在中国命理学史上，",
      "token_start": 5,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 2910,
      "end_ms": 3810,
      "text": "有这样一本书，",
      "token_start": 13,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4270,
      "end_ms": 5610,
      "text": "作者不是算命先生，",
      "token_start": 19,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5710,
      "end_ms": 8830,
      "text": "而是一位很可能从未替自己算过命的读书人。",
      "token_start": 27,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 8830,
      "end_ms": 10510,
      "text": "可正是他编成了这本书，",
      "token_start": 46,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 10750,
      "end_ms": 14590,
      "text": "让此后八百年的算命江湖几乎全都改姓徐。",
      "token_start": 56,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 15290,
      "end_ms": 16070,
      "text": "直到今天，",
      "token_start": 74,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 16390,
      "end_ms": 18230,
      "text": "你遇到的每一位八字师傅，",
      "token_start": 78,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 18470,
      "end_ms": 19970,
      "text": "无论嘴上承认与否，",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 20210,
      "end_ms": 22430,
      "text": "用的仍是这本书定下的规矩。",
      "token_start": 97,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 23110,
      "end_ms": 24330,
      "text": "他以一己之力，",
      "token_start": 109,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 24470,
      "end_ms": 27810,
      "text": "把华夏命理从神仙鬼怪的泥潭里拽了出来，",
      "token_start": 115,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 27970,
      "end_ms": 29905,
      "text": "放进阴阳五行的逻辑框架。",
      "token_start": 133,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 30160,
      "end_ms": 33220,
      "text": "完成这件事儿的人叫徐大生，",
      "token_start": 144,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 33220,
      "end_ms": 35920,
      "text": "南宋钱唐书生号东斋。",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 35920,
      "end_ms": 37320,
      "text": "公元一二五三年前后，",
      "token_start": 165,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 37480,
      "end_ms": 38560,
      "text": "徐大生做了一件，",
      "token_start": 174,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 38560,
      "end_ms": 40860,
      "text": "在当时看来极其出格的事儿。",
      "token_start": 181,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 40860,
      "end_ms": 44320,
      "text": "他把五代末年以来徐子平一脉流传的论命心得，",
      "token_start": 193,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 44580,
      "end_ms": 48520,
      "text": "连同当时诸多命理名儒的文集一并汇集起来，",
      "token_start": 213,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 48700,
      "end_ms": 49540,
      "text": "编成一部书，",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 49860,
      "end_ms": 53260,
      "text": "取名渊海子平渊海二字，",
      "token_start": 237,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 53500,
      "end_ms": 54880,
      "text": "本就是汇聚之意，",
      "token_start": 247,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 55220,
      "end_ms": 56380,
      "text": "取的是渊深，",
      "token_start": 254,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 56400,
      "end_ms": 58060,
      "text": "海阔包罗万象。",
      "token_start": 259,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 58360,
      "end_ms": 61875,
      "text": "当时全国真正懂这套方法的人屈指可数。",
      "token_start": 265,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 62220,
      "end_ms": 63735,
      "text": "而徐大生看懂了，",
      "token_start": 282,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 64050,
      "end_ms": 65705,
      "text": "他在定争论中写的明白。",
      "token_start": 289,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 66130,
      "end_ms": 67050,
      "text": "人命贵贱。",
      "token_start": 299,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 67250,
      "end_ms": 69550,
      "text": "仙官月令以日干为主，",
      "token_start": 303,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 69550,
      "end_ms": 71270,
      "text": "本三元要成格局，",
      "token_start": 312,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 71550,
      "end_ms": 73170,
      "text": "四柱喜见财官。",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 73330,
      "end_ms": 74275,
      "text": "这不是迷信，",
      "token_start": 325,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 74640,
      "end_ms": 80465,
      "text": "而是中华民族第一次尝试把人的命运放进一套可推演可验证的系统里去认知。",
      "token_start": 330,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 80730,
      "end_ms": 81250,
      "text": "那一年，",
      "token_start": 363,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 81510,
      "end_ms": 84350,
      "text": "命理学仍处在那英论命的旧时代，",
      "token_start": 366,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 84350,
      "end_ms": 91400,
      "text": "人们算命靠的是鬼谷子先师传下的那英法六十甲子配五行一段生死吉凶。",
      "token_start": 380,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 91660,
      "end_ms": 93480,
      "text": "这套方法自有灵验之处，",
      "token_start": 411,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 93640,
      "end_ms": 95955,
      "text": "却有一个致命短板太粗，",
      "token_start": 421,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 96400,
      "end_ms": 97340,
      "text": "他只能告诉你，",
      "token_start": 431,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 97540,
      "end_ms": 98400,
      "text": "此人命硬，",
      "token_start": 437,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 98480,
      "end_ms": 100940,
      "text": "那人命薄却说不清为什么硬，",
      "token_start": 441,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 101020,
      "end_ms": 101835,
      "text": "为什么薄，",
      "token_start": 453,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 102150,
      "end_ms": 102730,
      "text": "更说不清。",
      "token_start": 457,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 102730,
      "end_ms": 103925,
      "text": "同一年出生的人，",
      "token_start": 461,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 104160,
      "end_ms": 105875,
      "text": "命运为何天差地别？",
      "token_start": 468,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 106530,
      "end_ms": 108195,
      "text": "徐大生接下了这个难题，",
      "token_start": 476,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 108760,
      "end_ms": 111095,
      "text": "他不再满足于那英法的笼统判断，",
      "token_start": 486,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 111450,
      "end_ms": 114575,
      "text": "而是把徐子平的财官、格局法系统化，",
      "token_start": 500,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 115090,
      "end_ms": 124260,
      "text": "将一个人出生的年月日时四柱八字拆解为天干地支、阴阳五行、食神格局一层一层。",
      "token_start": 515,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 124260,
      "end_ms": 125125,
      "text": "剥开来看，",
      "token_start": 549,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 125570,
      "end_ms": 129334,
      "text": "他做的第一件事儿是把食神体系完整立起来。",
      "token_start": 553,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 129520,
      "end_ms": 130355,
      "text": "什么是食神？",
      "token_start": 572,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 130940,
      "end_ms": 132665,
      "text": "就是以日干为中心，",
      "token_start": 577,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 133020,
      "end_ms": 139430,
      "text": "把天干与日干之间的深刻关系、阴阳配合关系转化为十种人事语言。",
      "token_start": 585,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 139610,
      "end_ms": 140970,
      "text": "正观偏官，",
      "token_start": 613,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 141350,
      "end_ms": 143720,
      "text": "正印偏印正财，",
      "token_start": 617,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 143760,
      "end_ms": 144240,
      "text": "偏财，",
      "token_start": 623,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 144540,
      "end_ms": 145080,
      "text": "食神，",
      "token_start": 625,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 145380,
      "end_ms": 147555,
      "text": "商官比肩劫财，",
      "token_start": 627,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 147970,
      "end_ms": 148995,
      "text": "正官是贵气，",
      "token_start": 633,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 149300,
      "end_ms": 150300,
      "text": "七杀是压力。",
      "token_start": 638,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 150520,
      "end_ms": 151600,
      "text": "正应是庇护，",
      "token_start": 643,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 151780,
      "end_ms": 152895,
      "text": "食神是福气，",
      "token_start": 648,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 153230,
      "end_ms": 154270,
      "text": "商官是才华，",
      "token_start": 653,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 154490,
      "end_ms": 155170,
      "text": "也是锋芒。",
      "token_start": 658,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 155370,
      "end_ms": 159490,
      "text": "徐大生用这套体系第一次让命里从看命转向，",
      "token_start": 662,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 159490,
      "end_ms": 161310,
      "text": "看人一个人是什么性情，",
      "token_start": 681,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 161530,
      "end_ms": 163270,
      "text": "适合走什么路、何时该进，",
      "token_start": 691,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 163290,
      "end_ms": 164075,
      "text": "何时该退，",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 164390,
      "end_ms": 167005,
      "text": "都能在这十个概念的交错中找到线索。",
      "token_start": 705,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 167880,
      "end_ms": 169460,
      "text": "后世所有八字师傅，",
      "token_start": 721,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 169640,
      "end_ms": 170875,
      "text": "无论哪门哪派，",
      "token_start": 729,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 171170,
      "end_ms": 171690,
      "text": "一开口，",
      "token_start": 735,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 171690,
      "end_ms": 178245,
      "text": "就是你这个八字正官格官心透干源头都在渊海紫平。",
      "token_start": 738,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 178670,
      "end_ms": 183915,
      "text": "他做的第二件事是把格局从模糊的经验变成清晰的分类。",
      "token_start": 760,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 184400,
      "end_ms": 185400,
      "text": "在渊海紫坪中，",
      "token_start": 784,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 185620,
      "end_ms": 189280,
      "text": "徐大生将格局分为内十八阁和外十八阁，",
      "token_start": 790,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 189360,
      "end_ms": 199230,
      "text": "内十八阁包括正官阁月上偏官阁、时尚偏财阁、映寿阁、杂器财官阁等是常规命局的主流判断框架。",
      "token_start": 807,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 199310,
      "end_ms": 207054,
      "text": "外十八格则包括沿上格润、下格、从格格、曲直、格、架、色格等特殊格局，",
      "token_start": 847,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 207450,
      "end_ms": 211795,
      "text": "处理的是五行偏枯却反而大富大贵的极端情况。",
      "token_start": 874,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 212200,
      "end_ms": 217040,
      "text": "这套分类法把命理学从口诀式经验推向体系化推演，",
      "token_start": 894,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 217100,
      "end_ms": 217980,
      "text": "拿到一个八字，",
      "token_start": 916,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 218180,
      "end_ms": 219060,
      "text": "先看月令，",
      "token_start": 922,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 219280,
      "end_ms": 220480,
      "text": "月令决定格局，",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 220620,
      "end_ms": 223775,
      "text": "格局决定用神用神决定吉凶。",
      "token_start": 932,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 224240,
      "end_ms": 225560,
      "text": "这条链条一旦建立，",
      "token_start": 944,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 225800,
      "end_ms": 227475,
      "text": "算命就不再是猜，",
      "token_start": 952,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 227890,
      "end_ms": 229490,
      "text": "而是算他做的。",
      "token_start": 959,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 229490,
      "end_ms": 233345,
      "text": "第三件事是把命理判断的逻辑链条完整写了出来。",
      "token_start": 965,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 233910,
      "end_ms": 234810,
      "text": "在祭善篇中，",
      "token_start": 986,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 234890,
      "end_ms": 235475,
      "text": "他写道，",
      "token_start": 991,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 235960,
      "end_ms": 242380,
      "text": "欲知贵贱相官月令奶皮缸刺断吉凶专用日干为主，",
      "token_start": 994,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 242380,
      "end_ms": 244590,
      "text": "本三元要成格局，",
      "token_start": 1015,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 244910,
      "end_ms": 246350,
      "text": "四柱喜建财，",
      "token_start": 1022,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 246350,
      "end_ms": 247360,
      "text": "官用，",
      "token_start": 1027,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 247360,
      "end_ms": 248665,
      "text": "神不可损伤，",
      "token_start": 1029,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 249050,
      "end_ms": 250555,
      "text": "日主最宜剑忘。",
      "token_start": 1034,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 250760,
      "end_ms": 254605,
      "text": "这段话就是整部渊海子平的方法论总纲。",
      "token_start": 1040,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 255520,
      "end_ms": 256960,
      "text": "月令是刚日，",
      "token_start": 1057,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 256980,
      "end_ms": 257735,
      "text": "刚是主，",
      "token_start": 1062,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 258110,
      "end_ms": 259015,
      "text": "格局是框架，",
      "token_start": 1065,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 259320,
      "end_ms": 260495,
      "text": "用神是核心，",
      "token_start": 1070,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 260930,
      "end_ms": 262595,
      "text": "日主健忘是底线。",
      "token_start": 1075,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 263070,
      "end_ms": 264390,
      "text": "任何一个八字拿到手，",
      "token_start": 1082,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 264570,
      "end_ms": 265955,
      "text": "先看月令是什么？",
      "token_start": 1091,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 266180,
      "end_ms": 267340,
      "text": "再看日干强不强，",
      "token_start": 1098,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 267620,
      "end_ms": 269000,
      "text": "再看格局成不成。",
      "token_start": 1105,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 269200,
      "end_ms": 271045,
      "text": "再看用神有没有受伤，",
      "token_start": 1112,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 271590,
      "end_ms": 272290,
      "text": "这套逻辑，",
      "token_start": 1121,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 272310,
      "end_ms": 273150,
      "text": "环环相扣，",
      "token_start": 1125,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 273310,
      "end_ms": 274355,
      "text": "没有一处含糊。",
      "token_start": 1129,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 274930,
      "end_ms": 279235,
      "text": "这也是为什么后世盲人师傅能整本背诵渊海子平。",
      "token_start": 1135,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 279600,
      "end_ms": 282000,
      "text": "因为书中的每一个判断都有依据，",
      "token_start": 1156,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 282200,
      "end_ms": 285825,
      "text": "每一个依据都能回溯到阴阳五行的基本关系上。",
      "token_start": 1170,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 286240,
      "end_ms": 287840,
      "text": "但徐大生最狠的一招，",
      "token_start": 1190,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 287960,
      "end_ms": 290255,
      "text": "还不在于他把理论建的有多完整，",
      "token_start": 1199,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 290600,
      "end_ms": 292095,
      "text": "而在于他做了一个决定。",
      "token_start": 1213,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 292450,
      "end_ms": 295330,
      "text": "把密传公开在他之前，",
      "token_start": 1223,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 295550,
      "end_ms": 298930,
      "text": "命理学的核心技法大多掌握在少数术士手里，",
      "token_start": 1232,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 299410,
      "end_ms": 300190,
      "text": "师徒之间，",
      "token_start": 1251,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 300210,
      "end_ms": 300970,
      "text": "口耳相传，",
      "token_start": 1255,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 301190,
      "end_ms": 302810,
      "text": "外人根本摸不到门路。",
      "token_start": 1259,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 303490,
      "end_ms": 306130,
      "text": "徐大生却选择集诸儒之意。",
      "token_start": 1268,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 306130,
      "end_ms": 310950,
      "text": "传部把当时能收集到的命理论述汇编成书公之于世。",
      "token_start": 1279,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 311250,
      "end_ms": 313290,
      "text": "他放弃的是秘传的优势，",
      "token_start": 1301,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 313790,
      "end_ms": 316090,
      "text": "换来的却是一门学问的生存。",
      "token_start": 1311,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 316550,
      "end_ms": 320710,
      "text": "这个决定让渊海子平成为八字命理学的宗祖之作，",
      "token_start": 1323,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 321050,
      "end_ms": 324200,
      "text": "也成为此后所有有命理著作绕不开的起点。",
      "token_start": 1344,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 324260,
      "end_ms": 325100,
      "text": "没有这本书，",
      "token_start": 1362,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 325260,
      "end_ms": 326900,
      "text": "就没有后来的三命通会，",
      "token_start": 1367,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 327200,
      "end_ms": 328280,
      "text": "没有子凭真全。",
      "token_start": 1377,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 328600,
      "end_ms": 329480,
      "text": "没有滴天髓。",
      "token_start": 1383,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 329680,
      "end_ms": 332660,
      "text": "后世命理学的繁荣几乎都建立在徐大生。",
      "token_start": 1388,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 332660,
      "end_ms": 333840,
      "text": "这一次公开之上。",
      "token_start": 1405,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 334200,
      "end_ms": 335580,
      "text": "这部书共分五卷，",
      "token_start": 1412,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 335880,
      "end_ms": 336640,
      "text": "结构清晰，",
      "token_start": 1419,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 336840,
      "end_ms": 337720,
      "text": "层层递进。",
      "token_start": 1423,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 338040,
      "end_ms": 339220,
      "text": "第一卷讲基础，",
      "token_start": 1427,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 339500,
      "end_ms": 340780,
      "text": "五行所生之始，",
      "token_start": 1433,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 341040,
      "end_ms": 342760,
      "text": "天干地支所出天。",
      "token_start": 1439,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 342760,
      "end_ms": 344600,
      "text": "十甲子纳阴天干，",
      "token_start": 1446,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 344640,
      "end_ms": 345500,
      "text": "生旺死绝。",
      "token_start": 1453,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 345740,
      "end_ms": 348860,
      "text": "各种神煞以及起大运小运的方法，",
      "token_start": 1457,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 349140,
      "end_ms": 350360,
      "text": "这是全书的地基。",
      "token_start": 1471,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 351020,
      "end_ms": 352155,
      "text": "第二卷讲核心，",
      "token_start": 1478,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 352780,
      "end_ms": 355480,
      "text": "以祭善篇和看命入世为纲领，",
      "token_start": 1484,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 355640,
      "end_ms": 365575,
      "text": "详细论述正官、偏官欺杀、硬瘦、正财、偏财、食神、商官、劫财、洋刃等食神的用法，",
      "token_start": 1496,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 365900,
      "end_ms": 368015,
      "text": "以及各种格局的取法和判断。",
      "token_start": 1526,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 368420,
      "end_ms": 369595,
      "text": "这是全书的心脏。",
      "token_start": 1538,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 370220,
      "end_ms": 372870,
      "text": "第三卷讲六亲与人伦论，",
      "token_start": 1545,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 372870,
      "end_ms": 379755,
      "text": "父母七世、兄弟姐妹、子熙、女命、小儿庞及性情与疾病，",
      "token_start": 1555,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 380140,
      "end_ms": 381460,
      "text": "这是全书的血肉。",
      "token_start": 1576,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 381520,
      "end_ms": 387440,
      "text": "第四卷论人剑和十二月剑猴第五卷收尸诀是实战经验的精华，",
      "token_start": 1583,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 387440,
      "end_ms": 389210,
      "text": "集结五卷下来，",
      "token_start": 1609,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 389290,
      "end_ms": 390850,
      "text": "从宇宙观到方法论，",
      "token_start": 1615,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 391010,
      "end_ms": 393135,
      "text": "从理论框架到实战口诀，",
      "token_start": 1623,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 393460,
      "end_ms": 396255,
      "text": "一座完整的命理学大厦便立了起来。",
      "token_start": 1633,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 396730,
      "end_ms": 397110,
      "text": "当然，",
      "token_start": 1648,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 397470,
      "end_ms": 398975,
      "text": "徐大生也有他的局限，",
      "token_start": 1650,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 399510,
      "end_ms": 400745,
      "text": "他把话说得很明白，",
      "token_start": 1659,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 401210,
      "end_ms": 403555,
      "text": "这本书的方法简要而实用，",
      "token_start": 1667,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 403870,
      "end_ms": 404970,
      "text": "但分类不明，",
      "token_start": 1678,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 405250,
      "end_ms": 406275,
      "text": "论述粗略，",
      "token_start": 1683,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 407050,
      "end_ms": 407955,
      "text": "这不是谦虚，",
      "token_start": 1687,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 408310,
      "end_ms": 409085,
      "text": "而是事实。",
      "token_start": 1692,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 409960,
      "end_ms": 411400,
      "text": "作为第一部系统著作，",
      "token_start": 1696,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 411560,
      "end_ms": 414205,
      "text": "它的价值在于开创在于奠基，",
      "token_start": 1705,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 414550,
      "end_ms": 415490,
      "text": "而不在于精威。",
      "token_start": 1717,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 415550,
      "end_ms": 417770,
      "text": "后来的紫平真权把格局论命，",
      "token_start": 1723,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 417830,
      "end_ms": 419760,
      "text": "精雕细琢、地天髓，",
      "token_start": 1735,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 419920,
      "end_ms": 422260,
      "text": "把五行深刻推向哲学高度，",
      "token_start": 1742,
      "token_end_exclusive": 1753
    },
    {
      "start_ms": 422420,
      "end_ms": 425305,
      "text": "三命通会把资料汇编做到极致，",
      "token_start": 1753,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 425720,
      "end_ms": 428060,
      "text": "他们都是站在渊海紫平的肩膀上，",
      "token_start": 1766,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 428080,
      "end_ms": 429175,
      "text": "继续往前走的，",
      "token_start": 1780,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 429410,
      "end_ms": 431395,
      "text": "没有这个粗糙却坚实的起点，",
      "token_start": 1786,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 431690,
      "end_ms": 433205,
      "text": "后面的路无从谈起。",
      "token_start": 1798,
      "token_end_exclusive": 1806
    },
    {
      "start_ms": 433870,
      "end_ms": 436155,
      "text": "但徐大生的故事并未就此结束，",
      "token_start": 1806,
      "token_end_exclusive": 1819
    },
    {
      "start_ms": 436660,
      "end_ms": 438015,
      "text": "因为渊海紫平之后，",
      "token_start": 1819,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 438290,
      "end_ms": 441055,
      "text": "命理学又走过八百年八百年里，",
      "token_start": 1827,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 441370,
      "end_ms": 448900,
      "text": "江湖上出现了无数自称秘传真爵的算命师傅出现了无数让人越读越糊涂的白话译本，",
      "token_start": 1840,
      "token_end_exclusive": 1876
    },
    {
      "start_ms": 448900,
      "end_ms": 451340,
      "text": "也出现了无数把命理包装成玄学，",
      "token_start": 1876,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 451600,
      "end_ms": 454075,
      "text": "再把玄学包装成迷信的生意人。",
      "token_start": 1890,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 454400,
      "end_ms": 455700,
      "text": "普通人读不懂古文，",
      "token_start": 1903,
      "token_end_exclusive": 1911
    },
    {
      "start_ms": 455960,
      "end_ms": 459260,
      "text": "被劣质白话片爱好者被江湖神棍收割，",
      "token_start": 1911,
      "token_end_exclusive": 1927
    },
    {
      "start_ms": 459380,
      "end_ms": 460220,
      "text": "越修越偏。",
      "token_start": 1927,
      "token_end_exclusive": 1931
    },
    {
      "start_ms": 460400,
      "end_ms": 462485,
      "text": "真正的方法论藏在固纸堆里。",
      "token_start": 1931,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 462880,
      "end_ms": 465285,
      "text": "最核心的食神体系与格局框架，",
      "token_start": 1943,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 465640,
      "end_ms": 468885,
      "text": "反而被各种花里胡哨的神煞和口诀掩盖了。",
      "token_start": 1956,
      "token_end_exclusive": 1974
    },
    {
      "start_ms": 469300,
      "end_ms": 472275,
      "text": "于是有一条路被重新铺了出来。",
      "token_start": 1974,
      "token_end_exclusive": 1987
    },
    {
      "start_ms": 472830,
      "end_ms": 474970,
      "text": "一本以渊海子平为根基，",
      "token_start": 1987,
      "token_end_exclusive": 1997
    },
    {
      "start_ms": 475210,
      "end_ms": 481135,
      "text": "把整个子平命理体系用现代汉语重新讲透的书被推到普通人面前。",
      "token_start": 1997,
      "token_end_exclusive": 2025
    },
    {
      "start_ms": 481410,
      "end_ms": 482250,
      "text": "他没有迷信，",
      "token_start": 2025,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 482470,
      "end_ms": 483375,
      "text": "没有玄虚，",
      "token_start": 2030,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 483860,
      "end_ms": 485565,
      "text": "只有一位严谨的整理者。",
      "token_start": 2034,
      "token_end_exclusive": 2044
    },
    {
      "start_ms": 485800,
      "end_ms": 488260,
      "text": "把从徐子平到徐大生的命理脉络，",
      "token_start": 2044,
      "token_end_exclusive": 2058
    },
    {
      "start_ms": 488420,
      "end_ms": 490725,
      "text": "从食神到格局的内在逻辑，",
      "token_start": 2058,
      "token_end_exclusive": 2069
    },
    {
      "start_ms": 491040,
      "end_ms": 494160,
      "text": "从月令取用到岁运判断的完整链条，",
      "token_start": 2069,
      "token_end_exclusive": 2084
    },
    {
      "start_ms": 494420,
      "end_ms": 496805,
      "text": "用大白话一条一条拆开来讲，",
      "token_start": 2084,
      "token_end_exclusive": 2096
    },
    {
      "start_ms": 497220,
      "end_ms": 498205,
      "text": "你不需要背古文，",
      "token_start": 2096,
      "token_end_exclusive": 2103
    },
    {
      "start_ms": 498440,
      "end_ms": 499345,
      "text": "不需要拜师傅，",
      "token_start": 2103,
      "token_end_exclusive": 2109
    },
    {
      "start_ms": 499630,
      "end_ms": 501490,
      "text": "不需要在论坛上被大师们带偏。",
      "token_start": 2109,
      "token_end_exclusive": 2122
    },
    {
      "start_ms": 501830,
      "end_ms": 503055,
      "text": "你只需打开第一页，",
      "token_start": 2122,
      "token_end_exclusive": 2130
    },
    {
      "start_ms": 503360,
      "end_ms": 506305,
      "text": "就能沿着八百年前徐大生铺下的那条路，",
      "token_start": 2130,
      "token_end_exclusive": 2147
    },
    {
      "start_ms": 506610,
      "end_ms": 507930,
      "text": "一步一步走进去。",
      "token_start": 2147,
      "token_end_exclusive": 2154
    },
    {
      "start_ms": 508130,
      "end_ms": 511665,
      "text": "徐大生用一辈子把命理从密传变成公开。",
      "token_start": 2154,
      "token_end_exclusive": 2171
    },
    {
      "start_ms": 512160,
      "end_ms": 516515,
      "text": "后来真正要做的是把公开的命理从混乱变回清晰。",
      "token_start": 2171,
      "token_end_exclusive": 2192
    },
    {
      "start_ms": 517160,
      "end_ms": 517840,
      "text": "可说到底，",
      "token_start": 2192,
      "token_end_exclusive": 2196
    },
    {
      "start_ms": 518220,
      "end_ms": 521525,
      "text": "这条路的源头还是那本渊海紫平，",
      "token_start": 2196,
      "token_end_exclusive": 2210
    },
    {
      "start_ms": 522030,
      "end_ms": 523175,
      "text": "他直得放在枕边，",
      "token_start": 2210,
      "token_end_exclusive": 2217
    },
    {
      "start_ms": 523550,
      "end_ms": 524935,
      "text": "不是因为他能算准，",
      "token_start": 2217,
      "token_end_exclusive": 2225
    },
    {
      "start_ms": 525360,
      "end_ms": 528360,
      "text": "而是因为它能让你在遇到任何一个八字时，",
      "token_start": 2225,
      "token_end_exclusive": 2243
    },
    {
      "start_ms": 528620,
      "end_ms": 531305,
      "text": "心里有一张清清楚楚的地图。",
      "token_start": 2243,
      "token_end_exclusive": 2255
    },
    {
      "start_ms": 531780,
      "end_ms": 532535,
      "text": "八百年前，",
      "token_start": 2255,
      "token_end_exclusive": 2259
    },
    {
      "start_ms": 532900,
      "end_ms": 535215,
      "text": "徐大生在钱塘的某个书斋里，",
      "token_start": 2259,
      "token_end_exclusive": 2271
    },
    {
      "start_ms": 535520,
      "end_ms": 536280,
      "text": "一笔一笔，",
      "token_start": 2271,
      "token_end_exclusive": 2275
    },
    {
      "start_ms": 536280,
      "end_ms": 538735,
      "text": "把零散的命理口诀整理成章。",
      "token_start": 2275,
      "token_end_exclusive": 2287
    },
    {
      "start_ms": 539390,
      "end_ms": 540715,
      "text": "他没有算过自己的命，",
      "token_start": 2287,
      "token_end_exclusive": 2296
    },
    {
      "start_ms": 541110,
      "end_ms": 543225,
      "text": "却为后来者铺好了一条路，",
      "token_start": 2296,
      "token_end_exclusive": 2307
    },
    {
      "start_ms": 543710,
      "end_ms": 546255,
      "text": "你只是翻开第一页就能走上去。",
      "token_start": 2307,
      "token_end_exclusive": 2320
    },
    {
      "start_ms": 546720,
      "end_ms": 547475,
      "text": "而那一夜，",
      "token_start": 2320,
      "token_end_exclusive": 2324
    },
    {
      "start_ms": 548090,
      "end_ms": 550590,
      "text": "不妨就从渊海紫坪翻开，",
      "token_start": 2324,
      "token_end_exclusive": 2334
    },
    {
      "start_ms": 550850,
      "end_ms": 551645,
      "text": "我是小海龟，",
      "token_start": 2334,
      "token_end_exclusive": 2339
    },
    {
      "start_ms": 551910,
      "end_ms": 553655,
      "text": "欢迎持续关注我们下本书见。",
      "token_start": 2339,
      "token_end_exclusive": 2351
    }
  ],
