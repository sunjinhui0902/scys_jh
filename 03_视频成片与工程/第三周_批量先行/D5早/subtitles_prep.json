[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "跟亲家吃饭，",
    "chars": 6
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "主位的椅子刚拉开，您是先坐，",
    "chars": 14
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "还是先让？",
    "chars": 5
  },
  {
    "screen": 4,
    "line_id": "A02",
    "role": "爷爷",
    "text": "两亲家坐到一张桌上，",
    "chars": 10
  },
  {
    "screen": 5,
    "line_id": "A02",
    "role": "爷爷",
    "text": "处好了是亲戚，处不好，",
    "chars": 11
  },
  {
    "screen": 6,
    "line_id": "A02",
    "role": "爷爷",
    "text": "夹在中间的儿女最难做。",
    "chars": 11
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "座次上没那么多死规矩，",
    "chars": 11
  },
  {
    "screen": 8,
    "line_id": "A03",
    "role": "爷爷",
    "text": "就一条：先请年长的亲家落座，",
    "chars": 14
  },
  {
    "screen": 9,
    "line_id": "A03",
    "role": "爷爷",
    "text": "按各家的习惯来，别抢，",
    "chars": 11
  },
  {
    "screen": 10,
    "line_id": "A03",
    "role": "爷爷",
    "text": "也别推来推去，落座利索，",
    "chars": 12
  },
  {
    "screen": 11,
    "line_id": "A03",
    "role": "爷爷",
    "text": "大家都自在。",
    "chars": 6
  },
  {
    "screen": 12,
    "line_id": "A04",
    "role": "爷爷",
    "text": "再说说话头，三样少提：",
    "chars": 11
  },
  {
    "screen": 13,
    "line_id": "A04",
    "role": "爷爷",
    "text": "一不比——",
    "chars": 5
  },
  {
    "screen": 14,
    "line_id": "A04",
    "role": "爷爷",
    "text": "不比谁家孩子挣得多、",
    "chars": 10
  },
  {
    "screen": 15,
    "line_id": "A04",
    "role": "爷爷",
    "text": "谁家房子大；",
    "chars": 6
  },
  {
    "screen": 16,
    "line_id": "A05",
    "role": "爷爷",
    "text": "二不翻——",
    "chars": 5
  },
  {
    "screen": 17,
    "line_id": "A05",
    "role": "爷爷",
    "text": "儿女小两口拌嘴的事，",
    "chars": 10
  },
  {
    "screen": 18,
    "line_id": "A05",
    "role": "爷爷",
    "text": "不往饭桌上端；",
    "chars": 7
  },
  {
    "screen": 19,
    "line_id": "A06",
    "role": "爷爷",
    "text": "三不打听——人家的家事、",
    "chars": 12
  },
  {
    "screen": 20,
    "line_id": "A06",
    "role": "爷爷",
    "text": "钱财安排，那是人家的私事。",
    "chars": 13
  },
  {
    "screen": 21,
    "line_id": "A07",
    "role": "爷爷",
    "text": "夸倒是可以多夸：",
    "chars": 8
  },
  {
    "screen": 22,
    "line_id": "A07",
    "role": "爷爷",
    "text": "夸对方把孩子教得好，这一句，",
    "chars": 14
  },
  {
    "screen": 23,
    "line_id": "A07",
    "role": "爷爷",
    "text": "比送什么都受用。",
    "chars": 8
  },
  {
    "screen": 24,
    "line_id": "A08",
    "role": "爷爷",
    "text": "亲家这门亲，近不得远不得，",
    "chars": 13
  },
  {
    "screen": 25,
    "line_id": "A08",
    "role": "爷爷",
    "text": "全在分寸二字。",
    "chars": 7
  }
]