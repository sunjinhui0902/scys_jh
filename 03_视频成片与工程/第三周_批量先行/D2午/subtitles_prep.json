[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "敦煌莫高窟有些壁画上的人脸，",
    "chars": 14
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "看着是黑的——可据研究，",
    "chars": 12
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "画上去那会儿，",
    "chars": 7
  },
  {
    "screen": 4,
    "line_id": "A01",
    "role": "爷爷",
    "text": "原是白净的肉色，",
    "chars": 8
  },
  {
    "screen": 5,
    "line_id": "A01",
    "role": "爷爷",
    "text": "是颜料里的含铅成分，",
    "chars": 10
  },
  {
    "screen": 6,
    "line_id": "A01",
    "role": "爷爷",
    "text": "年久慢慢氧化变了色。",
    "chars": 10
  },
  {
    "screen": 7,
    "line_id": "A02",
    "role": "爷爷",
    "text": "头一个是干：敦煌少雨，",
    "chars": 11
  },
  {
    "screen": 8,
    "line_id": "A02",
    "role": "爷爷",
    "text": "空气干燥，",
    "chars": 5
  },
  {
    "screen": 9,
    "line_id": "A02",
    "role": "爷爷",
    "text": "潮气对颜料的伤害小。",
    "chars": 10
  },
  {
    "screen": 10,
    "line_id": "A03",
    "role": "爷爷",
    "text": "第二个是藏：洞窟开在崖壁上，",
    "chars": 14
  },
  {
    "screen": 11,
    "line_id": "A03",
    "role": "爷爷",
    "text": "平时不见强光，光照少，",
    "chars": 11
  },
  {
    "screen": 12,
    "line_id": "A03",
    "role": "爷爷",
    "text": "颜色褪得慢。",
    "chars": 6
  },
  {
    "screen": 13,
    "line_id": "A04",
    "role": "爷爷",
    "text": "第三个是料：",
    "chars": 6
  },
  {
    "screen": 14,
    "line_id": "A04",
    "role": "爷爷",
    "text": "古人多用矿物颜料，",
    "chars": 9
  },
  {
    "screen": 15,
    "line_id": "A04",
    "role": "爷爷",
    "text": "从石头里磨出来的颜色，",
    "chars": 11
  },
  {
    "screen": 16,
    "line_id": "A04",
    "role": "爷爷",
    "text": "相对稳定。",
    "chars": 5
  },
  {
    "screen": 17,
    "line_id": "A05",
    "role": "爷爷",
    "text": "当然，",
    "chars": 3
  },
  {
    "screen": 18,
    "line_id": "A05",
    "role": "爷爷",
    "text": "不是所有颜色都一成不变：",
    "chars": 12
  },
  {
    "screen": 19,
    "line_id": "A05",
    "role": "爷爷",
    "text": "有的颜料会氧化、变暗，",
    "chars": 11
  },
  {
    "screen": 20,
    "line_id": "A05",
    "role": "爷爷",
    "text": "壁画也会褪色，",
    "chars": 7
  },
  {
    "screen": 21,
    "line_id": "A05",
    "role": "爷爷",
    "text": "所以今天还有那么多人在精心",
    "chars": 13
  },
  {
    "screen": 22,
    "line_id": "A05",
    "role": "爷爷",
    "text": "护着它们。",
    "chars": 5
  },
  {
    "screen": 23,
    "line_id": "A06",
    "role": "爷爷",
    "text": "干燥、避光、颜料稳，",
    "chars": 10
  },
  {
    "screen": 24,
    "line_id": "A06",
    "role": "爷爷",
    "text": "再加上一代代人守护，",
    "chars": 10
  },
  {
    "screen": 25,
    "line_id": "A06",
    "role": "爷爷",
    "text": "才有了我们今天还",
    "chars": 8
  },
  {
    "screen": 26,
    "line_id": "A06",
    "role": "爷爷",
    "text": "能看见的千年颜色。",
    "chars": 9
  }
]