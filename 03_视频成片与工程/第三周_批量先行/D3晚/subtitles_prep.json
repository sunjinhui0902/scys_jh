[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "帮邻居接了一次孩子，",
    "chars": 10
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "后来天天都成了您的活儿；",
    "chars": 12
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "哪天您说有事，",
    "chars": 7
  },
  {
    "screen": 4,
    "line_id": "A01",
    "role": "爷爷",
    "text": "对方反倒不高兴了——好心，",
    "chars": 13
  },
  {
    "screen": 5,
    "line_id": "A01",
    "role": "爷爷",
    "text": "怎么就帮成了应该的？",
    "chars": 10
  },
  {
    "screen": 6,
    "line_id": "A02",
    "role": "爷爷",
    "text": "老话说，人善被人欺。",
    "chars": 10
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "可善良不等于没底线。",
    "chars": 10
  },
  {
    "screen": 8,
    "line_id": "A04",
    "role": "爷爷",
    "text": "《被遗忘的后半句》第一章第",
    "chars": 13
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "爷爷",
    "text": "10条写着：",
    "chars": 6
  },
  {
    "screen": 10,
    "line_id": "A04",
    "role": "爷爷",
    "text": "宁可人负我，切莫我负人。",
    "chars": 12
  },
  {
    "screen": 11,
    "line_id": "A05",
    "role": "爷爷",
    "text": "很多人把这句听成劝老实人",
    "chars": 12
  },
  {
    "screen": 12,
    "line_id": "A05",
    "role": "爷爷",
    "text": "忍着，",
    "chars": 3
  },
  {
    "screen": 13,
    "line_id": "A05",
    "role": "爷爷",
    "text": "我看不是。",
    "chars": 5
  },
  {
    "screen": 14,
    "line_id": "A06",
    "role": "爷爷",
    "text": "它说的是修养：别人负我，",
    "chars": 12
  },
  {
    "screen": 15,
    "line_id": "A06",
    "role": "爷爷",
    "text": "是他的事；我不负人，",
    "chars": 10
  },
  {
    "screen": 16,
    "line_id": "A06",
    "role": "爷爷",
    "text": "是我守的底线。",
    "chars": 7
  },
  {
    "screen": 17,
    "line_id": "A07",
    "role": "爷爷",
    "text": "可它从没说过，负我的人，",
    "chars": 12
  },
  {
    "screen": 18,
    "line_id": "A07",
    "role": "爷爷",
    "text": "我还得接着帮。",
    "chars": 7
  },
  {
    "screen": 19,
    "line_id": "A08",
    "role": "爷爷",
    "text": "善良的牙齿就在这儿：",
    "chars": 10
  },
  {
    "screen": 20,
    "line_id": "A08",
    "role": "爷爷",
    "text": "第一次帮是情分，",
    "chars": 8
  },
  {
    "screen": 21,
    "line_id": "A08",
    "role": "爷爷",
    "text": "对方得寸进尺，",
    "chars": 7
  },
  {
    "screen": 22,
    "line_id": "A08",
    "role": "爷爷",
    "text": "就当场把话说清——这次帮完，",
    "chars": 14
  },
  {
    "screen": 23,
    "line_id": "A08",
    "role": "爷爷",
    "text": "下次请提前安排；",
    "chars": 8
  },
  {
    "screen": 24,
    "line_id": "A09",
    "role": "爷爷",
    "text": "不吵不闹，但这个忙，",
    "chars": 10
  },
  {
    "screen": 25,
    "line_id": "A09",
    "role": "爷爷",
    "text": "到此为止。",
    "chars": 5
  },
  {
    "screen": 26,
    "line_id": "A10",
    "role": "爷爷",
    "text": "这本书我放在主页橱窗里了，",
    "chars": 13
  },
  {
    "screen": 27,
    "line_id": "A10",
    "role": "爷爷",
    "text": "点开我主页，商品橱窗里就有。",
    "chars": 14
  },
  {
    "screen": 28,
    "line_id": "A11",
    "role": "爷爷",
    "text": "您有没有帮着帮着、",
    "chars": 9
  },
  {
    "screen": 29,
    "line_id": "A11",
    "role": "爷爷",
    "text": "帮成应该的？",
    "chars": 6
  },
  {
    "screen": 30,
    "line_id": "A11",
    "role": "爷爷",
    "text": "后来是怎么收的场？",
    "chars": 9
  }
]