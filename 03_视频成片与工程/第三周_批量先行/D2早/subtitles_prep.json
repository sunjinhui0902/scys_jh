[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "儿女一句话：爸妈，",
    "chars": 9
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "孩子以后就全靠你们了。",
    "chars": 11
  },
  {
    "screen": 3,
    "line_id": "A02",
    "role": "爷爷",
    "text": "您要是当场一口应下，",
    "chars": 10
  },
  {
    "screen": 4,
    "line_id": "A02",
    "role": "爷爷",
    "text": "往后累了都不好意思开口；",
    "chars": 12
  },
  {
    "screen": 5,
    "line_id": "A02",
    "role": "爷爷",
    "text": "一口回绝，又怕伤了孩子的心。",
    "chars": 14
  },
  {
    "screen": 6,
    "line_id": "A03",
    "role": "爷爷",
    "text": "其实这事，答应不答应，",
    "chars": 11
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "先别急着表态，",
    "chars": 7
  },
  {
    "screen": 8,
    "line_id": "A03",
    "role": "爷爷",
    "text": "把四件事摆到桌面上说清：",
    "chars": 12
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "爷爷",
    "text": "第一，带到几岁有个头；",
    "chars": 11
  },
  {
    "screen": 10,
    "line_id": "A05",
    "role": "爷爷",
    "text": "第二，日常接送、",
    "chars": 8
  },
  {
    "screen": 11,
    "line_id": "A05",
    "role": "爷爷",
    "text": "买菜做饭这些活怎么分工；",
    "chars": 12
  },
  {
    "screen": 12,
    "line_id": "A06",
    "role": "爷爷",
    "text": "第三，孩子生病、家里有急事，",
    "chars": 14
  },
  {
    "screen": 13,
    "line_id": "A06",
    "role": "爷爷",
    "text": "谁请假、谁顶上，",
    "chars": 8
  },
  {
    "screen": 14,
    "line_id": "A06",
    "role": "爷爷",
    "text": "别全压在老人身上；",
    "chars": 9
  },
  {
    "screen": 15,
    "line_id": "A07",
    "role": "爷爷",
    "text": "第四，留出您二老自己的时间，",
    "chars": 14
  },
  {
    "screen": 16,
    "line_id": "A07",
    "role": "爷爷",
    "text": "看病、串门、跳个广场舞，",
    "chars": 12
  },
  {
    "screen": 17,
    "line_id": "A07",
    "role": "爷爷",
    "text": "那是正事不是偷懒。",
    "chars": 9
  },
  {
    "screen": 18,
    "line_id": "A08",
    "role": "爷爷",
    "text": "话说清了再点头，这不叫算计，",
    "chars": 14
  },
  {
    "screen": 19,
    "line_id": "A08",
    "role": "爷爷",
    "text": "叫把日子过长久。",
    "chars": 8
  },
  {
    "screen": 20,
    "line_id": "A09",
    "role": "爷爷",
    "text": "帮儿女带娃是情分，",
    "chars": 9
  },
  {
    "screen": 21,
    "line_id": "A09",
    "role": "爷爷",
    "text": "不是欠他们的债；",
    "chars": 8
  },
  {
    "screen": 22,
    "line_id": "A09",
    "role": "爷爷",
    "text": "把丑话说在前头，",
    "chars": 8
  },
  {
    "screen": 23,
    "line_id": "A09",
    "role": "爷爷",
    "text": "一家人反倒处得亲。",
    "chars": 9
  }
]