[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "奶奶",
    "text": "刚才孩子他爸罚站，",
    "chars": 9
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "奶奶",
    "text": "你当着面就把孩子拉走了，",
    "chars": 12
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "奶奶",
    "text": "我看儿子脸都沉了。",
    "chars": 9
  },
  {
    "screen": 4,
    "line_id": "A02",
    "role": "爷爷",
    "text": "孩子哭成那样，我能不心疼吗？",
    "chars": 14
  },
  {
    "screen": 5,
    "line_id": "A03",
    "role": "奶奶",
    "text": "心疼也得先忍着。",
    "chars": 8
  },
  {
    "screen": 6,
    "line_id": "A04",
    "role": "奶奶",
    "text": "普通的管教，先让儿女说完；",
    "chars": 13
  },
  {
    "screen": 7,
    "line_id": "A04",
    "role": "奶奶",
    "text": "咱一拆台，",
    "chars": 5
  },
  {
    "screen": 8,
    "line_id": "A04",
    "role": "奶奶",
    "text": "往后他爸说话就不算数，",
    "chars": 11
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "奶奶",
    "text": "孩子专挑咱俩当靠山。",
    "chars": 10
  },
  {
    "screen": 10,
    "line_id": "A05",
    "role": "奶奶",
    "text": "真要是动手伤着孩子，",
    "chars": 10
  },
  {
    "screen": 11,
    "line_id": "A05",
    "role": "奶奶",
    "text": "那另说，得拦。",
    "chars": 7
  },
  {
    "screen": 12,
    "line_id": "A06",
    "role": "爷爷",
    "text": "那我该咋办？",
    "chars": 6
  },
  {
    "screen": 13,
    "line_id": "A07",
    "role": "奶奶",
    "text": "三条：儿女管孩子，咱不插嘴、",
    "chars": 14
  },
  {
    "screen": 14,
    "line_id": "A07",
    "role": "奶奶",
    "text": "不拉人、不翻旧账；",
    "chars": 9
  },
  {
    "screen": 15,
    "line_id": "A07",
    "role": "奶奶",
    "text": "真觉得罚重了，回屋关上门，",
    "chars": 13
  },
  {
    "screen": 16,
    "line_id": "A07",
    "role": "奶奶",
    "text": "跟儿子慢慢说。",
    "chars": 7
  },
  {
    "screen": 17,
    "line_id": "A08",
    "role": "爷爷",
    "text": "行。咱俩是来帮忙的，",
    "chars": 10
  },
  {
    "screen": 18,
    "line_id": "A08",
    "role": "爷爷",
    "text": "不是来抢方向盘的。",
    "chars": 9
  },
  {
    "screen": 19,
    "line_id": "A09",
    "role": "爷爷",
    "text": "疼孩子，也得和儿女商量着来。",
    "chars": 14
  },
  {
    "screen": 20,
    "line_id": "A10",
    "role": "奶奶",
    "text": "对，管教的权留给儿女，",
    "chars": 11
  },
  {
    "screen": 21,
    "line_id": "A10",
    "role": "奶奶",
    "text": "这个家才顺。",
    "chars": 6
  }
]