[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "霜打过的白菜晾在院子里，",
    "chars": 12
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "老辈人这几天就开始刷大缸了—",
    "chars": 14
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "—",
    "chars": 1
  },
  {
    "screen": 4,
    "line_id": "A01",
    "role": "爷爷",
    "text": "今天小雪。",
    "chars": 5
  },
  {
    "screen": 5,
    "line_id": "A02",
    "role": "爷爷",
    "text": "老话说，小雪腌菜，大雪腌肉。",
    "chars": 14
  },
  {
    "screen": 6,
    "line_id": "A03",
    "role": "爷爷",
    "text": "有些地方，",
    "chars": 5
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "就有小雪前后腌菜的习惯。",
    "chars": 12
  },
  {
    "screen": 8,
    "line_id": "A04",
    "role": "爷爷",
    "text": "为啥赶在这个节气？",
    "chars": 9
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "爷爷",
    "text": "一是菜正当时：霜打过的白菜、",
    "chars": 14
  },
  {
    "screen": 10,
    "line_id": "A04",
    "role": "爷爷",
    "text": "萝卜、雪里蕻，水分足、",
    "chars": 11
  },
  {
    "screen": 11,
    "line_id": "A04",
    "role": "爷爷",
    "text": "味道厚；",
    "chars": 4
  },
  {
    "screen": 12,
    "line_id": "A05",
    "role": "爷爷",
    "text": "二是天渐渐冷了，老辈人说，",
    "chars": 13
  },
  {
    "screen": 13,
    "line_id": "A05",
    "role": "爷爷",
    "text": "这个时候下缸，心里踏实。",
    "chars": 12
  },
  {
    "screen": 14,
    "line_id": "A06",
    "role": "爷爷",
    "text": "过去没有冰箱，一缸咸菜，",
    "chars": 12
  },
  {
    "screen": 15,
    "line_id": "A06",
    "role": "爷爷",
    "text": "就是一家人冬天的一份储备。",
    "chars": 13
  },
  {
    "screen": 16,
    "line_id": "A07",
    "role": "爷爷",
    "text": "各家做法不一样：有干腌的，",
    "chars": 13
  },
  {
    "screen": 17,
    "line_id": "A07",
    "role": "爷爷",
    "text": "有做泡菜的，",
    "chars": 6
  },
  {
    "screen": 18,
    "line_id": "A07",
    "role": "爷爷",
    "text": "泡菜讲究坛沿那圈",
    "chars": 8
  },
  {
    "screen": 19,
    "line_id": "A07",
    "role": "爷爷",
    "text": "水勤看着点儿。",
    "chars": 7
  },
  {
    "screen": 20,
    "line_id": "A08",
    "role": "爷爷",
    "text": "如今什么菜都买得到，",
    "chars": 10
  },
  {
    "screen": 21,
    "line_id": "A08",
    "role": "爷爷",
    "text": "可不少老人到小雪还是要腌上",
    "chars": 13
  },
  {
    "screen": 22,
    "line_id": "A08",
    "role": "爷爷",
    "text": "一缸——",
    "chars": 4
  },
  {
    "screen": 23,
    "line_id": "A08",
    "role": "爷爷",
    "text": "腌的不是菜，是过日子的节奏，",
    "chars": 14
  },
  {
    "screen": 24,
    "line_id": "A08",
    "role": "爷爷",
    "text": "是老辈人迎冬的讲究。",
    "chars": 10
  },
  {
    "screen": 25,
    "line_id": "A09",
    "role": "爷爷",
    "text": "您家今年腌了吗？",
    "chars": 8
  },
  {
    "screen": 26,
    "line_id": "A10",
    "role": "爷爷",
    "text": "腌的什么？",
    "chars": 5
  }
]