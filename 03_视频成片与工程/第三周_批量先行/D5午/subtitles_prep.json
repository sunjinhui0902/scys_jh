[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "洪水冲过来，实心的桥身一堵，",
    "chars": 14
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "水劲全憋在一处；",
    "chars": 8
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "可河北有座桥，",
    "chars": 7
  },
  {
    "screen": 4,
    "line_id": "A01",
    "role": "爷爷",
    "text": "偏在大券的肩膀上开了小券，",
    "chars": 13
  },
  {
    "screen": 5,
    "line_id": "A01",
    "role": "爷爷",
    "text": "硬是站了一千四百多年——",
    "chars": 12
  },
  {
    "screen": 6,
    "line_id": "A01",
    "role": "爷爷",
    "text": "这就是赵州桥。",
    "chars": 7
  },
  {
    "screen": 7,
    "line_id": "A02",
    "role": "爷爷",
    "text": "相传主持修桥的匠人叫李春，",
    "chars": 13
  },
  {
    "screen": 8,
    "line_id": "A02",
    "role": "爷爷",
    "text": "是隋代人。",
    "chars": 5
  },
  {
    "screen": 9,
    "line_id": "A03",
    "role": "爷爷",
    "text": "它了不起的地方",
    "chars": 7
  },
  {
    "screen": 10,
    "line_id": "A03",
    "role": "爷爷",
    "text": "就在于这几个小券：",
    "chars": 9
  },
  {
    "screen": 11,
    "line_id": "A03",
    "role": "爷爷",
    "text": "桥肩不再是实心的，",
    "chars": 9
  },
  {
    "screen": 12,
    "line_id": "A03",
    "role": "爷爷",
    "text": "这叫敞肩拱，",
    "chars": 6
  },
  {
    "screen": 13,
    "line_id": "A03",
    "role": "爷爷",
    "text": "赵州桥是隋代首创。",
    "chars": 9
  },
  {
    "screen": 14,
    "line_id": "A04",
    "role": "爷爷",
    "text": "好处实在：一是桥身轻了，",
    "chars": 12
  },
  {
    "screen": 15,
    "line_id": "A04",
    "role": "爷爷",
    "text": "自重小了；",
    "chars": 5
  },
  {
    "screen": 16,
    "line_id": "A05",
    "role": "爷爷",
    "text": "二是发洪水时，",
    "chars": 7
  },
  {
    "screen": 17,
    "line_id": "A05",
    "role": "爷爷",
    "text": "水能从小券分流，",
    "chars": 8
  },
  {
    "screen": 18,
    "line_id": "A05",
    "role": "爷爷",
    "text": "不至于全压在桥身上。",
    "chars": 10
  },
  {
    "screen": 19,
    "line_id": "A06",
    "role": "爷爷",
    "text": "当然要说清：",
    "chars": 6
  },
  {
    "screen": 20,
    "line_id": "A06",
    "role": "爷爷",
    "text": "这桥历代都大修过，",
    "chars": 9
  },
  {
    "screen": 21,
    "line_id": "A06",
    "role": "爷爷",
    "text": "现存桥石多非隋代原石。",
    "chars": 11
  },
  {
    "screen": 22,
    "line_id": "A07",
    "role": "爷爷",
    "text": "可敞肩拱这个桥型、这份巧思，",
    "chars": 14
  },
  {
    "screen": 23,
    "line_id": "A07",
    "role": "爷爷",
    "text": "是实实在在从隋代传下来的。",
    "chars": 13
  },
  {
    "screen": 24,
    "line_id": "A08",
    "role": "爷爷",
    "text": "一座桥活一千四百年，",
    "chars": 10
  },
  {
    "screen": 25,
    "line_id": "A08",
    "role": "爷爷",
    "text": "靠的不是料有多金贵，",
    "chars": 10
  },
  {
    "screen": 26,
    "line_id": "A08",
    "role": "爷爷",
    "text": "是设计先想明白了。",
    "chars": 9
  }
]