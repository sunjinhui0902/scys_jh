[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "山西大同的悬空寺，",
    "chars": 9
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "整座寺贴在悬崖上，",
    "chars": 9
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "底下只见几根细柱子，",
    "chars": 10
  },
  {
    "screen": 4,
    "line_id": "A01",
    "role": "爷爷",
    "text": "看着一阵风都能吹下去。",
    "chars": 11
  },
  {
    "screen": 5,
    "line_id": "A02",
    "role": "爷爷",
    "text": "可这座寺从北魏年间开建，",
    "chars": 12
  },
  {
    "screen": 6,
    "line_id": "A02",
    "role": "爷爷",
    "text": "在崖上立了一千多年；先说清，",
    "chars": 14
  },
  {
    "screen": 7,
    "line_id": "A02",
    "role": "爷爷",
    "text": "如今看到的主体，",
    "chars": 8
  },
  {
    "screen": 8,
    "line_id": "A02",
    "role": "爷爷",
    "text": "多是明清时候重修的。",
    "chars": 10
  },
  {
    "screen": 9,
    "line_id": "A03",
    "role": "爷爷",
    "text": "它真正的秘密在崖壁里：",
    "chars": 11
  },
  {
    "screen": 10,
    "line_id": "A03",
    "role": "爷爷",
    "text": "修寺的人在岩壁上凿出洞，",
    "chars": 12
  },
  {
    "screen": 11,
    "line_id": "A03",
    "role": "爷爷",
    "text": "把结实的横梁插进去，",
    "chars": 10
  },
  {
    "screen": 12,
    "line_id": "A03",
    "role": "爷爷",
    "text": "主要的承重，",
    "chars": 6
  },
  {
    "screen": 13,
    "line_id": "A03",
    "role": "爷爷",
    "text": "就靠这些扎进山体的横梁。",
    "chars": 12
  },
  {
    "screen": 14,
    "line_id": "A04",
    "role": "爷爷",
    "text": "您在下面看见的细柱子，",
    "chars": 11
  },
  {
    "screen": 15,
    "line_id": "A04",
    "role": "爷爷",
    "text": "不是判断它稳不稳的依据——",
    "chars": 13
  },
  {
    "screen": 16,
    "line_id": "A04",
    "role": "爷爷",
    "text": "真功夫，藏在看不见的山里头。",
    "chars": 14
  },
  {
    "screen": 17,
    "line_id": "A05",
    "role": "爷爷",
    "text": "所以看悬空寺，",
    "chars": 7
  },
  {
    "screen": 18,
    "line_id": "A05",
    "role": "爷爷",
    "text": "别光盯着那几根柱子心惊，",
    "chars": 12
  },
  {
    "screen": 19,
    "line_id": "A05",
    "role": "爷爷",
    "text": "要看古人把力气用在了哪儿：",
    "chars": 13
  },
  {
    "screen": 20,
    "line_id": "A05",
    "role": "爷爷",
    "text": "不在面上显险，在暗处求稳。",
    "chars": 13
  }
]