[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "儿子当着您的面管孩子，",
    "chars": 11
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "您心疼，",
    "chars": 4
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "一伸手把孙子拉到身后——",
    "chars": 12
  },
  {
    "screen": 4,
    "line_id": "A01",
    "role": "爷爷",
    "text": "这一拉，坏的是规矩。",
    "chars": 10
  },
  {
    "screen": 5,
    "line_id": "A02",
    "role": "爷爷",
    "text": "从那天起，孩子就学精了：",
    "chars": 12
  },
  {
    "screen": 6,
    "line_id": "A02",
    "role": "爷爷",
    "text": "一挨说，就往爷爷奶奶身后躲；",
    "chars": 14
  },
  {
    "screen": 7,
    "line_id": "A02",
    "role": "爷爷",
    "text": "往后遇上事，先找老人挡着。",
    "chars": 13
  },
  {
    "screen": 8,
    "line_id": "A03",
    "role": "爷爷",
    "text": "我给您三条，记好了。",
    "chars": 10
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "爷爷",
    "text": "第一，不插嘴：儿女开口管，",
    "chars": 13
  },
  {
    "screen": 10,
    "line_id": "A04",
    "role": "爷爷",
    "text": "您把话咽回去。",
    "chars": 7
  },
  {
    "screen": 11,
    "line_id": "A05",
    "role": "爷爷",
    "text": "第二，不拉人：普通管教，",
    "chars": 12
  },
  {
    "screen": 12,
    "line_id": "A05",
    "role": "爷爷",
    "text": "别当着面把孩子抢过来；",
    "chars": 11
  },
  {
    "screen": 13,
    "line_id": "A05",
    "role": "爷爷",
    "text": "真要是动手伤着孩子，",
    "chars": 10
  },
  {
    "screen": 14,
    "line_id": "A05",
    "role": "爷爷",
    "text": "那是另一回事，得拦。",
    "chars": 10
  },
  {
    "screen": 15,
    "line_id": "A06",
    "role": "爷爷",
    "text": "第三，不翻旧账：",
    "chars": 8
  },
  {
    "screen": 16,
    "line_id": "A06",
    "role": "爷爷",
    "text": "别说",
    "chars": 2
  },
  {
    "screen": 17,
    "line_id": "A06",
    "role": "爷爷",
    "text": "「你小时候我也没这么管过你」。",
    "chars": 15
  },
  {
    "screen": 18,
    "line_id": "A07",
    "role": "爷爷",
    "text": "有意见怎么办？",
    "chars": 7
  },
  {
    "screen": 19,
    "line_id": "A08",
    "role": "爷爷",
    "text": "留一条：回屋，关门，",
    "chars": 10
  },
  {
    "screen": 20,
    "line_id": "A08",
    "role": "爷爷",
    "text": "跟儿女慢慢商量。",
    "chars": 8
  },
  {
    "screen": 21,
    "line_id": "A09",
    "role": "爷爷",
    "text": "咱老人的位置，",
    "chars": 7
  },
  {
    "screen": 22,
    "line_id": "A09",
    "role": "爷爷",
    "text": "是在儿女身后撑着，",
    "chars": 9
  },
  {
    "screen": 23,
    "line_id": "A09",
    "role": "爷爷",
    "text": "不是站到前头抢方向盘。",
    "chars": 11
  },
  {
    "screen": 24,
    "line_id": "A10",
    "role": "爷爷",
    "text": "撑得住，",
    "chars": 4
  },
  {
    "screen": 25,
    "line_id": "A10",
    "role": "爷爷",
    "text": "一家人的规矩",
    "chars": 6
  },
  {
    "screen": 26,
    "line_id": "A10",
    "role": "爷爷",
    "text": "才说得到一块儿去。",
    "chars": 9
  }
]