[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "两个人分站在墙的两头，",
    "chars": 11
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "贴着墙根轻声说句话，",
    "chars": 10
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "另一头的人居然能听见——",
    "chars": 12
  },
  {
    "screen": 4,
    "line_id": "A01",
    "role": "爷爷",
    "text": "这就是北京天坛的回音壁。",
    "chars": 12
  },
  {
    "screen": 5,
    "line_id": "A02",
    "role": "爷爷",
    "text": "靠的是什么？",
    "chars": 6
  },
  {
    "screen": 6,
    "line_id": "A03",
    "role": "爷爷",
    "text": "一是墙围成圆弧形，",
    "chars": 9
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "声音贴着墙面，",
    "chars": 7
  },
  {
    "screen": 8,
    "line_id": "A03",
    "role": "爷爷",
    "text": "一段一段往前传，不容易散掉；",
    "chars": 14
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "爷爷",
    "text": "二是墙面砌得平整光滑，",
    "chars": 11
  },
  {
    "screen": 10,
    "line_id": "A04",
    "role": "爷爷",
    "text": "声音在上面走，损耗小。",
    "chars": 11
  },
  {
    "screen": 11,
    "line_id": "A05",
    "role": "爷爷",
    "text": "古人建这堵墙时，",
    "chars": 8
  },
  {
    "screen": 12,
    "line_id": "A05",
    "role": "爷爷",
    "text": "未必算过什么声学，",
    "chars": 9
  },
  {
    "screen": 13,
    "line_id": "A05",
    "role": "爷爷",
    "text": "可这份手艺实实在在：",
    "chars": 10
  },
  {
    "screen": 14,
    "line_id": "A05",
    "role": "爷爷",
    "text": "轻声细语，顺着一堵墙，",
    "chars": 11
  },
  {
    "screen": 15,
    "line_id": "A05",
    "role": "爷爷",
    "text": "就能送到老远的另一头。",
    "chars": 11
  },
  {
    "screen": 16,
    "line_id": "A06",
    "role": "爷爷",
    "text": "去天坛别光看祈年殿，",
    "chars": 10
  },
  {
    "screen": 17,
    "line_id": "A06",
    "role": "爷爷",
    "text": "到回音壁和同伴分站两头，",
    "chars": 12
  },
  {
    "screen": 18,
    "line_id": "A06",
    "role": "爷爷",
    "text": "试着说句悄悄话。",
    "chars": 8
  },
  {
    "screen": 19,
    "line_id": "A07",
    "role": "爷爷",
    "text": "几百年前的墙，还在替人传话。",
    "chars": 14
  }
]