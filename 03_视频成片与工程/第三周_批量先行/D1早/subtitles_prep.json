[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "奶奶",
    "text": "又哭了？这盘棋输了，",
    "chars": 10
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "奶奶",
    "text": "眼泪比棋子掉得还快。",
    "chars": 10
  },
  {
    "screen": 3,
    "line_id": "A02",
    "role": "爷爷",
    "text": "先别急着哄。",
    "chars": 6
  },
  {
    "screen": 4,
    "line_id": "A03",
    "role": "爷爷",
    "text": "难过可以，眼泪也可以流，",
    "chars": 12
  },
  {
    "screen": 5,
    "line_id": "A03",
    "role": "爷爷",
    "text": "可棋子不能摔，棋盘不能推——",
    "chars": 14
  },
  {
    "screen": 6,
    "line_id": "A03",
    "role": "爷爷",
    "text": "先把棋子收好，收棋，",
    "chars": 10
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "就是认这盘的结果。",
    "chars": 9
  },
  {
    "screen": 8,
    "line_id": "A04",
    "role": "奶奶",
    "text": "可他说，爷爷故意赢他，",
    "chars": 11
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "奶奶",
    "text": "不跟他玩了。",
    "chars": 6
  },
  {
    "screen": 10,
    "line_id": "A05",
    "role": "爷爷",
    "text": "我要是故意让，",
    "chars": 7
  },
  {
    "screen": 11,
    "line_id": "A05",
    "role": "爷爷",
    "text": "他赢十盘也学不会。",
    "chars": 9
  },
  {
    "screen": 12,
    "line_id": "A06",
    "role": "爷爷",
    "text": "孙子，听好：",
    "chars": 6
  },
  {
    "screen": 13,
    "line_id": "A06",
    "role": "爷爷",
    "text": "下棋跟过日子一样，输了先认，",
    "chars": 14
  },
  {
    "screen": 14,
    "line_id": "A06",
    "role": "爷爷",
    "text": "不摔、不赖、不笑话人。",
    "chars": 11
  },
  {
    "screen": 15,
    "line_id": "A07",
    "role": "奶奶",
    "text": "那下次呢？",
    "chars": 5
  },
  {
    "screen": 16,
    "line_id": "A08",
    "role": "爷爷",
    "text": "下次开局前先说好三条：",
    "chars": 11
  },
  {
    "screen": 17,
    "line_id": "A08",
    "role": "爷爷",
    "text": "不摔棋子，不许悔棋，",
    "chars": 10
  },
  {
    "screen": 18,
    "line_id": "A08",
    "role": "爷爷",
    "text": "赢了不笑话人。",
    "chars": 7
  },
  {
    "screen": 19,
    "line_id": "A09",
    "role": "爷爷",
    "text": "做不到，今天就不下了。",
    "chars": 11
  },
  {
    "screen": 20,
    "line_id": "A10",
    "role": "奶奶",
    "text": "行，规矩说在前面，",
    "chars": 9
  },
  {
    "screen": 21,
    "line_id": "A10",
    "role": "奶奶",
    "text": "比输了再讲道理管用。",
    "chars": 10
  },
  {
    "screen": 22,
    "line_id": "A11",
    "role": "奶奶",
    "text": "等他心平了，",
    "chars": 6
  },
  {
    "screen": 23,
    "line_id": "A11",
    "role": "奶奶",
    "text": "再陪他看看这盘输在哪一步。",
    "chars": 13
  }
]