[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "公园里老伙计凑过来：",
    "chars": 10
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "你退休金一个月多少啊？",
    "chars": 11
  },
  {
    "screen": 3,
    "line_id": "A02",
    "role": "爷爷",
    "text": "你儿子挣得不少吧？",
    "chars": 9
  },
  {
    "screen": 4,
    "line_id": "A03",
    "role": "爷爷",
    "text": "说到相处的分寸，",
    "chars": 8
  },
  {
    "screen": 5,
    "line_id": "A03",
    "role": "爷爷",
    "text": "我想到《中国人的规矩》这本书",
    "chars": 14
  },
  {
    "screen": 6,
    "line_id": "A03",
    "role": "爷爷",
    "text": "，",
    "chars": 1
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "讲的就是咱们待人接物",
    "chars": 10
  },
  {
    "screen": 8,
    "line_id": "A03",
    "role": "爷爷",
    "text": "的老礼数。",
    "chars": 5
  },
  {
    "screen": 9,
    "line_id": "A04",
    "role": "爷爷",
    "text": "碰上打听收入，",
    "chars": 7
  },
  {
    "screen": 10,
    "line_id": "A04",
    "role": "爷爷",
    "text": "我自己的办法是三句话，",
    "chars": 11
  },
  {
    "screen": 11,
    "line_id": "A04",
    "role": "爷爷",
    "text": "笑着就挡回去了。",
    "chars": 8
  },
  {
    "screen": 12,
    "line_id": "A05",
    "role": "爷爷",
    "text": "问退休金：日常够用，",
    "chars": 10
  },
  {
    "screen": 13,
    "line_id": "A05",
    "role": "爷爷",
    "text": "我就不细报数了。",
    "chars": 8
  },
  {
    "screen": 14,
    "line_id": "A06",
    "role": "爷爷",
    "text": "问儿女工资：",
    "chars": 6
  },
  {
    "screen": 15,
    "line_id": "A06",
    "role": "爷爷",
    "text": "孩子们的事我不打听，",
    "chars": 10
  },
  {
    "screen": 16,
    "line_id": "A06",
    "role": "爷爷",
    "text": "他们孝顺就行。",
    "chars": 7
  },
  {
    "screen": 17,
    "line_id": "A07",
    "role": "爷爷",
    "text": "对方再追着问，您就哈哈一笑：",
    "chars": 14
  },
  {
    "screen": 18,
    "line_id": "A07",
    "role": "爷爷",
    "text": "老规矩，钱袋子的事，",
    "chars": 10
  },
  {
    "screen": 19,
    "line_id": "A07",
    "role": "爷爷",
    "text": "不兴细打听。",
    "chars": 6
  },
  {
    "screen": 20,
    "line_id": "A08",
    "role": "爷爷",
    "text": "其实打听的人未必有坏心，",
    "chars": 12
  },
  {
    "screen": 21,
    "line_id": "A08",
    "role": "爷爷",
    "text": "多半是闲聊没分寸——",
    "chars": 10
  },
  {
    "screen": 22,
    "line_id": "A08",
    "role": "爷爷",
    "text": "咱挡得巧，既不伤和气，",
    "chars": 11
  },
  {
    "screen": 23,
    "line_id": "A08",
    "role": "爷爷",
    "text": "也不露自家的底。",
    "chars": 8
  },
  {
    "screen": 24,
    "line_id": "A09",
    "role": "爷爷",
    "text": "说到底，",
    "chars": 4
  },
  {
    "screen": 25,
    "line_id": "A09",
    "role": "爷爷",
    "text": "谁家的收入都是一家人的隐私，",
    "chars": 14
  },
  {
    "screen": 26,
    "line_id": "A09",
    "role": "爷爷",
    "text": "跟交情深浅没关系；守住嘴，",
    "chars": 13
  },
  {
    "screen": 27,
    "line_id": "A09",
    "role": "爷爷",
    "text": "就是守住来往。",
    "chars": 7
  },
  {
    "screen": 28,
    "line_id": "A10",
    "role": "爷爷",
    "text": "这本书就在我主页橱窗里，",
    "chars": 12
  },
  {
    "screen": 29,
    "line_id": "A10",
    "role": "爷爷",
    "text": "点开我主页，商品橱窗里就有。",
    "chars": 14
  },
  {
    "screen": 30,
    "line_id": "A11",
    "role": "爷爷",
    "text": "被人追着打听过工资吗？",
    "chars": 11
  },
  {
    "screen": 31,
    "line_id": "A11",
    "role": "爷爷",
    "text": "您是怎么回的？",
    "chars": 7
  }
]