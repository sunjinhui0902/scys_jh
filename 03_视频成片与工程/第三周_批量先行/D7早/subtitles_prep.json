[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "做了一辈子饭，",
    "chars": 7
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "多少人栽在洋葱手里：",
    "chars": 10
  },
  {
    "screen": 3,
    "line_id": "A01",
    "role": "爷爷",
    "text": "刀刚下去，眼泪先下来了。",
    "chars": 12
  },
  {
    "screen": 4,
    "line_id": "A02",
    "role": "爷爷",
    "text": "这事儿怪谁？",
    "chars": 6
  },
  {
    "screen": 5,
    "line_id": "A03",
    "role": "爷爷",
    "text": "怪洋葱。",
    "chars": 4
  },
  {
    "screen": 6,
    "line_id": "A04",
    "role": "爷爷",
    "text": "洋葱一切开，",
    "chars": 6
  },
  {
    "screen": 7,
    "line_id": "A04",
    "role": "爷爷",
    "text": "里头的东西发生反应，",
    "chars": 10
  },
  {
    "screen": 8,
    "line_id": "A04",
    "role": "爷爷",
    "text": "冒出一股呛人的气，直往上冲。",
    "chars": 14
  },
  {
    "screen": 9,
    "line_id": "A05",
    "role": "爷爷",
    "text": "眼睛受了刺激，就会流泪——",
    "chars": 13
  },
  {
    "screen": 10,
    "line_id": "A05",
    "role": "爷爷",
    "text": "流泪是眼睛在冲洗自己。",
    "chars": 11
  },
  {
    "screen": 11,
    "line_id": "A06",
    "role": "爷爷",
    "text": "想少受点罪，",
    "chars": 6
  },
  {
    "screen": 12,
    "line_id": "A06",
    "role": "爷爷",
    "text": "老辈人传下来几个土办法：",
    "chars": 12
  },
  {
    "screen": 13,
    "line_id": "A06",
    "role": "爷爷",
    "text": "一是切之前把洋葱泡一泡凉水；",
    "chars": 14
  },
  {
    "screen": 14,
    "line_id": "A07",
    "role": "爷爷",
    "text": "二是刀沾着水切；",
    "chars": 8
  },
  {
    "screen": 15,
    "line_id": "A08",
    "role": "爷爷",
    "text": "三是把洋葱",
    "chars": 5
  },
  {
    "screen": 16,
    "line_id": "A08",
    "role": "爷爷",
    "text": "先在冰箱里镇一会儿再切。",
    "chars": 12
  },
  {
    "screen": 17,
    "line_id": "A09",
    "role": "爷爷",
    "text": "都不费事，管不管用，",
    "chars": 10
  },
  {
    "screen": 18,
    "line_id": "A09",
    "role": "爷爷",
    "text": "您下回切菜试一回就知道。",
    "chars": 12
  },
  {
    "screen": 19,
    "line_id": "A10",
    "role": "爷爷",
    "text": "做饭这点小事，处处都是学问。",
    "chars": 14
  },
  {
    "screen": 20,
    "line_id": "A11",
    "role": "爷爷",
    "text": "您切洋葱有什么绝招？",
    "chars": 10
  },
  {
    "screen": 21,
    "line_id": "A12",
    "role": "爷爷",
    "text": "说出来让大家学学。",
    "chars": 9
  }
]