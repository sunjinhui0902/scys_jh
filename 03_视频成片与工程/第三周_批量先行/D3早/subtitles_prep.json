[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "孙子下棋，输了就哭，",
    "chars": 10
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "棋盘一推不玩了。",
    "chars": 8
  },
  {
    "screen": 3,
    "line_id": "A02",
    "role": "爷爷",
    "text": "这种场面，我劝您别急着哄，",
    "chars": 13
  },
  {
    "screen": 4,
    "line_id": "A02",
    "role": "爷爷",
    "text": "也别让着他。",
    "chars": 6
  },
  {
    "screen": 5,
    "line_id": "A03",
    "role": "爷爷",
    "text": "您越让，他越觉得赢是应该的；",
    "chars": 14
  },
  {
    "screen": 6,
    "line_id": "A03",
    "role": "爷爷",
    "text": "哪天在外头输给别人，",
    "chars": 10
  },
  {
    "screen": 7,
    "line_id": "A03",
    "role": "爷爷",
    "text": "哭得更凶。",
    "chars": 5
  },
  {
    "screen": 8,
    "line_id": "A04",
    "role": "爷爷",
    "text": "我的办法就两步。",
    "chars": 8
  },
  {
    "screen": 9,
    "line_id": "A05",
    "role": "爷爷",
    "text": "第一步，输了先认：难过可以，",
    "chars": 14
  },
  {
    "screen": 10,
    "line_id": "A05",
    "role": "爷爷",
    "text": "眼泪也可以流，",
    "chars": 7
  },
  {
    "screen": 11,
    "line_id": "A05",
    "role": "爷爷",
    "text": "但棋子得自己收——收棋，",
    "chars": 12
  },
  {
    "screen": 12,
    "line_id": "A05",
    "role": "爷爷",
    "text": "就是认账。",
    "chars": 5
  },
  {
    "screen": 13,
    "line_id": "A06",
    "role": "爷爷",
    "text": "第二步，下次开局之前，",
    "chars": 11
  },
  {
    "screen": 14,
    "line_id": "A06",
    "role": "爷爷",
    "text": "先把规矩说好：不摔棋子、",
    "chars": 12
  },
  {
    "screen": 15,
    "line_id": "A06",
    "role": "爷爷",
    "text": "不许悔棋、赢了不笑话人；",
    "chars": 12
  },
  {
    "screen": 16,
    "line_id": "A06",
    "role": "爷爷",
    "text": "做不到，今天这棋就不下了。",
    "chars": 13
  },
  {
    "screen": 17,
    "line_id": "A07",
    "role": "爷爷",
    "text": "话说在前面，是规矩；",
    "chars": 10
  },
  {
    "screen": 18,
    "line_id": "A07",
    "role": "爷爷",
    "text": "等输了再讲，是数落，",
    "chars": 10
  },
  {
    "screen": 19,
    "line_id": "A07",
    "role": "爷爷",
    "text": "孩子听不进去。",
    "chars": 7
  },
  {
    "screen": 20,
    "line_id": "A08",
    "role": "爷爷",
    "text": "下棋是小事，输得起，",
    "chars": 10
  },
  {
    "screen": 21,
    "line_id": "A08",
    "role": "爷爷",
    "text": "才是大事。",
    "chars": 5
  },
  {
    "screen": 22,
    "line_id": "A09",
    "role": "爷爷",
    "text": "孩子将来要面对的输赢，",
    "chars": 11
  },
  {
    "screen": 23,
    "line_id": "A09",
    "role": "爷爷",
    "text": "比棋盘大得多。",
    "chars": 7
  }
]