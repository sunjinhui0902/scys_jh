[
  {
    "screen": 1,
    "line_id": "A01",
    "role": "爷爷",
    "text": "您见过轻轨",
    "chars": 5
  },
  {
    "screen": 2,
    "line_id": "A01",
    "role": "爷爷",
    "text": "从居民楼里穿过去的吗？",
    "chars": 11
  },
  {
    "screen": 3,
    "line_id": "A02",
    "role": "爷爷",
    "text": "在重庆李子坝，",
    "chars": 7
  },
  {
    "screen": 4,
    "line_id": "A02",
    "role": "爷爷",
    "text": "列车从居民楼中间几层钻进钻",
    "chars": 13
  },
  {
    "screen": 5,
    "line_id": "A02",
    "role": "爷爷",
    "text": "出，",
    "chars": 2
  },
  {
    "screen": 6,
    "line_id": "A02",
    "role": "爷爷",
    "text": "站就设在楼里，",
    "chars": 7
  },
  {
    "screen": 7,
    "line_id": "A02",
    "role": "爷爷",
    "text": "车站和住户各走各的门，",
    "chars": 11
  },
  {
    "screen": 8,
    "line_id": "A02",
    "role": "爷爷",
    "text": "互不打扰。",
    "chars": 5
  },
  {
    "screen": 9,
    "line_id": "A03",
    "role": "爷爷",
    "text": "很多人以为，这是楼盖好了、",
    "chars": 13
  },
  {
    "screen": 10,
    "line_id": "A03",
    "role": "爷爷",
    "text": "轨道硬塞进去的。",
    "chars": 8
  },
  {
    "screen": 11,
    "line_id": "A04",
    "role": "爷爷",
    "text": "其实不是：",
    "chars": 5
  },
  {
    "screen": 12,
    "line_id": "A04",
    "role": "爷爷",
    "text": "车站和大楼是同期设计的，",
    "chars": 12
  },
  {
    "screen": 13,
    "line_id": "A04",
    "role": "爷爷",
    "text": "轨道从楼里预留的位置通过。",
    "chars": 13
  },
  {
    "screen": 14,
    "line_id": "A05",
    "role": "爷爷",
    "text": "山城的地形逼出了这个办法：",
    "chars": 13
  },
  {
    "screen": 15,
    "line_id": "A05",
    "role": "爷爷",
    "text": "地不够平，就往空中要路。",
    "chars": 12
  },
  {
    "screen": 16,
    "line_id": "A06",
    "role": "爷爷",
    "text": "这一穿，穿成了重庆的名片，",
    "chars": 13
  },
  {
    "screen": 17,
    "line_id": "A06",
    "role": "爷爷",
    "text": "全国的人跑来看。",
    "chars": 8
  },
  {
    "screen": 18,
    "line_id": "A07",
    "role": "爷爷",
    "text": "下次去重庆，别光在楼下拍照，",
    "chars": 14
  },
  {
    "screen": 19,
    "line_id": "A07",
    "role": "爷爷",
    "text": "坐一趟车亲身穿一回楼，",
    "chars": 11
  },
  {
    "screen": 20,
    "line_id": "A07",
    "role": "爷爷",
    "text": "那才叫过瘾。",
    "chars": 6
  }
]