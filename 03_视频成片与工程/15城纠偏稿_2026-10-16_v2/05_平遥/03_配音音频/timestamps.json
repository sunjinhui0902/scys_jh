[
  {
    "index": 1,
    "text": "去平遥逛完古城墙",
    "start_ms": 0,
    "end_ms": 2832,
    "duration_ms": 2832
  },
  {
    "index": 2,
    "text": "再去西大街看老票号",
    "start_ms": 2992,
    "end_ms": 5848,
    "duration_ms": 2856
  },
  {
    "index": 3,
    "text": "一百多年前没有电脑",
    "start_ms": 6008,
    "end_ms": 8840,
    "duration_ms": 2832
  },
  {
    "index": 4,
    "text": "也没有银行卡和转账",
    "start_ms": 9000,
    "end_ms": 11856,
    "duration_ms": 2856
  },
  {
    "index": 5,
    "text": "日升昌开出一张薄纸",
    "start_ms": 12016,
    "end_ms": 14848,
    "duration_ms": 2832
  },
  {
    "index": 6,
    "text": "凭啥千里外兑出白银",
    "start_ms": 15008,
    "end_ms": 17768,
    "duration_ms": 2760
  },
  {
    "index": 7,
    "text": "秘密全藏在汉字密押",
    "start_ms": 17928,
    "end_ms": 21000,
    "duration_ms": 3072
  },
  {
    "index": 8,
    "text": "过去运现银要靠镖局",
    "start_ms": 21160,
    "end_ms": 24160,
    "duration_ms": 3000
  },
  {
    "index": 9,
    "text": "山高路远怕土匪劫镖",
    "start_ms": 24320,
    "end_ms": 27536,
    "duration_ms": 3216
  },
  {
    "index": 10,
    "text": "老掌柜想出破局奇招",
    "start_ms": 27696,
    "end_ms": 30552,
    "duration_ms": 2856
  },
  {
    "index": 11,
    "text": "把汉字编成隐秘诗句",
    "start_ms": 30712,
    "end_ms": 33808,
    "duration_ms": 3096
  },
  {
    "index": 12,
    "text": "分别对应日期和银两",
    "start_ms": 33968,
    "end_ms": 36848,
    "duration_ms": 2880
  },
  {
    "index": 13,
    "text": "写汇票时只填暗语字",
    "start_ms": 37008,
    "end_ms": 40320,
    "duration_ms": 3312
  },
  {
    "index": 14,
    "text": "外人拿到手如同天书",
    "start_ms": 40480,
    "end_ms": 43576,
    "duration_ms": 3096
  },
  {
    "index": 15,
    "text": "到了千里外的分号",
    "start_ms": 43736,
    "end_ms": 46352,
    "duration_ms": 2616
  },
  {
    "index": 16,
    "text": "掌柜翻开密押底本",
    "start_ms": 46512,
    "end_ms": 49152,
    "duration_ms": 2640
  },
  {
    "index": 17,
    "text": "核对暗语笔迹与印章",
    "start_ms": 49312,
    "end_ms": 52120,
    "duration_ms": 2808
  },
  {
    "index": 18,
    "text": "几层手续互相印证",
    "start_ms": 52280,
    "end_ms": 55136,
    "duration_ms": 2856
  },
  {
    "index": 19,
    "text": "才能兑出真金白银",
    "start_ms": 55296,
    "end_ms": 57936,
    "duration_ms": 2640
  },
  {
    "index": 20,
    "text": "并且暗号还定期更换",
    "start_ms": 58096,
    "end_ms": 61168,
    "duration_ms": 3072
  },
  {
    "index": 21,
    "text": "让做假账的彻底绝望",
    "start_ms": 61328,
    "end_ms": 64328,
    "duration_ms": 3000
  },
  {
    "index": 22,
    "text": "下次走进平遥老票号",
    "start_ms": 64488,
    "end_ms": 67392,
    "duration_ms": 2904
  },
  {
    "index": 23,
    "text": "别只在大门口拍牌匾",
    "start_ms": 67552,
    "end_ms": 70528,
    "duration_ms": 2976
  },
  {
    "index": 24,
    "text": "记得去后院账房展柜",
    "start_ms": 70688,
    "end_ms": 73616,
    "duration_ms": 2928
  },
  {
    "index": 25,
    "text": "亲眼看一看密押暗诗",
    "start_ms": 73776,
    "end_ms": 76704,
    "duration_ms": 2928
  },
  {
    "index": 26,
    "text": "想读懂百年老商帮",
    "start_ms": 76864,
    "end_ms": 79600,
    "duration_ms": 2736
  },
  {
    "index": 27,
    "text": "翻开这本中国历史名城",
    "start_ms": 79760,
    "end_ms": 82952,
    "duration_ms": 3192
  },
  {
    "index": 28,
    "text": "把古城智慧讲得通透",
    "start_ms": 83112,
    "end_ms": 86208,
    "duration_ms": 3096
  },
  {
    "index": 29,
    "text": "带孩子读懂中国名城",
    "start_ms": 86368,
    "end_ms": 89392,
    "duration_ms": 3024
  }
]